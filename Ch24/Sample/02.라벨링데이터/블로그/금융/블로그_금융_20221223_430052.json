{ "annotation": [ { "charNum": "1", "label": "대화형", "length": 39, "text": "경제와 친해지기 위해 노력하는 육아 대디 펀뻔삼촌의 경제 이야기입니다.", "value": { "text_id": "1", "word_num": 10, "핵심동사": "이야기입니다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "42", "label": "대화형", "length": 37, "text": "오늘의 경제신문 키워드는 프리미엄폰, 고용허가 쿼터제, 환율입니다.", "value": { "text_id": "2", "word_num": 8, "핵심동사": "환율입니다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "81", "label": "대화형", "length": 51, "text": "소비자의 입장에서 삼성과 애플의 경쟁은 더 나은 상품을 구입할 수 있는 좋은 계기가 됩니다.", "value": { "text_id": "3", "word_num": 15, "핵심동사": "됩니다", "확실성": "확실", "극성": "긍정", "시제": "미래", "key_word": " " } }, { "charNum": "134", "label": "대화형", "length": 23, "text": "하지만 폰값은 점점 더 올라가고 있습니다.", "value": { "text_id": "4", "word_num": 7, "핵심동사": "올라가고", "확실성": "확실", "극성": "미정", "시제": "현재", "key_word": " " } }, { "charNum": "159", "label": "대화형", "length": 49, "text": "물가는 상승하고 환율도 상승하는 첩첩산중의 생활에서 기업은 고용난까지 시달리고 있습니다.", "value": { "text_id": "5", "word_num": 11, "핵심동사": "시달리고", "확실성": "확실", "극성": "미정", "시제": "현재", "key_word": " " } }, { "charNum": "210", "label": "대화형", "length": 55, "text": "몇 날 며칠 신문을 보고 있지만 최근 희소식은 드물고 가계에 어려움만 주는 소식들만 전해 듣습니다.", "value": { "text_id": "6", "word_num": 16, "핵심동사": "듣습니다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "267", "label": "대화형", "length": 33, "text": "기분 좋은 글을 쓰고 싶지만 쉽지 않아서 착착한 심정입니다.", "value": { "text_id": "7", "word_num": 10, "핵심동사": "심정입니다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } } ], "dupLabelYn": "Y", "metaData": { "ID": "430052", "FILENAME": "430052.json", "MEDIA_TYPE": "블로그", "MEDIA_NAME": "티스토리 - https://bbassag.tistory.com/entry/%EA%B2%BD%EC%A0%9C%EC%9D%B4%EC%95%BC%EA%B8%B020220901-%ED%94%84%EB%A6%AC%EB%AF%B8%EC%97%84%ED%8F%B0-%EA%B3%A0%EC%9A%A9%ED%97%88%EA%B0%80-%EA%B6%88%ED%84%B0%EC%A0%9C-%ED%99%98%EC%9C%A8", "CATEGORY": "금융", "PUBDATE": "20220901", "SENTENCE": "7" } } 