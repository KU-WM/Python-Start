{ "annotation": [ { "charNum": "1", "label": "사실형", "length": 17, "text": "두번째로 해외주식 양도소득세다.", "value": { "text_id": "1", "word_num": 3, "핵심동사": "양도소득세다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "19", "label": "사실형", "length": 86, "text": "종합소득세보다 더 주의깊게 봐야할 것이 해외주식 양도소득세인데, 신고하지 않으면 무신고 가산세 20% + 1일당 0.025%의 세금이 추가 되기 때문이다.", "value": { "text_id": "2", "word_num": 19, "핵심동사": "때문이다", "확실성": "확실", "극성": "긍정", "시제": "미래", "key_word": " " } }, { "charNum": "106", "label": "사실형", "length": 41, "text": "양도소득세는 말 그대로 주식을 매도할 때 차익에 대해 세금을 내는 것이다.", "value": { "text_id": "3", "word_num": 11, "핵심동사": "내는", "확실성": "확실", "극성": "미정", "시제": "미래", "key_word": " " } }, { "charNum": "148", "label": "사실형", "length": 36, "text": "기본적으로 250만원은 비과세라, 차익이 250만원까지는 괜찮다.", "value": { "text_id": "4", "word_num": 6, "핵심동사": "괜찮다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "185", "label": "사실형", "length": 32, "text": "하지만 250만원을 넘는 차익에 대해 22% 과세가 된다.", "value": { "text_id": "5", "word_num": 8, "핵심동사": "된다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "218", "label": "사실형", "length": 38, "text": "매년 신고해야 하고 가산세가 크지만, 증권사에 대행을 맡길 수 있다.", "value": { "text_id": "6", "word_num": 10, "핵심동사": "맡길", "확실성": "확실", "극성": "미정", "시제": "미래", "key_word": " " } }, { "charNum": "257", "label": "사실형", "length": 50, "text": "방법은 증권사마다 다르니 본인이 이용 중인 증권사에 맞는 방법으로 대행 신고를 하면 된다.", "value": { "text_id": "7", "word_num": 13, "핵심동사": "된다", "확실성": "확실", "극성": "긍정", "시제": "미래", "key_word": " " } }, { "charNum": "308", "label": "추론형", "length": 25, "text": "가급적 증권사 대행을 이용하는게 편리해보인다.", "value": { "text_id": "8", "word_num": 5, "핵심동사": "편리해보인다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": "편리해보인다" } } ], "dupLabelYn": "Y", "metaData": { "ID": "430056", "FILENAME": "430056.json", "MEDIA_TYPE": "블로그", "MEDIA_NAME": "네이버 - https://blog.naver.com/dusalswls421/222852412889", "CATEGORY": "금융", "PUBDATE": "20220811", "SENTENCE": "8" } } 