{ "annotation": [ { "charNum": "1", "label": "대화형", "length": 16, "text": "금은 대표적인 안전자산입니다.", "value": { "text_id": "1", "word_num": 4, "핵심동사": "안전자산입니다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "19", "label": "대화형", "length": 59, "text": "금은 오래전부터 지역과 시대를 막론하고 인류가 화폐와 귀금속으로 활용할 만큼 희소가치가 큰 금속이었습니다.", "value": { "text_id": "2", "word_num": 14, "핵심동사": "금속이었습니다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": " " } }, { "charNum": "80", "label": "대화형", "length": 92, "text": "세계 금 위원회에 따르면 현재까지 인류가 채굴한 금의 양은 약 20만 1296톤이며, 앞으로 더 채굴할 수 있는 금의 매장량은 약 5만 3000천 톤으로 추정됩니다.", "value": { "text_id": "3", "word_num": 25, "핵심동사": "추정됩니다", "확실성": "불확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "174", "label": "대화형", "length": 56, "text": "지상의 모든 금들을 모아 쌓아서 정육면체를 만들 경우, 각 면의 길이는 22미터에 불과하다고 합니다.", "value": { "text_id": "4", "word_num": 15, "핵심동사": "합니다", "확실성": "불확실", "극성": "긍정", "시제": "미래", "key_word": " " } }, { "charNum": "232", "label": "대화형", "length": 19, "text": "이 정도로 금은 희귀한 금속입니다.", "value": { "text_id": "5", "word_num": 6, "핵심동사": "금속입니다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "253", "label": "대화형", "length": 60, "text": "금은 세계 어디서나 통용되는 자산으로, 금을 들고 어느 나라를 가던 돈과 바꿀 수 있어 환금성이 뛰어납니다.", "value": { "text_id": "6", "word_num": 17, "핵심동사": "뛰어납니다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "315", "label": "대화형", "length": 53, "text": "또한 물가가 상승해도 가치가 떨어지지 않아 대표적인 인플레이션 헤지 수단으로 활용되기도 합니다.", "value": { "text_id": "7", "word_num": 13, "핵심동사": "활용되기도", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "370", "label": "대화형", "length": 42, "text": "오늘은 대표적인 안전자산 금에 투자할 수 있는 방법들에 대해 알아보겠습니다.", "value": { "text_id": "8", "word_num": 11, "핵심동사": "알아보겠습니다", "확실성": "확실", "극성": "미정", "시제": "미래", "key_word": " " } } ], "dupLabelYn": "Y", "metaData": { "ID": "430066", "FILENAME": "430066.json", "MEDIA_TYPE": "블로그", "MEDIA_NAME": "티스토리 - https://econoclass.tistory.com/73?category=1279071", "CATEGORY": "금융", "PUBDATE": "20220725", "SENTENCE": "8" } } 