{ "annotation": [ { "charNum": "1", "label": "대화형", "length": 31, "text": "뉴시스 가상자산 판은 커지려는 움직임을 보이고 있습니다.", "value": { "text_id": "1", "word_num": 8, "핵심동사": "보이고", "확실성": "확실", "극성": "미정", "시제": "현재", "key_word": " " } }, { "charNum": "34", "label": "대화형", "length": 29, "text": "블랙록은 1경이 넘는 금액을 굴리는 자산운용사입니다.", "value": { "text_id": "2", "word_num": 7, "핵심동사": "자산운용사입니다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "65", "label": "대화형", "length": 78, "text": "이 회사는 코인베이스와 협업을 통해 가상자산 시장에 관심을 갖는 기관투자가들에게 수탁 서비스 등 다양한 서비스를 지원할 것이라고 밝혔습니다.", "value": { "text_id": "3", "word_num": 19, "핵심동사": "밝혔습니다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": " " } }, { "charNum": "145", "label": "대화형", "length": 42, "text": "이를 통해 다시한번 기관자금이 제대로 들어올 길을 연것으로 볼 수 있습니다.", "value": { "text_id": "4", "word_num": 12, "핵심동사": "볼", "확실성": "확실", "극성": "미정", "시제": "현재", "key_word": " " } }, { "charNum": "189", "label": "대화형", "length": 80, "text": "이미 블랙록은 블랙록 스트래티직 인컴 오퍼튜니티즈 및 블랙록 글로벌 앨로케이션 펀드 등 2개를 통해 비트코인 투자를 위해 시장에 진입하였습니다.", "value": { "text_id": "5", "word_num": 20, "핵심동사": "진입하였습니다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": " " } }, { "charNum": "271", "label": "대화형", "length": 31, "text": "그만큼 이 시장에 대한 관심도가 높다고 볼 수 있습니다.", "value": { "text_id": "6", "word_num": 10, "핵심동사": "볼", "확실성": "확실", "극성": "미정", "시제": "현재", "key_word": " " } }, { "charNum": "304", "label": "대화형", "length": 30, "text": "그럼에도 비트코인 가격이 폭등하거나 그러지 않았습니다.", "value": { "text_id": "7", "word_num": 7, "핵심동사": "그러지", "확실성": "불확실", "극성": "부정", "시제": "과거", "key_word": " " } }, { "charNum": "336", "label": "대화형", "length": 52, "text": "DCG 그룹의 베리실버트는 트윗을 통해 이 뉴스에도 가격이 움직이지 않은것에 놀라고 있습니다.", "value": { "text_id": "8", "word_num": 13, "핵심동사": "놀라고", "확실성": "확실", "극성": "미정", "시제": "현재", "key_word": " " } }, { "charNum": "390", "label": "대화형", "length": 36, "text": "결국 시장의 판도를 바꿀 주요한 기점으로 작용할 것으로 보이네요.", "value": { "text_id": "9", "word_num": 10, "핵심동사": "보이네요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "428", "label": "대화형", "length": 10, "text": "물론 장기적으로요.", "value": { "text_id": "10", "word_num": 3, "핵심동사": "장기적으로요", "확실성": "확실", "극성": "긍정", "시제": "미래", "key_word": " " } } ], "dupLabelYn": "Y", "metaData": { "ID": "430101", "FILENAME": "430101.json", "MEDIA_TYPE": "블로그", "MEDIA_NAME": "네이버 - https://blog.naver.com/rusiper1000/222841674552", "CATEGORY": "금융", "PUBDATE": "20220401", "SENTENCE": "10" } } 