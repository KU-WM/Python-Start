{ "annotation": [ { "charNum": "1", "label": "대화형", "length": 27, "text": "58주차 비트코인 적립식 투자가 완료 되었습니다.", "value": { "text_id": "1", "word_num": 7, "핵심동사": "완료 되었습니다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": " " } }, { "charNum": "30", "label": "대화형", "length": 21, "text": "어느덧 무더운 여름이 지나가고 있네요.", "value": { "text_id": "2", "word_num": 6, "핵심동사": "지나가고", "확실성": "확실", "극성": "미정", "시제": "현재", "key_word": " " } }, { "charNum": "53", "label": "대화형", "length": 35, "text": "아침, 저녁으로 선선한 바람이 조금씩 불어오고 있는거 같습니다.", "value": { "text_id": "3", "word_num": 9, "핵심동사": "같습니다", "확실성": "확실", "극성": "미정", "시제": "미래", "key_word": " " } }, { "charNum": "90", "label": "대화형", "length": 30, "text": "8월 적립식 투자도 1회만 더하면 9월에 진입하겠네요.", "value": { "text_id": "4", "word_num": 8, "핵심동사": "진입하겠네요", "확실성": "불확실", "극성": "미정", "시제": "미래", "key_word": " " } }, { "charNum": "122", "label": "대화형", "length": 37, "text": "이번주는 비트코인 가격의 변동성이 꽤나 컸던 한 주였던거 같습니다.", "value": { "text_id": "5", "word_num": 10, "핵심동사": "같습니다", "확실성": "확실", "극성": "부정", "시제": "현재", "key_word": " " } }, { "charNum": "161", "label": "대화형", "length": 49, "text": "3천만원이 넘었던 금액은 다시 하락하면서 2900만원대로 10%넘게 하락하기도 했습니다.", "value": { "text_id": "6", "word_num": 10, "핵심동사": "하락하기도", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": " " } }, { "charNum": "212", "label": "대화형", "length": 22, "text": "아직 힘차게 오를 힘은 부족해 보입니다.", "value": { "text_id": "7", "word_num": 7, "핵심동사": "보입니다", "확실성": "확실", "극성": "미정", "시제": "미래", "key_word": " " } }, { "charNum": "236", "label": "대화형", "length": 74, "text": "아무래도 거시적 경제 상황이나 단기적 악재(마운트곡스 해킹 물량이 시장에 풀리는 등)가 여전히 존재하는 만큼 시간이 필요해 보입니다.", "value": { "text_id": "8", "word_num": 18, "핵심동사": "보입니다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "312", "label": "대화형", "length": 33, "text": "시간이 필요하다는 것은 그만큼 기회가 주어지는것이기도 하죠.", "value": { "text_id": "9", "word_num": 7, "핵심동사": "주어지는", "확실성": "확실", "극성": "미정", "시제": "미래", "key_word": " " } }, { "charNum": "346", "label": "대화형", "length": 58, "text": "이번주는 비트코인 29,229,000원에 거래되고 있으며 10만원으로 0.00342125개를 모았습니다.", "value": { "text_id": "10", "word_num": 9, "핵심동사": "모았습니다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": " " } }, { "charNum": "406", "label": "대화형", "length": 55, "text": "이번주까지 580만원 투자를 하였고 현재 가치 370만원 정도로 -36% 수익률을 보이고 있습니다.", "value": { "text_id": "11", "word_num": 13, "핵심동사": "보이고", "확실성": "확실", "극성": "미정", "시제": "미래", "key_word": " " } }, { "charNum": "463", "label": "대화형", "length": 38, "text": "저번주 힘겹게 -30%대를 깨었는데 다시 -30%대로 회귀 했습니다.", "value": { "text_id": "12", "word_num": 9, "핵심동사": "회귀 했습니다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": " " } }, { "charNum": "503", "label": "대화형", "length": 36, "text": "이 정도 하락률은 한 끝차이일 뿐이니 존버하기 적당한거 같습니다.", "value": { "text_id": "13", "word_num": 10, "핵심동사": "같습니다", "확실성": "불확실", "극성": "부정", "시제": "현재", "key_word": " " } }, { "charNum": "541", "label": "대화형", "length": 32, "text": "평가금액 주황선도 결국 열심히 우상향 하다 주저 앉았네요.", "value": { "text_id": "14", "word_num": 9, "핵심동사": "주저 앉았네요", "확실성": "확실", "극성": "부정", "시제": "현재", "key_word": " " } }, { "charNum": "575", "label": "대화형", "length": 40, "text": "장기적으로 누적금액을 훨씬 상회할 것이기 때문에 아무런 상관이 없습니다.", "value": { "text_id": "15", "word_num": 10, "핵심동사": "없습니다", "확실성": "확실", "극성": "부정", "시제": "현재", "key_word": " " } } ], "dupLabelYn": "Y", "metaData": { "ID": "430180", "FILENAME": "430180.json", "MEDIA_TYPE": "블로그", "MEDIA_NAME": "네이버 - https://blog.naver.com/rusiper1000/222853835736", "CATEGORY": "금융", "PUBDATE": "20220401", "SENTENCE": "15" } } 