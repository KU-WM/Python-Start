{ "annotation": [ { "charNum": "1", "label": "사실형", "length": 74, "text": "비 정상적으로 부풀어 오른 주식시장의 거품은 장기적으로는 항상 평균으로 회귀하기 때문에 종종 시장 조정의 첫 신호중 하나로 판단된다.", "value": { "text_id": "1", "word_num": 19, "핵심동사": "판단된다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "77", "label": "사실형", "length": 41, "text": "S&P500의 주가수익비율은 현재 26으로 과거 평균 19보다 훨씬 높다.", "value": { "text_id": "2", "word_num": 10, "핵심동사": "높다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "120", "label": "사실형", "length": 43, "text": "S&P500의 주가수익비율은 2000년대 초반 닷컴버블때 30대에 도달했었다.", "value": { "text_id": "3", "word_num": 8, "핵심동사": "도달했었다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": " " } }, { "charNum": "165", "label": "사실형", "length": 29, "text": "일반적으로 장기 채권 수익률은 단기 수익율보다 높다.", "value": { "text_id": "4", "word_num": 8, "핵심동사": "높다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "196", "label": "사실형", "length": 38, "text": "투자자들이 장기 담보를 보유하는 것에 대한 보상을 요구하기 때문이다.", "value": { "text_id": "5", "word_num": 10, "핵심동사": "때문이다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "236", "label": "사실형", "length": 19, "text": "이로 인해 수익률 곡선이 상승한다.", "value": { "text_id": "6", "word_num": 6, "핵심동사": "상승한다", "확실성": "확실", "극성": "미정", "시제": "미래", "key_word": " " } }, { "charNum": "257", "label": "사실형", "length": 68, "text": "투자자들은 경제적 불확실성을 느낄 때, 안전을 찾고, 가격을 높여 수익율을 낮추기 위해 장기 채권에 투자하는 경향이 있다.", "value": { "text_id": "7", "word_num": 18, "핵심동사": "있다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "327", "label": "사실형", "length": 33, "text": "중앙은행은 종종 물가안정을 위한 도구로 통화정책을 사용한다.", "value": { "text_id": "8", "word_num": 8, "핵심동사": "사용한다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "362", "label": "사실형", "length": 26, "text": "인플레이션은 높은 금리 인상으로 대처하게 된다.", "value": { "text_id": "9", "word_num": 7, "핵심동사": "대처하게", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "390", "label": "사실형", "length": 49, "text": "높은 금리는 소비자의 지출을 억제하고 상품과 서비스를 판매하는 기업의 실적을 둔화시킨다.", "value": { "text_id": "10", "word_num": 12, "핵심동사": "둔화시킨다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "441", "label": "사실형", "length": 61, "text": "금리 인상은 기업의 자금 조달 비용도 증가시키게 되며 현재는 전 세계적으로 지속적인 금리인상을 압박받고 있다.", "value": { "text_id": "11", "word_num": 16, "핵심동사": "압박받고", "확실성": "확실", "극성": "미정", "시제": "현재", "key_word": " " } } ], "dupLabelYn": "Y", "metaData": { "ID": "430130", "FILENAME": "430130.json", "MEDIA_TYPE": "블로그", "MEDIA_NAME": "티스토리 - https://sysfund.com/568?category=621395", "CATEGORY": "금융", "PUBDATE": "20220914", "SENTENCE": "11" } } 