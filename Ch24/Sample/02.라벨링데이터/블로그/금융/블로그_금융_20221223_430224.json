{ "annotation": [ { "charNum": "1", "label": "사실형", "length": 28, "text": "한국과 중국에 다가올 위기의 핵심은 부채 위기이다.", "value": { "text_id": "1", "word_num": 8, "핵심동사": "위기이다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "31", "label": "사실형", "length": 18, "text": "부채 위기를 막는 길은 2가지다.", "value": { "text_id": "2", "word_num": 6, "핵심동사": "2가지다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "51", "label": "추론형", "length": 39, "text": "부채 증가 속도보다 더 빨리 소득을 늘리는 것이 첫번째이나 쉽지 않다.", "value": { "text_id": "3", "word_num": 12, "핵심동사": "쉽지", "확실성": "확실", "극성": "부정", "시제": "현재", "key_word": "쉽지" } }, { "charNum": "92", "label": "사실형", "length": 50, "text": "남은 길은 버는 것보다 상대적으로 부채 부담이 적은 수준으로 금리를 낮게 유지하는 것이다.", "value": { "text_id": "4", "word_num": 14, "핵심동사": "유지하는", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "144", "label": "사실형", "length": 49, "text": "지금까지 부채를 늘리면서도 결정적인 위기로 발전하지 않고 버틴 이유가 저금리 덕분이었다.", "value": { "text_id": "5", "word_num": 12, "핵심동사": "덕분이었다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": " " } }, { "charNum": "195", "label": "대화형", "length": 27, "text": "그러면 저금리 기조는 언제까지 유지할 수 있을까?", "value": { "text_id": "6", "word_num": 7, "핵심동사": "유지할", "확실성": "불확실", "극성": "부정", "시제": "현재", "key_word": " " } }, { "charNum": "223", "label": "사실형", "length": 34, "text": "2000년 이전까지는 한국의 기준금리가 미국보다 훨씬 높았다.", "value": { "text_id": "7", "word_num": 8, "핵심동사": "높았다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": " " } }, { "charNum": "259", "label": "추론형", "length": 59, "text": "당시의 한국과 미국의 경제적 역량 차이, 한국이 글로벌 경제에서 차지하는 위상의 차이를 고려하면 당연하다.", "value": { "text_id": "8", "word_num": 15, "핵심동사": "당연하다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": "당연하다" } }, { "charNum": "320", "label": "사실형", "length": 45, "text": "21세기 들어서는 두 번 미국의 기준금리가 한국보다 높았거나 같았을 때가 있었다.", "value": { "text_id": "9", "word_num": 12, "핵심동사": "있었다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": " " } }, { "charNum": "367", "label": "사실형", "length": 18, "text": "바로 2001년과 2007년이다.", "value": { "text_id": "10", "word_num": 4, "핵심동사": "2007년이다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": " " } }, { "charNum": "387", "label": "사실형", "length": 29, "text": "2001년에 미국은 기준금리를 6% 이상으로 올렸다.", "value": { "text_id": "11", "word_num": 7, "핵심동사": "올렸다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": " " } }, { "charNum": "418", "label": "사실형", "length": 54, "text": "IT버블로 시중에 유동성이 과도하게 풀리면서 인플레이션율이 4%를 향해 빠르게 상승했기 때문이다.", "value": { "text_id": "12", "word_num": 12, "핵심동사": "때문이다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "474", "label": "사실형", "length": 30, "text": "2007년에도 미국은 기준금리를 5% 이상으로 올렸다.", "value": { "text_id": "13", "word_num": 7, "핵심동사": "올렸다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": " " } }, { "charNum": "506", "label": "사실형", "length": 48, "text": "부동산 버블로 시중에 유동성이 과도하게 풀리면서 인플레이션율이 4%를 넘었기 때문이다.", "value": { "text_id": "14", "word_num": 11, "핵심동사": "때문이다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "556", "label": "사실형", "length": 44, "text": "무섭게 치솟던 미국의 인플레이션율은 2008년 6%에 육박할 수준까지 높아졌다.", "value": { "text_id": "15", "word_num": 9, "핵심동사": "높아졌다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": " " } }, { "charNum": "601", "label": "사실형", "length": 31, "text": "참고로 최근 미국의 인플레이션율은 2% 대에서 움직인다.", "value": { "text_id": "16", "word_num": 7, "핵심동사": "움직인다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "633", "label": "사실형", "length": 66, "text": "2001년과 2007년에 미국 기준금리가 한국의 기준금리보다 높았는데도 한국에서 외국자본이 탈출하지 않은 이유가 있다.", "value": { "text_id": "17", "word_num": 14, "핵심동사": "있다", "확실성": "확실", "극성": "부정", "시제": "현재", "key_word": " " } }, { "charNum": "701", "label": "사실형", "length": 103, "text": "미국 내 기준금리 인상이 경기 과열을 잡기 위한 고육지책이었고, 같은 시기 한국의 기준금리 역시 미국보다는 낮았지만 계속 인상 추세였기 때문에 한미간 금리 차이로 오는 리스크가 적었다.", "value": { "text_id": "18", "word_num": 27, "핵심동사": "적었다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": " " } }, { "charNum": "806", "label": "사실형", "length": 73, "text": "또한 한국을 포함한 신흥국의 주식과 부동산시장에서 자산버블이 더 크게 일어났기 때문에 수익률에서도 미국 시장에 비해 손해가 없었다.", "value": { "text_id": "19", "word_num": 17, "핵심동사": "없었다", "확실성": "확실", "극성": "부정", "시제": "과거", "key_word": " " } } ], "dupLabelYn": "Y", "metaData": { "ID": "430224", "FILENAME": "430224.json", "MEDIA_TYPE": "블로그", "MEDIA_NAME": "티스토리 - https://hyunjung1234.tistory.com/entry/%EB%8C%80%EB%B9%84%EA%B0%80-%EC%95%84%EB%8B%88%EB%9D%BC-%EC%9C%84%EA%B8%B0-%EB%8C%80%EC%9D%91%EC%9D%98-%EC%8B%9C%EA%B0%84-%EC%B6%9C%EC%B2%98-%EC%A7%80%EC%8B%9D%EB%85%B8%EB%A7%88%EB%93%9C-%EB%84%A4%EC%9D%B4%EB%B2%84%ED%8F%AC%EC%8A%A4%ED%8A%B8?category=0", "CATEGORY": "금융", "PUBDATE": "20220828", "SENTENCE": "19" } } 