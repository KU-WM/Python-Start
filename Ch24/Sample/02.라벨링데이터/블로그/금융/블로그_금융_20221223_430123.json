{ "annotation": [ { "charNum": "1", "label": "대화형", "length": 25, "text": "56주차 비트코인 적립식투자를 완료 했습니다.", "value": { "text_id": "1", "word_num": 6, "핵심동사": "완료 했습니다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": " " } }, { "charNum": "28", "label": "대화형", "length": 27, "text": "매주 비트코인 투자 한지 어느덧 1년이 지났네요.", "value": { "text_id": "2", "word_num": 8, "핵심동사": "지났네요", "확실성": "불확실", "극성": "긍정", "시제": "과거", "key_word": " " } }, { "charNum": "57", "label": "대화형", "length": 41, "text": "아직 처음 계획한 기간에 비해 반도 오지 않은거 같아 더 분발해야겠습니다.", "value": { "text_id": "3", "word_num": 12, "핵심동사": "분발해야겠습니다", "확실성": "불확실", "극성": "미정", "시제": "미래", "key_word": " " } }, { "charNum": "100", "label": "대화형", "length": 38, "text": "이번 주는 10만원으로 비트코인 0.00325626개를 적립했습니다.", "value": { "text_id": "4", "word_num": 7, "핵심동사": "적립했습니다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": " " } }, { "charNum": "140", "label": "대화형", "length": 44, "text": "비트코인은 전 주 대비 소폭 하락하였지만, 3천만원 이상을 유지해 주고 있네요.", "value": { "text_id": "5", "word_num": 12, "핵심동사": "유지해", "확실성": "확실", "극성": "미정", "시제": "현재", "key_word": " " } }, { "charNum": "186", "label": "대화형", "length": 42, "text": "현재까지 560만원을 투자 하였고, 현 평가 손실률은 -34% 정도 입니다.", "value": { "text_id": "6", "word_num": 11, "핵심동사": "-34% 정도 입니다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "230", "label": "대화형", "length": 29, "text": "현재평가액은 약 370만원 정도를 보여주고 있습니다.", "value": { "text_id": "7", "word_num": 7, "핵심동사": "보여주고", "확실성": "확실", "극성": "미정", "시제": "현재", "key_word": " " } }, { "charNum": "261", "label": "대화형", "length": 22, "text": "가격 상관 없이 계속 모아 나가겠습니다.", "value": { "text_id": "8", "word_num": 7, "핵심동사": "모아", "확실성": "불확실", "극성": "미정", "시제": "미래", "key_word": " " } }, { "charNum": "285", "label": "대화형", "length": 54, "text": "누적금액 대비 평가금액은 아직 원금까지도 거리가 다소 있지만, 시간이 필요할 뿐이라 생각 합니다.", "value": { "text_id": "9", "word_num": 14, "핵심동사": "생각 합니다", "확실성": "불확실", "극성": "부정", "시제": "현재", "key_word": " " } }, { "charNum": "341", "label": "대화형", "length": 44, "text": "언젠가 보라색 선을 넘어 다시는 아래로 내려오지 않는 그 시기가 있을 것입니다.", "value": { "text_id": "10", "word_num": 13, "핵심동사": "있을", "확실성": "불확실", "극성": "미정", "시제": "미래", "key_word": " " } }, { "charNum": "387", "label": "대화형", "length": 33, "text": "그때까지 큰 걱정 없이 투자해 나갈 수 있다고 생각 되네요.", "value": { "text_id": "11", "word_num": 11, "핵심동사": "생각 되네요", "확실성": "불확실", "극성": "미정", "시제": "미래", "key_word": " " } } ], "dupLabelYn": "Y", "metaData": { "ID": "430123", "FILENAME": "430123.json", "MEDIA_TYPE": "블로그", "MEDIA_NAME": "네이버 - https://blog.naver.com/rusiper1000/222841674552", "CATEGORY": "금융", "PUBDATE": "20220401", "SENTENCE": "11" } } 