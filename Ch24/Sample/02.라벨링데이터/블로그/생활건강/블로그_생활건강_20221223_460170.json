{ "annotation": [ { "charNum": "1", "label": "예측형", "length": 43, "text": "야채를 먹지 않으면 필요한 영양소를 섭취하지 못하고 영양실조가 발생할 것이다.", "value": { "text_id": "1", "word_num": 10, "핵심동사": "발생할", "확실성": "불확실", "극성": "부정", "시제": "미래", "key_word": "것이다" } }, { "charNum": "44", "label": "예측형", "length": 36, "text": "대체 음식을 먹을 가능성이 높아져 체중 증가의 원인이 될 것이다.", "value": { "text_id": "2", "word_num": 10, "핵심동사": "될", "확실성": "불확실", "극성": "부정", "시제": "미래", "key_word": "원인이/것이다" } }, { "charNum": "80", "label": "예측형", "length": 14, "text": "소화문제가 발생할 것이다.", "value": { "text_id": "3", "word_num": 3, "핵심동사": "발생할", "확실성": "불확실", "극성": "부정", "시제": "미래", "key_word": "것이다" } }, { "charNum": "94", "label": "예측형", "length": 28, "text": "그래서 변비, 설사 등 소화 문제가 악화될 것이다.", "value": { "text_id": "4", "word_num": 8, "핵심동사": "악화될", "확실성": "불확실", "극성": "부정", "시제": "미래", "key_word": "것이다" } }, { "charNum": "122", "label": "예측형", "length": 54, "text": "야채에는 면역력을 향상시키는 영양소가 풍부하기 때문에 야채를 먹지 않으면 면역력이 저하될 것이다.", "value": { "text_id": "5", "word_num": 12, "핵심동사": "저하될", "확실성": "불확실", "극성": "부정", "시제": "미래", "key_word": "것이다" } }, { "charNum": "176", "label": "예측형", "length": 48, "text": "고혈압, 콜레스테롤, 혈당 수치 등이 불균형 져서 심장질환 발생 위험이 증가할 것이다.", "value": { "text_id": "6", "word_num": 12, "핵심동사": "증가할", "확실성": "불확실", "극성": "부정", "시제": "미래", "key_word": "것이다" } }, { "charNum": "224", "label": "예측형", "length": 15, "text": "치아 건강이 악화될 것이다.", "value": { "text_id": "7", "word_num": 4, "핵심동사": "악화될", "확실성": "불확실", "극성": "부정", "시제": "미래", "key_word": "것이다" } }, { "charNum": "239", "label": "예측형", "length": 36, "text": "야채에는 치아 건강에 좋은 영양소를 포함하고 있을 가능성이 높다.", "value": { "text_id": "8", "word_num": 9, "핵심동사": "높다", "확실성": "불확실", "극성": "부정", "시제": "미래", "key_word": "가능성이" } }, { "charNum": "275", "label": "예측형", "length": 23, "text": "노인성 치매가 발생할 위험이 있을 것이다.", "value": { "text_id": "9", "word_num": 6, "핵심동사": "있을", "확실성": "불확실", "극성": "부정", "시제": "미래", "key_word": "위험이/것이다" } }, { "charNum": "298", "label": "예측형", "length": 39, "text": "체내 대사량이 감소하여 에너지 소모가 즐어들고, 체력이 떨어질 것이다.", "value": { "text_id": "10", "word_num": 9, "핵심동사": "떨어질", "확실성": "불확실", "극성": "부정", "시제": "미래", "key_word": "것이다" } } ], "dupLabelYn": "Y", "metaData": { "ID": "460170", "FILENAME": "460170.json", "MEDIA_TYPE": "블로그", "MEDIA_NAME": "티스토리 - https://galaxyrailroad999.tistory.com/111", "CATEGORY": "생활건강", "PUBDATE": "20230320", "SENTENCE": "10" } } 