{ "annotation": [ { "charNum": "1", "label": "예측형", "length": 35, "text": "내가 올해 하기로 마음먹은 금연이 매우 어려울 것으로 예측된다.", "value": { "text_id": "1", "word_num": 9, "핵심동사": "예측된다", "확실성": "불확실", "극성": "부정", "시제": "미래", "key_word": "어려울/것으로" } }, { "charNum": "36", "label": "예측형", "length": 30, "text": "몸에서 바라는 니코틴에 저항하기 어렵기 때문일 것이다.", "value": { "text_id": "2", "word_num": 7, "핵심동사": "것이다", "확실성": "불확실", "극성": "부정", "시제": "미래", "key_word": "어렵기/때문일" } }, { "charNum": "66", "label": "예측형", "length": 31, "text": "금단 현상으로 인한 스트레스로 금연은 쉽지 않을 것이다.", "value": { "text_id": "3", "word_num": 8, "핵심동사": "않을", "확실성": "불확실", "극성": "부정", "시제": "미래", "key_word": "쉽지/것이다" } }, { "charNum": "97", "label": "예측형", "length": 48, "text": "금연에 실패한다면 내 자신에게뿐만 아니라 주변인들에게도 거짓말을 하는 것이 될 것이다.", "value": { "text_id": "4", "word_num": 11, "핵심동사": "될", "확실성": "불확실", "극성": "부정", "시제": "미래", "key_word": "거짓말을/하는/것이다" } }, { "charNum": "145", "label": "예측형", "length": 39, "text": "뿐만 아니라 나의 금연 결심을 믿지 않았던 사람들은 의기양양할 것이다.", "value": { "text_id": "5", "word_num": 10, "핵심동사": "의기양양할", "확실성": "불확실", "극성": "부정", "시제": "미래", "key_word": "것이다" } } ], "dupLabelYn": "Y", "metaData": { "ID": "460031", "FILENAME": "460031.json", "MEDIA_TYPE": "블로그", "MEDIA_NAME": "티스토리 - https://galaxyrailroad999.tistory.com/4", "CATEGORY": "생활건강", "PUBDATE": "20230302", "SENTENCE": "5" } } 