{ "annotation": [ { "charNum": "1", "label": "예측형", "length": 30, "text": "그는 그의 딸이 공무원 시험에 합격하기를 바랄 것이다.", "value": { "text_id": "1", "word_num": 8, "핵심동사": "바랄", "확실성": "불확실", "극성": "미정", "시제": "미래", "key_word": "것이다" } }, { "charNum": "31", "label": "예측형", "length": 39, "text": "그러나 그의 딸이 공부하는 것을 보아서는 합격 여부는 불투명할 것이다.", "value": { "text_id": "2", "word_num": 10, "핵심동사": "불투명할", "확실성": "불확실", "극성": "미정", "시제": "미래", "key_word": "것이다" } }, { "charNum": "70", "label": "예측형", "length": 32, "text": "그녀가 과연 공부를 제대로 하고 있는지는 미지수일 것이다.", "value": { "text_id": "3", "word_num": 8, "핵심동사": "미지수일", "확실성": "불확실", "극성": "미정", "시제": "미래", "key_word": "것이다" } }, { "charNum": "102", "label": "예측형", "length": 35, "text": "그녀는 단지 수험생이라는 명분을 가지려고 할 수도 있을 것이다.", "value": { "text_id": "4", "word_num": 9, "핵심동사": "있을", "확실성": "불확실", "극성": "미정", "시제": "미래", "key_word": "가지려고/할/수도/것이다" } }, { "charNum": "137", "label": "예측형", "length": 40, "text": "사실 그녀의 관심사는 요리라서 요리학원을 다니려고 할 수도 있을 것이다.", "value": { "text_id": "5", "word_num": 10, "핵심동사": "있을", "확실성": "불확실", "극성": "미정", "시제": "미래", "key_word": "다니려고/할/수도/것이다" } }, { "charNum": "177", "label": "예측형", "length": 49, "text": "무엇이 되든 그녀는 곧 자신이 직업을 가져야 한다는 생각에 부담을 느낄 수 있을 것이다.", "value": { "text_id": "6", "word_num": 14, "핵심동사": "있을", "확실성": "불확실", "극성": "미정", "시제": "미래", "key_word": "느낄/수/것이다" } } ], "dupLabelYn": "Y", "metaData": { "ID": "460179", "FILENAME": "460179.json", "MEDIA_TYPE": "블로그", "MEDIA_NAME": "티스토리 - https://galaxyrailroad999.tistory.com/120", "CATEGORY": "생활건강", "PUBDATE": "20230320", "SENTENCE": "6" } } 