{ "annotation": [ { "charNum": "1", "label": "추론형", "length": 35, "text": "나는 밥을 먹지 않아서 배가 고프지만 간식은 먹지 않을 것이다.", "value": { "text_id": "1", "word_num": 10, "핵심동사": "않을", "확실성": "불확실", "극성": "부정", "시제": "미래", "key_word": "먹지/것이다" } }, { "charNum": "36", "label": "예측형", "length": 34, "text": "밥보다 간식이 살이 더 찌고 건강에 좋지 않을 가능성이 높다.", "value": { "text_id": "2", "word_num": 10, "핵심동사": "높다", "확실성": "불확실", "극성": "부정", "시제": "미래", "key_word": "가능성이" } }, { "charNum": "70", "label": "예측형", "length": 36, "text": "간식을 먹지 않고 다음 식사 시간까지 버티기는 쉽지 않을 것이다.", "value": { "text_id": "3", "word_num": 10, "핵심동사": "않을", "확실성": "불확실", "극성": "부정", "시제": "미래", "key_word": "쉽지/것이다" } }, { "charNum": "106", "label": "예측형", "length": 38, "text": "하지만 간식을 먹으면 다음 식사 시간에 또 밥을 먹기 어려울 것이다.", "value": { "text_id": "4", "word_num": 11, "핵심동사": "어려울", "확실성": "불확실", "극성": "부정", "시제": "미래", "key_word": "것이다" } }, { "charNum": "144", "label": "예측형", "length": 42, "text": "그렇게 밥은 잘 먹지 않고 간식을 먹다보면 살이 찌고 건강이 나빠질 것이다.", "value": { "text_id": "5", "word_num": 12, "핵심동사": "나빠질", "확실성": "불확실", "극성": "부정", "시제": "미래", "key_word": "것이다" } }, { "charNum": "186", "label": "추론형", "length": 32, "text": "그래서 나는 다음 식사 시간까지 간식을 먹지 않을 것이다.", "value": { "text_id": "6", "word_num": 9, "핵심동사": "않을", "확실성": "불확실", "극성": "부정", "시제": "미래", "key_word": "먹지/것이다" } } ], "dupLabelYn": "Y", "metaData": { "ID": "460107", "FILENAME": "460107.json", "MEDIA_TYPE": "블로그", "MEDIA_NAME": "티스토리 - https://galaxyrailroad999.tistory.com/78", "CATEGORY": "생활건강", "PUBDATE": "20230318", "SENTENCE": "6" } } 