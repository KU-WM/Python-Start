{ "annotation": [ { "charNum": "1", "label": "예측형", "length": 43, "text": "성화는 좋아하는 사람 앞에서 늘 서툴기 때문에 이번에도 고백에 실패할 것이다.", "value": { "text_id": "1", "word_num": 11, "핵심동사": "실패할", "확실성": "불확실", "극성": "부정", "시제": "미래", "key_word": "것이다" } }, { "charNum": "44", "label": "예측형", "length": 25, "text": "고백이 실패하면 성화의 사랑도 줄어들 것이다.", "value": { "text_id": "2", "word_num": 6, "핵심동사": "줄어들", "확실성": "불확실", "극성": "부정", "시제": "미래", "key_word": "것이다" } }, { "charNum": "69", "label": "예측형", "length": 40, "text": "성화는 그게 더 싫어서 좋아하는 상대방에게 속마음과 다르게 말할 것이다.", "value": { "text_id": "3", "word_num": 10, "핵심동사": "말할", "확실성": "불확실", "극성": "부정", "시제": "미래", "key_word": "다르게/것이다" } }, { "charNum": "109", "label": "예측형", "length": 32, "text": "이제 더는 너를 좋아하지 않는다는 거짓말을 계속할 것이다.", "value": { "text_id": "4", "word_num": 8, "핵심동사": "할", "확실성": "불확실", "극성": "부정", "시제": "미래", "key_word": "계속/것이다" } }, { "charNum": "141", "label": "예측형", "length": 30, "text": "당황한 상대방도 성화에게 안 좋은 감정이 생길 것이다.", "value": { "text_id": "5", "word_num": 8, "핵심동사": "생길", "확실성": "불확실", "극성": "부정", "시제": "미래", "key_word": "것이다" } }, { "charNum": "171", "label": "예측형", "length": 29, "text": "그래서 성화의 사랑 고백은 계속 악순환이 될 것이다.", "value": { "text_id": "6", "word_num": 8, "핵심동사": "될", "확실성": "불확실", "극성": "부정", "시제": "미래", "key_word": "악순환이/것이다" } } ], "dupLabelYn": "Y", "metaData": { "ID": "460063", "FILENAME": "460063.json", "MEDIA_TYPE": "블로그", "MEDIA_NAME": "티스토리 - https://gratuitous.tistory.com/63", "CATEGORY": "생활건강", "PUBDATE": "20230317", "SENTENCE": "6" } } 