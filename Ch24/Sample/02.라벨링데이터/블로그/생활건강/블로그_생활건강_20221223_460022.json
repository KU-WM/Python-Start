{ "annotation": [ { "charNum": "1", "label": "예측형", "length": 35, "text": "나는 친구들과 여행을 가기로 한 약속은 실패일 수 있을 것이다.", "value": { "text_id": "1", "word_num": 10, "핵심동사": "실패일", "확실성": "불확실", "극성": "미정", "시제": "미래", "key_word": "있을/것이다" } }, { "charNum": "36", "label": "예측형", "length": 33, "text": "남자친구의 허락 없이는 여행을 갈 수 없을 것이기 때문이다.", "value": { "text_id": "2", "word_num": 9, "핵심동사": "갈", "확실성": "불확실", "극성": "부정", "시제": "미래", "key_word": "여행을/때문이다" } }, { "charNum": "69", "label": "예측형", "length": 32, "text": "그래서 나는 남자친구한테 거짓말을 하고 갔다 올 계획이다.", "value": { "text_id": "3", "word_num": 8, "핵심동사": "계획이다", "확실성": "불확실", "극성": "부정", "시제": "미래", "key_word": "하고/갔다/올" } }, { "charNum": "101", "label": "예측형", "length": 25, "text": "하지만 나의 계획이 충분하지 않을지도 모른다.", "value": { "text_id": "4", "word_num": 6, "핵심동사": "모른다", "확실성": "불확실", "극성": "미정", "시제": "미래", "key_word": "충분하지/않았을지도" } }, { "charNum": "126", "label": "예측형", "length": 31, "text": "어쩌면 나는 남자친구한테 거짓말한 것이 들킬지도 모른다.", "value": { "text_id": "5", "word_num": 7, "핵심동사": "모른다", "확실성": "불확실", "극성": "미정", "시제": "미래", "key_word": "들킬지도" } }, { "charNum": "157", "label": "예측형", "length": 25, "text": "결국 친구들과의 약속은 실패로 돌아갈 것이다.", "value": { "text_id": "6", "word_num": 6, "핵심동사": "돌아갈", "확실성": "불확실", "극성": "부정", "시제": "미래", "key_word": "것이다" } } ], "dupLabelYn": "Y", "metaData": { "ID": "460022", "FILENAME": "460022.json", "MEDIA_TYPE": "블로그", "MEDIA_NAME": "네이버 - https://blog.naver.com/hisdata123/223026367053", "CATEGORY": "생활건강", "PUBDATE": "20230224", "SENTENCE": "6" } } 