{ "annotation": [ { "charNum": "1", "label": "예측형", "length": 42, "text": "책상에 먼지가 많으면 호흡기나 눈, 코, 입 주변에 가려움증이 생길 것이다.", "value": { "text_id": "1", "word_num": 11, "핵심동사": "생길", "확실성": "불확실", "극성": "부정", "시제": "미래", "key_word": "것이다" } }, { "charNum": "43", "label": "예측형", "length": 21, "text": "또한 콧물, 재채기를 하게 될 것이다.", "value": { "text_id": "2", "word_num": 6, "핵심동사": "될", "확실성": "불확실", "극성": "부정", "시제": "미래", "key_word": "하게/것이다" } }, { "charNum": "64", "label": "예측형", "length": 20, "text": "이는 알러지 증상으로 연결될 것이다.", "value": { "text_id": "3", "word_num": 5, "핵심동사": "연결될", "확실성": "불확실", "극성": "부정", "시제": "미래", "key_word": "것이다" } }, { "charNum": "84", "label": "예측형", "length": 30, "text": "책상이 먼지로 가득하면 공부에 집중하기 어려울 것이다.", "value": { "text_id": "4", "word_num": 7, "핵심동사": "어려울", "확실성": "불확실", "극성": "부정", "시제": "미래", "key_word": "것이다" } }, { "charNum": "114", "label": "예측형", "length": 22, "text": "이렇게 되면 성과가 나기 어려울 것이다.", "value": { "text_id": "5", "word_num": 6, "핵심동사": "어려울", "확실성": "불확실", "극성": "부정", "시제": "미래", "key_word": "것이다" } }, { "charNum": "136", "label": "예측형", "length": 32, "text": "책상 위의 먼지는 세균, 곰팡이로 번식할 수 있을 것이다.", "value": { "text_id": "6", "word_num": 9, "핵심동사": "있을", "확실성": "불확실", "극성": "부정", "시제": "미래", "key_word": "번식할/수/것이다" } }, { "charNum": "168", "label": "예측형", "length": 22, "text": "이는 건강 문제를 일으킬 가능성이 높다.", "value": { "text_id": "7", "word_num": 6, "핵심동사": "높다", "확실성": "불확실", "극성": "부정", "시제": "미래", "key_word": "가능성이" } }, { "charNum": "190", "label": "예측형", "length": 54, "text": "보통 흰색 또는 밝은색의 먼지라서 잘 안 보여서 호흡할 때 몸 안으로 들어갈 확률이 높을 것이다.", "value": { "text_id": "8", "word_num": 16, "핵심동사": "높을", "확실성": "불확실", "극성": "부정", "시제": "미래", "key_word": "것이다" } }, { "charNum": "244", "label": "예측형", "length": 37, "text": "컴퓨터나 프린터 등의 기계에 먼지가 쌓이면 오작동을 일으킬 것이다.", "value": { "text_id": "9", "word_num": 9, "핵심동사": "일으킬", "확실성": "불확실", "극성": "부정", "시제": "미래", "key_word": "오작동을/것이다" } }, { "charNum": "281", "label": "예측형", "length": 36, "text": "전기 제품이나 담배 등에 의해 화재 발생이 생길 수 있을 것이다.", "value": { "text_id": "10", "word_num": 11, "핵심동사": "있을", "확실성": "불확실", "극성": "부정", "시제": "미래", "key_word": "생길/수/것이다" } }, { "charNum": "317", "label": "예측형", "length": 29, "text": "먼지가 눈으로 들어가 결막염이 생길 수 있을 것이다.", "value": { "text_id": "11", "word_num": 8, "핵심동사": "있을", "확실성": "불확실", "극성": "부정", "시제": "미래", "key_word": "생길/수/것이다" } }, { "charNum": "346", "label": "예측형", "length": 22, "text": "또한 시력이 저하될 위험도 있을 것이다.", "value": { "text_id": "12", "word_num": 6, "핵심동사": "있을", "확실성": "불확실", "극성": "부정", "시제": "미래", "key_word": "위험도/것이다" } }, { "charNum": "368", "label": "예측형", "length": 29, "text": "천식이 있는 사람들에게는 천식 증상이 악화될 것이다.", "value": { "text_id": "13", "word_num": 7, "핵심동사": "악화될", "확실성": "불확실", "극성": "부정", "시제": "미래", "key_word": "것이다" } }, { "charNum": "397", "label": "예측형", "length": 40, "text": "여러 제품들로 인한 먼지는 화학물질이나 독성물질이 포함될 가능성이 있다.", "value": { "text_id": "14", "word_num": 9, "핵심동사": "있다", "확실성": "불확실", "극성": "부정", "시제": "미래", "key_word": "가능성이" } }, { "charNum": "437", "label": "예측형", "length": 25, "text": "이것은 치명적인 건강의 손상을 가져올 것이다.", "value": { "text_id": "15", "word_num": 6, "핵심동사": "가져올", "확실성": "불확실", "극성": "부정", "시제": "미래", "key_word": "것이다" } }, { "charNum": "462", "label": "추론형", "length": 32, "text": "따라서 규칙적인 청소와 청결을 유지하도록 해야 할 것이다.", "value": { "text_id": "16", "word_num": 8, "핵심동사": "할", "확실성": "불확실", "극성": "부정", "시제": "미래", "key_word": "유지하도록/해야/것이다" } } ], "dupLabelYn": "Y", "metaData": { "ID": "460173", "FILENAME": "460173.json", "MEDIA_TYPE": "블로그", "MEDIA_NAME": "티스토리 - https://galaxyrailroad999.tistory.com/114", "CATEGORY": "생활건강", "PUBDATE": "20230320", "SENTENCE": "16" } } 