{ "annotation": [ { "charNum": "1", "label": "예측형", "length": 27, "text": "당신이 제명에 죽을 수 있을지는 불투명할 것이다.", "value": { "text_id": "1", "word_num": 7, "핵심동사": "불투명할", "확실성": "불확실", "극성": "미정", "시제": "미래", "key_word": "것이다" } }, { "charNum": "28", "label": "예측형", "length": 35, "text": "당신이 지은 죄로 당신을 저주할 사람들이 많을 수 있을 것이다.", "value": { "text_id": "2", "word_num": 10, "핵심동사": "있을", "확실성": "불확실", "극성": "미정", "시제": "미래", "key_word": "많을/수/것이다" } }, { "charNum": "63", "label": "예측형", "length": 26, "text": "밤길을 가다 무슨 일을 당할 수도 있을 것이다.", "value": { "text_id": "3", "word_num": 8, "핵심동사": "있을", "확실성": "불확실", "극성": "미정", "시제": "미래", "key_word": "당할/수도/것이다" } }, { "charNum": "89", "label": "예측형", "length": 40, "text": "꼭 다른 사람의 복수가 아니더라도 운명이 당신을 벌할 수도 있을 것이다.", "value": { "text_id": "4", "word_num": 11, "핵심동사": "있을", "확실성": "불확실", "극성": "미정", "시제": "미래", "key_word": "벌할/수도/것이다" } }, { "charNum": "129", "label": "예측형", "length": 36, "text": "사법기관이 벌하지 못했다고 당신의 죄가 없어질 것은 아닐 것이다.", "value": { "text_id": "5", "word_num": 9, "핵심동사": "아닐", "확실성": "불확실", "극성": "미정", "시제": "미래", "key_word": "없어질/것은/것이다" } }, { "charNum": "165", "label": "예측형", "length": 33, "text": "많은 사람들이 당신이 불행해지는 모습을 보기를 바랄 것이다.", "value": { "text_id": "6", "word_num": 8, "핵심동사": "바랄", "확실성": "불확실", "극성": "미정", "시제": "미래", "key_word": "것이다" } } ], "dupLabelYn": "Y", "metaData": { "ID": "460190", "FILENAME": "460190.json", "MEDIA_TYPE": "블로그", "MEDIA_NAME": "네이버 - https://blog.naver.com/hisdata123/223050928312", "CATEGORY": "생활건강", "PUBDATE": "20230321", "SENTENCE": "6" } } 