{ "annotation": [ { "charNum": "1", "label": "예측형", "length": 38, "text": "속내를 털어놓을 수 있는 친구가 진짜 친구라고 말할 수 있을 것이다.", "value": { "text_id": "1", "word_num": 11, "핵심동사": "있을", "확실성": "불확실", "극성": "긍정", "시제": "미래", "key_word": "말할/수/것이다" } }, { "charNum": "39", "label": "예측형", "length": 34, "text": "친한 친구라면 내가 잘못했더라도 나를 험담하지는 않을 것이다.", "value": { "text_id": "2", "word_num": 8, "핵심동사": "않을", "확실성": "불확실", "극성": "미정", "시제": "미래", "key_word": "험담하지는/것이다" } }, { "charNum": "73", "label": "예측형", "length": 39, "text": "또한 나를 위로해주고 도와주고 진심 어린 충고를 해줄 것으로 생각한다.", "value": { "text_id": "3", "word_num": 10, "핵심동사": "생각한다", "확실성": "불확실", "극성": "미정", "시제": "미래", "key_word": "해줄/것으로" } }, { "charNum": "112", "label": "예측형", "length": 42, "text": "물론 나도 친구가 잘돼야 힘이 날 수도 있기에 친구가 잘되기를 바랄 것이다.", "value": { "text_id": "4", "word_num": 12, "핵심동사": "바랄", "확실성": "불확실", "극성": "미정", "시제": "미래", "key_word": "것이다" } }, { "charNum": "154", "label": "예측형", "length": 28, "text": "어쩌면 가족보다 소중한 친구가 생길 가능성도 있다.", "value": { "text_id": "5", "word_num": 7, "핵심동사": "있다", "확실성": "불확실", "극성": "미정", "시제": "미래", "key_word": "가능성도" } }, { "charNum": "182", "label": "예측형", "length": 36, "text": "사람들은 서로에게 없어서는 안 되는 친구가 생기기를 바랄 것이다.", "value": { "text_id": "6", "word_num": 9, "핵심동사": "바랄", "확실성": "불확실", "극성": "미정", "시제": "미래", "key_word": "것이다" } } ], "dupLabelYn": "Y", "metaData": { "ID": "460039", "FILENAME": "460039.json", "MEDIA_TYPE": "블로그", "MEDIA_NAME": "티스토리 - https://gratuitous.tistory.com/32", "CATEGORY": "생활건강", "PUBDATE": "20230306", "SENTENCE": "6" } } 