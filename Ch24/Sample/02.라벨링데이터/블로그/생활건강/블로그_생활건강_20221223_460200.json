{ "annotation": [ { "charNum": "1", "label": "예측형", "length": 27, "text": "그의 눈이 완전히 회복될지는 알 수 없을 것이다.", "value": { "text_id": "1", "word_num": 8, "핵심동사": "없을", "확실성": "불확실", "극성": "미정", "시제": "미래", "key_word": "알/수/것이다" } }, { "charNum": "28", "label": "예측형", "length": 49, "text": "질환이 비교적 일찍 발견이 되었지만 약이 잘 듣지 않고 있어 계속 진행될 가능성이 있다.", "value": { "text_id": "2", "word_num": 14, "핵심동사": "있다", "확실성": "불확실", "극성": "미정", "시제": "미래", "key_word": "가능성이" } }, { "charNum": "77", "label": "예측형", "length": 30, "text": "그와 그의 가족들의 근심은 점점 깊어가고 있을 것이다.", "value": { "text_id": "3", "word_num": 8, "핵심동사": "있을", "확실성": "불확실", "극성": "미정", "시제": "미래", "key_word": "깊어가고/것이다" } }, { "charNum": "107", "label": "예측형", "length": 31, "text": "의사 역시 여러 가지 다른 방법을 찾아보고 있을 것이다.", "value": { "text_id": "4", "word_num": 9, "핵심동사": "있을", "확실성": "불확실", "극성": "미정", "시제": "미래", "key_word": "찾아보고/것이다" } }, { "charNum": "138", "label": "예측형", "length": 35, "text": "그의 눈이 회복되지 않는다면 결국 점차 실명으로 진행될 것이다.", "value": { "text_id": "5", "word_num": 9, "핵심동사": "진행될", "확실성": "불확실", "극성": "미정", "시제": "미래", "key_word": "것이다" } }, { "charNum": "173", "label": "예측형", "length": 28, "text": "그는 간절히 눈이 회복되기만을 바라고 있을 것이다.", "value": { "text_id": "6", "word_num": 7, "핵심동사": "있을", "확실성": "불확실", "극성": "미정", "시제": "미래", "key_word": "바라고/것이다" } } ], "dupLabelYn": "Y", "metaData": { "ID": "460200", "FILENAME": "460200.json", "MEDIA_TYPE": "블로그", "MEDIA_NAME": "네이버 - https://blog.naver.com/hisdata123/223050933949", "CATEGORY": "생활건강", "PUBDATE": "20230321", "SENTENCE": "6" } } 