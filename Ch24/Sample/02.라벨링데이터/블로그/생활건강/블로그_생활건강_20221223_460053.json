{ "annotation": [ { "charNum": "1", "label": "예측형", "length": 17, "text": "그의 프로포즈는 실패할 것이다.", "value": { "text_id": "1", "word_num": 4, "핵심동사": "실패할", "확실성": "불확실", "극성": "부정", "시제": "미래", "key_word": "것이다" } }, { "charNum": "18", "label": "예측형", "length": 41, "text": "사람이 많은 공개된 장소에서 하는 프로포즈는 거절하기 매우 어려울 것이다.", "value": { "text_id": "2", "word_num": 10, "핵심동사": "어려울", "확실성": "불확실", "극성": "부정", "시제": "미래", "key_word": "매우/것이다" } }, { "charNum": "59", "label": "예측형", "length": 50, "text": "어떤 여자라도 그런 반강제성을 가진 프로포즈에 부담감을 가지지 않기는 매우 어려울 것이다.", "value": { "text_id": "3", "word_num": 12, "핵심동사": "어려울", "확실성": "불확실", "극성": "부정", "시제": "미래", "key_word": "매우/것이다" } }, { "charNum": "109", "label": "예측형", "length": 30, "text": "그녀는 당장은 프로포즈를 받아들겠다고 거짓말할 것이다.", "value": { "text_id": "4", "word_num": 6, "핵심동사": "거짓말할", "확실성": "불확실", "극성": "부정", "시제": "미래", "key_word": "것이다" } }, { "charNum": "139", "label": "예측형", "length": 44, "text": "하지만 사람들의 박수와 눈길이 부담스러울 뿐, 감동을 주는 데는 실패할 것이다.", "value": { "text_id": "5", "word_num": 11, "핵심동사": "실패할", "확실성": "불확실", "극성": "부정", "시제": "미래", "key_word": "것이다" } }, { "charNum": "183", "label": "예측형", "length": 54, "text": "결국 그녀는 그를 떠날 것이고, 그는 주변에 그녀가 변심한 것이라고 의도치 않게 거짓말할 것이다.", "value": { "text_id": "6", "word_num": 14, "핵심동사": "거짓말할", "확실성": "불확실", "극성": "부정", "시제": "미래", "key_word": "것이다" } }, { "charNum": "237", "label": "예측형", "length": 49, "text": "그가 그 사실을 모르는 한 다른 여자를 만나도 프로포즈에 성공하기는 매우 어려울 것이다.", "value": { "text_id": "7", "word_num": 13, "핵심동사": "어려울", "확실성": "불확실", "극성": "부정", "시제": "미래", "key_word": "매우/것이다" } }, { "charNum": "286", "label": "예측형", "length": 34, "text": "그가 올가을에 결혼할 계획이라고 한 것은 헛소문이 될 것이다.", "value": { "text_id": "8", "word_num": 9, "핵심동사": "될", "확실성": "불확실", "극성": "부정", "시제": "미래", "key_word": "헛소문이/것이다" } } ], "dupLabelYn": "Y", "metaData": { "ID": "460053", "FILENAME": "460053.json", "MEDIA_TYPE": "블로그", "MEDIA_NAME": "티스토리 - https://gratuitous.tistory.com/51", "CATEGORY": "생활건강", "PUBDATE": "20230316", "SENTENCE": "8" } } 