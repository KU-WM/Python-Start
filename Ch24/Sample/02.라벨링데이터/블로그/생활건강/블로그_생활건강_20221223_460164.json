{ "annotation": [ { "charNum": "1", "label": "예측형", "length": 39, "text": "겨울에 핫팩을 사용할 때 여러 문제를 잘 확인하고 사용해야 할 것이다.", "value": { "text_id": "1", "word_num": 11, "핵심동사": "할", "확실성": "불확실", "극성": "부정", "시제": "미래", "key_word": "사용해야/것이다" } }, { "charNum": "40", "label": "예측형", "length": 26, "text": "핫팩이 직접 피부에 닿지 않게 해야 할 것이다.", "value": { "text_id": "2", "word_num": 8, "핵심동사": "할", "확실성": "불확실", "극성": "부정", "시제": "미래", "key_word": "해야/것이다" } }, { "charNum": "66", "label": "예측형", "length": 24, "text": "왜냐하면 화상에 위험이 있을 가능성이 있다.", "value": { "text_id": "3", "word_num": 6, "핵심동사": "있다", "확실성": "불확실", "극성": "부정", "시제": "미래", "key_word": "가능성이" } }, { "charNum": "90", "label": "예측형", "length": 36, "text": "핫팩 내부에 사용되는 화학 물질이 유해할 수 있을 가능성이 있다.", "value": { "text_id": "4", "word_num": 10, "핵심동사": "있다", "확실성": "불확실", "극성": "부정", "시제": "미래", "key_word": "가능성이" } }, { "charNum": "126", "label": "예측형", "length": 16, "text": "알러지가 생길 가능성이 있다.", "value": { "text_id": "5", "word_num": 4, "핵심동사": "있다", "확실성": "불확실", "극성": "부정", "시제": "미래", "key_word": "가능성이" } }, { "charNum": "142", "label": "예측형", "length": 23, "text": "한번 사용하면 재사용하기가 어려울 것이다.", "value": { "text_id": "6", "word_num": 5, "핵심동사": "어려울", "확실성": "불확실", "극성": "부정", "시제": "미래", "key_word": "것이다" } }, { "charNum": "165", "label": "예측형", "length": 19, "text": "폐기물 처리 문제가 발생할 것이다.", "value": { "text_id": "7", "word_num": 5, "핵심동사": "발생할", "확실성": "불확실", "극성": "부정", "시제": "미래", "key_word": "것이다" } }, { "charNum": "184", "label": "예측형", "length": 18, "text": "환경 오염 문제가 발생할 것이다.", "value": { "text_id": "8", "word_num": 5, "핵심동사": "발생할", "확실성": "불확실", "극성": "부정", "시제": "미래", "key_word": "것이다" } }, { "charNum": "202", "label": "예측형", "length": 22, "text": "전자파 유발 물체가 생길 가능성이 있다.", "value": { "text_id": "9", "word_num": 6, "핵심동사": "있다", "확실성": "불확실", "극성": "부정", "시제": "미래", "key_word": "가능성이" } }, { "charNum": "224", "label": "추론형", "length": 50, "text": "따라서 내부 물질을 잘 확인하고 사용방법을 잘 알고 안전에 유의하면서 사용해야 할 것이다.", "value": { "text_id": "10"