{ "annotation": [ { "charNum": "1", "label": "예측형", "length": 22, "text": "새해 목표는 항상 실패할 가능성이 높다.", "value": { "text_id": "1", "word_num": 6, "핵심동사": "높다", "확실성": "불확실", "극성": "부정", "시제": "미래", "key_word": "가능성이" } }, { "charNum": "23", "label": "추론형", "length": 37, "text": "하지만 나는 올해에도 한 해를 실패하지 않도록 계획을 세울 것이다.", "value": { "text_id": "2", "word_num": 10, "핵심동사": "세울", "확실성": "확실", "극성": "부정", "시제": "미래", "key_word": "계획을/것이다" } }, { "charNum": "60", "label": "예측형", "length": 47, "text": "계획을 지키지 않는 것은 내가 나 자신에게 거짓말을 하는 것으로 볼 수 있을 것이다.", "value": { "text_id": "3", "word_num": 14, "핵심동사": "있을", "확실성": "불확실", "극성": "부정", "시제": "미래", "key_word": "볼/수/것이다" } }, { "charNum": "107", "label": "예측형", "length": 34, "text": "올해는 내가 나에게 부끄럽지 않도록 계획을 꼭 실천할 것이다.", "value": { "text_id": "4", "word_num": 9, "핵심동사": "실천할", "확실성": "불확실", "극성": "부정", "시제": "미래", "key_word": "것이다" } }, { "charNum": "141", "label": "예측형", "length": 24, "text": "첫 번째 계획은 거짓말을 하지 않는 것이다.", "value": { "text_id": "5", "word_num": 7, "핵심동사": "않는", "확실성": "불확실", "극성": "부정", "시제": "미래", "key_word": "하지/것이다" } }, { "charNum": "165", "label": "예측형", "length": 40, "text": "거짓말을 하면 그 거짓말을 막기 위해 더 큰 거짓말을 할 가능성이 높다.", "value": { "text_id": "6", "word_num": 12, "핵심동사": "높다", "확실성": "불확실", "극성": "부정", "시제": "미래", "key_word": "가능성이" } }, { "charNum": "205", "label": "추론형", "length": 30, "text": "두 번째 계획은 실패를 하더라도 다시 도전하는 것이다.", "value": { "text_id": "7", "word_num": 8, "핵심동사": "도전하는", "확실성": "확실", "극성": "긍정", "시제": "미래", "key_word": "것이다" } } ], "dupLabelYn": "Y", "metaData": { "ID": "460118", "FILENAME": "460118.json", "MEDIA_TYPE": "블로그", "MEDIA_NAME": "티스토리 - https://galaxyrailroad999.tistory.com/89", "CATEGORY": "생활건강", "PUBDATE": "20230318", "SENTENCE": "7" } } 