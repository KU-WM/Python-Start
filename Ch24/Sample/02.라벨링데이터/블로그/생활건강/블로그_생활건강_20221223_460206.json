{ "annotation": [ { "charNum": "1", "label": "예측형", "length": 20, "text": "그는 대머리가 될 수도 있을 것이다.", "value": { "text_id": "1", "word_num": 6, "핵심동사": "있을", "확실성": "불확실", "극성": "미정", "시제": "미래", "key_word": "될/수도/것이다" } }, { "charNum": "21", "label": "예측형", "length": 37, "text": "그의 할아버지가 대머리이기 때문에 그것이 유전될 수도 있을 것이다.", "value": { "text_id": "2", "word_num": 9, "핵심동사": "있을", "확실성": "불확실", "극성": "미정", "시제": "미래", "key_word": "유전될/수도/것이다" } }, { "charNum": "58", "label": "예측형", "length": 52, "text": "그러나 그의 아버지는 아직도 머리가 풍성하기 때문에 대머리가 되지 않을 가능성도 있을 것이다.", "value": { "text_id": "3", "word_num": 13, "핵심동사": "있을", "확실성": "불확실", "극성": "미정", "시제": "미래", "key_word": "가능성도/것이다" } }, { "charNum": "110", "label": "예측형", "length": 33, "text": "그는 제발 아버지를 닮아 대머리가 되지 않기를 바랄 것이다.", "value": { "text_id": "4", "word_num": 9, "핵심동사": "바랄", "확실성": "불확실", "극성": "미정", "시제": "미래", "key_word": "되지/않기를/것이다" } }, { "charNum": "143", "label": "예측형", "length": 43, "text": "그는 아직 애인이 없는데 탈모가 시작되면 연애하기 힘들어질 수도 있을 것이다.", "value": { "text_id": "5", "word_num": 11, "핵심동사": "있을", "확실성": "불확실", "극성": "미정", "시제": "미래", "key_word": "힘들어질/수도/것이다" } }, { "charNum": "186", "label": "예측형", "length": 37, "text": "그가 탈모가 시작되기 전 애인을 만들 수 있을지는 미지수일 것이다.", "value": { "text_id": "6", "word_num": 10, "핵심동사": "미지수일", "확실성": "불확실", "극성": "미정", "시제": "미래", "key_word": "것이다" } } ], "dupLabelYn": "Y", "metaData": { "ID": "460206", "FILENAME": "460206.json", "MEDIA_TYPE": "블로그", "MEDIA_NAME": "네이버 - https://blog.naver.com/hisdata123/223050935199", "CATEGORY": "생활건강", "PUBDATE": "20230321", "SENTENCE": "6" } } 