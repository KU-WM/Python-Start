{ "annotation": [ { "charNum": "1", "label": "추론형", "length": 36, "text": "분노 조절을 하기 어려우면 인간관계에 손상이 생길 가능성이 있다.", "value": { "text_id": "1", "word_num": 9, "핵심동사": "있다", "확실성": "불확실", "극성": "미정", "시제": "미래", "key_word": "가능성이" } }, { "charNum": "37", "label": "예측형", "length": 23, "text": "정신 건강 문제가 발생할 수 있을 것이다.", "value": { "text_id": "2", "word_num": 7, "핵심동사": "있을", "확실성": "불확실", "극성": "미정", "시제": "미래", "key_word": "발생할/수/것이다" } }, { "charNum": "60", "label": "예측형", "length": 33, "text": "물리적인 위력을 행사하여 법적 문제가 발생할 것이 예측된다.", "value": { "text_id": "3", "word_num": 8, "핵심동사": "예측된다", "확실성": "불확실", "극성": "미정", "시제": "미래", "key_word": "발생할/것이" } }, { "charNum": "93", "label": "예측형", "length": 20, "text": "업무 수행에도 어려움이 생길 것이다.", "value": { "text_id": "4", "word_num": 5, "핵심동사": "생길", "확실성": "불확실", "극성": "부정", "시제": "미래", "key_word": "것이다" } }, { "charNum": "113", "label": "예측형", "length": 45, "text": "스트레스와 불안이 증가하여 업무 능력이나 학습 능력에 악영향을 줄 가능성이 높다.", "value": { "text_id": "5", "word_num": 11, "핵심동사": "높다", "확실성": "불확실", "극성": "미정", "시제": "미래", "key_word": "가능성이" } }, { "charNum": "158", "label": "예측형", "length": 30, "text": "가족이나 친구들과의 관계에 영향을 미칠 가능성이 있다.", "value": { "text_id": "6", "word_num": 7, "핵심동사": "있다", "확실성": "불확실", "극성": "미정", "시제": "미래", "key_word": "가능성이" } }, { "charNum": "188", "label": "예측형", "length": 22, "text": "불필요한 경쟁이나 갈등이 발생할 것이다.", "value": { "text_id": "7", "word_num": 5, "핵심동사": "발생할", "확실성": "불확실", "극성": "긍정", "시제": "미래", "key_word": "것이다" } }, { "charNum": "210", "label": "예측형", "length": 29, "text": "자신에 대한 스스로 평가가 하락할 수도 있을 것이다.", "value": { "text_id": "8", "word_num": 8, "핵심동사": "있을", "확실성": "불확실", "극성": "긍정", "시제": "미래", "key_word": "하락할/수도/것이다" } }, { "charNum": "239", "label": "예측형", "length": 20, "text": "타인의 신뢰를 상실할 가능성이 있다.", "value": { "text_id": "9", "word_num": 5, "핵심동사": "있다", "확실성": "불확실", "극성": "긍정", "시제": "미래", "key_word": "가능성이" } }, { "charNum": "259", "label": "추론형", "length": 54, "text": "따라서 분노할 때 자신의 감정을 인식하고 안정을 할 수 있는 자기 조절 능력을 키워야 할 것이다.", "value": { "text_id": "10", "word_num": 16, "핵심동사": "할", "확실성": "불확실", "극성": "긍정", "시제": "미래", "key_word": "키워야/것이다" } } ], "dupLabelYn": "Y", "metaData": { "ID": "420501", "FILENAME": "420501.json", "MEDIA_TYPE": "블로그", "MEDIA_NAME": "네이버 - https://blog.naver.com/hisdata123/223049541855", "CATEGORY": "사회", "PUBDATE": "20230320", "SENTENCE": "10" } } 