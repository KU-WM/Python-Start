{ "annotation": [ { "charNum": "1", "label": "예측형", "length": 28, "text": "나는 이번 주말에 산에 가지 않을 수 없을 것이다.", "value": { "text_id": "1", "word_num": 9, "핵심동사": "없을", "확실성": "불확실", "극성": "부정", "시제": "미래", "key_word": "가지/않을/수/것이다" } }, { "charNum": "29", "label": "예측형", "length": 40, "text": "나는 산을 싫어하지만, 회사에서 가는 등산 모임에 빠질 수 없을 것이다.", "value": { "text_id": "2", "word_num": 11, "핵심동사": "없을", "확실성": "불확실", "극성": "부정", "시제": "미래", "key_word": "빠질/수/것이다" } }, { "charNum": "69", "label": "예측형", "length": 40, "text": "특히 이번 등산 모임에는 회장님이 오셔서 더욱 더 빠질 수 없을 것이다.", "value": { "text_id": "3", "word_num": 12, "핵심동사": "없을", "확실성": "불확실", "극성": "부정", "시제": "미래", "key_word": "빠질/수/것이다" } }, { "charNum": "109", "label": "예측형", "length": 26, "text": "다른 직원들도 등산 모임에 빠지지 않을 것이다.", "value": { "text_id": "4", "word_num": 7, "핵심동사": "않을", "확실성": "불확실", "극성": "부정", "시제": "미래", "key_word": "빠지지/것이다" } }, { "charNum": "135", "label": "예측형", "length": 37, "text": "나는 주말에 다른 약속이 있었지만, 그 약속은 갈 수 없을 것이다.", "value": { "text_id": "5", "word_num": 11, "핵심동사": "없을", "확실성": "불확실", "극성": "부정", "시제": "미래", "key_word": "갈/수/것이다" } }, { "charNum": "172", "label": "추론형", "length": 52, "text": "꼭 가야 하는 약속이었지만 이번 주말에 산에 가는 것도 빠질 수 없어서 약속을 취소할 것이다.", "value": { "text_id": "6", "word_num": 15, "핵심동사": "취소할", "확실성": "불확실", "극성": "부정", "시제": "미래", "key_word": "것이다" } } ], "dupLabelYn": "Y", "metaData": { "ID": "420425", "FILENAME": "420425.json", "MEDIA_TYPE": "블로그", "MEDIA_NAME": "네이버 - https://blog.naver.com/create_virus/223048999536", "CATEGORY": "사회", "PUBDATE": "20230319", "SENTENCE": "6" } } 