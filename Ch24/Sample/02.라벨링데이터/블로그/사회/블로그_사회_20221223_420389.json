{ "annotation": [ { "charNum": "1", "label": "예측형", "length": 37, "text": "여자 아이들 중에 공주 캐릭터를 좋아하지 않는 아이는 없을 것이다.", "value": { "text_id": "1", "word_num": 10, "핵심동사": "없을", "확실성": "불확실", "극성": "부정", "시제": "미래", "key_word": "좋아하지/않는/아이는/것이다" } }, { "charNum": "38", "label": "예측형", "length": 46, "text": "예쁜 공주 드레스를 입고 공주 머리를 하는 것을 싫어하는 여자 아이는 없을 것이다.", "value": { "text_id": "2", "word_num": 13, "핵심동사": "없을", "확실성": "불확실", "극성": "부정", "시제": "미래", "key_word": "아이는/것이다" } }, { "charNum": "84", "label": "예측형", "length": 19, "text": "그런데 남자 아이들은 다를 것이다.", "value": { "text_id": "3", "word_num": 5, "핵심동사": "다를", "확실성": "불확실", "극성": "부정", "시제": "미래", "key_word": "남자/아이들은/것이다" } }, { "charNum": "103", "label": "예측형", "length": 33, "text": "남자 아이들은 공주 옷, 공주 머리에는 관심이 없을 것이다.", "value": { "text_id": "4", "word_num": 9, "핵심동사": "없을", "확실성": "불확실", "극성": "부정", "시제": "미래", "key_word": "관심이/것이다" } }, { "charNum": "136", "label": "예측형", "length": 54, "text": "그리고 남자 아이들은 운동이나 게임 등에 관심을 보이고 여자 아이들과는 성향이 같지 않을 것이다.", "value": { "text_id": "5", "word_num": 14, "핵심동사": "않을", "확실성": "불확실", "극성": "부정", "시제": "미래", "key_word": "성향이/같지/것이다" } }, { "charNum": "190", "label": "예측형", "length": 57, "text": "이러한 성향은 사회가 만든 것일지도 모르지만 여자 아이와 남자 아이는 성향이 같기 매우 어려울 것이다.", "value": { "text_id": "6", "word_num": 15, "핵심동사": "어려울", "확실성": "불확실", "극성": "부정", "시제": "미래", "key_word": "매우/것이다" } } ], "dupLabelYn": "Y", "metaData": { "ID": "420389", "FILENAME": "420389.json", "MEDIA_TYPE": "블로그", "MEDIA_NAME": "네이버 - https://blog.naver.com/create_virus/223048990704", "CATEGORY": "사회", "PUBDATE": "20230319", "SENTENCE": "6" } } 