{ "annotation": [ { "charNum": "1", "label": "사실형", "length": 35, "text": "현재 우리나라는 거짓말처럼 인구 감소가 계속될 것으로 예견된다.", "value": { "text_id": "1", "word_num": 8, "핵심동사": "예견된다", "확실성": "불확실", "극성": "부정", "시제": "미래", "key_word": " " } }, { "charNum": "36", "label": "예측형", "length": 27, "text": "정부에서는 마땅한 대안을 마련하기는 힘들 것이다.", "value": { "text_id": "2", "word_num": 6, "핵심동사": "힘들", "확실성": "불확실", "극성": "부정", "시제": "미래", "key_word": "것이다" } }, { "charNum": "63", "label": "예측형", "length": 36, "text": "저출산 문제가 개인의 경제 문제로 연결되며 해결이 어려울 것이다.", "value": { "text_id": "3", "word_num": 9, "핵심동사": "어려울", "확실성": "불확실", "극성": "부정", "시제": "미래", "key_word": "것이다" } }, { "charNum": "99", "label": "예측형", "length": 32, "text": "도시와 지방에서의 출산 복지를 공정히 나누지 못할 것이다.", "value": { "text_id": "4", "word_num": 8, "핵심동사": "못할", "확실성": "불확실", "극성": "부정", "시제": "미래", "key_word": "나누지/것은다" } }, { "charNum": "131", "label": "예측형", "length": 50, "text": "과거처럼 도시와 지방 간에 출산 정책과 복지에 차이를 둔다면 실패로 돌아갈 가능성이 있다.", "value": { "text_id": "5", "word_num": 13, "핵심동사": "있다", "확실성": "불확실", "극성": "부정", "시제": "미래", "key_word": "가능성이" } }, { "charNum": "181", "label": "예측형", "length": 37, "text": "여전히 저출산 문제가 점점 더 심각해져 해결이 매우 어려울 것이다.", "value": { "text_id": "6", "word_num": 10, "핵심동사": "어려울", "확실성": "불확실", "극성": "부정", "시제": "미래", "key_word": "매우/것이다" } } ], "dupLabelYn": "Y", "metaData": { "ID": "420339", "FILENAME": "420339.json", "MEDIA_TYPE": "블로그", "MEDIA_NAME": "네이버 - https://blog.naver.com/create_virus/223048984191", "CATEGORY": "사회", "PUBDATE": "20230319", "SENTENCE": "6" } } 