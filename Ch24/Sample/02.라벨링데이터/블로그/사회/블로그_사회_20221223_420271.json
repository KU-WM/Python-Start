{ "annotation": [ { "charNum": "1", "label": "예측형", "length": 42, "text": "앞으로 다가올 미래에는 많은 직업들이 유지하기 매우 어려울 것으로 예견된다.", "value": { "text_id": "1", "word_num": 10, "핵심동사": "예견된다", "확실성": "불확실", "극성": "부정", "시제": "미래", "key_word": "어려울/것으로" } }, { "charNum": "43", "label": "예측형", "length": 47, "text": "왜냐하면 현재의 직업들은 발전된 기계들로 인하여 자리 유지가 실패할 것이기 때문이다.", "value": { "text_id": "2", "word_num": 11, "핵심동사": "실패할", "확실성": "확실", "극성": "부정", "시제": "미래", "key_word": "것이기/때문이다" } }, { "charNum": "90", "label": "예측형", "length": 40, "text": "더욱이 최근 발전하고 있는 AI 기술은 많은 직업을 사라지게 할 것이다.", "value": { "text_id": "3", "word_num": 11, "핵심동사": "할", "확실성": "확실", "극성": "부정", "시제": "미래", "key_word": "사라지게/것이다" } }, { "charNum": "130", "label": "예측형", "length": 45, "text": "예를 들어 현재 고임금 전문직으로 불리는 회계사라는 직업도 사라질 가능성이 높다.", "value": { "text_id": "4", "word_num": 11, "핵심동사": "높다", "확실성": "불확실", "극성": "부정", "시제": "미래", "key_word": "가능성이" } }, { "charNum": "175", "label": "예측형", "length": 19, "text": "변호사 역시 사라질 가능성이 높다.", "value": { "text_id": "5", "word_num": 5, "핵심동사": "높다", "확실성": "불확실", "극성": "부정", "시제": "미래", "key_word": "가능성이" } }, { "charNum": "194", "label": "예측형", "length": 40, "text": "이러한 기술의 발전 및 변화는 많은 직업군을 사라지게 할 가능성이 높다.", "value": { "text_id": "6", "word_num": 11, "핵심동사": "높다", "확실성": "불확실", "극성": "부정", "시제": "미래", "key_word": "가능성이" } } ], "dupLabelYn": "Y", "metaData": { "ID": "420271", "FILENAME": "420271.json", "MEDIA_TYPE": "블로그", "MEDIA_NAME": "티스토리 - https://galaxyrailroad999.tistory.com/5", "CATEGORY": "사회", "PUBDATE": "20230302", "SENTENCE": "6" } } 