{ "annotation": [ { "charNum": "1", "label": "예측형", "length": 30, "text": "우리나라 사람들은 점점 결혼하지 않을 것으로 예견된다.", "value": { "text_id": "1", "word_num": 7, "핵심동사": "예견된다", "확실성": "불확실", "극성": "부정", "시제": "미래", "key_word": "점점/것으로" } }, { "charNum": "31", "label": "예측형", "length": 19, "text": "따라서 출산도 매우 어려울 것이다.", "value": { "text_id": "2", "word_num": 5, "핵심동사": "어려울", "확실성": "불확실", "극성": "부정", "시제": "미래", "key_word": "것이다" } }, { "charNum": "50", "label": "예측형", "length": 17, "text": "군대에도 사람이 줄어들 것이다.", "value": { "text_id": "3", "word_num": 4, "핵심동사": "줄어들", "확실성": "불확실", "극성": "부정", "시제": "미래", "key_word": "것이다" } }, { "charNum": "67", "label": "예측형", "length": 21, "text": "그러면 우리나라 방어도 실패할 것이다.", "value": { "text_id": "4", "word_num": 5, "핵심동사": "실패할", "확실성": "불확실", "극성": "부정", "시제": "미래", "key_word": "것이다" } }, { "charNum": "88", "label": "예측형", "length": 55, "text": "사회에는 나이가 많은 사람들이 많아질 것이고 사람들이 면접을 볼 때 거짓말을 할 수도 있을 것이다.", "value": { "text_id": "5", "word_num": 15, "핵심동사": "할", "확실성": "불확실", "극성": "부정", "시제": "미래", "key_word": "있을/것이다" } }, { "charNum": "143", "label": "예측형", "length": 18, "text": "학교도 점점 줄 것으로 예측된다.", "value": { "text_id": "6", "word_num": 5, "핵심동사": "예측된다", "확실성": "불확실", "극성": "부정", "시제": "미래", "key_word": "줄/것으로" } }, { "charNum": "161", "label": "예측형", "length": 28, "text": "그래서 교사라는 직업을 보기가 매우 어려울 것이다.", "value": { "text_id": "7", "word_num": 7, "핵심동사": "어려울", "확실성": "불확실", "극성": "부정", "시제": "미래", "key_word": "것이다" } }, { "charNum": "189", "label": "예측형", "length": 70, "text": "부부라는 말보다 싱글이라는 말을 많이 쓸 가능성이 높고, 경우에 따라서는 부부라고 거짓말을 하는 사림들이 생길 가능성도 있다.", "value": { "text_id": "8", "word_num": 17, "핵심동사": "있다", "확실성": "불확실", "극성": "부정", "시제": "미래", "key_word": "가능성도" } } ], "dupLabelYn": "Y", "metaData": { "ID": "420253", "FILENAME": "420253.json", "MEDIA_TYPE": "블로그", "MEDIA_NAME": "네이버 - https://blog.naver.com/hisdata123/223021653719", "CATEGORY": "사회", "PUBDATE": "20230220", "SENTENCE": "8" } } 