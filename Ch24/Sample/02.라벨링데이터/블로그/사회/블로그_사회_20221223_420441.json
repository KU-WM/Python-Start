{ "annotation": [ { "charNum": "1", "label": "예측형", "length": 29, "text": "앞으로 하나의 직업으로 살기에는 매우 어려울 것이다.", "value": { "text_id": "1", "word_num": 7, "핵심동사": "어려울", "확실성": "불확실", "극성": "부정", "시제": "미래", "key_word": "것이다" } }, { "charNum": "30", "label": "예측형", "length": 41, "text": "또한 물가가 계속해서 오르고 주식의 단가는 내려가서 계속 힘들어질 것이다.", "value": { "text_id": "2", "word_num": 10, "핵심동사": "힘들어질", "확실성": "불확실", "극성": "부정", "시제": "미래", "key_word": "것이다" } }, { "charNum": "71", "label": "예측형", "length": 45, "text": "그래서 사람들은 아르바이트를 구하려고 할 것이지만 경쟁률이 높아서 어려울 것이다.", "value": { "text_id": "3", "word_num": 10, "핵심동사": "어려울", "확실성": "불확실", "극성": "부정", "시제": "미래", "key_word": "것이다" } }, { "charNum": "116", "label": "예측형", "length": 31, "text": "또한 직장마저도 정규직이 없어져서 더욱 힘들어질 것이다.", "value": { "text_id": "4", "word_num": 7, "핵심동사": "힘들어질", "확실성": "불확실", "극성": "부정", "시제": "미래", "key_word": "것이다" } }, { "charNum": "147", "label": "예측형", "length": 28, "text": "그래서 젊은 사람들의 목돈 만들기는 실패할 것이다.", "value": { "text_id": "5", "word_num": 7, "핵심동사": "실패할", "확실성": "불확실", "극성": "부정", "시제": "미래", "key_word": "것이다" } }, { "charNum": "175", "label": "예측형", "length": 19, "text": "계속해서 어려운 사회가 될 것이다.", "value": { "text_id": "6", "word_num": 5, "핵심동사": "될", "확실성": "불확실", "극성": "부정", "시제": "미래", "key_word": "사회가/것이다" } } ], "dupLabelYn": "Y", "metaData": { "ID": "420441", "FILENAME": "420441.json", "MEDIA_TYPE": "블로그", "MEDIA_NAME": "네이버 - https://blog.naver.com/hisdata123/223049520716", "CATEGORY": "사회", "PUBDATE": "20230320", "SENTENCE": "6" } } 