{ "annotation": [ { "charNum": "1", "label": "예측형", "length": 29, "text": "나는 다른 동네로 이사를 가고 싶지만 어려울 것이다.", "value": { "text_id": "1", "word_num": 8, "핵심동사": "어려울", "확실성": "불확실", "극성": "부정", "시제": "미래", "key_word": "것이다" } }, { "charNum": "30", "label": "예측형", "length": 44, "text": "다른 동네로 이사를 가면 아이가 학교를 옮겨야 해서 적응하기 쉽지 않을 것이다.", "value": { "text_id": "2", "word_num": 12, "핵심동사": "않을", "확실성": "불확실", "극성": "부정", "시제": "미래", "key_word": "쉽지/것이다" } }, { "charNum": "74", "label": "예측형", "length": 28, "text": "그리고 정든 이웃들과 헤어지는 것도 어려울 것이다.", "value": { "text_id": "3", "word_num": 7, "핵심동사": "어려울", "확실성": "불확실", "극성": "부정", "시제": "미래", "key_word": "것이다" } }, { "charNum": "102", "label": "예측형", "length": 35, "text": "하지만 지금 사는 동네는 앞으로도 상권이 발달하지 않을 것이다.", "value": { "text_id": "4", "word_num": 9, "핵심동사": "않을", "확실성": "불확실", "극성": "부정", "시제": "미래", "key_word": "발달하지/것이다" } }, { "charNum": "137", "label": "예측형", "length": 31, "text": "마트나 병원이 생기지 않아서 생활이 계속 불편할 것이다.", "value": { "text_id": "5", "word_num": 8, "핵심동사": "불편할", "확실성": "불확실", "극성": "부정", "시제": "미래", "key_word": "것이다" } }, { "charNum": "168", "label": "예측형", "length": 48, "text": "그래서 나는 이사를 가고 싶지만 여러가지 이유로 이사를 포기하지 않으면 안 될 것이다.", "value": { "text_id": "6", "word_num": 13, "핵심동사": "안될", "확실성": "불확실", "극성": "부정", "시제": "미래", "key_word": "않으면/것이다" } } ], "dupLabelYn": "Y", "metaData": { "ID": "420380", "FILENAME": "420380.json", "MEDIA_TYPE": "블로그", "MEDIA_NAME": "네이버 - https://blog.naver.com/create_virus/223048989658", "CATEGORY": "사회", "PUBDATE": "20230319", "SENTENCE": "6" } } 