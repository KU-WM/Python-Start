{ "annotation": [ { "charNum": "1", "label": "예측형", "length": 24, "text": "앞으로 오랫동안 햇빛을 보기 어려울 것이다.", "value": { "text_id": "1", "word_num": 6, "핵심동사": "어려울", "확실성": "불확실", "극성": "부정", "시제": "미래", "key_word": "것이다" } }, { "charNum": "25", "label": "예측형", "length": 28, "text": "이제 긴 장미가 시작되어 날씨가 좋지 않을 것이다.", "value": { "text_id": "2", "word_num": 8, "핵심동사": "않을", "확실성": "불확실", "극성": "부정", "시제": "미래", "key_word": "좋지/것이다" } }, { "charNum": "53", "label": "예측형", "length": 44, "text": "장마에는 비가 많이 오는 것뿐만 아니라 맑은 하늘을 보기 어려울 가능성이 높다.", "value": { "text_id": "3", "word_num": 12, "핵심동사": "높다", "확실성": "불확실", "극성": "부정", "시제": "미래", "key_word": "가능성이" } }, { "charNum": "97", "label": "예측형", "length": 22, "text": "그래서 사람들은 장마철을 싫어할 것이다.", "value": { "text_id": "4", "word_num": 5, "핵심동사": "싫어할", "확실성": "불확실", "극성": "부정", "시제": "미래", "key_word": "것이다" } }, { "charNum": "119", "label": "예측형", "length": 41, "text": "장마가 시작되면 습도가 높아져서 사람들의 불쾌지수가 떨어지지 않을 것이다.", "value": { "text_id": "5", "word_num": 9, "핵심동사": "않을", "확실성": "불확실", "극성": "부정", "시제": "미래", "key_word": "떨어지지/것이다" } }, { "charNum": "160", "label": "예측형", "length": 34, "text": "하지만 기나긴 장마도 언젠가는 끝나고 비가 오지 않을 것이다.", "value": { "text_id": "6", "word_num": 9, "핵심동사": "않을", "확실성": "불확실", "극성": "부정", "시제": "미래", "key_word": "오지/것이다" } } ], "dupLabelYn": "Y", "metaData": { "ID": "420419", "FILENAME": "420419.json", "MEDIA_TYPE": "블로그", "MEDIA_NAME": "네이버 - https://blog.naver.com/create_virus/223048994204", "CATEGORY": "사회", "PUBDATE": "20230319", "SENTENCE": "6" } } 