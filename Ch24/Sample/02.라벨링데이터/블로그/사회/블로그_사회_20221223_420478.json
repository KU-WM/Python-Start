{ "annotation": [ { "charNum": "1", "label": "예측형", "length": 49, "text": "좋아하는 일을 하지 않으면 동기가 많아지기 쉽지 않고 일의 흥미도 잃을 수 있을 것이다.", "value": { "text_id": "1", "word_num": 14, "핵심동사": "있을", "확실성": "불확실", "극성": "부정", "시제": "미래", "key_word": "잃을/것이다" } }, { "charNum": "50", "label": "예측형", "length": 35, "text": "업무에 대해 만족하기가 쉽지 않고 불만족이 생길 가능성이 있다.", "value": { "text_id": "2", "word_num": 9, "핵심동사": "있다", "확실성": "불확실", "극성": "부정", "시제": "미래", "key_word": "가능성이" } }, { "charNum": "85", "label": "예측형", "length": 19, "text": "생산성이 늘지 않고 저하될 것이다.", "value": { "text_id": "3", "word_num": 5, "핵심동사": "저하될", "확실성": "불확실", "극성": "부정", "시제": "미래", "key_word": "것이다" } }, { "charNum": "104", "label": "예측형", "length": 32, "text": "자신의 능력과 업무가 맞지 않을 수 있을 것으로 예견된다.", "value": { "text_id": "4", "word_num": 9, "핵심동사": "예견된다", "확실성": "불확실", "극성": "미정", "시제": "미래", "key_word": "맞지/않을/수/있을/것으로" } }, { "charNum": "136", "label": "예측형", "length": 22, "text": "직업 몰입도가 높지 않아 감소될 것이다.", "value": { "text_id": "5", "word_num": 6, "핵심동사": "감소될", "확실성": "불확실", "극성": "부정", "시제": "미래", "key_word": "것이다" } }, { "charNum": "158", "label": "예측형", "length": 28, "text": "업무 스트레스가 적지 않게 늘어날 것으로 예견된다.", "value": { "text_id": "6", "word_num": 7, "핵심동사": "예견된다", "확실성": "불확실", "극성": "미정", "시제": "미래", "key_word": "늘어날/것으로" } }, { "charNum": "186", "label": "예측형", "length": 30, "text": "직업에 대한 만족도는 당연히 늘지 않고 줄어들 것이다.", "value": { "text_id": "7", "word_num": 8, "핵심동사": "줄어들", "확실성": "불확실", "극성": "부정", "시제": "미래", "key_word": "것이다" } }, { "charNum": "216", "label": "예측형", "length": 21, "text": "효율성이 증가하지 않고 감소될 것이다.", "value": { "text_id": "8", "word_num": 5, "핵심동사": "감소될", "확실성": "불확실", "극성": "부정", "시제": "미래", "key_word": "것이다" } }, { "charNum": "237", "label": "예측형", "length": 28, "text": "목표를 달성하기가 쉽지 않아 어려울 가능성이 있다.", "value": { "text_id": "9", "word_num": 7, "핵심동사": "있다", "확실성": "불확실", "극성": "부정", "시제": "미래", "key_word": "가능성이" } }, { "charNum": "265", "label": "예측형", "length": 51, "text": "따라서 자신이 좋아하지 않는 일보다는 좋아