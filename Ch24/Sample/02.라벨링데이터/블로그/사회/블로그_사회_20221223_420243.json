{ "annotation": [ { "charNum": "1", "label": "예측형", "length": 22, "text": "한동안은 경제가 활성화되기 힘들 것이다.", "value": { "text_id": "1", "word_num": 5, "핵심동사": "힘들", "확실성": "불확실", "극성": "부정", "시제": "미래", "key_word": "것이다" } }, { "charNum": "23", "label": "예측형", "length": 46, "text": "그렇기 때문에 정부는 경제성장률을 하향 조정하나 목표 달성에 실패할 것으로 보인다.", "value": { "text_id": "2", "word_num": 11, "핵심동사": "보인다", "확실성": "불확실", "극성": "부정", "시제": "현재", "key_word": "실패할/것으로" } }, { "charNum": "69", "label": "예측형", "length": 44, "text": "많은 국민들은 소비를 줄일 가능성이 높아지고 경제 회복은 당분간 어려울 것이다.", "value": { "text_id": "3", "word_num": 11, "핵심동사": "어려울", "확실성": "불확실", "극성": "부정", "시제": "미래", "key_word": "것이다" } }, { "charNum": "113", "label": "예측형", "length": 53, "text": "정부는 경제 활성화를 위한 정책을 펼칠 계획이지만, 당초 목표에는 도달하지 못할 가능성이 높다.", "value": { "text_id": "4", "word_num": 13, "핵심동사": "높다", "확실성": "불확실", "극성": "부정", "시제": "미래", "key_word": "가능성이" } }, { "charNum": "166", "label": "예측형", "length": 34, "text": "그럼에도 거짓말 같은 경제 반등을 위해 최선을 다할 계획이다.", "value": { "text_id": "5", "word_num": 9, "핵심동사": "계획이다", "확실성": "불확실", "극성": "긍정", "시제": "미래", "key_word": "최선을/다할" } } ], "dupLabelYn": "Y", "metaData": { "ID": "420243", "FILENAME": "420243.json", "MEDIA_TYPE": "블로그", "MEDIA_NAME": "네이버 - https://blog.naver.com/hisdata123/223021636519", "CATEGORY": "사회", "PUBDATE": "20230220", "SENTENCE": "5" } } 