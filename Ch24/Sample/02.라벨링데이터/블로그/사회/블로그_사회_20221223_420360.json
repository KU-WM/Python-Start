{ "annotation": [ { "charNum": "1", "label": "예측형", "length": 31, "text": "그는 아무래도 분노를 조절하지 못하는 병이 있을 것이다.", "value": { "text_id": "1", "word_num": 8, "핵심동사": "있을", "확실성": "불확실", "극성": "긍정", "시제": "현재", "key_word": "병이/것이다" } }, { "charNum": "32", "label": "예측형", "length": 46, "text": "그는 예상하지 못했던 일이 갑자기 일어나면 감정을 조절하지 못하고 화를 낼 것이다.", "value": { "text_id": "2", "word_num": 12, "핵심동사": "낼", "확실성": "불확실", "극성": "부정", "시제": "미래", "key_word": "화를/것이다" } }, { "charNum": "78", "label": "예측형", "length": 35, "text": "또한 충분히 참을 수 있는 작은 일에도 화를 참지 못할 것이다.", "value": { "text_id": "3", "word_num": 11, "핵심동사": "못할", "확실성": "불확실", "극성": "부정", "시제": "미래", "key_word": "참지/것이다" } }, { "charNum": "113", "label": "예측형", "length": 35, "text": "그래서 그의 주변에 있는 사람들을 그를 좋아할 수 없을 것이다.", "value": { "text_id": "4", "word_num": 10, "핵심동사": "없을", "확실성": "불확실", "극성": "부정", "시제": "미래", "key_word": "좋아할/수/것이다" } }, { "charNum": "148", "label": "예측형", "length": 38, "text": "매일 그의 감정을 겪어야 하는 그의 아내는 매일 매우 어려울 것이다.", "value": { "text_id": "5", "word_num": 11, "핵심동사": "어려울", "확실성": "불확실", "극성": "부정", "시제": "현재", "key_word": "매우/것이다" } }, { "charNum": "186", "label": "추론형", "length": 40, "text": "그래서 나는 그의 아내를 만나게 되면 위로를 아끼지 않고 전할 계획이다.", "value": { "text_id": "6", "word_num": 11, "핵심동사": "계획이다", "확실성": "불확실", "극성": "긍정", "시제": "미래", "key_word": "위로를/전할" } } ], "dupLabelYn": "Y", "metaData": { "ID": "420360", "FILENAME": "420360.json", "MEDIA_TYPE": "블로그", "MEDIA_NAME": "네이버 - https://blog.naver.com/create_virus/223048987417", "CATEGORY": "사회", "PUBDATE": "20230319", "SENTENCE": "6" } } 