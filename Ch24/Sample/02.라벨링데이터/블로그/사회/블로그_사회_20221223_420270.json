{ "annotation": [ { "charNum": "1", "label": "예측형", "length": 14, "text": "나는 이직을 할 예정이다.", "value": { "text_id": "1", "word_num": 4, "핵심동사": "예정이다", "확실성": "불확실", "극성": "부정", "시제": "미래", "key_word": "이직을/할" } }, { "charNum": "15", "label": "예측형", "length": 31, "text": "나는 앞으로 이직을 위한 구체적인 교육을 받을 예정이다.", "value": { "text_id": "2", "word_num": 8, "핵심동사": "예정이다", "확실성": "불확실", "극성": "부정", "시제": "미래", "key_word": "교육을/받을" } }, { "charNum": "46", "label": "예측형", "length": 41, "text": "이직 후 업무에 익숙하지 않다면 직장 동료들에게 민폐를 끼치게 될 것이다.", "value": { "text_id": "3", "word_num": 11, "핵심동사": "될", "확실성": "불확실", "극성": "부정", "시제": "미래", "key_word": "민폐를/끼치게/것이다" } }, { "charNum": "87", "label": "예측형", "length": 60, "text": "미숙한 업무 처리로 도움을 청하면서 일을 하게 된다면 자괴감이 들게 되어 직장생활을 오래 하지 못할 것이다.", "value": { "text_id": "4", "word_num": 16, "핵심동사": "하지", "확실성": "불확실", "극성": "부정", "시제": "미래", "key_word": "못할/것이다" } }, { "charNum": "147", "label": "예측형", "length": 57, "text": "더불어 미리 건강을 챙기지 않으면 이직을 위한 자리가 있다고 해도 지속적인 업무 수행이 어려울 것이다.", "value": { "text_id": "5", "word_num": 15, "핵심동사": "어려울", "확실성": "불확실", "극성": "부정", "시제": "미래", "key_word": "것이다" } } ], "dupLabelYn": "Y", "metaData": { "ID": "420270", "FILENAME": "420270.json", "MEDIA_TYPE": "블로그", "MEDIA_NAME": "티스토리 - https://galaxyrailroad999.tistory.com/3", "CATEGORY": "사회", "PUBDATE": "20230302", "SENTENCE": "5" } } 