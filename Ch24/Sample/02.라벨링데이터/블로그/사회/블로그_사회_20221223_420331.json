{ "annotation": [ { "charNum": "1", "label": "예측형", "length": 18, "text": "현수는 취업 시험을 볼 계획이다.", "value": { "text_id": "1", "word_num": 5, "핵심동사": "볼", "확실성": "불확실", "극성": "미정", "시제": "미래", "key_word": "계획이다" } }, { "charNum": "19", "label": "예측형", "length": 56, "text": "이번 시험에는 5000명 정도의 수험생이 응시할 것으로 예상되어 현수의 합격 여부는 미지수일 것이다.", "value": { "text_id": "2", "word_num": 13, "핵심동사": "미지수", "확실성": "불확실", "극성": "미정", "시제": "미래", "key_word": "일/것이다" } }, { "charNum": "75", "label": "예측형", "length": 62, "text": "한편 이번 시험부터는 필기시험과 실기시험의 비중이 변경될 예정이라 누구도 시험의 결과를 예측하기 어려울 것이다.", "value": { "text_id": "3", "word_num": 14, "핵심동사": "어려울", "확실성": "불확실", "극성": "미정", "시제": "미래", "key_word": "예측하기/것이다" } }, { "charNum": "137", "label": "예측형", "length": 66, "text": "그러나 일각에서는 그간 업무 현장에서의 불만의 목소리를 참고하여 실기의 비중이 대폭 상승할 가능성이 높다고 이야기한다.", "value": { "text_id": "4", "word_num": 15, "핵심동사": "이야기한다", "확실성": "불확실", "극성": "미정", "시제": "미래", "key_word": "가능성이/높다고" } }, { "charNum": "203", "label": "예측형", "length": 46, "text": "이렇게 되면 필기 위주의 시험 준비를 한 수험생이 합격할 것인지는 미지수일 것이다.", "value": { "text_id": "5", "word_num": 12, "핵심동사": "미지수일", "확실성": "불확실", "극성": "미정", "시제": "미래", "key_word": "것이다" } }, { "charNum": "249", "label": "예측형", "length": 56, "text": "그러나 만점에 가까운 필기성적과 평균적인 실기점수를 받는다면 현수가 합격하지 말란 법은 없을 것이다.", "value": { "text_id": "6", "word_num": 13, "핵심동사": "없을", "확실성": "불확실", "극성": "미정", "시제": "미래", "key_word": "법은/것이다" } } ], "dupLabelYn": "Y", "metaData": { "ID": "420331", "FILENAME": "420331.json", "MEDIA_TYPE": "블로그", "MEDIA_NAME": "티스토리 - https://galaxyrailroad999.tistory.com/49", "CATEGORY": "사회", "PUBDATE": "20230316", "SENTENCE": "6" } } 