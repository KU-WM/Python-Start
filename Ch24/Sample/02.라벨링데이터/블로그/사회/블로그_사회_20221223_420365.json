{ "annotation": [ { "charNum": "1", "label": "예측형", "length": 35, "text": "나는 내일 친구의 결혼식이 있지만 가지 못할 수도 있을 것이다.", "value": { "text_id": "1", "word_num": 10, "핵심동사": "있을", "확실성": "불확실", "극성": "미정", "시제": "미래", "key_word": "가지/못할/수도/것이다" } }, { "charNum": "36", "label": "예측형", "length": 52, "text": "친구 두 명이 같은 날에 결혼식을 해서 어느 한 친구의 결혼식에만 가기는 매우 어려울 것이다.", "value": { "text_id": "2", "word_num": 15, "핵심동사": "어려울", "확실성": "불확실", "극성": "부정", "시제": "미래", "key_word": "매우/것이다" } }, { "charNum": "88", "label": "예측형", "length": 36, "text": "그래서 차라리 두 친구의 결혼식을 모두 가지 않을 가능성이 있다.", "value": { "text_id": "3", "word_num": 10, "핵심동사": "있다", "확실성": "불확실", "극성": "부정", "시제": "미래", "key_word": "가능성이" } }, { "charNum": "124", "label": "예측형", "length": 26, "text": "하지만 친구들은 나에게 서운해하지 않을 것이다.", "value": { "text_id": "4", "word_num": 6, "핵심동사": "않을", "확실성": "불확실", "극성": "부정", "시제": "미래", "key_word": "서운해/하지/것이다" } }, { "charNum": "150", "label": "예측형", "length": 37, "text": "나의 결혼식에도 두 친구는 신혼여행에 가 있어서 오지 못할 것이다.", "value": { "text_id": "5", "word_num": 10, "핵심동사": "못할", "확실성": "불확실", "극성": "부정", "시제": "미래", "key_word": "가/있어서/오지/것이다" } }, { "charNum": "187", "label": "예측형", "length": 43, "text": "나는 오늘 밤에 결혼식에 대해 고민하느라 잠을 잘 자지 못할 것으로 예측된다.", "value": { "text_id": "6", "word_num": 12, "핵심동사": "예측된다", "확실성": "불확실", "극성": "부정", "시제": "미래", "key_word": "자지/못할/것으로" } } ], "dupLabelYn": "Y", "metaData": { "ID": "420365", "FILENAME": "420365.json", "MEDIA_TYPE": "블로그", "MEDIA_NAME": "네이버 - https://blog.naver.com/create_virus/223048987961", "CATEGORY": "사회", "PUBDATE": "20230319", "SENTENCE": "6" } } 