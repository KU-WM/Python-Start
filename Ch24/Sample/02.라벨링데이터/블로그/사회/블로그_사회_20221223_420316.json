{ "annotation": [ { "charNum": "1", "label": "예측형", "length": 43, "text": "20, 30대는 경제적 문제로 인하여 결혼을 하지 않는 경우가 늘어날 것이다.", "value": { "text_id": "1", "word_num": 11, "핵심동사": "늘어날", "확실성": "불확실", "극성": "미정", "시제": "미래", "key_word": "것이다" } }, { "charNum": "44", "label": "예측형", "length": 29, "text": "그로 인해 자연스럽게 출산율이 낮아질 가능성이 높다.", "value": { "text_id": "2", "word_num": 7, "핵심동사": "높다", "확실성": "불확실", "극성": "부정", "시제": "미래", "key_word": "가능성이" } }, { "charNum": "73", "label": "예측형", "length": 32, "text": "출산율은 낮아지는 대신 고령화 인구는 점점 늘어날 것이다.", "value": { "text_id": "3", "word_num": 8, "핵심동사": "늘어날", "확실성": "불확실", "극성": "미정", "시제": "미래", "key_word": "것이다" } }, { "charNum": "105", "label": "예측형", "length": 41, "text": "그래서 우리는 출산율을 높이기 위해 많은 정책을 고민해 보아야 할 것이다.", "value": { "text_id": "4", "word_num": 11, "핵심동사": "할", "확실성": "불확실", "극성": "미정", "시제": "미래", "key_word": "보아야/것이다" } }, { "charNum": "146", "label": "추론형", "length": 47, "text": "하루빨리 저출산 문제와 고령화 문제를 해결할 수 있는 여러 정책이 나와야 할 것이다.", "value": { "text_id": "5", "word_num": 13, "핵심동사": "할", "확실성": "불확실", "극성": "미정", "시제": "미래", "key_word": "나와야/것이다" } } ], "dupLabelYn": "Y", "metaData": { "ID": "420316", "FILENAME": "420316.json", "MEDIA_TYPE": "블로그", "MEDIA_NAME": "티스토리 - https://galaxyrailroad999.tistory.com/46", "CATEGORY": "사회", "PUBDATE": "20230306", "SENTENCE": "5" } } 