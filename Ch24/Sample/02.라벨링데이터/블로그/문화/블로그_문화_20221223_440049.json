{ "annotation": [ { "charNum": "1", "label": "예측형", "length": 30, "text": "우리나라에서 고양이는 강아지만큼 친숙하지 않을 것이다.", "value": { "text_id": "1", "word_num": 6, "핵심동사": "않을", "확실성": "불확실", "극성": "미정", "시제": "미래", "key_word": "친숙하지/것이다" } }, { "charNum": "31", "label": "예측형", "length": 47, "text": "하지만 고양이의 매력을 안다면 앞으로 고양이를 키우는 집은 점점 더 늘어 날 것이다.", "value": { "text_id": "2", "word_num": 13, "핵심동사": "늘어날", "확실성": "불확실", "극성": "미정", "시제": "미래", "key_word": "것이다" } }, { "charNum": "78", "label": "예측형", "length": 23, "text": "고양이는 강아지처럼 상냥하지 않을 것이다.", "value": { "text_id": "3", "word_num": 5, "핵심동사": "않을", "확실성": "불확실", "극성": "미정", "시제": "미래", "key_word": "상냥하지/것이다" } }, { "charNum": "101", "label": "추론형", "length": 51, "text": "하지만 강아지처럼 산책을 시켜주지 않아도 되고 혼자 있어도 외로움을 많이 타지 않을 것이다.", "value": { "text_id": "4", "word_num": 13, "핵심동사": "않을", "확실성": "불확실", "극성": "미정", "시제": "미래", "key_word": "타지/것이다" } }, { "charNum": "152", "label": "예측형", "length": 35, "text": "그리고 강아지보다 사람의 도움이 많이 필요로 하지 않을 것이다.", "value": { "text_id": "5", "word_num": 9, "핵심동사": "않을", "확실성": "불확실", "극성": "미정", "시제": "미래", "key_word": "하지/것이다" } }, { "charNum": "187", "label": "예측형", "length": 59, "text": "강아지도 귀엽지만 고양이만의 매력이 없지 않으므로 앞으로 고양이를 키우는 집이 더 늘어날 것으로 예견된다.", "value": { "text_id": "6", "word_num": 14, "핵심동사": "예견된다", "확실성": "불확실", "극성": "미정", "시제": "미래", "key_word": "늘어날/것으로" } } ], "dupLabelYn": "Y", "metaData": { "ID": "440049", "FILENAME": "440049.json", "MEDIA_TYPE": "블로그", "MEDIA_NAME": "네이버 - https://blog.naver.com/create_virus/223047586744", "CATEGORY": "문화", "PUBDATE": "20230317", "SENTENCE": "6" } } 