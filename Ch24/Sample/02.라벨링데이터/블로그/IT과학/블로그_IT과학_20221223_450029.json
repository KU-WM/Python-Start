{ "annotation": [ { "charNum": "1", "label": "대화형", "length": 19, "text": "공용 와이파이와 비슷한 경우입니다.", "value": { "text_id": "1", "word_num": 4, "핵심동사": "경우입니다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "21", "label": "대화형", "length": 30, "text": "회사 망은 보통 논리적으로 인터넷과 분리되어 있습니다.", "value": { "text_id": "2", "word_num": 7, "핵심동사": "분리되어", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "52", "label": "대화형", "length": 93, "text": "그렇지만 비대면 시대가 되면서 집에서 근무를 할 경우가 많이 생기고 있고 그렇다고 회사 망을 인터넷에 그냥 공개하자니 해킹이나 감염 등의 사이버 위협요소가 존재합니다.", "value": { "text_id": "3", "word_num": 23, "핵심동사": "존재합니다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "146", "label": "대화형", "length": 62, "text": "보통 회사에서 VPN 서버를 설치하여 해당 서버를 통해서만 데이터를 주고받는다면 문제가 생길 확률은 낮아집니다.", "value": { "text_id": "4", "word_num": 14, "핵심동사": "낮아집니다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "209", "label": "대화형", "length": 55, "text": "또한 공용 와이파이와 비슷하게 데이터가 해커에게 넘어가도 암호화된 데이터이기에 큰 의미가 없습니다.", "value": { "text_id": "5", "word_num": 12, "핵심동사": "없습니다", "확실성": "확실", "극성": "부정", "시제": "현재", "key_word": " " } } ], "dupLabelYn": "Y", "metaData": { "ID": "450029", "FILENAME": "450029.json", "MEDIA_TYPE": "블로그", "MEDIA_NAME": "티스토리 - https://comptogether.tistory.com/32?category=1002659", "CATEGORY": "IT과학", "PUBDATE": "20211129", "SENTENCE": "5" } } 