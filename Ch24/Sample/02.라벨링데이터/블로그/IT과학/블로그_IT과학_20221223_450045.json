{ "annotation": [ { "charNum": "1", "label": "사실형", "length": 34, "text": "2021년에는 기업들의 ＇데이터＇ 확보 전쟁이 더욱 치열하다.", "value": { "text_id": "1", "word_num": 7, "핵심동사": "치열하다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "35", "label": "추론형", "length": 84, "text": "데이터 자체가 자산으로 인정되며, 가치가 높아지는데 반해, 개인정보 공유 및 활용을 제한하는 ＇데이터 프라이버시＇ 정책이 본격적으로 시행되기 때문이다.", "value": { "text_id": "2", "word_num": 18, "핵심동사": "때문이다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": "때문이다" } }, { "charNum": "119", "label": "추론형", "length": 36, "text": "데이터 프라이버시 시대에는 고객의 ＇신뢰＇ 확보가 매우 중요하다.", "value": { "text_id": "3", "word_num": 8, "핵심동사": "중요하다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": "중요하다" } }, { "charNum": "155", "label": "사실형", "length": 60, "text": "PwC 조사 결과, 소비자의 85%는 데이터 활용에 대해 신뢰할만한 회사가 더 많아져야 한다고 여기고 있다.", "value": { "text_id": "4", "word_num": 15, "핵심동사": "여기고", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "215", "label": "사실형", "length": 36, "text": "또한 83%의 소비자는 스스로 자신의 데이터를 관리하고 싶어했다.", "value": { "text_id": "5", "word_num": 8, "핵심동사": "관리하고", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": " " } }, { "charNum": "251", "label": "추론형", "length": 57, "text": "기업은 고객의 신뢰를 얻기 위해 ＇데이터 접근(Access)＇ 방식을 고객 중심으로 바꿔야 할 것이다.", "value": { "text_id": "6", "word_num": 13, "핵심동사": "바꿔야", "확실성": "확실", "극성": "긍정", "시제": "미래", "key_word": "바꿔야" } } ], "dupLabelYn": "Y", "metaData": { "ID": "450045", "FILENAME": "450045.json", "MEDIA_TYPE": "블로그", "MEDIA_NAME": "네이버 - https://blog.naver.com/swedu_et/222327262020", "CATEGORY": "IT과학", "PUBDATE": "20210429", "SENTENCE": "6" } } 