{ "annotation": [ { "charNum": "1", "label": "대화형", "length": 53, "text": "주식이나 경제에 대해 조금이라도 관심이 있으신 분들은 테슬라라는 회사를 모르실 수 없을 겁니다.", "value": { "text_id": "1", "word_num": 13, "핵심동사": "모르실", "확실성": "불확실", "극성": "부정", "시제": "현재", "key_word": " " } }, { "charNum": "55", "label": "대화형", "length": 23, "text": "바로 자율주행 자동차를 만드는 회사인데요.", "value": { "text_id": "2", "word_num": 5, "핵심동사": "회사인데요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "79", "label": "대화형", "length": 55, "text": "주가가 계속해서 오르고 있으며 CEO인 일론 머스크는 2021년 현재 부자 1위에 등극해 있습니다.", "value": { "text_id": "3", "word_num": 13, "핵심동사": "등극해", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "135", "label": "대화형", "length": 47, "text": "한국에서도 테슬라 자동차가 점점 보이고 있고 관련된 뉴스도 계속해서 들리고 있습니다.", "value": { "text_id": "4", "word_num": 11, "핵심동사": "들리고", "확실성": "확실", "극성": "미정", "시제": "현재", "key_word": " " } }, { "charNum": "183", "label": "대화형", "length": 36, "text": "전 세계에서 떠들석 하는 자율주행 자동차, 그 실체는 무엇일까요?", "value": { "text_id": "5", "word_num": 9, "핵심동사": "무엇일까요", "확실성": "불확실", "극성": "미정", "시제": "현재", "key_word": " " } }, { "charNum": "220", "label": "대화형", "length": 61, "text": "오늘은 자율주행 자동차에 대해 간략히 설명해드리고 앞으로 어떻게 발전해 나갈 것인지 같이 엿보도록 하겠습니다.", "value": { "text_id": "6", "word_num": 15, "핵심동사": "엿보도록", "확실성": "확실", "극성": "미정", "시제": "미래", "key_word": " " } } ], "dupLabelYn": "Y", "metaData": { "ID": "450069", "FILENAME": "450069.json", "MEDIA_TYPE": "블로그", "MEDIA_NAME": "티스토리 - https://comptogether.tistory.com/22?category=1002659", "CATEGORY": "IT과학", "PUBDATE": "20211114", "SENTENCE": "6" } } 