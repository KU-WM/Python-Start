{ "annotation": [ { "charNum": "1", "label": "대화형", "length": 45, "text": "흑체 복사를 성공적으로 해석한 것은 양자화 개념이 탄생한 이래 첫 소도소시입니다.", "value": { "text_id": "1", "word_num": 11, "핵심동사": "소도소시입니다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "47", "label": "대화형", "length": 34, "text": "물체가 가열될 때 전자기파의 형태로 적외선 복사를 발산합니다.", "value": { "text_id": "2", "word_num": 8, "핵심동사": "발산합니다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "82", "label": "대화형", "length": 30, "text": "물체가 뜨거워지면 붉은 파장 부분이 보이기 시작합니다.", "value": { "text_id": "3", "word_num": 7, "핵심동사": "시작합니다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "113", "label": "대화형", "length": 17, "text": "대부분의 열복사는 적외선입니다.", "value": { "text_id": "4", "word_num": 3, "핵심동사": "적외선입니다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "131", "label": "대화형", "length": 79, "text": "물체가 태양의 표면처럼 뜨거워지지 않는 한그러나 당시 실험실에서는 이 조건을 달성할 수 없었고 흑체 스펙트럼의 일부만 재는 것이 가능했습니다.", "value": { "text_id": "5", "word_num": 19, "핵심동사": "가능했습니다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": " " } } ], "dupLabelYn": "Y", "metaData": { "ID": "450015", "FILENAME": "450015.json", "MEDIA_TYPE": "블로그", "MEDIA_NAME": "티스토리 - https://wiselyinfo.com/116?category=567099", "CATEGORY": "IT과학", "PUBDATE": "20220326", "SENTENCE": "5" } } 