{ "annotation": [ { "charNum": "1", "label": "사실형", "length": 48, "text": "반철 자기 매질 내에서, 2종의 자기 차격자 원자의 자기 모멘트의 교환 작용은 음이다.", "value": { "text_id": "1", "word_num": 13, "핵심동사": "음이다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "50", "label": "사실형", "length": 52, "text": "각 원자의 자기 모멘트의 방향이 가까운 각 원자의 자기 모멘트와 반대 방향으로 평행하게 된다.", "value": { "text_id": "2", "word_num": 14, "핵심동사": "평행하게", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "103", "label": "대화형", "length": 55, "text": "만약 자기 매질 내에서 2종의 자기 모멘트가 완전히 같을 경우, 전체 정자기 모멘트는 0이 됩니다.", "value": { "text_id": "3", "word_num": 15, "핵심동사": "됩니다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "159", "label": "대화형", "length": 30, "text": "이런 유형의 자기는 질서정연하여 반강자성이라고 합니다.", "value": { "text_id": "4", "word_num": 6, "핵심동사": "합니다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "190", "label": "대화형", "length": 35, "text": "그것은 0도에서 네르 온도 사이의 자화율과 순자성이 비슷합니다.", "value": { "text_id": "5", "word_num": 8, "핵심동사": "비슷합니다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "226", "label": "대화형", "length": 15, "text": "네르 온도에서 가장 큽니다.", "value": { "text_id": "6", "word_num": 4, "핵심동사": "큽니다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "242", "label": "대화형", "length": 33, "text": "반철자기매체는 일반적으로 전이금속화합물, 특히 산화물입니다.", "value": { "text_id": "7", "word_num": 5, "핵심동사": "산화물입니다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "276", "label": "대화형", "length": 48, "text": "비교적 많은 괄, 적철광, 크롬, 철망간 합금, 니켈의 산화물(NiO) 등이 있습니다.", "value": { "text_id": "8", "word_num": 12, "핵심동사": "있습니다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } } ], "dupLabelYn": "Y", "metaData": { "ID": "450122", "FILENAME": "450122.json", "MEDIA_TYPE": "블로그", "MEDIA_NAME": "티스토리 - https://wiselyinfo.com/111", "CATEGORY": "IT과학", "PUBDATE": "20220324", "SENTENCE": "8" } } 