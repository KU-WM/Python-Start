{ "annotation": [ { "charNum": "1", "label": "사실형", "length": 26, "text": "블랙홀은 물질이 스스로 붕괴된 공간의 영역이다.", "value": { "text_id": "1", "word_num": 6, "핵심동사": "영역이다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "27", "label": "사실형", "length": 29, "text": "중력이 너무 강해서 빛조차 빠져나갈 수 없다고 한다.", "value": { "text_id": "2", "word_num": 8, "핵심동사": "빠져나갈", "확실성": "확실", "극성": "부정", "시제": "현재", "key_word": " " } }, { "charNum": "56", "label": "추론형", "length": 39, "text": "빛조차도 탈출할 수 없을 정도로 중력이 강한 천체로 정의할 수 있겠다.", "value": { "text_id": "3", "word_num": 11, "핵심동사": "정의할", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": "정의할" } }, { "charNum": "95", "label": "사실형", "length": 36, "text": "블랙홀은 어떤 커다란 별의 폭발적인 소멸로 인해 나타난다고 본다.", "value": { "text_id": "4", "word_num": 9, "핵심동사": "나타난다고", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "131", "label": "사실형", "length": 23, "text": "거대하고 우리 태양 질량의 수십억 배이다.", "value": { "text_id": "5", "word_num": 6, "핵심동사": "수십억 배이다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "154", "label": "사실형", "length": 42, "text": "은하 중심에서 발견되는블랙홀들이 어떻게 형성되었는지는 아직 알려지지 않았다.", "value": { "text_id": "6", "word_num": 8, "핵심동사": "알려지지", "확실성": "확실", "극성": "부정", "시제": "현재", "key_word": " " } }, { "charNum": "196", "label": "대화형", "length": 31, "text": "블랙홀은 주변 환경에 영향을 미치는 방식으로 감지됩니다.", "value": { "text_id": "7", "word_num": 7, "핵심동사": "감지됩니다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } } ], "dupLabelYn": "Y", "metaData": { "ID": "450095", "FILENAME": "450095.json", "MEDIA_TYPE": "블로그", "MEDIA_NAME": "티스토리 - https://yousim04.com/entry/M87-%EB%B8%94%EB%9E%99%ED%99%80-%EA%B4%80%EC%B8%A1", "CATEGORY": "IT과학", "PUBDATE": "20220901", "SENTENCE": "7" } } 