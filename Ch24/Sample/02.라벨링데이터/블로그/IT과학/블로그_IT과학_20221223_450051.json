{ "annotation": [ { "charNum": "1", "label": "대화형", "length": 50, "text": "네모난 맷돌을 세 개의 프리즘으로 갈아 붙이면 그란 톰슨 프리즘보다 통광 면적이 넓습니다.", "value": { "text_id": "1", "word_num": 13, "핵심동사": "넓습니다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "51", "label": "사실형", "length": 16, "text": "공간의 발산각은 약 26°다.", "value": { "text_id": "2", "word_num": 4, "핵심동사": "26°다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "67", "label": "대화형", "length": 41, "text": "일부 고급 편광현미경의 상,하 편광경에서는 이런 프리즘을 많이 사용합니다.", "value": { "text_id": "3", "word_num": 9, "핵심동사": "사용합니다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "108", "label": "대화형", "length": 34, "text": "쌍상 프리즘은 o, e 두 가지 편광광을 동시에 발생시킵니다.", "value": { "text_id": "4", "word_num": 9, "핵심동사": "발생시킵니다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "142", "label": "대화형", "length": 35, "text": "그러나 이들은 자연방해석능체의 o, e빛보다 분리각도가 큽니다.", "value": { "text_id": "5", "word_num": 7, "핵심동사": "큽니다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "177", "label": "대화형", "length": 30, "text": "양광을 동시에 사용하셔도 되고 따로 사용하셔도 됩니다.", "value": { "text_id": "6", "word_num": 7, "핵심동사": "사용하셔도", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } } ], "dupLabelYn": "Y", "metaData": { "ID": "450051", "FILENAME": "450051.json", "MEDIA_TYPE": "블로그", "MEDIA_NAME": "티스토리 - https://wiselyinfo.com/104", "CATEGORY": "IT과학", "PUBDATE": "20220323", "SENTENCE": "6" } } 