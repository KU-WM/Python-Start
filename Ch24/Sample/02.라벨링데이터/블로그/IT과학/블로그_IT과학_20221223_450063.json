{ "annotation": [ { "charNum": "1", "label": "대화형", "length": 47, "text": "5G란 5세대 무선 통신기술이며 기존 4G인 LTE를 대체하기 위해 만들어 졌습니다.", "value": { "text_id": "1", "word_num": 11, "핵심동사": "만들어 졌습니다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": " " } }, { "charNum": "49", "label": "대화형", "length": 44, "text": "이론상으로는 4G의 속도보다 무려 100배 이상 빠르고 신뢰성이 더욱 높습니다.", "value": { "text_id": "2", "word_num": 10, "핵심동사": "높습니다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "94", "label": "대화형", "length": 31, "text": "하지만 실제 체감상으로는 4-5배 정도 빠르다고 합니다.", "value": { "text_id": "3", "word_num": 7, "핵심동사": "빠르다고", "확실성": "확실", "극성": "미정", "시제": "현재", "key_word": " " } }, { "charNum": "126", "label": "대화형", "length": 26, "text": "5G를 설명할 때 사용하는 세 단어가 있습니다.", "value": { "text_id": "4", "word_num": 7, "핵심동사": "있습니다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "153", "label": "대화형", "length": 22, "text": "바로 초고속, 초저지연, 초연결 입니다.", "value": { "text_id": "5", "word_num": 5, "핵심동사": "입니다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "176", "label": "대화형", "length": 38, "text": "그럼 어떤 기술이 적용되어있고 어떤 문제점이 있는지 같이 살펴볼까요?", "value": { "text_id": "6", "word_num": 9, "핵심동사": "살펴볼까요", "확실성": "확실", "극성": "미정", "시제": "미래", "key_word": " " } } ], "dupLabelYn": "Y", "metaData": { "ID": "450063", "FILENAME": "450063.json", "MEDIA_TYPE": "블로그", "MEDIA_NAME": "티스토리 - https://comptogether.tistory.com/14", "CATEGORY": "IT과학", "PUBDATE": "20211104", "SENTENCE": "6" } } 