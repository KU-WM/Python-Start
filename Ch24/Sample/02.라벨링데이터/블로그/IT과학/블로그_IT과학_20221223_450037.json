{ "annotation": [ { "charNum": "1", "label": "대화형", "length": 22, "text": "개인적으로 강력하게 추천하는 게임입니다.", "value": { "text_id": "1", "word_num": 4, "핵심동사": "게임입니다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "23", "label": "대화형", "length": 47, "text": "다양한 직업을 받아 게임에서 퀘스트를 받는 것 처럼 하나씩 진행하는 특징이 있습니다.", "value": { "text_id": "2", "word_num": 12, "핵심동사": "있습니다", "확실성": "확실", "극성": "미정", "시제": "현재", "key_word": " " } }, { "charNum": "70", "label": "대화형", "length": 75, "text": "물론 현실에서는 실제로는 할 수 없는 손님에게 물건 던지기나 상사한테 깽판 치는 것도 가능하기에 스트레스 해소용으로도 즐길 수 있겠죠?", "value": { "text_id": "3", "word_num": 19, "핵심동사": "즐길", "확실성": "불확실", "극성": "미정", "시제": "미래", "key_word": " " } }, { "charNum": "145", "label": "대화형", "length": 48, "text": "특히 어린 아이들도 쉽게 체험해 볼 수 있는 컨텐츠이기에 추천하는 이유 중 하나입니다.", "value": { "text_id": "4", "word_num": 13, "핵심동사": "하나입니다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "193", "label": "대화형", "length": 73, "text": "현재기준으로 가능한 회사원, 정비사, 편의점점주, 요리사가 되어서 현실뿐만 아닌 가상에도 즐겁게 일해보시는 기회가 되시길 바랍니다.", "value": { "text_id": "5", "word_num": 15, "핵심동사": "바랍니다", "확실성": "확실", "극성": "미정", "시제": "현재", "key_word": " " } } ], "dupLabelYn": "Y", "metaData": { "ID": "450037", "FILENAME": "450037.json", "MEDIA_TYPE": "블로그", "MEDIA_NAME": "티스토리 - https://comptogether.tistory.com/3?category=1002659", "CATEGORY": "IT과학", "PUBDATE": "20211024", "SENTENCE": "5" } } 