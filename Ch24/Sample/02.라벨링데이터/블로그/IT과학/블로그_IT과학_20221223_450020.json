{ "annotation": [ { "charNum": "1", "label": "대화형", "length": 25, "text": "투톤(일명 2방향 색성) 결정으로 진행됩니다.", "value": { "text_id": "1", "word_num": 5, "핵심동사": "진행됩니다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "27", "label": "대화형", "length": 52, "text": "어떤 쌍굴절 결정들은 서로 수직인 두 종류의 편광광에 대해 서로 다른 흡수를 가지고 있습니다.", "value": { "text_id": "2", "word_num": 14, "핵심동사": "가지고", "확실성": "확실", "극성": "미정", "시제": "현재", "key_word": " " } }, { "charNum": "80", "label": "대화형", "length": 42, "text": "예를 들어 전기석은 e광을 흡수하는 것보다 o광을 훨씬 더 크게 흡수합니다.", "value": { "text_id": "3", "word_num": 11, "핵심동사": "흡수합니다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "123", "label": "대화형", "length": 52, "text": "백색광은 1㎜ 두께의 전기석웨이퍼를 거쳐 거의 모든 o광은 흡수되고 e광은 약간만 흡수됩니다.", "value": { "text_id": "4", "word_num": 12, "핵심동사": "흡수됩니다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "176", "label": "대화형", "length": 51, "text": "투과하는 편광광은 약간 황록색을 띠고 있어 흡수가 파장에 대한 의존관계를 충분히 나타냅니다.", "value": { "text_id": "5", "word_num": 12, "핵심동사": "나타냅니다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } } ], "dupLabelYn": "Y", "metaData": { "ID": "450020", "FILENAME": "450020.json", "MEDIA_TYPE": "블로그", "MEDIA_NAME": "티스토리 - https://wiselyinfo.com/104", "CATEGORY": "IT과학", "PUBDATE": "20220323", "SENTENCE": "5" } } 