{ "annotation": [ { "charNum": "1", "label": "대화형", "length": 14, "text": "제목만 보셔도 딱 알겠죠?", "value": { "text_id": "1", "word_num": 4, "핵심동사": "알겠죠", "확실성": "불확실", "극성": "미정", "시제": "현재", "key_word": " " } }, { "charNum": "16", "label": "대화형", "length": 19, "text": "바로 VR에서 즐기는 채팅방입니다.", "value": { "text_id": "2", "word_num": 4, "핵심동사": "채팅방입니다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "36", "label": "대화형", "length": 89, "text": "물론 이 채팅방은 키보드를 이용한 텍스트가 아니라 마이크를 이용한 목소리로 대화하고 거기에 몸짓까지 추가하여 다양한 방식으로 다른 사용자와 대화할 수 있습니다.", "value": { "text_id": "3", "word_num": 21, "핵심동사": "대화할", "확실성": "확실", "극성": "미정", "시제": "현재", "key_word": " " } }, { "charNum": "126", "label": "대화형", "length": 71, "text": "맵과 아바타의 가짓 수도 많으며 본인만의 것도 만들고 배포할 수 있으며, 정말 다양한 나라의 사람들과 만나 소통할 수 있습니다.", "value": { "text_id": "4", "word_num": 19, "핵심동사": "소통할", "확실성": "확실", "극성": "미정", "시제": "현재", "key_word": " " } }, { "charNum": "198", "label": "대화형", "length": 57, "text": "보통은 영어로 많이 대화하지만 한국 유저와 맵도 꽤 있어서 찾아보시면 재밌는 시간을 보낼 수 있습니다.", "value": { "text_id": "5", "word_num": 15, "핵심동사": "보낼", "확실성": "확실", "극성": "미정", "시제": "현재", "key_word": " " } }, { "charNum": "256", "label": "대화형", "length": 60, "text": "그 외에 영화나 저스트 댄스 등을 같이 하는 등 어쩌면 비대면 시대에 딱 맞는 게임이라고도 볼 수 있겠네요.", "value": { "text_id": "6", "word_num": 18, "핵심동사": "볼", "확실성": "확실", "극성": "미정", "시제": "현재", "key_word": " " } } ], "dupLabelYn": "Y", "metaData": { "ID": "450074", "FILENAME": "450074.json", "MEDIA_TYPE": "블로그", "MEDIA_NAME": "티스토리 - https://comptogether.tistory.com/3?category=1002659", "CATEGORY": "IT과학", "PUBDATE": "20211024", "SENTENCE": "6" } } 