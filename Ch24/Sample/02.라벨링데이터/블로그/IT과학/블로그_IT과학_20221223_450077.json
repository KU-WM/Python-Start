{ "annotation": [ { "charNum": "1", "label": "사실형", "length": 50, "text": "메타버스란 META(가상, 초월)와 Universe(우주)를 뜻하는 두 단어의 합성어이다.", "value": { "text_id": "1", "word_num": 8, "핵심동사": "합성어이다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "51", "label": "대화형", "length": 32, "text": "쉽게 말해 현실을 초월한 가상세계라고 정의할 수 있습니다.", "value": { "text_id": "2", "word_num": 8, "핵심동사": "정의할", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "83", "label": "사실형", "length": 53, "text": "앞서 우리는 메타버스 속에서 살아간다고 했지만 너무나 당연한 일상이 되어 인지하지 못하고 있다.", "value": { "text_id": "3", "word_num": 13, "핵심동사": "인지하지", "확실성": "확실", "극성": "부정", "시제": "현재", "key_word": " " } }, { "charNum": "136", "label": "사실형", "length": 40, "text": "참고로 저는 아침에 눈을 뜨면 인스타그램을 키고 타인의 일상을 확인한다.", "value": { "text_id": "4", "word_num": 10, "핵심동사": "확인한다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "176", "label": "사실형", "length": 46, "text": "뿐만 아니라 페이스북, 트위터 등 다양한 sns플랫폼을 통해 나의 일상을 공유한다.", "value": { "text_id": "5", "word_num": 11, "핵심동사": "공유한다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "222", "label": "사실형", "length": 21, "text": "이것은 라이프로깅 메타버스라고 부른다.", "value": { "text_id": "6", "word_num": 4, "핵심동사": "부른다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "243", "label": "사실형", "length": 40, "text": "비영리 기술 연구단체 ASF에 따르면 메타버스는 크게 4가지로 분류한다.", "value": { "text_id": "7", "word_num": 9, "핵심동사": "분류한다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } } ], "dupLabelYn": "Y", "metaData": { "ID": "450077", "FILENAME": "450077.json", "MEDIA_TYPE": "블로그", "MEDIA_NAME": "티스토리 - https://sonnyisback.tistory.com/115", "CATEGORY": "IT과학", "PUBDATE": "20220713", "SENTENCE": "7" } } 