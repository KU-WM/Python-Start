{ "annotation": [ { "charNum": "1", "label": "대화형", "length": 61, "text": "40여년 가까이 지속된 몽고(원)와의 항쟁을 화친으로 마무리한 고려는 원으로부터 여러 간섭에 시달리게 됩니다.", "value": { "text_id": "1", "word_num": 14, "핵심동사": "시달리게", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "64", "label": "대화형", "length": 44, "text": "참고로 몽고는 ＇원종 12년(1271년)＇ 국호를 몽고에서 ＇원＇으로 바꿉니다.", "value": { "text_id": "2", "word_num": 11, "핵심동사": "바꿉니다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "112", "label": "대화형", "length": 32, "text": "먼저 고려의 일부 영토를 원의 직할령으로 만들어 버립니다.", "value": { "text_id": "3", "word_num": 9, "핵심동사": "만들어", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "146", "label": "대화형", "length": 49, "text": "제주도의 ＇탐라총관부＇, 영흥 지방의 ＇쌍성총관부＇, 평양지방의 ＇동녕부＇가 그것입니다.", "value": { "text_id": "4", "word_num": 9, "핵심동사": "그것입니다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "197", "label": "대화형", "length": 94, "text": "탐라총관부의 경우 목마장을 두었으며, 쌍성총관부는 철령 이북의 땅을, 동녕부는 자비령 이북의 땅을 관할하였으나, 동녕부와 탐라총관부는 고려가 나중에 되찾아 오게 됩니다.", "value": { "text_id": "5", "word_num": 23, "핵심동사": "되찾아", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } } ], "dupLabelYn": "Y", "metaData": { "ID": "410229", "FILENAME": "410229.json", "MEDIA_TYPE": "블로그", "MEDIA_NAME": "티스토리 - https://latebloomer2022.com/entry/24-%EC%9B%90-%EA%B0%84%EC%84%AD%EA%B8%B0?category=1080209", "CATEGORY": "역사", "PUBDATE": "20220612", "SENTENCE": "5" } } 