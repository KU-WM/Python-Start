{ "annotation": [ { "charNum": "1", "label": "추론형", "length": 32, "text": "1987년 이후 한국은 세계가 놀랄 만한 성장을 이루었다.", "value": { "text_id": "1", "word_num": 8, "핵심동사": "이루었다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "성장을" } }, { "charNum": "33", "label": "추론형", "length": 34, "text": "2012년을 기준으로 한국의 경제 규모는 세계에서 15위이다.", "value": { "text_id": "2", "word_num": 7, "핵심동사": "15위이다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "세계에서" } }, { "charNum": "67", "label": "추론형", "length": 34, "text": "국민소득도 1인당 2만 3000달러를 넘어서 세계 34위이다.", "value": { "text_id": "3", "word_num": 7, "핵심동사": "34위이다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "세계" } }, { "charNum": "101", "label": "추론형", "length": 47, "text": "삼성전자, 현대자동차, LG, POSCO 등은 전 세계에 널리 알려진 기업이 되었다.", "value": { "text_id": "4", "word_num": 11, "핵심동사": "되었다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "기업이" } }, { "charNum": "148", "label": "추론형", "length": 40, "text": "2013년 현재 한국인들은 국민의 직접 선거로 평화롭게 대통령을 뽑는다.", "value": { "text_id": "5", "word_num": 9, "핵심동사": "뽑는다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "대통령을" } }, { "charNum": "188", "label": "추론형", "length": 65, "text": "노태우, 김영삼, 김대중, 노무현, 이명박, 박근혜 등 전두환 이후 모든 대통령들은 국민이 직접 투표를 하여 뽑았다.", "value": { "text_id": "6", "word_num": 16, "핵심동사": "뽑았다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "투표를" } }, { "charNum": "253", "label": "추론형", "length": 63, "text": "이것은 4·19혁명으로 생겨난 민주주의의 싹이 수많은 사람들의 노력과 고통 속에서 자랑스럽게 맺은 열매일 것이다.", "value": { "text_id": "7", "word_num": 14, "핵심동사": "열매일", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "맺은/것이다" } }, { "charNum": "316", "label": "추론형", "length": 38, "text": "현재의 한국은 경제적 발전과 민주주의의 발전을 동시에 이룬 나라이다.", "value": { "text_id": "8", "word_num": 9, "핵심동사": "나라이다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "이룬" } }, { "charNum": "354", "label": "추론형", "length": 40, "text": "세계가 한국의 발전에 큰 관심을 갖는 것도 바로 이런 점 때문일 것이다.", "value": { "text_id": "9", "word_num": 12, "핵심동사": "때문일", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "것이다" } } ], "dupLabelYn": "Y", "metaData": { "ID": "310195", "FILENAME": "310195.json", "MEDIA_TYPE": "도서", "MEDIA_NAME": "커뮤니케이션북스", "CATEGORY": "역사", "PUBDATE": "41628", "SENTENCE": "9" } } 