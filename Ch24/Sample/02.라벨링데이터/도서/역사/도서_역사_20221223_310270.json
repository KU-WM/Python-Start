{ "annotation": [ { "charNum": "1", "label": "추론형", "length": 25, "text": "형 김동한은 망설이지 않고 그러겠다고 했다. ", "value": { "text_id": "1", "word_num": 7, "핵심동사": "했다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "그러겠다고" } }, { "charNum": "26", "label": "추론형", "length": 26, "text": "하지만 김수환은 얼른 대답을 할 수가 없었다. ", "value": { "text_id": "2", "word_num": 8, "핵심동사": "할", "확실성": "확실", "극성": "부정", "시제": "과거", "key_word": "수가/없었다" } }, { "charNum": "52", "label": "추론형", "length": 27, "text": "신부가 되면 사람들의 존경을 받을 수는 있었다. ", "value": { "text_id": "3", "word_num": 8, "핵심동사": "받을", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "수는/있었다" } }, { "charNum": "79", "label": "추론형", "length": 26, "text": "하지만 신부가 되면 돈을 많이 벌기 어려웠다. ", "value": { "text_id": "4", "word_num": 8, "핵심동사": "어려웠다", "확실성": "확실", "극성": "부정", "시제": "과거", "key_word": "벌기" } }, { "charNum": "105", "label": "추론형", "length": 22, "text": "게다가 어머니를 모시기는 더욱 어려웠다.", "value": { "text_id": "5", "word_num": 5, "핵심동사": "어려웠다", "확실성": "확실", "극성": "부정", "시제": "과거", "key_word": "더욱" } } ], "dupLabelYn": "Y", "metaData": { "ID": "310270", "FILENAME": "310270.json", "MEDIA_TYPE": "도서", "MEDIA_NAME": "커뮤니케이션북스", "CATEGORY": "역사", "PUBDATE": "20130225", "SENTENCE": "5" } } 