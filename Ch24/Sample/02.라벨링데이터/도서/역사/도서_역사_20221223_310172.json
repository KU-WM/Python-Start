{ "annotation": [ { "charNum": "1", "label": "추론형", "length": 40, "text": "그런데 유엔군이 북한 지역까지 공격하자 중국이 전쟁에 참여하기 시작했다.", "value": { "text_id": "1", "word_num": 9, "핵심동사": "시작했다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "참여하기" } }, { "charNum": "41", "label": "추론형", "length": 38, "text": "중국은 같은 공산주의 나라인 북한을 유엔군이 차지하게 둘 수 없었다.", "value": { "text_id": "2", "word_num": 10, "핵심동사": "둘", "확실성": "확실", "극성": "부정", "시제": "과거", "key_word": "차지하게/수/없었다" } }, { "charNum": "79", "label": "추론형", "length": 31, "text": "중국은 20만 명이 넘는 군대를 보내 유엔군을 공격했다.", "value": { "text_id": "3", "word_num": 8, "핵심동사": "공격했다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "유엔군을" } }, { "charNum": "110", "label": "추론형", "length": 40, "text": "남한과 유엔군의 승리로 거의 끝날 것 같던 전쟁이 다시 시작되는 듯했다.", "value": { "text_id": "4", "word_num": 11, "핵심동사": "시작되는", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "듯했다" } }, { "charNum": "150", "label": "추론형", "length": 40, "text": "한국군과 유엔군은 중국군의 공격에 밀려 다시 한반도의 남쪽으로 쫓겨났다.", "value": { "text_id": "5", "word_num": 9, "핵심동사": "쫓겨났다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "다시" } }, { "charNum": "190", "label": "추론형", "length": 26, "text": "1951년 1월 4일에는 다시 서울을 빼앗겼다.", "value": { "text_id": "6", "word_num": 6, "핵심동사": "빼앗겼다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "서울을" } }, { "charNum": "216", "label": "추론형", "length": 51, "text": "이때부터 한반도의 중간 지역을 사이에 두고 중국군과 유엔군 사이의 전투가 계속해서 이어졌다.", "value": { "text_id": "7", "word_num": 12, "핵심동사": "이어졌다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "계속해서" } }, { "charNum": "267", "label": "추론형", "length": 37, "text": "양쪽은 서로 승리와 패배를 주고받으며 뒤로 밀리지 않으려고 애썼다.", "value": { "text_id": "8", "word_num": 9, "핵심동사": "애썼다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "밀리지/않으려고" } } ], "dupLabelYn": "Y", "metaData": { "ID": "310172", "FILENAME": "310172.json", "MEDIA_TYPE": "도서", "MEDIA_NAME": "커뮤니케이션북스", "CATEGORY": "역사", "PUBDATE": "41628", "SENTENCE": "8" } } 