{ "annotation": [ { "charNum": "1", "label": "추론형", "length": 48, "text": "추기경으로 임명되고 난 후 김수환에게는 전보다 더 큰 용기가 필요한 일들이 많아졌다. ", "value": { "text_id": "1", "word_num": 13, "핵심동사": "많아졌다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "필요한/일들이" } }, { "charNum": "49", "label": "추론형", "length": 22, "text": "1970년대 한국은 매우 혼란스러웠다. ", "value": { "text_id": "2", "word_num": 5, "핵심동사": "혼란스러웠다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "매우" } }, { "charNum": "71", "label": "추론형", "length": 29, "text": "정부가 국민을 무시하고 억누르려고 했기 때문이었다. ", "value": { "text_id": "3", "word_num": 7, "핵심동사": "때문이었다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "억누르려고" } }, { "charNum": "100", "label": "추론형", "length": 26, "text": "힘없는 국민들은 정부에 맞서며 고통을 당했다. ", "value": { "text_id": "4", "word_num": 7, "핵심동사": "당했다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "고통을" } }, { "charNum": "126", "label": "추론형", "length": 28, "text": "가톨릭은 국민들의 고통을 함께 나누려고 노력했다. ", "value": { "text_id": "5", "word_num": 7, "핵심동사": "노력했다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "나누려고" } }, { "charNum": "154", "label": "추론형", "length": 24, "text": "정부를 따르는 사람들은 가톨릭을 비난했다. ", "value": { "text_id": "6", "word_num": 6, "핵심동사": "비난했다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "가톨릭을" } }, { "charNum": "178", "label": "추론형", "length": 34, "text": "종교가 사회에 지나치게 관심을 갖는 것은 옳지 않다고 했다. ", "value": { "text_id": "7", "word_num": 10, "핵심동사": "했다", "확실성": "확실", "극성": "부정", "시제": "과거", "key_word": "옳지/않다고" } } ], "dupLabelYn": "Y", "metaData": { "ID": "310335", "FILENAME": "310335.json", "MEDIA_TYPE": "도서", "MEDIA_NAME": "커뮤니케이션북스", "CATEGORY": "역사", "PUBDATE": "20130225", "SENTENCE": "7" } } 