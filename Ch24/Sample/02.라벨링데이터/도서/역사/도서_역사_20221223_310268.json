{ "annotation": [ { "charNum": "1", "label": "추론형", "length": 17, "text": "김수환은 8남매 중 막내였다. ", "value": { "text_id": "1", "word_num": 5, "핵심동사": "막내였다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "김수환은" } }, { "charNum": "18", "label": "추론형", "length": 24, "text": "김수환은 어머니가 고생하는 것이 속상했다. ", "value": { "text_id": "2", "word_num": 6, "핵심동사": "속상했다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "고생하는 것이" } }, { "charNum": "42", "label": "추론형", "length": 33, "text": "김수환은 어머니에게 효도하기 위해 돈을 많이 벌고 싶었다. ", "value": { "text_id": "3", "word_num": 9, "핵심동사": "벌고", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "싶었다" } }, { "charNum": "75", "label": "추론형", "length": 30, "text": "돈을 많이 벌려면 장사를 하는 것이 좋을 것 같았다. ", "value": { "text_id": "4", "word_num": 10, "핵심동사": "좋을", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "것/같았다" } }, { "charNum": "105", "label": "추론형", "length": 23, "text": "그리고 결혼도 일찍 해야 할 것 같았다. ", "value": { "text_id": "5", "word_num": 8, "핵심동사": "해야", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "할/것/같았다" } }, { "charNum": "128", "label": "추론형", "length": 29, "text": "김수환은 부자가 되어 어머니를 편하게 모시고 싶었다.", "value": { "text_id": "6", "word_num": 7, "핵심동사": "모시고", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "싶었다" } } ], "dupLabelYn": "Y", "metaData": { "ID": "310268", "FILENAME": "310268.json", "MEDIA_TYPE": "도서", "MEDIA_NAME": "커뮤니케이션북스", "CATEGORY": "역사", "PUBDATE": "20130225", "SENTENCE": "6" } } 