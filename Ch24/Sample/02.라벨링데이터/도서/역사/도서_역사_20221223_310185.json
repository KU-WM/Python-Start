{ "annotation": [ { "charNum": "1", "label": "추론형", "length": 19, "text": "국민들은 더 이상 참을 수 없었다.", "value": { "text_id": "1", "word_num": 6, "핵심동사": "참을", "확실성": "확실", "극성": "부정", "시제": "과거", "key_word": "수/없었다" } }, { "charNum": "20", "label": "추론형", "length": 40, "text": "사람들은 새로 바뀐 헌법이 옳지 않으며 박정희가 물러나야 한다고 외쳤다.", "value": { "text_id": "2", "word_num": 10, "핵심동사": "외쳐다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "물러나야/한다고" } }, { "charNum": "60", "label": "추론형", "length": 18, "text": "하지만 박정희는 물러나지 않았다.", "value": { "text_id": "3", "word_num": 4, "핵심동사": "물러나지", "확실성": "확실", "극성": "부정", "시제": "과거", "key_word": "않았다" } }, { "charNum": "78", "label": "추론형", "length": 46, "text": "그는 자신을 반대하는 많은 사람들에게 억울한 누명을 씌워 죽이거나 감옥에 가두었다.", "value": { "text_id": "4", "word_num": 11, "핵심동사": "가두었다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "감옥에" } }, { "charNum": "124", "label": "추론형", "length": 42, "text": "상황이 점점 나빠지자 한국 사회 전체에서 박정희를 반대하는 시위가 일어났다.", "value": { "text_id": "5", "word_num": 10, "핵심동사": "일어났다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "시위가" } }, { "charNum": "166", "label": "추론형", "length": 19, "text": "가장 먼저 학생들이 시위를 벌였다.", "value": { "text_id": "6", "word_num": 5, "핵심동사": "벌였다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "시위를" } }, { "charNum": "185", "label": "추론형", "length": 38, "text": "그리고 가톨릭 신부들과 작가, 지식인들, 정치인들이 시위에 참여했다.", "value": { "text_id": "7", "word_num": 8, "핵심동사": "참여했다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "시위에" } }, { "charNum": "223", "label": "추론형", "length": 28, "text": "노동자들도 자신의 권리를 주장하며 강하게 저항했다.", "value": { "text_id": "8", "word_num": 6, "핵심동사": "저항했다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "강하게" } }, { "charNum": "251", "label": "추론형", "length": 45, "text": "하지만 박정희는 시위하는 사람들을 무서운 힘으로 억누르며 자신의 뜻대로 행동했다.", "value": { "text_id": "9", "word_num": 10, "핵심동사": "행동했다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "뜻대로" } } ], "dupLabelYn": "Y", "metaData": { "ID": "310185", "FILENAME": "310185.json", "MEDIA_TYPE": "도서", "MEDIA_NAME": "커뮤니케이션북스", "CATEGORY": "역사", "PUBDATE": "41628", "SENTENCE": "9" } } 