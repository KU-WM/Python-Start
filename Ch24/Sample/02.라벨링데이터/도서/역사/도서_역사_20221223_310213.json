{ "annotation": [ { "charNum": "1", "label": "추론형", "length": 42, "text": "선덕여왕이 신분이 낮은 사람에게 높은 벼슬을 주려고 하자 신하들은 반대했다.", "value": { "text_id": "1", "word_num": 10, "핵심동사": "반대했다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "신하들은" } }, { "charNum": "43", "label": "대화형", "length": 16, "text": "＂그것은 안 되는 일입니다.＂", "value": { "text_id": "2", "word_num": 4, "핵심동사": "되는", "확실성": "확실", "극성": "부정", "시제": "현재", "key_word": " " } }, { "charNum": "59", "label": "대화형", "length": 35, "text": "＂여왕님, 낮은 신분의 사람에게 높은 벼슬을 주면 안 됩니다.＂", "value": { "text_id": "3", "word_num": 9, "핵심동사": "주면", "확실성": "확실", "극성": "부정", "시제": "현재", "key_word": " " } }, { "charNum": "94", "label": "추론형", "length": 21, "text": "신하들이 선덕여왕에게 반대하며 말했다.", "value": { "text_id": "4", "word_num": 4, "핵심동사": "말했다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "반대하며" } }, { "charNum": "115", "label": "대화형", "length": 42, "text": "＂능력이 있는 사람에게 기회를 주는 것은 신라에도 큰 이익이 될 것입니다.＂", "value": { "text_id": "5", "word_num": 11, "핵심동사": "될", "확실성": "확실", "극성": "긍정", "시제": "미래", "key_word": " " } }, { "charNum": "157", "label": "대화형", "length": 18, "text": "＂제발 제 뜻을 따라 주십시오.＂", "value": { "text_id": "6", "word_num": 5, "핵심동사": "주십시오", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "175", "label": "추론형", "length": 22, "text": "선덕여왕은 반대하는 신하들을 설득했다. ", "value": { "text_id": "7", "word_num": 5, "핵심동사": "설득했다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "신하들을" } }, { "charNum": "197", "label": "추론형", "length": 41, "text": "그리고 능력은 있지만 신분이 낮은 김유신과 김춘추에게 높은 벼슬을 주었다.", "value": { "text_id": "8", "word_num": 10, "핵심동사": "주었다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "벼슬을" } } ], "dupLabelYn": "Y", "metaData": { "ID": "310213", "FILENAME": "310213.json", "MEDIA_TYPE": "도서", "MEDIA_NAME": "커뮤니케이션북스", "CATEGORY": "역사", "PUBDATE": "20131237", "SENTENCE": "8" } } 