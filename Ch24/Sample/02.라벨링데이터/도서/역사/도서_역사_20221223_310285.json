{ "annotation": [ { "charNum": "1", "label": "추론형", "length": 28, "text": "김수환은 당연히 학교에서 쫓겨날 것이라고 생각했다.", "value": { "text_id": "1", "word_num": 6, "핵심동사": "생각했다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "쫓겨날/것이라고" } }, { "charNum": "29", "label": "추론형", "length": 19, "text": "처음에는 신부가 되고 싶지 않았다.", "value": { "text_id": "2", "word_num": 5, "핵심동사": "되고", "확실성": "확실", "극성": "부정", "시제": "과거", "key_word": "싶지/않았다" } }, { "charNum": "48", "label": "추론형", "length": 27, "text": "하지만 오래 고민해서 신부가 되기로 마음먹었다. ", "value": { "text_id": "3", "word_num": 7, "핵심동사": "마음먹었다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "되기로" } }, { "charNum": "75", "label": "추론형", "length": 27, "text": "그런데 이제 쫓겨난다고 생각하니 마음이 아팠다. ", "value": { "text_id": "4", "word_num": 7, "핵심동사": "아팠다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "마음이" } }, { "charNum": "102", "label": "추론형", "length": 27, "text": "며칠 후 방학이 되어 김수환은 집으로 돌아갔다. ", "value": { "text_id": "5", "word_num": 8, "핵심동사": "돌아갔다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "집으로" } }, { "charNum": "129", "label": "추론형", "length": 27, "text": "김수환은 퇴학을 알리는 편지가 오기를 기다렸다. ", "value": { "text_id": "6", "word_num": 7, "핵심동사": "기다렸다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "오기를" } }, { "charNum": "156", "label": "추론형", "length": 24, "text": "하지만 방학이 끝나도 편지는 오지 않았다. ", "value": { "text_id": "7", "word_num": 7, "핵심동사": "오지", "확실성": "확실", "극성": "부정", "시제": "과거", "key_word": "않았다" } }, { "charNum": "180", "label": "추론형", "length": 25, "text": "다음 해에 김수환은 무사히 신학교를 졸업했다.", "value": { "text_id": "8", "word_num": 6, "핵심동사": "졸업했다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "신학교를" } } ], "dupLabelYn": "Y", "metaData": { "ID": "310285", "FILENAME": "310285.json", "MEDIA_TYPE": "도서", "MEDIA_NAME": "커뮤니케이션북스", "CATEGORY": "역사", "PUBDATE": "20130225", "SENTENCE": "8" } } 