{ "annotation": [ { "charNum": "1", "label": "추론형", "length": 28, "text": "어머니는 혼자서 아이들을 키우느라 항상 힘들었다. ", "value": { "text_id": "1", "word_num": 7, "핵심동사": "힘들었다", "확실성": "확실", "극성": "부정", "시제": "과거", "key_word": "항상" } }, { "charNum": "29", "label": "추론형", "length": 23, "text": "하루 종일 장사를 하고 밤늦게 돌아왔다. ", "value": { "text_id": "2", "word_num": 7, "핵심동사": "돌아왔다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "밤늦게" } }, { "charNum": "52", "label": "추론형", "length": 18, "text": "돈을 벌 사람은 어머니뿐이었다. ", "value": { "text_id": "3", "word_num": 5, "핵심동사": "어머니뿐이었다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "사람은" } }, { "charNum": "70", "label": "추론형", "length": 24, "text": "아버지는 김수환이 네 살 때 병이 들었다. ", "value": { "text_id": "4", "word_num": 8, "핵심동사": "들었다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "병이" } }, { "charNum": "94", "label": "추론형", "length": 33, "text": "아버지는 계 속 앓다가 김수환이 여덟 살 때 돌아 가셨다. ", "value": { "text_id": "5", "word_num": 11, "핵심동사": "돌아가셨다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "앓다가" } }, { "charNum": "127", "label": "추론형", "length": 38, "text": "어머니는 아버지를 원망하지 않았고 아무리 힘들어도 불평하지 않았다. ", "value": { "text_id": "6", "word_num": 9, "핵심동사": "불평하지", "확실성": "확실", "극성": "부정", "시제": "과거", "key_word": "않았다" } } ], "dupLabelYn": "Y", "metaData": { "ID": "310267", "FILENAME": "310267.json", "MEDIA_TYPE": "도서", "MEDIA_NAME": "커뮤니케이션북스", "CATEGORY": "역사", "PUBDATE": "20130225", "SENTENCE": "6" } } 