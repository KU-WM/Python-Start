{ "annotation": [ { "charNum": "1", "label": "추론형", "length": 49, "text": "덕만 공주는 왕이 되기에 부족함이 없었지만, 여왕을 인정할 수 없다는 귀족들이 많았다. ", "value": { "text_id": "1", "word_num": 13, "핵심동사": "많았다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "귀족들이" } }, { "charNum": "50", "label": "추론형", "length": 24, "text": "지금까지 신라에 여왕이 없었기 때문이었다. ", "value": { "text_id": "2", "word_num": 6, "핵심동사": "때문이었다", "확실성": "확실", "극성": "부정", "시제": "과거", "key_word": "없었기" } }, { "charNum": "74", "label": "추론형", "length": 40, "text": "그래서 진평왕은 덕만 공주를 왕으로 만들기 위해 여러 가지를 준비했다. ", "value": { "text_id": "3", "word_num": 11, "핵심동사": "준비했다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "그래서/위해" } }, { "charNum": "114", "label": "추론형", "length": 39, "text": "가장 먼저 덕만 공주에게 적이 될 만한 사람을 없애기 위해 노력했다. ", "value": { "text_id": "4", "word_num": 12, "핵심동사": "노력했다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "없애기/위해" } }, { "charNum": "153", "label": "추론형", "length": 58, "text": "진평왕은 둘째 공주의 남편에게 왕 다음으로 높은 자리를 주고 그에게 덕만 공주를 보호해 달라고 부탁했다.", "value": { "text_id": "5", "word_num": 15, "핵심동사": "부탁했다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "보호해/달라고" } } ], "dupLabelYn": "Y", "metaData": { "ID": "310203", "FILENAME": "310203.json", "MEDIA_TYPE": "도서", "MEDIA_NAME": "커뮤니케이션북스", "CATEGORY": "역사", "PUBDATE": "20131227", "SENTENCE": "5" } } 