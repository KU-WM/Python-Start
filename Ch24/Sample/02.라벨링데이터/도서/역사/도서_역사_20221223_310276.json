{ "annotation": [ { "charNum": "1", "label": "추론형", "length": 18, "text": "어느 날 좋은 생각이 떠올랐다. ", "value": { "text_id": "1", "word_num": 6, "핵심동사": "떠올랐다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "생각이" } }, { "charNum": "19", "label": "추론형", "length": 28, "text": "학교의 규칙을 어겨서 쫓겨나면 된다는 생각이었다. ", "value": { "text_id": "2", "word_num": 7, "핵심동사": "생각이었다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "된다는" } }, { "charNum": "47", "label": "추론형", "length": 21, "text": "신학교에는 여러 가지 규칙이 있었다. ", "value": { "text_id": "3", "word_num": 6, "핵심동사": "있었다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "규칙이" } }, { "charNum": "68", "label": "추론형", "length": 29, "text": "그중에 돈을 갖고 있으면 안 된다는 규칙이 있었다. ", "value": { "text_id": "4", "word_num": 9, "핵심동사": "있었다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "규칙이" } }, { "charNum": "97", "label": "추론형", "length": 31, "text": "돈을 갖고 있다가 들키면 당장 학교에서 쫓겨나야 했다. ", "value": { "text_id": "5", "word_num": 9, "핵심동사": "쫓겨나야", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "했다" } }, { "charNum": "128", "label": "추론형", "length": 25, "text": "주머니 속을 보니 마침 동전이 하나 있었다. ", "value": { "text_id": "6", "word_num": 8, "핵심동사": "있었다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "하나" } }, { "charNum": "153", "label": "추론형", "length": 20, "text": "김수환은 동전을 서랍 속에 넣었다. ", "value": { "text_id": "7", "word_num": 6, "핵심동사": "넣었다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "속에" } }, { "charNum": "173", "label": "추론형", "length": 27, "text": "서랍을 열기만 하면 바로 동전을 볼 수 있었다. ", "value": { "text_id": "8", "word_num": 9, "핵심동사": "볼", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "수/있었다" } }, { "charNum": "200", "label": "추론형", "length": 27, "text": "김수환은 선생님이 서랍 속을 살피기를 기다렸다. ", "value": { "text_id": "9", "word_num": 7, "핵심동사": "기다렸다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "살피기를" } }, { "charNum": "227", "label": "추론형", "length": 23, "text": "그리고 자기의 이름을 부르기를 기다렸다. ", "value": { "text_id": "10", "word_num": 6, "핵심동사": "기다렸다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "부르기를" } }, { "charNum": "250", "label": "추론형", "length": 32, "text": "하지만 아무리 기다려도 선생님은 김수환을 부르지 않았다. ", "value": { "text_id": "11", "word_num": 8, "핵심동사": "부르지", "확실성": "확실", "극성": "부정", "시제": "과거", "key_word": "않았다" } }, { "charNum": "282", "label": "추론형", "length": 16, "text": "며칠이 지나도 마찬가지였다. ", "value": { "text_id": "12", "word_num": 4, "핵심동사": "마찬가지였다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "지나도" } }, { "charNum": "298", "label": "추론형", "length": 31, "text": "김수환은 몹시 실망해서 동전을 꺼내 던져 버리고 말았다.", "value": { "text_id": "13", "word_num": 8, "핵심동사": "던져", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "버리고" } } ], "dupLabelYn": "Y", "metaData": { "ID": "310276", "FILENAME": "310276.json", "MEDIA_TYPE": "도서", "MEDIA_NAME": "커뮤니케이션북스", "CATEGORY": "역사", "PUBDATE": "20130225", "SENTENCE": "13" } } 