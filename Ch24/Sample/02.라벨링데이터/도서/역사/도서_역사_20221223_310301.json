{ "annotation": [ { "charNum": "1", "label": "추론형", "length": 37, "text": "아주 가난한 사람들에게는 더 특별한 방법으로 돈을 나누어 주었다. ", "value": { "text_id": "1", "word_num": 10, "핵심동사": "주었다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "돈을/나누어" } }, { "charNum": "38", "label": "추론형", "length": 26, "text": "천주교 신자는 모두 ＇고해성사＇를 해야 했다. ", "value": { "text_id": "2", "word_num": 7, "핵심동사": "해야", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "했다" } }, { "charNum": "64", "label": "추론형", "length": 41, "text": "고해성사는 자신의 잘못을 신부를 통해 하느님께 고백하고 뉘우치는 것이다. ", "value": { "text_id": "3", "word_num": 10, "핵심동사": "뉘우치는", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": "고백하고" } }, { "charNum": "105", "label": "추론형", "length": 28, "text": "그러니까 고해성사의 내용은 비밀인 것이 당연했다. ", "value": { "text_id": "4", "word_num": 7, "핵심동사": "당연했다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "비밀인" } }, { "charNum": "133", "label": "추론형", "length": 33, "text": "안동 성당의 신자들도 김수환에게 고해성사를 하러 찾아왔다. ", "value": { "text_id": "5", "word_num": 8, "핵심동사": "찾아왔다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "신자들도" } }, { "charNum": "166", "label": "추론형", "length": 41, "text": "김수환은 신자들이 고해성사를 하러 오면 그들의 처지에 맞게 돈을 주었다. ", "value": { "text_id": "6", "word_num": 11, "핵심동사": "주었다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "처지에/맞게" } }, { "charNum": "207", "label": "추론형", "length": 23, "text": "그리고 돈 받은 것을 비밀로 하게 했다. ", "value": { "text_id": "7", "word_num": 8, "핵심동사": "하게", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "비밀로/했다" } }, { "charNum": "230", "label": "추론형", "length": 35, "text": "나누어 준 돈 때문에 신자들이 다툴까 봐 걱정했기 때문이었다. ", "value": { "text_id": "8", "word_num": 10, "핵심동사": "때문이었다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "걱정했기" } }, { "charNum": "265", "label": "추론형", "length": 41, "text": "신자들은 고해성사를 하러 갔다가 신부인 김수환이 돈을 주자 크게 놀랐다. ", "value": { "text_id": "9", "word_num": 11, "핵심동사": "놀랐다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "크게" } }, { "charNum": "306", "label": "추론형", "length": 26, "text": "하지만 그 이유를 알고서 모두가 비밀을 지켰다.", "value": { "text_id": "10", "word_num": 7, "핵심동사": "지켰다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "비밀을" } } ], "dupLabelYn": "Y", "metaData": { "ID": "310301", "FILENAME": "310301.json", "MEDIA_TYPE": "도서", "MEDIA_NAME": "커뮤니케이션북스", "CATEGORY": "역사", "PUBDATE": "20130225", "SENTENCE": "10" } } 