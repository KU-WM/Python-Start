{ "annotation": [ { "charNum": "1", "label": "추론형", "length": 33, "text": "1979년 10월 26일, 김수환은 로마 교황청에 있었다. ", "value": { "text_id": "1", "word_num": 8, "핵심동사": "있었다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "교황청에" } }, { "charNum": "34", "label": "추론형", "length": 39, "text": "그런데 그곳에서 한국 대통령이 죽임을 당했다는 놀라운 소식을 들었다. ", "value": { "text_id": "2", "word_num": 10, "핵심동사": "들었다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "소식을" } }, { "charNum": "73", "label": "추론형", "length": 32, "text": "김수환은 대통령의 장례식을 위해 얼른 한국으로 돌아왔다. ", "value": { "text_id": "3", "word_num": 8, "핵심동사": "돌아왔다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "한국으로" } }, { "charNum": "105", "label": "추론형", "length": 16, "text": "김수환은 장례식에서 말했다. ", "value": { "text_id": "4", "word_num": 4, "핵심동사": "말했다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "장례식에서" } }, { "charNum": "121", "label": "대화형", "length": 30, "text": "＂돌아가신 대통령께서는 분명히 나라를 사랑하셨습니다.＂", "value": { "text_id": "5", "word_num": 5, "핵심동사": "사랑하셨습니다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": " " } }, { "charNum": "151", "label": "대화형", "length": 21, "text": "＂나라를 위해 많은 일을 하셨습니다.＂", "value": { "text_id": "6", "word_num": 5, "핵심동사": "하셨습니다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": " " } }, { "charNum": "172", "label": "대화형", "length": 33, "text": "＂하지만 하느님이 원하는 나라는 국민이 주인인 나라입니다.＂", "value": { "text_id": "7", "word_num": 7, "핵심동사": "나라입니다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "205", "label": "대화형", "length": 29, "text": "＂국민을 무시하고 강제로 다스리는 나라가 아닙니다.＂", "value": { "text_id": "8", "word_num": 6, "핵심동사": "아닙니다", "확실성": "확실", "극성": "부정", "시제": "현재", "key_word": " " } } ], "dupLabelYn": "Y", "metaData": { "ID": "310345", "FILENAME": "310345.json", "MEDIA_TYPE": "도서", "MEDIA_NAME": "커뮤니케이션북스", "CATEGORY": "역사", "PUBDATE": "20130225", "SENTENCE": "8" } } 