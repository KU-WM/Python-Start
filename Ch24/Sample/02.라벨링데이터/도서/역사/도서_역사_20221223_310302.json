{ "annotation": [ { "charNum": "1", "label": "추론형", "length": 29, "text": "김수환은 매일 저녁마다 사람들에게 성경을 가르쳤다. ", "value": { "text_id": "1", "word_num": 7, "핵심동사": "가르쳤다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "성경을" } }, { "charNum": "30", "label": "추론형", "length": 34, "text": "사람들 중에는 처음으로 가톨릭을 믿기 시작한 사람도 있었다. ", "value": { "text_id": "2", "word_num": 9, "핵심동사": "있었다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "사람도" } }, { "charNum": "64", "label": "추론형", "length": 40, "text": "그리고 오래전부터 가톨릭을 믿었으나 성경을 잘 모르는 사람들도 있었다. ", "value": { "text_id": "3", "word_num": 10, "핵심동사": "있었다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "사람들도" } }, { "charNum": "104", "label": "추론형", "length": 24, "text": "안동은 시골이어서 밤이면 할 일이 없었다. ", "value": { "text_id": "4", "word_num": 7, "핵심동사": "없었다", "확실성": "확실", "극성": "부정", "시제": "과거", "key_word": "할/일이" } }, { "charNum": "128", "label": "추론형", "length": 36, "text": "성경을 공부하러 모인 사람들은 함께 이야기를 나누며 즐거워했다. ", "value": { "text_id": "5", "word_num": 9, "핵심동사": "즐거워했다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "나누며" } }, { "charNum": "164", "label": "추론형", "length": 41, "text": "수업이 끝나면 김수환은 사람들과 함께 앉아 즐겁게 이야기를 나누곤 했다. ", "value": { "text_id": "6", "word_num": 11, "핵심동사": "나누곤", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "이야기를/했다" } } ], "dupLabelYn": "Y", "metaData": { "ID": "310302", "FILENAME": "310302.json", "MEDIA_TYPE": "도서", "MEDIA_NAME": "커뮤니케이션북스", "CATEGORY": "역사", "PUBDATE": "20130225", "SENTENCE": "6" } } 