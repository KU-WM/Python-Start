{ "annotation": [ { "charNum": "1", "label": "추론형", "length": 56, "text": "1990년대가 되자 정부와 국민들 사이의 긴장이 줄었고 가톨릭과 정부 사이의 긴장도 많이 사라졌다. ", "value": { "text_id": "1", "word_num": 14, "핵심동사": "사라졌다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "많이" } }, { "charNum": "57", "label": "추론형", "length": 24, "text": "민주화 운동의 움직임도 조금씩 차분해졌다. ", "value": { "text_id": "2", "word_num": 6, "핵심동사": "차분해졌다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": "조금씩" } }, { "charNum": "81", "label": "추론형", "length": 34, "text": "김수환은 사회에 쏟았던 관심을 다른 종교로 옮기기 시작했다. ", "value": { "text_id": "3", "word_num": 9, "핵심동사": "시작했다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "옮기기" } }, { "charNum": "115", "label": "추론형", "length": 37, "text": "한국에는 가톨릭뿐만 아니라 개신교와 불교 등 여러 종교가 있었다. ", "value": { "text_id": "4", "word_num": 10, "핵심동사": "있었다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "종교가" } }, { "charNum": "152", "label": "추론형", "length": 44, "text": "여러 종교가 서로 싸우는 일은 거의 없었지만 서로 마음을 나누는 일도 없었다. ", "value": { "text_id": "5", "word_num": 13, "핵심동사": "없었다", "확실성": "확실", "극성": "부정", "시제": "과거", "key_word": "나누는/일도" } } ], "dupLabelYn": "Y", "metaData": { "ID": "310353", "FILENAME": "310353.json", "MEDIA_TYPE": "도서", "MEDIA_NAME": "커뮤니케이션북스", "CATEGORY": "역사", "PUBDATE": "20130225", "SENTENCE": "5" } } 