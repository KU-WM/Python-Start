{ "annotation": [ { "charNum": "1", "label": "추론형", "length": 47, "text": "나중에 추기경이 된 후 김수환은 안동 성당에서 보낸 시간이 가장 행복했다고 말했다. ", "value": { "text_id": "1", "word_num": 13, "핵심동사": "말했다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "행복했다고" } }, { "charNum": "48", "label": "추론형", "length": 31, "text": "가난한 신자들을 도울 수 있어서 즐겁고 기뻤다고 했다. ", "value": { "text_id": "2", "word_num": 9, "핵심동사": "했다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "기뻤다고" } }, { "charNum": "79", "label": "추론형", "length": 24, "text": "하지만 안동에서 지낸 시간은 길지 않았다. ", "value": { "text_id": "3", "word_num": 7, "핵심동사": "않았다", "확실성": "확실", "극성": "부정", "시제": "과거", "key_word": "시간은/길지" } }, { "charNum": "103", "label": "추론형", "length": 31, "text": "2년 후 김수환은 다른 일을 맡아 안동을 떠나게 되었다.", "value": { "text_id": "4", "word_num": 9, "핵심동사": "떠나게", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "안동을" } }, { "charNum": "134", "label": "추론형", "length": 25, "text": "안동을 떠난 김수환은 커다란 슬픔을 겪었다. ", "value": { "text_id": "5", "word_num": 7, "핵심동사": "겪었다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "슬픔을" } }, { "charNum": "159", "label": "추론형", "length": 16, "text": "어머니가 돌아가신 일이었다. ", "value": { "text_id": "6", "word_num": 4, "핵심동사": "일이었다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "돌아가신" } }, { "charNum": "175", "label": "추론형", "length": 26, "text": "어머니는 병에 걸려 몇 달 동안 고생을 했다. ", "value": { "text_id": "7", "word_num": 9, "핵심동사": "했다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "고생을" } }, { "charNum": "201", "label": "추론형", "length": 32, "text": "그리고 사랑하는 막내아들의 무릎에 기대어 숨을 거두었다. ", "value": { "text_id": "8", "word_num": 8, "핵심동사": "거두었다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "숨을" } }, { "charNum": "233", "label": "추론형", "length": 34, "text": "김수환은 어머니의 시신이 있는 방에서 밤늦도록 혼자 있었다. ", "value": { "text_id": "9", "word_num": 9, "핵심동사": "있었다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "혼자" } }, { "charNum": "267", "label": "추론형", "length": 22, "text": "그의 눈에서는 뜨거운 눈물이 흘러내렸다.", "value": { "text_id": "10", "word_num": 5, "핵심동사": "흘러내렸다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "눈물이" } } ], "dupLabelYn": "Y", "metaData": { "ID": "310305", "FILENAME": "310305.json", "MEDIA_TYPE": "도서", "MEDIA_NAME": "커뮤니케이션북스", "CATEGORY": "역사", "PUBDATE": "20130225", "SENTENCE": "10" } } 