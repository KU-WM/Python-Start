{ "annotation": [ { "charNum": "1", "label": "추론형", "length": 38, "text": "조선은 전쟁을 중단했다며 중국과 일본 군대에게 돌아가 달라고 했다. ", "value": { "text_id": "1", "word_num": 10, "핵심동사": "했다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "돌아가달라고" } }, { "charNum": "39", "label": "추론형", "length": 21, "text": "하지만 두 나라 모두 이를 거절했다. ", "value": { "text_id": "2", "word_num": 7, "핵심동사": "거절했다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "하지만" } }, { "charNum": "60", "label": "추론형", "length": 33, "text": "일본 군대는 궁궐을 먼저 차지했고 새로운 정부를 만들었다. ", "value": { "text_id": "3", "word_num": 9, "핵심동사": "만들었다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "정부를" } }, { "charNum": "93", "label": "추론형", "length": 37, "text": "그리고 중국 군대를 갑자기 공격해 두 나라 간에 전쟁이 벌어졌다. ", "value": { "text_id": "4", "word_num": 11, "핵심동사": "벌어졌다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "전쟁이" } }, { "charNum": "130", "label": "추론형", "length": 23, "text": "두 나라의 전쟁터는 바로 조선 땅이었다. ", "value": { "text_id": "5", "word_num": 7, "핵심동사": "땅이었다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "조선" } }, { "charNum": "153", "label": "추론형", "length": 47, "text": "일본은 육지와 바다 모두에서 중국을 크게 물리치고 나자 동학군을 공격할 준비를 했다.", "value": { "text_id": "6", "word_num": 12, "핵심동사": "했다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "준비를" } } ], "dupLabelYn": "Y", "metaData": { "ID": "310140", "FILENAME": "310140.json", "MEDIA_TYPE": "도서", "MEDIA_NAME": "커뮤니케이션북스", "CATEGORY": "역사", "PUBDATE": "20131220", "SENTENCE": "6" } } 