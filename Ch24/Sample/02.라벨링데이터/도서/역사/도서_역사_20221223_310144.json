{ "annotation": [ { "charNum": "1", "label": "추론형", "length": 38, "text": "명성황후를 잃은 고종은 일본이 다음에는 무슨 짓을 저지를지 두려웠다.", "value": { "text_id": "1", "word_num": 9, "핵심동사": "두려웠다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "무슨 짓을" } }, { "charNum": "39", "label": "추론형", "length": 32, "text": "결국 고종은 러시아 관리가 있는 곳으로 피해 몸을 숨겼다.", "value": { "text_id": "2", "word_num": 9, "핵심동사": "숨겼다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "몸을" } }, { "charNum": "71", "label": "추론형", "length": 32, "text": "그리고 일본과 친한 관리들을 정부에서 몰아내라고 명령했다.", "value": { "text_id": "3", "word_num": 7, "핵심동사": "명령했다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "몰아내려고" } }, { "charNum": "103", "label": "추론형", "length": 54, "text": "일본은 중국과 전쟁을 끝낸 지 오래지 않아 바로 러시아와 또다시 전쟁을 하기는 어렵다고 판단했다.", "value": { "text_id": "4", "word_num": 14, "핵심동사": "판단했다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "어렵다고" } }, { "charNum": "157", "label": "추론형", "length": 12, "text": "일본은 일단 물러났다.", "value": { "text_id": "5", "word_num": 3, "핵심동사": "물러났다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "일단" } }, { "charNum": "169", "label": "추론형", "length": 29, "text": "그리고 보이지 않게 러시아와 전쟁을 할 준비를 했다.", "value": { "text_id": "6", "word_num": 8, "핵심동사": "했다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "준비를" } }, { "charNum": "198", "label": "추론형", "length": 48, "text": "이렇게 되자 일본과 가까웠던 조선의 관리들은 대부분 죽임을 당하거나 일본으로 달아났다.", "value": { "text_id": "7", "word_num": 11, "핵심동사": "달아났다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "일본으로" } }, { "charNum": "246", "label": "추론형", "length": 31, "text": "그리고 러시아와 가까운 관리들로 새로운 정부를 이루었다.", "value": { "text_id": "8", "word_num": 7, "핵심동사": "이루었다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "정부를" } } ], "dupLabelYn": "Y", "metaData": { "ID": "310144", "FILENAME": "310144.json", "MEDIA_TYPE": "도서", "MEDIA_NAME": "커뮤니케이션북스", "CATEGORY": "역사", "PUBDATE": "20131220", "SENTENCE": "8" } } 