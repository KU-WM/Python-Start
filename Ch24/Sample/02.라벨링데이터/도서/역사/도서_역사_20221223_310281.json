{ "annotation": [ { "charNum": "1", "label": "추론형", "length": 24, "text": "그런데 김수환에게 특별한 사건이 일어났다. ", "value": { "text_id": "1", "word_num": 6, "핵심동사": "일어났다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "사건이" } }, { "charNum": "25", "label": "추론형", "length": 27, "text": "그가 신학교에서 정말로 쫓겨날 뻔한 사건이었다. ", "value": { "text_id": "2", "word_num": 7, "핵심동사": "사건이었다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "정말로" } }, { "charNum": "52", "label": "추론형", "length": 36, "text": "김수환이 신학교에 다니던 때에 한국은 아무 힘도 없는 나라였다. ", "value": { "text_id": "3", "word_num": 10, "핵심동사": "나라였다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "힘도/없는" } }, { "charNum": "88", "label": "추론형", "length": 24, "text": "모든 힘을 일본에 강제로 빼앗긴 처지였다. ", "value": { "text_id": "4", "word_num": 7, "핵심동사": "처지였다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "빼앗긴" } }, { "charNum": "112", "label": "추론형", "length": 23, "text": "한국 사람들은 나라를 다시 찾고 싶었다. ", "value": { "text_id": "5", "word_num": 7, "핵심동사": "찾고", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "싶었다" } }, { "charNum": "135", "label": "추론형", "length": 22, "text": "하지만 그런 마음을 드러내기 어려웠다. ", "value": { "text_id": "6", "word_num": 6, "핵심동사": "어려웠다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "드러내기" } }, { "charNum": "157", "label": "추론형", "length": 31, "text": "말만 해도 일본 경찰에게 붙잡혀 가거나 죽임을 당했다. ", "value": { "text_id": "7", "word_num": 9, "핵심동사": "당했다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "죽임을" } }, { "charNum": "188", "label": "추론형", "length": 31, "text": "김수환은 청년이 되면서 점점 일본에 대한 분노가 커졌다.", "value": { "text_id": "8", "word_num": 8, "핵심동사": "커졌다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "분노가" } } ], "dupLabelYn": "Y", "metaData": { "ID": "310281", "FILENAME": "310281.json", "MEDIA_TYPE": "도서", "MEDIA_NAME": "커뮤니케이션북스", "CATEGORY": "역사", "PUBDATE": "20130225", "SENTENCE": "8" } } 