{ "annotation": [ { "charNum": "1", "label": "추론형", "length": 38, "text": "38선을 경계로 한반도의 남쪽과 북쪽에는 서로 다른 나라가 세워졌다.", "value": { "text_id": "1", "word_num": 9, "핵심동사": "세워졌다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "서로/나라가" } }, { "charNum": "39", "label": "추론형", "length": 43, "text": "북한은 새로운 정부를 만든 후 남한에서 미국 군인들이 나가야 한다고 주장했다.", "value": { "text_id": "2", "word_num": 11, "핵심동사": "주장했다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "나가야/한다고" } }, { "charNum": "82", "label": "추론형", "length": 22, "text": "북한은 남한을 차지하려는 욕심이 있었다.", "value": { "text_id": "3", "word_num": 5, "핵심동사": "있었다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "욕심이" } }, { "charNum": "104", "label": "추론형", "length": 30, "text": "소련 군인은 북한의 뜻대로 소련으로 돌아가기 시작했다.", "value": { "text_id": "4", "word_num": 7, "핵심동사": "시작했다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "돌아가기" } }, { "charNum": "134", "label": "추론형", "length": 33, "text": "북한은 소련이 떠나기 전에 이미 강한 군대를 만들어 놓았다.", "value": { "text_id": "5", "word_num": 9, "핵심동사": "만들어", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "놓았다" } }, { "charNum": "167", "label": "추론형", "length": 41, "text": "북한은 남한과는 비교할 수 없을 정도로 뛰어난 전쟁 능력을 갖추고 있었다.", "value": { "text_id": "6", "word_num": 11, "핵심동사": "갖추고", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "능력을/있었다" } }, { "charNum": "208", "label": "추론형", "length": 36, "text": "그리고 미국이 물러가면 곧바로 남한을 공격할 준비를 하고 있었다.", "value": { "text_id": "7", "word_num": 9, "핵심동사": "하고", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "준비를/있었다" } }, { "charNum": "244", "label": "추론형", "length": 50, "text": "이런 사실을 알지 못한 미국은 1949년 6월에 대부분의 미국 군인들을 한국에서 내보냈다.", "value": { "text_id": "8", "word_num": 12, "핵심동사": "내보냈다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "한국에서" } }, { "charNum": "294", "label": "추론형", "length": 40, "text": "남한은 서둘러 군대를 키우려고 했지만 북한의 능력에 비하면 보잘것없었다.", "value": { "text_id": "9", "word_num": 9, "핵심동사": "없었다", "확실성": "확실", "극성": "부정", "시제": "과거", "key_word": "비하면/보잘것" } } ], "dupLabelYn": "Y", "metaData": { "ID": "310168", "FILENAME": "310168.json", "MEDIA_TYPE": "도서", "MEDIA_NAME": "커뮤니케이션북스", "CATEGORY": "역사", "PUBDATE": "41628", "SENTENCE": "9" } } 