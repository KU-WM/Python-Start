{ "annotation": [ { "charNum": "1", "label": "추론형", "length": 27, "text": "그 소식을 들은 김수환은 감사의 기도를 올렸다. ", "value": { "text_id": "1", "word_num": 8, "핵심동사": "올렸다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "기도를" } }, { "charNum": "28", "label": "추론형", "length": 29, "text": "그동안 명동성당에서 일어났던 많은 일들이 떠올랐다. ", "value": { "text_id": "2", "word_num": 7, "핵심동사": "떠올랐다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "일들이" } }, { "charNum": "57", "label": "추론형", "length": 41, "text": "그 중에서도 경찰을 피해 명동성당에 왔던 대학생들이 가장 먼저 생각났다. ", "value": { "text_id": "3", "word_num": 11, "핵심동사": "생각났다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "먼저" } }, { "charNum": "98", "label": "추론형", "length": 40, "text": "그들을 구하려고 자신이 직접 나서서 경찰과 맞서 싸웠던 날이 생각났다. ", "value": { "text_id": "4", "word_num": 11, "핵심동사": "생각났다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "싸웠던/날이" } }, { "charNum": "138", "label": "추론형", "length": 31, "text": "그날 이후 김수환은 매일 밤마다 잠들지 못해 괴로웠다. ", "value": { "text_id": "5", "word_num": 9, "핵심동사": "괴로웠다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "잠들지/못해" } }, { "charNum": "169", "label": "추론형", "length": 31, "text": "김수환은 눈을 감고 천천히 그날의 일을 떠올려 보았다. ", "value": { "text_id": "6", "word_num": 9, "핵심동사": "떠올려", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "보았다" } } ], "dupLabelYn": "Y", "metaData": { "ID": "310349", "FILENAME": "310349.json", "MEDIA_TYPE": "도서", "MEDIA_NAME": "커뮤니케이션북스", "CATEGORY": "역사", "PUBDATE": "20130225", "SENTENCE": "6" } } 