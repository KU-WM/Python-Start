{ "annotation": [ { "charNum": "1", "label": "추론형", "length": 26, "text": "마침내 젊은 죄수가 사형을 받는 날이 되었다. ", "value": { "text_id": "1", "word_num": 8, "핵심동사": "되었다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "날이" } }, { "charNum": "27", "label": "추론형", "length": 28, "text": "그 소식을 듣고 김수환은 얼른 감옥으로 달려갔다. ", "value": { "text_id": "2", "word_num": 8, "핵심동사": "달려갔다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "감옥으로" } }, { "charNum": "55", "label": "추론형", "length": 24, "text": "그리고 그를 위해 눈물을 흘리며 기도했다. ", "value": { "text_id": "3", "word_num": 7, "핵심동사": "기도했다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "눈물을/흘리며" } }, { "charNum": "79", "label": "추론형", "length": 31, "text": "걱정하는 김수환과 달리 젊은 죄수는 편안한 얼굴이었다. ", "value": { "text_id": "4", "word_num": 8, "핵심동사": "얼굴이었다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "편안한" } }, { "charNum": "110", "label": "추론형", "length": 38, "text": "죄수는 자신을 가톨릭 묘지에 묻어 달라고 말하고 사형대로 걸어갔다. ", "value": { "text_id": "5", "word_num": 10, "핵심동사": "걸어갔다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "사형대로" } }, { "charNum": "148", "label": "추론형", "length": 35, "text": "잠시 후 사형이 시작되었고 ＂쿵!＂ 하는 소리가 크게 들렸다. ", "value": { "text_id": "6", "word_num": 10, "핵심동사": "들렸다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "소리가" } }, { "charNum": "183", "label": "추론형", "length": 33, "text": "그 소리는 심장을 찌르는 것처럼 차갑고 날카로운 소리였다. ", "value": { "text_id": "7", "word_num": 9, "핵심동사": "소리였다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "날카로운" } }, { "charNum": "216", "label": "추론형", "length": 15, "text": "그리고 주위가 조용해졌다. ", "value": { "text_id": "8", "word_num": 4, "핵심동사": "조용해졌다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "주위가" } } ], "dupLabelYn": "Y", "metaData": { "ID": "310324", "FILENAME": "310324.json", "MEDIA_TYPE": "도서", "MEDIA_NAME": "커뮤니케이션북스", "CATEGORY": "역사", "PUBDATE": "20130225", "SENTENCE": "8" } } 