{ "annotation": [ { "charNum": "1", "label": "추론형", "length": 64, "text": "강한 힘과 용기, 그리고 뛰어난 능력을 지닌 태종 이방원은 누구라도 두려움을 느끼고 우러러보게 만드는 사람이었다. ", "value": { "text_id": "1", "word_num": 16, "핵심동사": "사람이었다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "만드는" } }, { "charNum": "65", "label": "추론형", "length": 18, "text": "그에게는 네 명의 아들이 있었다.", "value": { "text_id": "2", "word_num": 5, "핵심동사": "있었다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "아들이" } }, { "charNum": "83", "label": "추론형", "length": 51, "text": "첫째 아들의 이름은 이제, 둘째 아들은 이보, 셋째 아들은 이도, 넷째 아들은 이종이었다. ", "value": { "text_id": "3", "word_num": 14, "핵심동사": "이종이었다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "아들은" } }, { "charNum": "134", "label": "추론형", "length": 44, "text": "막내였던 이종은 다른 형제들과 다르게 태종이 왕이 된 후에 궁궐에서 태어났다. ", "value": { "text_id": "4", "word_num": 12, "핵심동사": "태어났다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "궁궐에서" } }, { "charNum": "178", "label": "추론형", "length": 30, "text": "그래서 태종에게 가장 많은 사랑을 받았던 아들이었다. ", "value": { "text_id": "5", "word_num": 8, "핵심동사": "아들이었다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "받았던" } }, { "charNum": "208", "label": "추론형", "length": 32, "text": "하지만 아쉽게도 열네 살의 어린 나이에 일찍 죽고 말았다.", "value": { "text_id": "6", "word_num": 9, "핵심동사": "죽고", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "말았다" } } ], "dupLabelYn": "Y", "metaData": { "ID": "310238", "FILENAME": "310238.json", "MEDIA_TYPE": "도서", "MEDIA_NAME": "커뮤니케이션북스", "CATEGORY": "역사", "PUBDATE": "20131220", "SENTENCE": "6" } } 