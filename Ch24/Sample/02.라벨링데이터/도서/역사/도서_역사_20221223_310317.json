{ "annotation": [ { "charNum": "1", "label": "사실형", "length": 26, "text": "1963년 11월, 김수환은 한국으로 돌아왔다.", "value": { "text_id": "1", "word_num": 6, "핵심동사": "돌아왔다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": " " } }, { "charNum": "29", "label": "사실형", "length": 26, "text": "김수환은 독일에서 보고 배운 것을 잊지 않았다.", "value": { "text_id": "2", "word_num": 8, "핵심동사": "잊지", "확실성": "확실", "극성": "부정", "시제": "과거", "key_word": " " } }, { "charNum": "57", "label": "사실형", "length": 27, "text": "그것을 가지고 한국 가톨릭을 위해 일하고 싶었다.", "value": { "text_id": "3", "word_num": 8, "핵심동사": "일하고", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": " " } }, { "charNum": "86", "label": "사실형", "length": 19, "text": "그런데 그에게 뜻밖의 연락이 왔다.", "value": { "text_id": "4", "word_num": 6, "핵심동사": "왔다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": " " } }, { "charNum": "107", "label": "사실형", "length": 20, "text": "≪가톨릭신문≫을 맡으라는 연락이었다.", "value": { "text_id": "5", "word_num": 4, "핵심동사": "연락이었다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": " " } }, { "charNum": "129", "label": "사실형", "length": 40, "text": "김수환은 신문을 만들어 본 적이 없었기 때문에 어떻게 해야 할지 몰랐다.", "value": { "text_id": "6", "word_num": 12, "핵심동사": "몰랐다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": " " } }, { "charNum": "171", "label": "사실형", "length": 29, "text": "하지만 해 보지도 않고 안 하겠다고 할 수는 없었다.", "value": { "text_id": "7", "word_num": 10, "핵심동사": "할", "확실성": "확실", "극성": "부정", "시제": "과거", "key_word": " " } }, { "charNum": "202", "label": "사실형", "length": 24, "text": "김수환은 어쩔 수 없이 가톨릭신문사로 갔다.", "value": { "text_id": "8", "word_num": 7, "핵심동사": "갔다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": " " } } ], "dupLabelYn": "Y", "metaData": { "ID": "310317", "FILENAME": "310317.json", "MEDIA_TYPE": "도서", "MEDIA_NAME": "커뮤니케이션북스", "CATEGORY": "역사", "PUBDATE": "20130225", "SENTENCE": "8" } } 