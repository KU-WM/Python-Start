{ "annotation": [ { "charNum": "1", "label": "추론형", "length": 23, "text": "외국에서 사는 것은 몹시 힘든 일이었다. ", "value": { "text_id": "1", "word_num": 7, "핵심동사": "일이었다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "힘든" } }, { "charNum": "24", "label": "추론형", "length": 27, "text": "김수환은 한국에 있던 외국인 신부들을 생각했다. ", "value": { "text_id": "2", "word_num": 7, "핵심동사": "생각했다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "신부들을" } }, { "charNum": "51", "label": "추론형", "length": 28, "text": "외국인 신부들이 얼마나 힘들었을지 알 것 같았다. ", "value": { "text_id": "3", "word_num": 8, "핵심동사": "알", "확실성": "불확실", "극성": "긍정", "시제": "과거", "key_word": "것/같았다" } }, { "charNum": "79", "label": "추론형", "length": 21, "text": "그런데 무엇보다 힘든 것은 공부였다. ", "value": { "text_id": "4", "word_num": 6, "핵심동사": "공부였다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "힘든/것은" } }, { "charNum": "100", "label": "추론형", "length": 27, "text": "한국에서 성경을 공부한 것으로는 많이 부족했다. ", "value": { "text_id": "5", "word_num": 7, "핵심동사": "부족했다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "많이" } }, { "charNum": "127", "label": "추론형", "length": 45, "text": "다른 나라 말을 배우면서 그 말로 성경을 읽고 배우는 것은 정말 힘든 일이었다. ", "value": { "text_id": "6", "word_num": 14, "핵심동사": "일이었다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "정말/힘든" } } ], "dupLabelYn": "Y", "metaData": { "ID": "310311", "FILENAME": "310311.json", "MEDIA_TYPE": "도서", "MEDIA_NAME": "커뮤니케이션북스", "CATEGORY": "역사", "PUBDATE": "20130225", "SENTENCE": "6" } } 