{ "annotation": [ { "charNum": "1", "label": "추론형", "length": 35, "text": "그런데 의사를 만난 후, 김수환의 걱정은 놀라움으로 바뀌었다. ", "value": { "text_id": "1", "word_num": 9, "핵심동사": "바뀌었다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "놀라움으로" } }, { "charNum": "36", "label": "추론형", "length": 27, "text": "김수환은 정말로 축농증이라는 병에 걸려 있었다. ", "value": { "text_id": "2", "word_num": 7, "핵심동사": "걸려", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "병에" } }, { "charNum": "63", "label": "추론형", "length": 22, "text": "의사는 당장 수술을 해야 한다고 했다. ", "value": { "text_id": "3", "word_num": 7, "핵심동사": "했다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "수술을/해야/한다고" } }, { "charNum": "85", "label": "추론형", "length": 22, "text": "김수환의 거짓말은 정말이 되어 버렸다. ", "value": { "text_id": "4", "word_num": 6, "핵심동사": "되어", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "버렸다" } }, { "charNum": "107", "label": "추론형", "length": 23, "text": "김수환은 수술을 받고 6개월 동안 쉬었다.", "value": { "text_id": "5", "word_num": 6, "핵심동사": "쉬었다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "동안" } } ], "dupLabelYn": "Y", "metaData": { "ID": "310279", "FILENAME": "310279.json", "MEDIA_TYPE": "도서", "MEDIA_NAME": "커뮤니케이션북스", "CATEGORY": "역사", "PUBDATE": "20130225", "SENTENCE": "5" } } 