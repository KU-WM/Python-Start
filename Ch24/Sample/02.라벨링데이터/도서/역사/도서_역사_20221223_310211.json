{ "annotation": [ { "charNum": "1", "label": "추론형", "length": 25, "text": "그 후 신라에는 크고 작은 불이 계속 났다. ", "value": { "text_id": "1", "word_num": 9, "핵심동사": "났다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "계속" } }, { "charNum": "26", "label": "추론형", "length": 25, "text": "사람들은 지귀가 불귀신이 되었다고 생각했다. ", "value": { "text_id": "2", "word_num": 6, "핵심동사": "생각했다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "되었다고" } }, { "charNum": "51", "label": "추론형", "length": 47, "text": "불귀신이 된 지귀가 신라를 떠나지 못하기 때문에 신라에 계속 불이 난다고 생각했다. ", "value": { "text_id": "3", "word_num": 13, "핵심동사": "생각했다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "불이/난다고" } }, { "charNum": "98", "label": "추론형", "length": 34, "text": "선덕여왕은 지귀의 영혼을 위로하는 제사를 정성스럽게 지냈다. ", "value": { "text_id": "4", "word_num": 8, "핵심동사": "지냈다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "정성스럽게" } }, { "charNum": "132", "label": "추론형", "length": 31, "text": "그리고 지귀를 달래는 주문을 만들어 백성들에게 주었다. ", "value": { "text_id": "5", "word_num": 8, "핵심동사": "주었다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "백성들에게" } }, { "charNum": "163", "label": "추론형", "length": 47, "text": "선덕여왕이 만든 그 주문을 적은 부적을 집에 붙인 후에는 더 이상 불이 나지 않았다.", "value": { "text_id": "6", "word_num": 14, "핵심동사": "나지", "확실성": "확실", "극성": "부정", "시제": "과거", "key_word": "않았다" } } ], "dupLabelYn": "Y", "metaData": { "ID": "310211", "FILENAME": "310211.json", "MEDIA_TYPE": "도서", "MEDIA_NAME": "커뮤니케이션북스", "CATEGORY": "역사", "PUBDATE": "20131235", "SENTENCE": "6" } } 