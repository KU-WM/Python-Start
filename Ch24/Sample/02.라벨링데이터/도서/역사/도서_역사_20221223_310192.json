{ "annotation": [ { "charNum": "1", "label": "추론형", "length": 17, "text": "하지만 국민들의 생각은 달랐다.", "value": { "text_id": "1", "word_num": 4, "핵심동사": "달랐다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "생각은" } }, { "charNum": "18", "label": "추론형", "length": 48, "text": "국민들은 원래의 헌법을 바꾸어 국민이 직접 대통령을 뽑는 직접 선거를 하고 싶어 했다.", "value": { "text_id": "2", "word_num": 13, "핵심동사": "하고", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "싶어/했다" } }, { "charNum": "66", "label": "추론형", "length": 44, "text": "국민이 나라의 주인이므로 대통령을 뽑는 것도 국민이 직접 해야 한다고 생각했다.", "value": { "text_id": "3", "word_num": 11, "핵심동사": "생각했다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "해야/한다고" } }, { "charNum": "110", "label": "추론형", "length": 35, "text": "이러한 국민들의 생각은 민주화를 향한 강한 바람을 담고 있었다.", "value": { "text_id": "4", "word_num": 9, "핵심동사": "담고", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "바람을/있었다" } }, { "charNum": "145", "label": "추론형", "length": 44, "text": "그러자 많은 정치인들과 사회운동가들이 힘을 합쳐 헌법을 바꾸자며 시위를 벌였다.", "value": { "text_id": "5", "word_num": 10, "핵심동사": "벌였다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "시위를" } }, { "charNum": "189", "label": "추론형", "length": 33, "text": "특히 대학생들은 더욱 거세게 저항하며 직접 선거를 주장했다.", "value": { "text_id": "6", "word_num": 8, "핵심동사": "주장했다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "직접" } } ], "dupLabelYn": "Y", "metaData": { "ID": "310192", "FILENAME": "310192.json", "MEDIA_TYPE": "도서", "MEDIA_NAME": "커뮤니케이션북스", "CATEGORY": "역사", "PUBDATE": "41628", "SENTENCE": "6" } } 