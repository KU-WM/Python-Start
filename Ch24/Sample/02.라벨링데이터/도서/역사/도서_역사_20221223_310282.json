{ "annotation": [ { "charNum": "1", "label": "추론형", "length": 38, "text": "신학교의 선생님들 중에는 신부도 있었고 신부가 아닌 사람도 있었다. ", "value": { "text_id": "1", "word_num": 10, "핵심동사": "있었다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "사람도" } }, { "charNum": "39", "label": "추론형", "length": 22, "text": "신부인 선생님들은 대부분 외국인이었다. ", "value": { "text_id": "2", "word_num": 5, "핵심동사": "외국인이었다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "대부분" } }, { "charNum": "61", "label": "추론형", "length": 26, "text": "그래서 한국 사람들의 마음을 잘 알지 못했다. ", "value": { "text_id": "3", "word_num": 8, "핵심동사": "알지", "확실성": "확실", "극성": "부정", "시제": "과거", "key_word": "못했다" } }, { "charNum": "87", "label": "추론형", "length": 34, "text": "신부인 선생님들은 학생들에게 분노를 가지면 안 된다고 했다. ", "value": { "text_id": "4", "word_num": 9, "핵심동사": "했다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "된다고" } }, { "charNum": "121", "label": "추론형", "length": 27, "text": "분노는 신부에게 어울리지 않는 마음이라고 했다. ", "value": { "text_id": "5", "word_num": 7, "핵심동사": "했다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "마음이라고" } }, { "charNum": "148", "label": "추론형", "length": 23, "text": "하지만 김수환은 그 말을 따를 수 없었다.", "value": { "text_id": "6", "word_num": 7, "핵심동사": "따를", "확실성": "확실", "극성": "부정", "시제": "과거", "key_word": "말을/없었다" } } ], "dupLabelYn": "Y", "metaData": { "ID": "310282", "FILENAME": "310282.json", "MEDIA_TYPE": "도서", "MEDIA_NAME": "커뮤니케이션북스", "CATEGORY": "역사", "PUBDATE": "20130225", "SENTENCE": "6" } } 