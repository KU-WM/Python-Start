{ "annotation": [ { "charNum": "1", "label": "추론형", "length": 40, "text": "그런데 12세기가 되자 평화로웠던 고려에 조금씩 문제가 생기기 시작했다.", "value": { "text_id": "1", "word_num": 9, "핵심동사": "시작했다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "생기기" } }, { "charNum": "41", "label": "추론형", "length": 72, "text": "여러 지방의 귀족들이 군사를 이끌고 왕의 군대와 싸우기도 하고,가난한 백성들이 힘을 모아 왕에게 맞서는 전쟁을 일으키기도 했다. ", "value": { "text_id": "2", "word_num": 18, "핵심동사": "일으키기도", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "맞서는/했다" } }, { "charNum": "113", "label": "추론형", "length": 59, "text": "결국 12세기 말에는 군사들을 맡고 있는 신하인 무신들이 왕에게 맞서 큰 전쟁을 일으키고 왕을 쫓아냈다. ", "value": { "text_id": "3", "word_num": 16, "핵심동사": "쫓아냈다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "일으키고" } }, { "charNum": "172", "label": "추론형", "length": 56, "text": "무신들은 자신들의 마음에 드는 사람을 왕으로 세우고 그 후 오랫동안 자신들의 뜻대로 고려를 다스렸다.", "value": { "text_id": "4", "word_num": 14, "핵심동사": "다스렸다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "고려를" } }, { "charNum": "228", "label": "추론형", "length": 31, "text": "무신 정권을 이끈 지도자들은 돈을 받고 벼슬을 팔았다. ", "value": { "text_id": "5", "word_num": 9, "핵심동사": "팔았다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "이끈" } }, { "charNum": "259", "label": "추론형", "length": 32, "text": "벼슬을 산 지방관리들은 백성의 재물을 마음대로 빼앗았다. ", "value": { "text_id": "6", "word_num": 8, "핵심동사": "빼앗았다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "마음대로" } }, { "charNum": "291", "label": "추론형", "length": 22, "text": "그리고 온갖 방법으로 백성들을 괴롭혔다.", "value": { "text_id": "7", "word_num": 5, "핵심동사": "괴롭혔다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "방법으로" } } ], "dupLabelYn": "Y", "metaData": { "ID": "310110", "FILENAME": "310110.json", "MEDIA_TYPE": "도서", "MEDIA_NAME": "커뮤니케이션북스", "CATEGORY": "역사", "PUBDATE": "20131220", "SENTENCE": "7" } } 