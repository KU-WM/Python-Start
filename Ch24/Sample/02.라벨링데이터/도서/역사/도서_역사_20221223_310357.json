{ "annotation": [ { "charNum": "1", "label": "대화형", "length": 30, "text": "＂명동성당은 우리나라의 기쁨과 괴로움을 함께했습니다.＂", "value": { "text_id": "1", "word_num": 6, "핵심동사": "함께했습니다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": " " } }, { "charNum": "33", "label": "대화형", "length": 26, "text": "＂명동성당은 한국 사회를 밝히는 등대였습니다.＂", "value": { "text_id": "2", "word_num": 5, "핵심동사": "등대였습니다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": " " } }, { "charNum": "60", "label": "대화형", "length": 22, "text": "＂앞으로도 등대로 계속 남을 것입니다.＂", "value": { "text_id": "3", "word_num": 6, "핵심동사": "남을", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "84", "label": "대화형", "length": 41, "text": "＂명동성당이 예수님의 빛을 더 환하게 밝히려면 우리의 노력이 필요합니다.＂", "value": { "text_id": "4", "word_num": 10, "핵심동사": "필요합니다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "127", "label": "대화형", "length": 35, "text": "＂더 열심히 예수님을 믿고 따라야 한다는 것을 잊지 마십시오.＂", "value": { "text_id": "5", "word_num": 10, "핵심동사": "잊지", "확실성": "확실", "극성": "부정", "시제": "현재", "key_word": " " } } ], "dupLabelYn": "Y", "metaData": { "ID": "310357", "FILENAME": "310357.json", "MEDIA_TYPE": "도서", "MEDIA_NAME": "커뮤니케이션북스", "CATEGORY": "역사", "PUBDATE": "20130225", "SENTENCE": "5" } } 