{ "annotation": [ { "charNum": "1", "label": "추론형", "length": 28, "text": "쉬는 동안 김수환의 마음이 조금씩 변하기 시작했다.", "value": { "text_id": "1", "word_num": 7, "핵심동사": "시작했다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "변하기" } }, { "charNum": "29", "label": "추론형", "length": 30, "text": "거짓말을 안 했다면 진짜로 병이 있는지 몰랐을 것이다.", "value": { "text_id": "2", "word_num": 8, "핵심동사": "몰랐을", "확실성": "불확실", "극성": "긍정", "시제": "과거", "key_word": "있는지" } }, { "charNum": "59", "label": "추론형", "length": 32, "text": "거짓말을 한 자신에게 하느님은 병을 고칠 기회를 주셨다. ", "value": { "text_id": "3", "word_num": 9, "핵심동사": "주셨다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "기회를" } }, { "charNum": "91", "label": "추론형", "length": 27, "text": "김수환은 신부가 되는 일에 대해 깊이 생각했다. ", "value": { "text_id": "4", "word_num": 8, "핵심동사": "생각했다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "깊이" } }, { "charNum": "118", "label": "추론형", "length": 28, "text": "가톨릭의 위대한 사람들에 관한 책도 많이 읽었다. ", "value": { "text_id": "5", "word_num": 8, "핵심동사": "읽었다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "책도/많이" } }, { "charNum": "146", "label": "추론형", "length": 30, "text": "신부가 되기 싫다는 마음이 조금씩 사라지기 시작했다. ", "value": { "text_id": "6", "word_num": 8, "핵심동사": "시작했다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "사라지기" } }, { "charNum": "176", "label": "추론형", "length": 23, "text": "병이 다 낫자 김수환은 학교로 돌아갔다. ", "value": { "text_id": "7", "word_num": 7, "핵심동사": "돌아갔다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "학교로" } }, { "charNum": "199", "label": "추론형", "length": 21, "text": "그리고 매일 열심히 기도하고 공부했다.", "value": { "text_id": "8", "word_num": 5, "핵심동사": "공부했다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "기도하고" } } ], "dupLabelYn": "Y", "metaData": { "ID": "310280", "FILENAME": "310280.json", "MEDIA_TYPE": "도서", "MEDIA_NAME": "커뮤니케이션북스", "CATEGORY": "역사", "PUBDATE": "20130225", "SENTENCE": "8" } } 