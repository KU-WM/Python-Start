{ "annotation": [ { "charNum": "1", "label": "추론형", "length": 26, "text": "＇화랑＇은 신라만의 특별한 청년 교육제도였다. ", "value": { "text_id": "1", "word_num": 6, "핵심동사": "교육제도였다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "특별한" } }, { "charNum": "27", "label": "추론형", "length": 45, "text": "신라에서는 외모가 아름답고 능력이 뛰어난 귀족 청년들을 뽑아 화랑이라고 불렀다. ", "value": { "text_id": "2", "word_num": 11, "핵심동사": "불렀다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "화랑이라고" } }, { "charNum": "72", "label": "추론형", "length": 32, "text": "화랑의 첫째 목적은 군대를 이끌 장수를 키우는 것이었다. ", "value": { "text_id": "3", "word_num": 9, "핵심동사": "키우는", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "장수를/것이었다" } }, { "charNum": "104", "label": "추론형", "length": 38, "text": "하지만 화랑과 화랑을 따르는 낭도들이 무예만 훈련한 것은 아니었다. ", "value": { "text_id": "4", "word_num": 10, "핵심동사": "아니었다", "확실성": "확실", "극성": "부정", "시제": "과거", "key_word": "훈련한" } }, { "charNum": "142", "label": "추론형", "length": 28, "text": "이들은 학문을 통해 많은 지식을 얻으려고 애썼다. ", "value": { "text_id": "5", "word_num": 8, "핵심동사": "애썼다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "얻으려고" } }, { "charNum": "170", "label": "추론형", "length": 34, "text": "그리고 바른 태도를 지닌 훌륭한 인간이 되기 위해서 노력했다.", "value": { "text_id": "6", "word_num": 9, "핵심동사": "노력했다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "되기/위해서" } }, { "charNum": "204", "label": "추론형", "length": 42, "text": "신라가 삼국을 통일하는 데에 화랑이 중요한 역할을 한 것은 당연한 결과였다.", "value": { "text_id": "7", "word_num": 11, "핵심동사": "결과였다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "당연한" } } ], "dupLabelYn": "Y", "metaData": { "ID": "310103", "FILENAME": "310103.json", "MEDIA_TYPE": "도서", "MEDIA_NAME": "커뮤니케이션북스", "CATEGORY": "역사", "PUBDATE": "20131220", "SENTENCE": "7" } } 