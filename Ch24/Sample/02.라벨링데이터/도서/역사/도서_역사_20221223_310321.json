{ "annotation": [ { "charNum": "1", "label": "추론형", "length": 24, "text": "그리고 가톨릭이 무엇을 고쳐야 할지 물었다.", "value": { "text_id": "1", "word_num": 6, "핵심동사": "물었다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "무엇을/고쳐야" } }, { "charNum": "25", "label": "추론형", "length": 34, "text": "개신교, 불교 등 다른 종교의 지도자들이 답장을 보내 왔다. ", "value": { "text_id": "2", "word_num": 10, "핵심동사": "보내", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "왔다" } }, { "charNum": "59", "label": "추론형", "length": 23, "text": "그중에는 가톨릭을 비난하는 글도 많았다. ", "value": { "text_id": "3", "word_num": 6, "핵심동사": "많았다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "글도" } }, { "charNum": "82", "label": "추론형", "length": 26, "text": "김수환은 편지들을 있는 그대로 신문에 담았다. ", "value": { "text_id": "4", "word_num": 7, "핵심동사": "담았다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "신문에" } }, { "charNum": "108", "label": "추론형", "length": 39, "text": "가톨릭 신자들 중에는 김수환의 이런 행동을 걱정하는 사람들도 있었다. ", "value": { "text_id": "5", "word_num": 10, "핵심동사": "있었다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "사람들도" } }, { "charNum": "147", "label": "추론형", "length": 22, "text": "하지만 김수환은 생각을 바꾸지 않았다. ", "value": { "text_id": "6", "word_num": 6, "핵심동사": "바꾸지", "확실성": "확실", "극성": "부정", "시제": "과거", "key_word": "생각을" } }, { "charNum": "169", "label": "추론형", "length": 35, "text": "세상이 가톨릭을 어떻게 보는지 반드시 알아야 한다고 생각했다. ", "value": { "text_id": "7", "word_num": 9, "핵심동사": "생각했다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "한다고" } } ], "dupLabelYn": "Y", "metaData": { "ID": "310321", "FILENAME": "310321.json", "MEDIA_TYPE": "도서", "MEDIA_NAME": "커뮤니케이션북스", "CATEGORY": "역사", "PUBDATE": "20130225", "SENTENCE": "7" } } 