{ "annotation": [ { "charNum": "1", "label": "추론형", "length": 31, "text": "지귀는 아침 일찍부터 탑 아래에서 선덕여왕을 기다렸다. ", "value": { "text_id": "1", "word_num": 8, "핵심동사": "기다렸다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "아침/일찍부터" } }, { "charNum": "32", "label": "추론형", "length": 40, "text": "조금만 있으면 선덕여왕을 볼 수 있다고 생각하니 시간이 길게 느껴졌다. ", "value": { "text_id": "2", "word_num": 11, "핵심동사": "느껴졌다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "길게" } }, { "charNum": "72", "label": "추론형", "length": 22, "text": "지귀는 탑을 돌며 선덕여왕을 기다렸다. ", "value": { "text_id": "3", "word_num": 6, "핵심동사": "기다렸다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "지귀는" } }, { "charNum": "94", "label": "추론형", "length": 27, "text": "탑을 돌고 또 돌았지만 선덕여왕은 오지 않았다. ", "value": { "text_id": "4", "word_num": 8, "핵심동사": "오지", "확실성": "확실", "극성": "부정", "시제": "과거", "key_word": "않았다" } }, { "charNum": "121", "label": "추론형", "length": 39, "text": "두근거리는 마음으로 탑을 돌던 지귀는 잠시 쉬다가 깜빡 잠이 들었다. ", "value": { "text_id": "5", "word_num": 11, "핵심동사": "들었다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "깜빡/잠이" } }, { "charNum": "160", "label": "추론형", "length": 33, "text": "그동안 잠을 잘 자지 못해서 몹시 지쳐 있었기 때문이었다. ", "value": { "text_id": "6", "word_num": 10, "핵심동사": "때문이었다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "지쳐/있었기" } }, { "charNum": "193", "label": "추론형", "length": 28, "text": "잠시 후 불공을 마친 선덕여왕이 탑 아래로 왔다. ", "value": { "text_id": "7", "word_num": 9, "핵심동사": "왔다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "아래로" } }, { "charNum": "221", "label": "추론형", "length": 20, "text": "거기에는 어떤 청년이 잠들어 있었다.", "value": { "text_id": "8", "word_num": 5, "핵심동사": "잠들어", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "청년이/있었다" } }, { "charNum": "241", "label": "대화형", "length": 17, "text": "＇아, 이 청년이 지귀로구나.＇", "value": { "text_id": "9", "word_num": 4, "핵심동사": "지귀로구나", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "258", "label": "대화형", "length": 23, "text": "＇얼마나 피곤하면 이렇게 잠이 들었을까?＇", "value": { "text_id": "10", "word_num": 5, "핵심동사": "들었들까", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": " " } }, { "charNum": "281", "label": "추론형", "length": 22, "text": "그래서 선덕여왕은 지귀를 깨우지 않았다.", "value": { "text_id": "11", "word_num": 5, "핵심동사": "깨우지", "확실성": "확실", "극성": "부정", "시제": "과거", "key_word": "않았다" } }, { "charNum": "303", "label": "추론형", "length": 31, "text": "대신 자신의 팔찌를 빼어 지귀의 가슴 위에 올려 두었다.", "value": { "text_id": "12", "word_num": 9, "핵심동사": "올려", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "두었다" } } ], "dupLabelYn": "Y", "metaData": { "ID": "310209", "FILENAME": "310209.json", "MEDIA_TYPE": "도서", "MEDIA_NAME": "커뮤니케이션북스", "CATEGORY": "역사", "PUBDATE": "20131233", "SENTENCE": "12" } } 