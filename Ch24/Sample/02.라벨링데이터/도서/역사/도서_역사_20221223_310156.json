{ "annotation": [ { "charNum": "1", "label": "추론형", "length": 31, "text": "수천 명의 사람들은 거리에서 ＂대한독립 만세＂를 외쳤다.", "value": { "text_id": "1", "word_num": 7, "핵심동사": "외쳤다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "사람들은" } }, { "charNum": "32", "label": "추론형", "length": 16, "text": "학교와 가게들은 문을 닫았다.", "value": { "text_id": "2", "word_num": 4, "핵심동사": "닫았다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "문들" } }, { "charNum": "48", "label": "추론형", "length": 25, "text": "만세를 부르는 시위는 지방으로도 퍼져 나갔다.", "value": { "text_id": "3", "word_num": 6, "핵심동사": "퍼져", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "지방으로도" } }, { "charNum": "73", "label": "추론형", "length": 38, "text": "사람들이 많이 모이는 장날이면 ＂대한독립 만세＂라는 소리가 들렸다. ", "value": { "text_id": "4", "word_num": 9, "핵심동사": "들렸다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "소리가" } }, { "charNum": "111", "label": "추론형", "length": 39, "text": "3·1운동은 중국과 러시아, 미국에 있는 조선인들에게까지 퍼져 나갔다.", "value": { "text_id": "5", "word_num": 8, "핵심동사": "퍼져", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "나갔다" } }, { "charNum": "150", "label": "추론형", "length": 32, "text": "결국 ＂대한독립 만세＂를 외치는 운동은 5월까지 이어졌다.", "value": { "text_id": "6", "word_num": 7, "핵심동사": "이어졌다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "운동은" } } ], "dupLabelYn": "Y", "metaData": { "ID": "310156", "FILENAME": "310156.json", "MEDIA_TYPE": "도서", "MEDIA_NAME": "커뮤니케이션북스", "CATEGORY": "역사", "PUBDATE": "41628", "SENTENCE": "6" } } 