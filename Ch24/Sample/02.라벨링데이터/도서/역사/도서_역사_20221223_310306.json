{ "annotation": [ { "charNum": "1", "label": "추론형", "length": 35, "text": "김수환은 속으로 ＇이제 나는 고아가 되었구나!＇라고 생각했다. ", "value": { "text_id": "1", "word_num": 8, "핵심동사": "생각했다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "속으로" } }, { "charNum": "36", "label": "추론형", "length": 18, "text": "그는 서른 두 살의 어른이었다. ", "value": { "text_id": "2", "word_num": 6, "핵심동사": "어른이었다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "그는" } }, { "charNum": "54", "label": "추론형", "length": 28, "text": "하지만 자신이 부모를 잃은 아이 같다고 생각했다. ", "value": { "text_id": "3", "word_num": 8, "핵심동사": "생각했다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "아이/같다고" } }, { "charNum": "82", "label": "추론형", "length": 26, "text": "부모 잃은 아이의 두려움과 외로움이 느껴졌다. ", "value": { "text_id": "4", "word_num": 7, "핵심동사": "느껴졌다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "외로움이" } }, { "charNum": "108", "label": "추론형", "length": 38, "text": "형 김동한 신부는 전쟁터에 있어서 어머니의 임종을 지킬 수 없었다. ", "value": { "text_id": "5", "word_num": 11, "핵심동사": "없었다", "확실성": "확실", "극성": "부정", "시제": "과거", "key_word": "지킬/수" } }, { "charNum": "146", "label": "추론형", "length": 35, "text": "김수환은 어머니의 임종을 지킨 것을 마지막 효도라고 생각했다. ", "value": { "text_id": "6", "word_num": 9, "핵심동사": "생각했다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "마지막/효도라고" } }, { "charNum": "181", "label": "추론형", "length": 33, "text": "그리고 어머니의 사랑에 보답할 특별한 기회였다고 생각했다. ", "value": { "text_id": "7", "word_num": 8, "핵심동사": "생각했다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "기회였다고" } }, { "charNum": "214", "label": "추론형", "length": 25, "text": "김수환은 그 기회를 얻은 것에 대해 감사했다.", "value": { "text_id": "8", "word_num": 7, "핵심동사": "감사했다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "기회를/얻은/것에" } } ], "dupLabelYn": "Y", "metaData": { "ID": "310306", "FILENAME": "310306.json", "MEDIA_TYPE": "도서", "MEDIA_NAME": "커뮤니케이션북스", "CATEGORY": "역사", "PUBDATE": "20130225", "SENTENCE": "8" } } 