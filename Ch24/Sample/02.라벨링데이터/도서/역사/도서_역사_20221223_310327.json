{ "annotation": [ { "charNum": "1", "label": "추론형", "length": 33, "text": "신부가 된 지 15년 만에 김수환은 또 다른 일을 맡았다. ", "value": { "text_id": "1", "word_num": 11, "핵심동사": "맡았다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "일을" } }, { "charNum": "34", "label": "추론형", "length": 30, "text": "마산의 가톨릭교회를 대표하는 주교로 임명된 것이었다. ", "value": { "text_id": "2", "word_num": 7, "핵심동사": "임명된", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "것이었다" } }, { "charNum": "64", "label": "추론형", "length": 32, "text": "마산의 주교는 마산의 성당과 신자들을 이끄는 지도자였다. ", "value": { "text_id": "3", "word_num": 8, "핵심동사": "지도자였다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "이끄는" } }, { "charNum": "96", "label": "추론형", "length": 23, "text": "마산은 김수환의 외갓집이 있는 곳이었다. ", "value": { "text_id": "4", "word_num": 6, "핵심동사": "곳이었다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "있는" } }, { "charNum": "119", "label": "추론형", "length": 50, "text": "어렸을 때 어머니를 따라서 외갓집에 자주 갔기 때문에 마산은 김수환이 잘 아는 도시였다. ", "value": { "text_id": "5", "word_num": 14, "핵심동사": "도시였다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "마산을" } }, { "charNum": "169", "label": "추론형", "length": 25, "text": "김수환은 기쁜 마음으로 마산을 향해 떠났다. ", "value": { "text_id": "6", "word_num": 7, "핵심동사": "떠났다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "마음으로/향해" } } ], "dupLabelYn": "Y", "metaData": { "ID": "310327", "FILENAME": "310327.json", "MEDIA_TYPE": "도서", "MEDIA_NAME": "커뮤니케이션북스", "CATEGORY": "역사", "PUBDATE": "20130225", "SENTENCE": "6" } } 