{ "annotation": [ { "charNum": "1", "label": "추론형", "length": 37, "text": "하지만 대한제국의 이런 노력도 일본의 거센 욕심을 막을 수 없었다.", "value": { "text_id": "1", "word_num": 10, "핵심동사": "막을", "확실성": "확실", "극성": "부정", "시제": "과거", "key_word": "거센 욕심을/없었다" } }, { "charNum": "38", "label": "추론형", "length": 44, "text": "대한제국과 만주를 서로 지배하려고 다투던 일본과 러시아는 결국 전쟁을 일으켰다.", "value": { "text_id": "2", "word_num": 10, "핵심동사": "일으켰다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "전쟁을" } }, { "charNum": "82", "label": "추론형", "length": 34, "text": "일본은 러시아에 미리 알리지 않고 몰래 먼저 공격을 시작했다.", "value": { "text_id": "3", "word_num": 9, "핵심동사": "시작했다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "먼저" } }, { "charNum": "116", "label": "추론형", "length": 17, "text": "결국 전쟁에서 일본이 승리했다.", "value": { "text_id": "4", "word_num": 4, "핵심동사": "승리했다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "결국" } }, { "charNum": "133", "label": "추론형", "length": 36, "text": "일본은 러시아까지 이기고 나자 대한제국을 완전히 지배하려고 했다.", "value": { "text_id": "5", "word_num": 8, "핵심동사": "지배하려고", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "완전히" } }, { "charNum": "169", "label": "추론형", "length": 26, "text": "그래서 대한제국에 대해 불평등 조약을 강요했다.", "value": { "text_id": "6", "word_num": 6, "핵심동사": "강요했다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "조약을" } }, { "charNum": "195", "label": "추론형", "length": 64, "text": "조약의 내용을 보면 ＇대한제국은 다른 나라와 관계를 맺을 권리가 없으며 일본의 보호를 받는 나라＇라고 되어 있었다.", "value": { "text_id": "7", "word_num": 16, "핵심동사": "되어", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "있었다" } } ], "dupLabelYn": "Y", "metaData": { "ID": "310147", "FILENAME": "310147.json", "MEDIA_TYPE": "도서", "MEDIA_NAME": "커뮤니케이션북스", "CATEGORY": "역사", "PUBDATE": "41628", "SENTENCE": "7" } } 