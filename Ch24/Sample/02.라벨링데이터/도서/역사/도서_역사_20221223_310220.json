{ "annotation": [ { "charNum": "1", "label": "추론형", "length": 13, "text": "어느 추운 겨울이었다. ", "value": { "text_id": "1", "word_num": 4, "핵심동사": "겨울이었다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "추운" } }, { "charNum": "14", "label": "추론형", "length": 19, "text": "경주의 절에 이상한 일이 있었다. ", "value": { "text_id": "2", "word_num": 6, "핵심동사": "있었다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "이상한" } }, { "charNum": "33", "label": "추론형", "length": 38, "text": "절의 연못에 개구리가 떼로 모여들어 며칠 동안이나 계속해서 울었다. ", "value": { "text_id": "3", "word_num": 10, "핵심동사": "울었다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "계속해서" } }, { "charNum": "71", "label": "추론형", "length": 53, "text": "겨울잠을 자야하는 개구리들이 떼를 지어 며칠이나 울자 백성들 사이에서는 안 좋은 소문이 퍼졌다.", "value": { "text_id": "4", "word_num": 13, "핵심동사": "퍼졌다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "소문이" } }, { "charNum": "124", "label": "대화형", "length": 36, "text": "＂겨울잠을 자야 할 개구리들이 왜 떼로 모여들어 밤낮없이 울지?＂", "value": { "text_id": "5", "word_num": 9, "핵심동사": "울지", "확실성": "확실", "극성": "미정", "시제": "현재", "key_word": " " } }, { "charNum": "160", "label": "대화형", "length": 13, "text": "＂정말 이상한 일이야.＂", "value": { "text_id": "6", "word_num": 3, "핵심동사": "이상한", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "173", "label": "대화형", "length": 24, "text": "＂신라에 안 좋은 일이 생긴 것이 분명해.＂", "value": { "text_id": "7", "word_num": 7, "핵심동사": "분명해", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } } ], "dupLabelYn": "Y", "metaData": { "ID": "310220", "FILENAME": "310220.json", "MEDIA_TYPE": "도서", "MEDIA_NAME": "커뮤니케이션북스", "CATEGORY": "역사", "PUBDATE": "20131244", "SENTENCE": "7" } } 