{ "annotation": [ { "charNum": "1", "label": "추론형", "length": 34, "text": "이 신화는 누군가가 재미를 위해 지어낸 이야기일 수도 있다. ", "value": { "text_id": "1", "word_num": 10, "핵심동사": "이야기일", "확실성": "불확실", "극성": "미정", "시제": "현재", "key_word": "수도/있다" } }, { "charNum": "35", "label": "추론형", "length": 55, "text": "하늘에서 환인의 아들이 내려오는 것, 곰이 여자가 되는 것 등은 실제로는 일어날 수 없기 때문이다.", "value": { "text_id": "2", "word_num": 15, "핵심동사": "일어날", "확실성": "확실", "극성": "부정", "시제": "미래", "key_word": "때문이다" } }, { "charNum": "90", "label": "추론형", "length": 43, "text": "하지만 옛날 사람들은 중요한 사건을 이야기로 만들어 후손들에게 전하곤 했다. ", "value": { "text_id": "3", "word_num": 11, "핵심동사": "전하곤", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": "했다" } }, { "charNum": "133", "label": "추론형", "length": 19, "text": "신화도 그런 이야기 중 하나이다. ", "value": { "text_id": "4", "word_num": 6, "핵심동사": "하나이다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": "그런" } }, { "charNum": "152", "label": "추론형", "length": 60, "text": "이렇게 생각하면 단군 신화도 재미를 위해 지어낸 이야기가 아니라 중요한 사건이 담긴 이야기라고 볼 수 있다.", "value": { "text_id": "5", "word_num": 16, "핵심동사": "볼", "확실성": "불확실", "극성": "긍정", "시제": "현재", "key_word": "수/있다" } }, { "charNum": "212", "label": "추론형", "length": 31, "text": "즉 단군 신화의 의미를 다음과 같이 생각해 볼 수 있다.", "value": { "text_id": "6", "word_num": 10, "핵심동사": "볼", "확실성": "불확실", "극성": "긍정", "시제": "현재", "key_word": "생각하면" } } ], "dupLabelYn": "Y", "metaData": { "ID": "310095", "FILENAME": "310095.json", "MEDIA_TYPE": "도서", "MEDIA_NAME": "커뮤니케이션북스", "CATEGORY": "역사", "PUBDATE": "20131220", "SENTENCE": "6" } } 