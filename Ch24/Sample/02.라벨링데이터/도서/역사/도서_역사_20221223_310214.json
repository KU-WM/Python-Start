{ "annotation": [ { "charNum": "1", "label": "추론형", "length": 27, "text": "김유신은 신라에 의해 멸망한 나라의 왕손이었다. ", "value": { "text_id": "1", "word_num": 7, "핵심동사": "왕손이었다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "나라의" } }, { "charNum": "28", "label": "추론형", "length": 32, "text": "그래서 골품제가 있는 신라에서는 능력을 보일 수 없었다. ", "value": { "text_id": "2", "word_num": 9, "핵심동사": "보일", "확실성": "확실", "극성": "부정", "시제": "과거", "key_word": "능력을" } }, { "charNum": "60", "label": "추론형", "length": 43, "text": "선덕여왕은 김유신이 나라를 위해 큰일을 할 수 있는 사람이라는 것을 알았다. ", "value": { "text_id": "3", "word_num": 12, "핵심동사": "알았다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "할/사람이라는" } }, { "charNum": "103", "label": "추론형", "length": 20, "text": "선덕여왕은 김유신에게 손을 내밀었다.", "value": { "text_id": "4", "word_num": 4, "핵심동사": "내밀었다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "손을" } }, { "charNum": "123", "label": "대화형", "length": 32, "text": "＂김유신, 나를 도와서 이 나라를 지켜 줄 수 있겠는가?＂", "value": { "text_id": "5", "word_num": 9, "핵심동사": "지켜줄", "확실성": "확실", "극성": "미정", "시제": "미래", "key_word": " " } }, { "charNum": "155", "label": "대화형", "length": 27, "text": "＂네, 여왕님의 뜻이라면 무엇이라도 하겠습니다.＂", "value": { "text_id": "6", "word_num": 5, "핵심동사": "하겠습니다", "확실성": "확실", "극성": "긍정", "시제": "미래", "key_word": " " } }, { "charNum": "182", "label": "추론형", "length": 41, "text": "김유신은 자신의 능력을 알아보고 기회를 준 선덕여왕에게 진심으로 감사했다.", "value": { "text_id": "7", "word_num": 9, "핵심동사": "감사했다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "진심으로" } } ], "dupLabelYn": "Y", "metaData": { "ID": "310214", "FILENAME": "310214.json", "MEDIA_TYPE": "도서", "MEDIA_NAME": "커뮤니케이션북스", "CATEGORY": "역사", "PUBDATE": "20131238", "SENTENCE": "7" } } 