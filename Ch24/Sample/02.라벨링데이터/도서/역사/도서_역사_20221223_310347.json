{ "annotation": [ { "charNum": "1", "label": "추론형", "length": 45, "text": "정부는 맞서는 국민들을 가만두지 않고 더욱 거칠고 강한 힘으로 억누르려고 했다. ", "value": { "text_id": "1", "word_num": 12, "핵심동사": "억누르려고", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "힘으로/했다" } }, { "charNum": "46", "label": "추론형", "length": 27, "text": "수많은 사람들이 다치거나 죽고 감옥에 잡혀갔다. ", "value": { "text_id": "2", "word_num": 7, "핵심동사": "잡혀갔다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "감옥에" } }, { "charNum": "73", "label": "추론형", "length": 23, "text": "김수환은 더 이상 보고 있을 수 없었다. ", "value": { "text_id": "3", "word_num": 8, "핵심동사": "보고", "확실성": "확실", "극성": "부정", "시제": "과거", "key_word": "있을/수/없었다" } }, { "charNum": "96", "label": "추론형", "length": 22, "text": "김수환은 새로운 대통령을 직접 만났다. ", "value": { "text_id": "4", "word_num": 6, "핵심동사": "만났다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "직접" } }, { "charNum": "118", "label": "추론형", "length": 39, "text": "그리고 정부와 맞서는 사람들을 좀 더 너그럽게 대해 달라고 부탁했다. ", "value": { "text_id": "5", "word_num": 11, "핵심동사": "부탁했다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "달라고" } }, { "charNum": "157", "label": "추론형", "length": 29, "text": "하지만 새로운 대통령은 김수환의 말을 듣지 않았다. ", "value": { "text_id": "6", "word_num": 8, "핵심동사": "듣지", "확실성": "확실", "극성": "부정", "시제": "과거", "key_word": "말을/않았다" } }, { "charNum": "186", "label": "추론형", "length": 23, "text": "정부와 가톨릭 사이의 긴장은 더욱 커졌다.", "value": { "text_id": "7", "word_num": 6, "핵심동사": "커졌다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": "더욱" } } ], "dupLabelYn": "Y", "metaData": { "ID": "310347", "FILENAME": "310347.json", "MEDIA_TYPE": "도서", "MEDIA_NAME": "커뮤니케이션북스", "CATEGORY": "역사", "PUBDATE": "20130225", "SENTENCE": "7" } } 