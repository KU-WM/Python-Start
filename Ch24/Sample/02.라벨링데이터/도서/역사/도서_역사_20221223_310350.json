{ "annotation": [ { "charNum": "1", "label": "추론형", "length": 64, "text": "그날 거리에서 소리치던 대학생들은 경찰을 피해 달아났지만 어디에도 숨을 곳이 없었기 때문에 명동성당으로 도망쳤다. ", "value": { "text_id": "1", "word_num": 15, "핵심동사": "도망쳤다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "명동성당으로" } }, { "charNum": "65", "label": "추론형", "length": 25, "text": "경찰들은 대학생들을 쫓아 명동성당까지 왔다. ", "value": { "text_id": "2", "word_num": 6, "핵심동사": "왔다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "명동성당까지" } }, { "charNum": "90", "label": "추론형", "length": 38, "text": "경찰들 은 김수환과 명동성당 신부들에게 대학생들을 내놓으라고 했다. ", "value": { "text_id": "3", "word_num": 9, "핵심동사": "했다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "내놓으라고" } }, { "charNum": "128", "label": "추론형", "length": 33, "text": "그렇지 않으면 성당에 들어가 대학생들을 잡아가겠다고 했다. ", "value": { "text_id": "4", "word_num": 8, "핵심동사": "했다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "잡아가야겠다고" } }, { "charNum": "161", "label": "추론형", "length": 38, "text": "김수환은 경찰들이 절대로 명동성당에 들어와서는 안 된다고 생각했다. ", "value": { "text_id": "5", "word_num": 9, "핵심동사": "생각했다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "안된다고" } }, { "charNum": "199", "label": "추론형", "length": 23, "text": "그리고 학생들을 잡아가게 할 수 없었다. ", "value": { "text_id": "6", "word_num": 7, "핵심동사": "할", "확실성": "확실", "극성": "부정", "시제": "과거", "key_word": "잡아가게/없었다" } }, { "charNum": "222", "label": "추론형", "length": 24, "text": "만약 잡혀가면 학생들은 무사하기 어려웠다. ", "value": { "text_id": "7", "word_num": 6, "핵심동사": "어려웠다", "확실성": "확실", "극성": "부정", "시제": "과거", "key_word": "무사하기" } }, { "charNum": "246", "label": "추론형", "length": 15, "text": "김수환은 경찰들에게 말했다.", "value": { "text_id": "8", "word_num": 3, "핵심동사": "말했다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "경찰들에게" } }, { "charNum": "261", "label": "대화형", "length": 29, "text": "＂경찰이 들어오면 맨 앞에는 내가 있을 것입니다.＂ ", "value": { "text_id": "9", "word_num": 8, "핵심동사": "있을", "확실성": "확실", "극성": "긍정", "시제": "미래", "key_word": " " } }, { "charNum": "290", "label": "대화형", "length": 33, "text": "＂그 뒤에는 신부들이, 그 뒤에는 수녀들이 있을 것입니다.＂", "value": { "text_id": "10", "word_num": 8, "핵심동사": "있을", "확실성": "확실", "극성": "긍정", "시제": "미래", "key_word": " " } }, { "charNum": "323", "label": "대화형", "length": 25, "text": "＂그리고 맨 뒤에 학생들이 있을 것입니다.＂ ", "value": { "text_id": "11", "word_num": 7, "핵심동사": "있을", "확실성": "확실", "극성": "긍정", "시제": "미래", "key_word": " " } }, { "charNum": "348", "label": "대화형", "length": 42, "text": "＂학생들을 데려가려면 나와 신부들, 수녀들을 모두 물리쳐야 할 것입니다.＂ ", "value": { "text_id": "12", "word_num": 10, "핵심동사": "물리쳐야", "확실성": "확실", "극성": "긍정", "시제": "미래", "key_word": " " } }, { "charNum": "390", "label": "추론형", "length": 27, "text": "결국 경찰들은 명동성당 안으로 들어오지 못했다. ", "value": { "text_id": "13", "word_num": 7, "핵심동사": "들어오지", "확실성": "확실", "극성": "부정", "시제": "과거", "key_word": "못했다" } } ], "dupLabelYn": "Y", "metaData": { "ID": "310350", "FILENAME": "310350.json", "MEDIA_TYPE": "도서", "MEDIA_NAME": "커뮤니케이션북스", "CATEGORY": "역사", "PUBDATE": "20130225", "SENTENCE": "13" } } 