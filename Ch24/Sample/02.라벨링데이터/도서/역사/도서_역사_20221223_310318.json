{ "annotation": [ { "charNum": "1", "label": "추론형", "length": 28, "text": "당시 ≪가톨릭신문≫은 신문이라고 하기도 어려웠다. ", "value": { "text_id": "1", "word_num": 6, "핵심동사": "어려웠다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "신문이라고/하기도" } }, { "charNum": "29", "label": "추론형", "length": 33, "text": "기자와 일하는 사람들을 모두 합쳐도 열 명이 되지 않았다. ", "value": { "text_id": "2", "word_num": 10, "핵심동사": "되지", "확실성": "확실", "극성": "부정", "시제": "과거", "key_word": "않았다" } }, { "charNum": "62", "label": "추론형", "length": 46, "text": "항상 돈이 모자라 겨우 신문을 만들었고 기자들의 월급을 주는 일조차 쉽지 않았다. ", "value": { "text_id": "3", "word_num": 13, "핵심동사": "쉽지", "확실성": "확실", "극성": "부정", "시제": "과거", "key_word": "일조차/않았다" } }, { "charNum": "108", "label": "추론형", "length": 30, "text": "하지만 김수환은 그들과 함께 열심히 신문을 만들었다. ", "value": { "text_id": "4", "word_num": 8, "핵심동사": "만들었다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "신문을" } }, { "charNum": "138", "label": "추론형", "length": 20, "text": "매일 정성을 다해 부지런히 일했다. ", "value": { "text_id": "5", "word_num": 6, "핵심동사": "일했다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "부지런히" } }, { "charNum": "158", "label": "추론형", "length": 31, "text": "그러자 조금씩 변화가 나타나고 상황이 좋아지기 시작했다.", "value": { "text_id": "6", "word_num": 7, "핵심동사": "시작했다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "좋아지기" } } ], "dupLabelYn": "Y", "metaData": { "ID": "310318", "FILENAME": "310318.json", "MEDIA_TYPE": "도서", "MEDIA_NAME": "커뮤니케이션북스", "CATEGORY": "역사", "PUBDATE": "20130225", "SENTENCE": "6" } } 