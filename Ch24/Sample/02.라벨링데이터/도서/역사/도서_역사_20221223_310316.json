{ "annotation": [ { "charNum": "1", "label": "추론형", "length": 33, "text": "독일에서 지낸 7년 동안 김수환은 많은 것을 보고 배웠다. ", "value": { "text_id": "1", "word_num": 10, "핵심동사": "배웠다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "보고" } }, { "charNum": "34", "label": "추론형", "length": 32, "text": "그중에서 가장 중요한 것은 가톨릭에 일어난 변화들이었다. ", "value": { "text_id": "2", "word_num": 8, "핵심동사": "변화들이었다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "일어난" } }, { "charNum": "66", "label": "추론형", "length": 50, "text": "가톨릭은 세상을 향해 문을 열기 시작하면서 다른 종교를 너그러운 마음으로 대하기 시작했다.", "value": { "text_id": "3", "word_num": 12, "핵심동사": "시작했다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "마음으로/대하기" } }, { "charNum": "116", "label": "추론형", "length": 29, "text": "가톨릭이 세상에서 최고라는 생각이 사라지고 있었다. ", "value": { "text_id": "4", "word_num": 7, "핵심동사": "사라지고", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "있었다" } }, { "charNum": "145", "label": "추론형", "length": 25, "text": "김수환은 이런 변화를 몸과 마음으로 느꼈다. ", "value": { "text_id": "5", "word_num": 7, "핵심동사": "느꼈다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "마음으로" } }, { "charNum": "170", "label": "추론형", "length": 30, "text": "그리고 한국 가톨릭에도 그런 변화가 일어나기를 바랐다.", "value": { "text_id": "6", "word_num": 7, "핵심동사": "바랐다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "일어나기를" } } ], "dupLabelYn": "Y", "metaData": { "ID": "310316", "FILENAME": "310316.json", "MEDIA_TYPE": "도서", "MEDIA_NAME": "커뮤니케이션북스", "CATEGORY": "역사", "PUBDATE": "20130225", "SENTENCE": "6" } } 