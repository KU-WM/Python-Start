{ "annotation": [ { "charNum": "1", "label": "추론형", "length": 34, "text": "고종의 왕비인 명성황후는 이런 일본의 태도에 두려움을 느꼈다.", "value": { "text_id": "1", "word_num": 8, "핵심동사": "느꼈다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "태도에/두려움을" } }, { "charNum": "35", "label": "추론형", "length": 23, "text": "명성황후는 일본을 조심해야겠다고 생각했다.", "value": { "text_id": "2", "word_num": 4, "핵심동사": "생각했다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "조심해야겠다고" } }, { "charNum": "58", "label": "추론형", "length": 33, "text": "그래서 러시아와 친한 사람들로 새로운 정부를 이루려고 했다.", "value": { "text_id": "3", "word_num": 8, "핵심동사": "이루려고", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "정부를" } }, { "charNum": "91", "label": "추론형", "length": 46, "text": "전쟁에서 중국이 일본에 패했기 때문에 조선이 도움을 요청할 곳은 러시아밖에 없었다.", "value": { "text_id": "4", "word_num": 11, "핵심동사": "없었다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "러시아밖에" } }, { "charNum": "137", "label": "추론형", "length": 28, "text": "일본은 명성황후의 이런 행동을 보고만 있지 않았다.", "value": { "text_id": "5", "word_num": 7, "핵심동사": "보고만", "확실성": "확실", "극성": "부정", "시제": "과거", "key_word": "않았다" } }, { "charNum": "165", "label": "추론형", "length": 40, "text": "일본은 1895년에 궁궐을 차지하고 자객을 보내 명성황후를 죽이게 했다.", "value": { "text_id": "6", "word_num": 9, "핵심동사": "죽이게", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "했다" } }, { "charNum": "205", "label": "추론형", "length": 26, "text": "일본은 명성황후를 죽이고 나서 증거들을 없앴다.", "value": { "text_id": "7", "word_num": 6, "핵심동사": "없앴다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "증거들을" } }, { "charNum": "231", "label": "추론형", "length": 44, "text": "그리고 명성황후와 사이가 좋지 않았던 흥선대원군이 죽이라고 시킨 것처럼 꾸몄다.", "value": { "text_id": "8", "word_num": 10, "핵심동사": "꾸몄다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "시킨/것처럼" } } ], "dupLabelYn": "Y", "metaData": { "ID": "310143", "FILENAME": "310143.json", "MEDIA_TYPE": "도서", "MEDIA_NAME": "커뮤니케이션북스", "CATEGORY": "역사", "PUBDATE": "20131220", "SENTENCE": "8" } } 