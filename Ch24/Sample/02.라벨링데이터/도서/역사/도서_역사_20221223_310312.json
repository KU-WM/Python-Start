{ "annotation": [ { "charNum": "1", "label": "추론형", "length": 28, "text": "하지만 공부가 언제나 힘들기만 한 것은 아니었다. ", "value": { "text_id": "1", "word_num": 8, "핵심동사": "아니었다", "확실성": "확실", "극성": "부정", "시제": "과거", "key_word": "힘들기만/한" } }, { "charNum": "29", "label": "추론형", "length": 23, "text": "처음에는 제대로 알아듣지 못해 답답했다. ", "value": { "text_id": "2", "word_num": 6, "핵심동사": "답답했다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "처음에는/못해" } }, { "charNum": "52", "label": "추론형", "length": 28, "text": "그러나 시간이 지날수록 알아듣는 내용이 많아졌다. ", "value": { "text_id": "3", "word_num": 7, "핵심동사": "많아졌다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "내용이" } }, { "charNum": "80", "label": "추론형", "length": 33, "text": "김수환은 한국에서 알던 것들이 얼마나 부족했는지 깨달았다. ", "value": { "text_id": "4", "word_num": 8, "핵심동사": "깨달았다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "부족했는지" } }, { "charNum": "113", "label": "추론형", "length": 26, "text": "그리고 얼마나 뒤떨어진 것이었는지도 깨달았다. ", "value": { "text_id": "5", "word_num": 6, "핵심동사": "깨달았다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "뒤떨어진/것이었는지도" } }, { "charNum": "139", "label": "추론형", "length": 24, "text": "김수환은 배우는 기쁨이 크다는 것을 느꼈다.", "value": { "text_id": "6", "word_num": 6, "핵심동사": "느꼈다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "기쁨이/크다는/것을" } } ], "dupLabelYn": "Y", "metaData": { "ID": "310312", "FILENAME": "310312.json", "MEDIA_TYPE": "도서", "MEDIA_NAME": "커뮤니케이션북스", "CATEGORY": "역사", "PUBDATE": "20130225", "SENTENCE": "6" } } 