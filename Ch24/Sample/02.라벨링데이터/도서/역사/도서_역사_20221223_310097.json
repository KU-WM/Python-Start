{ "annotation": [ { "charNum": "1", "label": "추론형", "length": 43, "text": "고조선은 이미 오래전에 사라졌고 고조선에 관한 기록도 거의 남아 있지 않다. ", "value": { "text_id": "1", "word_num": 12, "핵심동사": "남아", "확실성": "확실", "극성": "부정", "시제": "현재", "key_word": "거의/않다" } }, { "charNum": "44", "label": "추론형", "length": 33, "text": "따라서 고조선이 실제로 있었다는 흔적을 찾기는 쉽지 않다. ", "value": { "text_id": "2", "word_num": 9, "핵심동사": "쉽지", "확실성": "확실", "극성": "부정", "시제": "현재", "key_word": "않다" } }, { "charNum": "77", "label": "추론형", "length": 37, "text": "하지만 한국인들의 삶 속에는 고조선의 흔적들이 여전히 남아 있다. ", "value": { "text_id": "3", "word_num": 10, "핵심동사": "남아", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": "여전히" } }, { "charNum": "114", "label": "추론형", "length": 53, "text": "개천절, 홍익인간의 사상, 단기(＇단군 기원＇의 줄임말) 등은 고조선과 관련 있는 단어들이다. ", "value": { "text_id": "4", "word_num": 12, "핵심동사": "단어들이다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": "관련" } }, { "charNum": "167", "label": "추론형", "length": 16, "text": "개천절은 한국의 국경일이다. ", "value": { "text_id": "5", "word_num": 4, "핵심동사": "국경일이다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": "한국의" } }, { "charNum": "183", "label": "추론형", "length": 47, "text": "＇하늘이 열린 날＇이라는 뜻으로 고조선이 건국된 날이라고 전해지는 10월 3일이다. ", "value": { "text_id": "6", "word_num": 11, "핵심동사": "3일이다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": "전해지는" } }, { "charNum": "230", "label": "추론형", "length": 47, "text": "그리고 홍익인간은 ＇인간을 널리 이롭게 한다＇는 뜻으로 단군 신화에 나오는 말이다. ", "value": { "text_id": "7", "word_num": 12, "핵심동사": "말이다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": "나오는" } }, { "charNum": "277", "label": "추론형", "length": 36, "text": "서울에 있는 ＇홍익대학교＇는 학교 이름에 ＇홍익＇을 쓰고 있다. ", "value": { "text_id": "8", "word_num": 9, "핵심동사": "쓰고", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": "쓰고" } }, { "charNum": "313", "label": "추론형", "length": 45, "text": "단기는 단군이 나라를 세운 기원전 2333년을 시작으로 연도를 표시하는 방법이다.", "value": { "text_id": "9", "word_num": 10, "핵심동사": "방법이다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": "표시하는" } }, { "charNum": "358", "label": "추론형", "length": 48, "text": "단기는 연도를 표시하는 서기와 함께 사용되다가 1962년부터 공식적으로는 폐지되었다. ", "value": { "text_id": "10", "word_num": 10, "핵심동사": "폐지되었다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "공식적으로는" } }, { "charNum": "406", "label": "추론형", "length": 38, "text": "하지만 개천절을 기념하는 행사 등에서는 아직도 단기를 쓰기도 한다. ", "value": { "text_id": "11", "word_num": 10, "핵심동사": "쓰기도", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": "단기를" } }, { "charNum": "444", "label": "추론형", "length": 38, "text": "서기 2013년은 단기로 4346년(2333+2013=4346)이다.", "value": { "text_id": "12", "word_num": 4, "핵심동사": "4346년(2333+2013=4346)이다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": "단기로" } } ], "dupLabelYn": "Y", "metaData": { "ID": "310097", "FILENAME": "310097.json", "MEDIA_TYPE": "도서", "MEDIA_NAME": "커뮤니케이션북스", "CATEGORY": "역사", "PUBDATE": "20131220", "SENTENCE": "12" } } 