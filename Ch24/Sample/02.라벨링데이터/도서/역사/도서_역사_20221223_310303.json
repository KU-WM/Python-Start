{ "annotation": [ { "charNum": "1", "label": "추론형", "length": 36, "text": "시간이 지나자 안동 성당 신자들은 점점 김수환을 따르게 되었다. ", "value": { "text_id": "1", "word_num": 10, "핵심동사": "따르게", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "되었다" } }, { "charNum": "37", "label": "추론형", "length": 44, "text": "김수환이 볼일이 있어서 다른 지방에 가게 되면, 신자들은 그를 붙잡고 말했다. ", "value": { "text_id": "2", "word_num": 12, "핵심동사": "말했다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "붙잡고" } }, { "charNum": "81", "label": "대화형", "length": 14, "text": "＂신부님, 가지 마세요.＂", "value": { "text_id": "3", "word_num": 3, "핵심동사": "마세요", "확실성": "확실", "극성": "부정", "시제": "현재", "key_word": " " } }, { "charNum": "95", "label": "대화형", "length": 33, "text": "＂신부님이 하루라도 안 계시면 성당이 텅 빈 것 같아요.＂ ", "value": { "text_id": "4", "word_num": 10, "핵심동사": "빈", "확실성": "불확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "128", "label": "추론형", "length": 26, "text": "신자들의 말에 김수환은 눈물이 날만큼 기뻤다. ", "value": { "text_id": "5", "word_num": 7, "핵심동사": "기뻤다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "눈물이/날만큼" } }, { "charNum": "154", "label": "추론형", "length": 24, "text": "그래서 일을 마치면 서둘러 돌아오곤 했다. ", "value": { "text_id": "6", "word_num": 7, "핵심동사": "돌아오곤", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "서둘러" } } ], "dupLabelYn": "Y", "metaData": { "ID": "310303", "FILENAME": "310303.json", "MEDIA_TYPE": "도서", "MEDIA_NAME": "커뮤니케이션북스", "CATEGORY": "역사", "PUBDATE": "20130225", "SENTENCE": "6" } } 