{ "annotation": [ { "charNum": "1", "label": "추론형", "length": 34, "text": "진평왕의 명령으로 신하들은 궁궐의 신하 뜰에 꽃씨를 심었다. ", "value": { "text_id": "1", "word_num": 9, "핵심동사": "심었다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "꽃씨를" } }, { "charNum": "35", "label": "추론형", "length": 22, "text": "시간이 흘러 모란꽃이 아름답게 피었다. ", "value": { "text_id": "2", "word_num": 6, "핵심동사": "피었다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "아름답게" } }, { "charNum": "57", "label": "추론형", "length": 14, "text": "정말 아름다운 꽃이었다. ", "value": { "text_id": "3", "word_num": 4, "핵심동사": "꽃이었다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "아름다운" } }, { "charNum": "71", "label": "추론형", "length": 30, "text": "이 아름다운 꽃에 향기가 없다는 것은 믿기 어려웠다. ", "value": { "text_id": "4", "word_num": 9, "핵심동사": "어려웠다", "확실성": "확실", "극성": "부정", "시제": "과거", "key_word": "믿기" } }, { "charNum": "101", "label": "추론형", "length": 37, "text": "덕만 공주의 말을 생각하며 진평왕은 모란꽃을 향해 고개를 숙였다. ", "value": { "text_id": "5", "word_num": 10, "핵심동사": "숙였다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "고개를" } }, { "charNum": "138", "label": "추론형", "length": 15, "text": "그리고 다시 한 번 놀랐다.", "value": { "text_id": "6", "word_num": 5, "핵심동사": "놀랐다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "다시" } }, { "charNum": "153", "label": "대화형", "length": 27, "text": "＂덕만 공주의 말처럼 이 꽃에는 향기가 없구나!＂", "value": { "text_id": "7", "word_num": 7, "핵심동사": "없구나", "확실성": "확실", "극성": "부정", "시제": "과거", "key_word": " " } }, { "charNum": "180", "label": "추론형", "length": 47, "text": "진평왕은 덕만 공주에게 어떻게 그림을 보고 꽃에 향기가 없다는 것을 알았는지 물었다.", "value": { "text_id": "8", "word_num": 12, "핵심동사": "물었다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "알았는지" } }, { "charNum": "227", "label": "대화형", "length": 26, "text": "＂향기가 있는 꽃에는 나비와 벌이 모여듭니다.＂", "value": { "text_id": "9", "word_num": 6, "핵심동사": "모여듭니다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": " " } }, { "charNum": "253", "label": "대화형", "length": 33, "text": "＂그런데 이 꽃 그림에는 나비와 벌이 한 마리도 없습니다.＂", "value": { "text_id": "10", "word_num": 9, "핵심동사": "없습니다", "확실성": "확실", "극성": "부정", "시제": "과거", "key_word": " " } }, { "charNum": "286", "label": "추론형", "length": 12, "text": "덕만 공주가 대답했다.", "value": { "text_id": "11", "word_num": 3, "핵심동사": "대답했다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "대답했다" } }, { "charNum": "298", "label": "추론형", "length": 41, "text": "이 말을 들은 진평왕은 물론 신하들도 모두 덕만 공주의 지혜에 감탄했다. ", "value": { "text_id": "12", "word_num": 12, "핵심동사": "감탄했다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "지혜에" } }, { "charNum": "339", "label": "추론형", "length": 37, "text": "특히 진평왕은 왕의 자리를 덕만공주에게 물려주어야겠다고 결심했다. ", "value": { "text_id": "13", "word_num": 8, "핵심동사": "결심했다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "물려주어야겠다고" } }, { "charNum": "376", "label": "추론형", "length": 33, "text": "귀족과 신하들도 뛰어난 공주의 지혜를 인정할 수밖에 없었다.", "value": { "text_id": "14", "word_num": 8, "핵심동사": "인정할", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "수밖에/없었다" } } ], "dupLabelYn": "Y", "metaData": { "ID": "310200", "FILENAME": "310200.json", "MEDIA_TYPE": "도서", "MEDIA_NAME": "커뮤니케이션북스", "CATEGORY": "역사", "PUBDATE": "20131224", "SENTENCE": "14" } } 