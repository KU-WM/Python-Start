{ "annotation": [ { "charNum": "1", "label": "추론형", "length": 41, "text": "서양의 여러 나라들과 마찬가지로 일본도 계속해서 조선에 교류를 요구했다. ", "value": { "text_id": "1", "word_num": 10, "핵심동사": "요구했다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "교류를" } }, { "charNum": "42", "label": "추론형", "length": 47, "text": "일본은 조선의 항구를 열고 외국 배와 사람들이 마음껏 드나들 수 있게 하라고 했다. ", "value": { "text_id": "2", "word_num": 14, "핵심동사": "했다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "하라고" } }, { "charNum": "89", "label": "추론형", "length": 23, "text": "그때마다 조선은 일본의 요구를 거절했다. ", "value": { "text_id": "3", "word_num": 6, "핵심동사": "거절했다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "요구를" } }, { "charNum": "112", "label": "추론형", "length": 35, "text": "그러자 일본은 군대를 이끌고 와서 조선을 공격하겠다고 위협했다.", "value": { "text_id": "4", "word_num": 8, "핵심동사": "위협했다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "공격하겠다고" } }, { "charNum": "147", "label": "추론형", "length": 46, "text": "결국 일본의 힘을 이기지 못한 조선은 1876년에 일본의 요구를 들어주고 말았다. ", "value": { "text_id": "5", "word_num": 12, "핵심동사": "들어주고", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "말았다" } }, { "charNum": "193", "label": "추론형", "length": 20, "text": "그리고 일본과 교류하겠다고 약속했다.", "value": { "text_id": "6", "word_num": 4, "핵심동사": "약속했다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "교류하겠다고" } }, { "charNum": "213", "label": "추론형", "length": 33, "text": "이것은 조선이 외국과 맺은 첫 번째의 근대적인 조약이었다. ", "value": { "text_id": "7", "word_num": 9, "핵심동사": "조약이었다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "근대적인" } }, { "charNum": "246", "label": "추론형", "length": 25, "text": "하지만 일본에게만 유리한 불평등 조약이었다. ", "value": { "text_id": "8", "word_num": 6, "핵심동사": "조약이었다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "불평등" } } ], "dupLabelYn": "Y", "metaData": { "ID": "310133", "FILENAME": "310133.json", "MEDIA_TYPE": "도서", "MEDIA_NAME": "커뮤니케이션북스", "CATEGORY": "역사", "PUBDATE": "20131220", "SENTENCE": "8" } } 