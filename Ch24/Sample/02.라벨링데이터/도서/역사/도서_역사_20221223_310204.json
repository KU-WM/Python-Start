{ "annotation": [ { "charNum": "1", "label": "추론형", "length": 32, "text": "그리고 왕과 궁궐을 보호하는 군대를 더 강하게 만들었다. ", "value": { "text_id": "1", "word_num": 9, "핵심동사": "만들었다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "강하게" } }, { "charNum": "33", "label": "추론형", "length": 44, "text": "이전까지는 귀족들의 군대가 왕의 군대보다 더 강했기 때문에 왕의 힘이 약했다. ", "value": { "text_id": "2", "word_num": 12, "핵심동사": "약했다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "힘이" } }, { "charNum": "77", "label": "추론형", "length": 44, "text": "진평왕은 덕만 공주에게 강한 권력을 만들어 주기 위해서 왕의 군대를 강화했다. ", "value": { "text_id": "3", "word_num": 12, "핵심동사": "강화했다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "군대를" } }, { "charNum": "121", "label": "추론형", "length": 46, "text": "진평왕이 노력했지만, 덕만공주가 왕이 되는 것을 반대하는 귀족들이 모이기 시작했다.", "value": { "text_id": "4", "word_num": 10, "핵심동사": "시작했다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "모이기" } }, { "charNum": "167", "label": "대화형", "length": 36, "text": "＂아무리 능력이 있는 공주라고 해도 여자가 왕이 될 수는 없다!＂", "value": { "text_id": "5", "word_num": 10, "핵심동사": "될", "확실성": "확실", "극성": "부정", "시제": "미래", "key_word": " " } }, { "charNum": "203", "label": "추론형", "length": 30, "text": "결국 이들은 진평왕의 뜻을 거스르고 반란을 준비했다. ", "value": { "text_id": "6", "word_num": 8, "핵심동사": "준비했다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "반란을" } }, { "charNum": "233", "label": "추론형", "length": 42, "text": "당시 신라의 귀족들은 많은 사병을 거느리고 있었고, 그 힘이 아주 강했다. ", "value": { "text_id": "7", "word_num": 12, "핵심동사": "강했다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "아주" } }, { "charNum": "275", "label": "추론형", "length": 42, "text": "이들이 반란을 준비하고 있다는 사실을 알게 된 진평왕은 화가 나서 명령했다.", "value": { "text_id": "8", "word_num": 11, "핵심동사": "명령했다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "화가/나서" } }, { "charNum": "317", "label": "대화형", "length": 18, "text": "＂감히 반란을 일으키려 하다니!＂", "value": { "text_id": "9", "word_num": 4, "핵심동사": "일으키려", "확실성": "확실", "극성": "긍정", "시제": "미래", "key_word": " " } }, { "charNum": "335", "label": "대화형", "length": 14, "text": "＂이들을 반드시 잡아라.＂", "value": { "text_id": "10", "word_num": 3, "핵심동사": "잡아라", "확실성": "확실", "극성": "긍정", "시제": "미래", "key_word": " " } }, { "charNum": "349", "label": "추론형", "length": 44, "text": "진평왕의 명령에 따라 군사들이 반란을 준비하던 귀족들 중 한 명을 잡아 왔다. ", "value": { "text_id": "11", "word_num": 13, "핵심동사": "잡아왔다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "준비하던" } }, { "charNum": "393", "label": "추론형", "length": 16, "text": "진평왕은 이 귀족을 죽였다. ", "value": { "text_id": "12", "word_num": 5, "핵심동사": "죽였다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "귀족을" } }, { "charNum": "409", "label": "추론형", "length": 22, "text": "그리고 그의 먼 친척까지 모두 죽였다. ", "value": { "text_id": "13", "word_num": 7, "핵심동사": "죽였다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "모두" } }, { "charNum": "431", "label": "추론형", "length": 39, "text": "다른 귀족 한 명은 멀리 백제 근처까지 도망쳤지만 결국 붙잡혀 왔다. ", "value": { "text_id": "14", "word_num": 12, "핵심동사": "왔다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "붙잡혀" } }, { "charNum": "470", "label": "추론형", "length": 25, "text": "그리고 모든 사람이 보는 앞에서 처형당했다. ", "value": { "text_id": "15", "word_num": 7, "핵심동사": "처형당했다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "앞에서" } }, { "charNum": "495", "label": "추론형", "length": 28, "text": "진평왕은 반란을 준비한 귀족들을 엄하게 처벌했다. ", "value": { "text_id": "16", "word_num": 7, "핵심동사": "처벌했다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "엄하게" } }, { "charNum": "523", "label": "추론형", "length": 40, "text": "그래서 다른 귀족들이 덕만 공주가 왕이 되는 것을 반대하지 못하게 했다.", "value": { "text_id": "17", "word_num": 11, "핵심동사": "반대하지", "확실성": "확실", "극성": "부정", "시제": "과거", "key_word": "못하게/했다" } } ], "dupLabelYn": "Y", "metaData": { "ID": "310204", "FILENAME": "310204.json", "MEDIA_TYPE": "도서", "MEDIA_NAME": "커뮤니케이션북스", "CATEGORY": "역사", "PUBDATE": "20131228", "SENTENCE": "17" } } 