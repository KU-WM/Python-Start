{ "annotation": [ { "charNum": "1", "label": "추론형", "length": 36, "text": "선덕여왕은 백성 한 사람, 한 사람을 따뜻하게 대하는 왕이었다. ", "value": { "text_id": "1", "word_num": 10, "핵심동사": "왕이었다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "대하는" } }, { "charNum": "37", "label": "추론형", "length": 34, "text": "어느 날 ＇지귀＇라는 청년이 우연히 선덕여왕을 보게 되었다. ", "value": { "text_id": "2", "word_num": 9, "핵심동사": "보게", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "되었다" } }, { "charNum": "71", "label": "추론형", "length": 32, "text": "지귀는 선덕여왕을 보자마자 한눈에 반해서 사랑에 빠졌다. ", "value": { "text_id": "3", "word_num": 8, "핵심동사": "빠졌다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "사랑에" } }, { "charNum": "103", "label": "추론형", "length": 18, "text": "지귀는 신분이 낮은 청년이었다. ", "value": { "text_id": "4", "word_num": 5, "핵심동사": "청년이었다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "낮은" } }, { "charNum": "121", "label": "추론형", "length": 36, "text": "그래서 선덕여왕에 대한 지귀의 사랑은 이룰 수가 없는 사랑이었다.", "value": { "text_id": "5", "word_num": 9, "핵심동사": "사랑이었다", "확실성": "확실", "극성": "부정", "시제": "과거", "key_word": "이룰/수가/없는" } }, { "charNum": "157", "label": "추론형", "length": 32, "text": "하지만 지귀는 선덕여왕에 대한 사랑을 멈출 수가 없었다. ", "value": { "text_id": "6", "word_num": 9, "핵심동사": "멈출", "확실성": "확실", "극성": "부정", "시제": "과거", "key_word": "수가/없었다" } }, { "charNum": "189", "label": "추론형", "length": 37, "text": "지귀는 선덕여왕이 너무 보고 싶어 그리워하다가 그만 병에 걸렸다. ", "value": { "text_id": "7", "word_num": 10, "핵심동사": "걸렸다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "병에" } }, { "charNum": "226", "label": "추론형", "length": 31, "text": "선덕여왕을 만날 수 없는 지귀는 점점 더 몸이 약해졌다.", "value": { "text_id": "8", "word_num": 9, "핵심동사": "약해졌다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "몸이" } } ], "dupLabelYn": "Y", "metaData": { "ID": "310207", "FILENAME": "310207.json", "MEDIA_TYPE": "도서", "MEDIA_NAME": "커뮤니케이션북스", "CATEGORY": "역사", "PUBDATE": "20131231", "SENTENCE": "8" } } 