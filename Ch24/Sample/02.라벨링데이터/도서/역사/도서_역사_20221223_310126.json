{ "annotation": [ { "charNum": "1", "label": "추론형", "length": 38, "text": "조선은 16세기 말부터 17세기 초까지 두 번의 큰 전쟁을 치른다. ", "value": { "text_id": "1", "word_num": 11, "핵심동사": "치른다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "큰/전쟁을" } }, { "charNum": "39", "label": "추론형", "length": 53, "text": "1592년부터 7년 동안은 일본과 싸웠고, 1627년과 1636년에는 중국의 청나라와 싸웠다. ", "value": { "text_id": "2", "word_num": 11, "핵심동사": "싸웠다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "청나라와" } }, { "charNum": "92", "label": "추론형", "length": 28, "text": "두 나라와의 전쟁 이후 조선에는 변화가 나타난다. ", "value": { "text_id": "3", "word_num": 8, "핵심동사": "나타난다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "변화가" } }, { "charNum": "120", "label": "추론형", "length": 25, "text": "이전까지 조선의 학문은 성리학이 중심이었다. ", "value": { "text_id": "4", "word_num": 6, "핵심동사": "중심이었다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "성리학이" } }, { "charNum": "145", "label": "추론형", "length": 27, "text": "성리학은 실제 생활보다 생각을 중요하게 여겼다. ", "value": { "text_id": "5", "word_num": 7, "핵심동사": "여겼다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "중요하게" } }, { "charNum": "172", "label": "추론형", "length": 54, "text": "그리고 지켜야 할 규칙과 법을 지나치게 강조했기 때문에 실제 생활과 맞지 않는 가르침도 많았다. ", "value": { "text_id": "6", "word_num": 15, "핵심동사": "많았다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "맞지/않는" } }, { "charNum": "226", "label": "추론형", "length": 55, "text": "특히 전쟁 때문에 피해를 본 사람들을 돕고 나라를 복구하는 일에 성리학은 큰 도움을 주지 못했다. ", "value": { "text_id": "7", "word_num": 16, "핵심동사": "주지", "확실성": "확실", "극성": "부정", "시제": "과거", "key_word": "도움을/못했다" } } ], "dupLabelYn": "Y", "metaData": { "ID": "310126", "FILENAME": "310126.json", "MEDIA_TYPE": "도서", "MEDIA_NAME": "커뮤니케이션북스", "CATEGORY": "역사", "PUBDATE": "20131220", "SENTENCE": "7" } } 