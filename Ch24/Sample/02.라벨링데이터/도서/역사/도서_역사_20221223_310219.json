{ "annotation": [ { "charNum": "1", "label": "추론형", "length": 41, "text": "첨성대는 별과 해와 달이 어떻게 움직이는지를 관찰할 수 있는 천문대이다. ", "value": { "text_id": "1", "word_num": 11, "핵심동사": "천문대이다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": "관찰할/수/있는" } }, { "charNum": "42", "label": "추론형", "length": 28, "text": "첨성대는 한 해의 날수만큼의 돌을 쌓아 만들었다. ", "value": { "text_id": "2", "word_num": 8, "핵심동사": "만들었다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "돌을/쌓아" } }, { "charNum": "70", "label": "추론형", "length": 22, "text": "첨성대의 몸통은 27단으로 이루어졌다. ", "value": { "text_id": "3", "word_num": 5, "핵심동사": "이루어졌다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "27단으로" } }, { "charNum": "92", "label": "추론형", "length": 27, "text": "맨 꼭대기에 있는 단을 합하면 모두 28단이다. ", "value": { "text_id": "4", "word_num": 8, "핵심동사": "28단이다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": "모두" } }, { "charNum": "119", "label": "추론형", "length": 18, "text": "28은 동양의 별자리 숫자이다. ", "value": { "text_id": "5", "word_num": 5, "핵심동사": "숫자이다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": "별자리" } }, { "charNum": "137", "label": "추론형", "length": 49, "text": "또한 첨성대 중앙에 낸 창문을 중심으로 위로 12단, 아래로 12단으로 이루어져 있다. ", "value": { "text_id": "6", "word_num": 13, "핵심동사": "이루어져", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": "12단으로/있다" } }, { "charNum": "186", "label": "추론형", "length": 62, "text": "12단은 12개월을 말하고, 위와 아래를 합친 24단은 태양의 운동을 바탕으로 계절을 나눈 24절기를 의미한다.", "value": { "text_id": "7", "word_num": 14, "핵심동사": "의미한다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": "24절기를" } }, { "charNum": "248", "label": "추론형", "length": 63, "text": "하늘과 별을 관찰하는 천문대가 세워진 뒤에는 별의 위치와 별이 사라진 위치까지도 정확하게 기록할 수 있게 되었다.", "value": { "text_id": "8", "word_num": 16, "핵심동사": "기록할", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "정확하게/있게/되었다" } }, { "charNum": "311", "label": "추론형", "length": 68, "text": "선덕여왕이 세운 첨성대는 동양에서 제일 오래된 천문대이고, 현재까지 남아 있는 천문대 중 세계에서 가장 오래된 천문대이다.", "value": { "text_id": "9", "word_num": 16, "핵심동사": "천문대이다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": "가장/오래된" } }, { "charNum": "379", "label": "추론형", "length": 33, "text": "백성을 사랑해 천문학을 연구했던 선덕여왕은 첨성대를 남겼다.", "value": { "text_id": "10", "word_num": 7, "핵심동사": "남겼다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "첨성대를" } } ], "dupLabelYn": "Y", "metaData": { "ID": "310219", "FILENAME": "310219.json", "MEDIA_TYPE": "도서", "MEDIA_NAME": "커뮤니케이션북스", "CATEGORY": "역사", "PUBDATE": "20131243", "SENTENCE": "10" } } 