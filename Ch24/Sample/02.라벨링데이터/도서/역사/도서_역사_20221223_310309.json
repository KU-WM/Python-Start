{ "annotation": [ { "charNum": "1", "label": "추론형", "length": 23, "text": "당시 독일에는 한국 사람이 거의 없었다. ", "value": { "text_id": "1", "word_num": 7, "핵심동사": "없었다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "거의" } }, { "charNum": "24", "label": "추론형", "length": 27, "text": "김수환이 있는 도시에 한국인은 두세 명뿐이었다. ", "value": { "text_id": "2", "word_num": 7, "핵심동사": "두세 명뿐이었다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "한국인은" } }, { "charNum": "51", "label": "추론형", "length": 24, "text": "길을 걸으면 사람들이 김수환을 쳐다보았다. ", "value": { "text_id": "3", "word_num": 6, "핵심동사": "쳐다보았다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "김수환을" } }, { "charNum": "75", "label": "추론형", "length": 33, "text": "사람들은 자신들과 다르게 생긴 모습을 신기한 듯이 보았다. ", "value": { "text_id": "4", "word_num": 9, "핵심동사": "보았다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "신기한/듯이" } }, { "charNum": "108", "label": "추론형", "length": 27, "text": "버스에 타면 놀라서 그를 피하는 사람도 있었다. ", "value": { "text_id": "5", "word_num": 8, "핵심동사": "있었다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "사람도" } }, { "charNum": "135", "label": "추론형", "length": 30, "text": "한국 사람이 없으니까 한국 음식을 파는 곳도 없었다. ", "value": { "text_id": "6", "word_num": 9, "핵심동사": "없었다", "확실성": "확실", "극성": "부정", "시제": "과거", "key_word": "파는/곳도" } }, { "charNum": "165", "label": "추론형", "length": 23, "text": "그래서 혼자 밥을 해서 먹는 날도 많았다.", "value": { "text_id": "7", "word_num": 7, "핵심동사": "많았다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "먹는/날도" } } ], "dupLabelYn": "Y", "metaData": { "ID": "310309", "FILENAME": "310309.json", "MEDIA_TYPE": "도서", "MEDIA_NAME": "커뮤니케이션북스", "CATEGORY": "역사", "PUBDATE": "20130225", "SENTENCE": "7" } } 