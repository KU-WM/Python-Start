{ "annotation": [ { "charNum": "1", "label": "추론형", "length": 38, "text": "김수환이 만난 죄수들 중에는 영원히 잊지 못할 사람이 하나 있었다. ", "value": { "text_id": "1", "word_num": 11, "핵심동사": "있었다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "사람이" } }, { "charNum": "39", "label": "추론형", "length": 26, "text": "그는 사형을 받기로 되어 있는 젊은 죄수였다. ", "value": { "text_id": "2", "word_num": 8, "핵심동사": "죄수였다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "젊은" } }, { "charNum": "65", "label": "추론형", "length": 32, "text": "그는 사람을 죽이고 돈을 훔친 죄로 감옥에 왔다고 했다. ", "value": { "text_id": "3", "word_num": 10, "핵심동사": "했다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "왔다고" } }, { "charNum": "97", "label": "추론형", "length": 26, "text": "젊은 죄수는 감옥에서 천주교를 믿기 시작했다. ", "value": { "text_id": "4", "word_num": 7, "핵심동사": "시작했다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "믿기" } }, { "charNum": "123", "label": "추론형", "length": 20, "text": "그리고 자기의 죄를 크게 뉘우쳤다. ", "value": { "text_id": "5", "word_num": 6, "핵심동사": "뉘우쳤다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "크게" } }, { "charNum": "143", "label": "추론형", "length": 27, "text": "착한 눈빛만 보아도 그의 마음을 알 수 있었다. ", "value": { "text_id": "6", "word_num": 9, "핵심동사": "알", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "수/있었다" } } ], "dupLabelYn": "Y", "metaData": { "ID": "310323", "FILENAME": "310323.json", "MEDIA_TYPE": "도서", "MEDIA_NAME": "커뮤니케이션북스", "CATEGORY": "역사", "PUBDATE": "20130225", "SENTENCE": "6" } } 