{ "annotation": [ { "charNum": "1", "label": "사실형", "length": 23, "text": "2020년에도 ＇문재인 케어＇는 직진한다.", "value": { "text_id": "1", "word_num": 4, "핵심동사": "직진한다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "25", "label": "사실형", "length": 41, "text": "최근 발표된 ＇국민건강보험 종합계획 2020년 시행계획＇을 살펴본 결과다.", "value": { "text_id": "2", "word_num": 8, "핵심동사": "결과다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "67", "label": "사실형", "length": 41, "text": "문재인 케어는 건강보험 적용 범위를 넓히고 보장성을 강화하는 것이 골자다.", "value": { "text_id": "3", "word_num": 10, "핵심동사": "골자다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "109", "label": "사실형", "length": 85, "text": "2017년 문재인정부는 ＇5년간 30조6000억원을 들여 미용·성형 등을 제외한 모든 의학적 비급여를 건강보험에서 보장하겠다＇는 계획을 발표한 바 있다.", "value": { "text_id": "4", "word_num": 17, "핵심동사": "발표한", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": " " } }, { "charNum": "195", "label": "추론형", "length": 56, "text": "물론 과도한 의료비 부담으로 적절한 검사나 치료가 어려웠던 환자들이 혜택을 받는다는 점은 긍정적이다.", "value": { "text_id": "5", "word_num": 13, "핵심동사": "긍정적이다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": "긍정적이다" } }, { "charNum": "252", "label": "추론형", "length": 15, "text": "하지만 역시 문제는 돈이다.", "value": { "text_id": "6", "word_num": 4, "핵심동사": "돈이다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": "돈이다" } }, { "charNum": "268", "label": "사실형", "length": 48, "text": "건강보험은 2019년 당기 수지 적자 약 3조2000억원을 기록하며 흔들리는 모습이다.", "value": { "text_id": "7", "word_num": 10, "핵심동사": "모습이다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "317", "label": "사실형", "length": 38, "text": "2020년 환자 본인 부담률이 되레 지난해보다 높아지는 항목도 있다.", "value": { "text_id": "8", "word_num": 9, "핵심동사": "있다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } } ], "dupLabelYn": "Y", "metaData": { "ID": "230149", "FILENAME": "230149.json", "MEDIA_TYPE": "매거진", "MEDIA_NAME": "매경이코노미", "CATEGORY": "금융", "PUBDATE": "20200106", "SENTENCE": "8" } } 