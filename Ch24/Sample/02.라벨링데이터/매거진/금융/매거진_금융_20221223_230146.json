{ "annotation": [ { "charNum": "1", "label": "추론형", "length": 51, "text": "상속증여세법 개정에 따라 6억원 한도에서 주택가격의 100%를 상속세에서 공제받을 수 있다.", "value": { "text_id": "1", "word_num": 11, "핵심동사": "공제받을", "확실성": "불확실", "극성": "긍정", "시제": "미래", "key_word": "공제받을" } }, { "charNum": "53", "label": "사실형", "length": 30, "text": "지금까지는 5억원 한도로 주택가격 80%를 공제받았다.", "value": { "text_id": "2", "word_num": 6, "핵심동사": "공제받았다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": " " } }, { "charNum": "84", "label": "사실형", "length": 14, "text": "상속공제 기준도 완화했다.", "value": { "text_id": "3", "word_num": 3, "핵심동사": "완화했다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": " " } }, { "charNum": "99", "label": "사실형", "length": 70, "text": "상속 시작 시점에서 자녀의 요건을 ＇무주택자＇에서 ＇무주택자 또는 피상속인과 공동으로 1가구 1주택을 보유한 자＇로 확대했다.", "value": { "text_id": "4", "word_num": 15, "핵심동사": "확대했다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": " " } }, { "charNum": "170", "label": "사실형", "length": 56, "text": "공동명의로 해당 주택을 보유했을 경우 동거 주택 상속공제 혜택을 받지 못하던 것을 구제하려는 취지다.", "value": { "text_id": "5", "word_num": 14, "핵심동사": "취지다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "227", "label": "사실형", "length": 86, "text": "정부 관계자는 ＂주택가격 상승 등 현실을 반영하고 10년 이상 동거해 공제를 받는 사례가 적어 효도 장려 측면에서 해당 내용을 추가하게 됐다＂고 설명했다.", "value": { "text_id": "6", "word_num": 22, "핵심동사": "설명했다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": " " } } ], "dupLabelYn": "Y", "metaData": { "ID": "230146", "FILENAME": "230146.json", "MEDIA_TYPE": "매거진", "MEDIA_NAME": "매경이코노미", "CATEGORY": "금융", "PUBDATE": "20200106", "SENTENCE": "6" } } 