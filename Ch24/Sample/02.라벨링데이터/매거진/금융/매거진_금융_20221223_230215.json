{ "annotation": [ { "charNum": "1", "label": "사실형", "length": 36, "text": "지난 70여년 동안 세계 경제를 주도한 것은 GDP라는 지표였다.", "value": { "text_id": "1", "word_num": 9, "핵심동사": "지표였다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": " " } }, { "charNum": "37", "label": "사실형", "length": 29, "text": "＇GDP가 클수록 잘사는 나라＇라는 인식은 견고하다.", "value": { "text_id": "2", "word_num": 6, "핵심동사": "견고하다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "66", "label": "사실형", "length": 18, "text": "각국은 GDP 키우기에 급급했다.", "value": { "text_id": "3", "word_num": 4, "핵심동사": "급급했다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": " " } }, { "charNum": "84", "label": "사실형", "length": 29, "text": "그 결과 전 세계 GDP는 실제로 계속 성장 중이다.", "value": { "text_id": "4", "word_num": 9, "핵심동사": "성장 중이다", "확실성": "확실", "극성": "미정", "시제": "현재", "key_word": " " } }, { "charNum": "113", "label": "사실형", "length": 29, "text": "하지만 그 뒤에는 여러 중요한 문제들이 가려져 있다.", "value": { "text_id": "5", "word_num": 8, "핵심동사": "가려져", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "142", "label": "사실형", "length": 14, "text": "소득 불평등이 대표적이다.", "value": { "text_id": "6", "word_num": 3, "핵심동사": "대표적이다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "156", "label": "대화형", "length": 74, "text": "나라 경제는 계속 성장한다는데 개인 생활 수준은 점점 더 나빠진다면, 대체 이 ＇성장＇이라는 건 무엇을, 그리고 누구를 위한 것일까.", "value": { "text_id": "7", "word_num": 19, "핵심동사": "위한", "확실성": "불확실", "극성": "미정", "시제": "현재", "key_word": " " } }, { "charNum": "230", "label": "사실형", "length": 83, "text": "파이낸셜타임즈에서 약 30년간 근무한 기자 출신 저자는 경제성장 만능주의로부터 나타나는 문제들을 통해 기존 경제 측정 방식의 한계를 낱낱이 고발한다.", "value": { "text_id": "8", "word_num": 19, "핵심동사": "고발한다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": " " } }, { "charNum": "313", "label": "사실형", "length": 36, "text": "그는 `GDP는 현실을 제대로 반영하지 못하고 있다`고 역설한다.", "value": { "text_id": "9", "word_num": 8, "핵심동사": "역설한다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "349", "label": "사실형", "length": 98, "text": "GDP는 공공 서비스에 대한 정부의 지출, 가사노동 등을 외면하고 나아가 불평등의 심화나 국가 간 대규모 무역수지 불균형 같은 중요한 문제에 관해서도 설명하지 못한다는 것이다.", "value": { "text_id": "10", "word_num": 24, "핵심동사": "설명하지", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "447", "label": "추론형", "length": 44, "text": "GDP가 제대로 측정하지 못했던 ＇자연자본＇과 ＇행복＇에 대한 논의도 필요하다.", "value": { "text_id": "11", "word_num": 9, "핵심동사": "필요하다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": "필요하다" } }, { "charNum": "491", "label": "사실형", "length": 64, "text": "저자는 현재까지 GDP가 일으킨 문제들, 그리고 간과한 부분들이 있었다는 걸 우선 인정하는 것이 중요하다고 말한다.", "value": { "text_id": "12", "word_num": 15, "핵심동사": "말한다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "555", "label": "추론형", "length": 22, "text": "GDP는 유용하지만 단독으로는 위험하다.", "value": { "text_id": "13", "word_num": 4, "핵심동사": "위험하다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": "위험하다" } }, { "charNum": "577", "label": "사실형", "length": 77, "text": "1인당 GDP, 소득 중간값, 웰빙 등 새로운 지표들을 소개하며 다양한 측정 방법을 병행해 경제를 바라보는 시각을 넓혀야 한다고 주장한다.", "value": { "text_id": "14", "word_num": 19, "핵심동사": "주장한다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } } ], "dupLabelYn": "Y", "metaData": { "ID": "230215", "FILENAME": "230215.json", "MEDIA_TYPE": "매거진", "MEDIA_NAME": "매경이코노미", "CATEGORY": "금융", "PUBDATE": "20200113", "SENTENCE": "14" } } 