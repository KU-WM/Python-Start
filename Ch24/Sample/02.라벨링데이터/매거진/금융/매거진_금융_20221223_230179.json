{ "annotation": [ { "charNum": "1", "label": "사실형", "length": 44, "text": "서울 양천구 목동 A아파트 단지에 거주하는 이 모 씨는 요즘 밤잠을 못 이룬다.", "value": { "text_id": "1", "word_num": 13, "핵심동사": "이룬다", "확실성": "확실", "극성": "부정", "시제": "현재", "key_word": " " } }, { "charNum": "46", "label": "사실형", "length": 48, "text": "오는 3월이 전세 만기인데 집주인이 전셋값을 7000만원 올려달라고 요구했기 때문이다.", "value": { "text_id": "2", "word_num": 10, "핵심동사": "때문이다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "95", "label": "사실형", "length": 47, "text": "여윳돈이 없어 주변 다른 아파트 전세를 물색해봤지만 수천만원씩 오른 곳이 수두룩하다.", "value": { "text_id": "3", "word_num": 11, "핵심동사": "수두룩하다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "143", "label": "사실형", "length": 116, "text": "이 씨는 ＂정부가 집값을 잡기 위해 부동산 규제를 쏟아내지만 정작 전세 거주자들만 피해를 보는 분위기다.＂ ＂청약가점제 탓에 새 아파트 청약 당첨도 어려워 반전세 물건이라도 구해야 할지 걱정＂이라고 털어놨다.", "value": { "text_id": "4", "word_num": 28, "핵심동사": "털어놨다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": " " } }, { "charNum": "260", "label": "사실형", "length": 28, "text": "12·16 부동산 대책 후폭풍에 전셋값이 요동친다.", "value": { "text_id": "5", "word_num": 6, "핵심동사": "요동친다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "289", "label": "사실형", "length": 52, "text": "집주인이 몇 달 만에 전세금을 수천만원에서 수억원씩 높이면서 세입자들이 적잖은 충격에 빠졌다.", "value": { "text_id": "6", "word_num": 12, "핵심동사": "빠졌다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": " " } }, { "charNum": "342", "label": "사실형", "length": 40, "text": "머지않아 서울, 수도권 전역에 전세대란이 벌어질 것이라는 우려도 나온다.", "value": { "text_id": "7", "word_num": 9, "핵심동사": "나온다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "383", "label": "대화형", "length": 23, "text": "전세대란이 나타나는 근본적인 배경은 뭘까.", "value": { "text_id": "8", "word_num": 5, "핵심동사": "뭘까", "확실성": "불확실", "극성": "미정", "시제": "현재", "key_word": " " } } ], "dupLabelYn": "Y", "metaData": { "ID": "230179", "FILENAME": "230179.json", "MEDIA_TYPE": "매거진", "MEDIA_NAME": "매경이코노미", "CATEGORY": "금융", "PUBDATE": "20200109", "SENTENCE": "8" } } 