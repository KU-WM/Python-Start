{ "annotation": [ { "charNum": "1", "label": "사실형", "length": 79, "text": "또 생애주기별 제공되는 행정 서비스를 한 번에 안내받고 신청까지 하는 ＇생애주기 원스톱 서비스＇가 올 상반기 ＇임신·아동 돌봄＇까지 확대된다.", "value": { "text_id": "1", "word_num": 18, "핵심동사": "확대된다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "80", "label": "사실형", "length": 50, "text": "행정안전부는 지난 1월 1일 이 같은 내용의 ＇새해부터 달라지는 제도 10선＇을 발표했다.", "value": { "text_id": "2", "word_num": 12, "핵심동사": "발표했다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": " " } }, { "charNum": "130", "label": "사실형", "length": 42, "text": "행안부는 ＇국민안전＇과 ＇정부혁신＇＇공정과세＇세 가지 분야로 나눠 발표했다.", "value": { "text_id": "3", "word_num": 7, "핵심동사": "발표했다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": " " } }, { "charNum": "172", "label": "사실형", "length": 28, "text": "그중에서도 국민안전 분야에서의 변화가 눈길을 끈다.", "value": { "text_id": "4", "word_num": 6, "핵심동사": "끈다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "200", "label": "사실형", "length": 29, "text": "올 4월 1일부터는 소방공무원이 국가직으로 전환된다.", "value": { "text_id": "5", "word_num": 6, "핵심동사": "전환된다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "229", "label": "추론형", "length": 47, "text": "대형 재난의 대응 역량이 강화되고 지역별 소방 서비스 격차가 줄어들 것으로 기대된다.", "value": { "text_id": "6", "word_num": 12, "핵심동사": "기대된다", "확실성": "확실", "극성": "긍정", "시제": "미래", "key_word": "기대된다" } }, { "charNum": "276", "label": "사실형", "length": 54, "text": "또 ＇민식이법＇통과에 맞춰 올 3월부터 어린이 보호구역 무인 교통 단속용 장비 설치가 의무화된다.", "value": { "text_id": "7", "word_num": 13, "핵심동사": "의무화된다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "330", "label": "사실형", "length": 73, "text": "2022년까지 전국 모든 스쿨존에 단속장비를 설치할 계획으로 올해는 교통사고 우려가 큰 지역에 단속장비 1500대를 먼저 설치한다.", "value": { "text_id": "8", "word_num": 16, "핵심동사": "설치한다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } } ], "dupLabelYn": "Y", "metaData": { "ID": "230144", "FILENAME": "230144.json", "MEDIA_TYPE": "매거진", "MEDIA_NAME": "매경이코노미", "CATEGORY": "금융", "PUBDATE": 