{ "annotation": [ { "charNum": "1", "label": "사실형", "length": 31, "text": "대장주 삼성전자가 연일 신저가를 경신하고 있는 모습이다.", "value": { "text_id": "1", "word_num": 7, "핵심동사": "모습이다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "33", "label": "사실형", "length": 33, "text": "이날도 6만700원까지 추락하면서 52주 신저가를 기록했다.", "value": { "text_id": "2", "word_num": 6, "핵심동사": "기록했다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": " " } }, { "charNum": "68", "label": "사실형", "length": 45, "text": "15일 삼성전자는 전 거래일 대비 1.94% 하락한 6만700원에 거래를 마쳤다.", "value": { "text_id": "3", "word_num": 10, "핵심동사": "마쳤다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": " " } }, { "charNum": "114", "label": "사실형", "length": 41, "text": "지난 3월 7만원 선을 깨고 내리막길을 걷더니 이제는 5만전자도 코앞이다.", "value": { "text_id": "4", "word_num": 10, "핵심동사": "코앞이다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "156", "label": "사실형", "length": 25, "text": "이날 외국인들은 삼성전자를 팔아치우기 바빴다.", "value": { "text_id": "5", "word_num": 5, "핵심동사": "바빴다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": " " } }, { "charNum": "182", "label": "사실형", "length": 31, "text": "외국인은 삼성전자를 712억3223만원어치를 순매도했다.", "value": { "text_id": "6", "word_num": 4, "핵심동사": "순매도했다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": " " } }, { "charNum": "214", "label": "사실형", "length": 21, "text": "반면 개인은 삼성전자를 대거 매수했다.", "value": { "text_id": "7", "word_num": 5, "핵심동사": "매수했다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": " " } }, { "charNum": "236", "label": "사실형", "length": 58, "text": "이날 삼성전자는 368억7515만원으로, 현대차에 이어 두 번째로 개인이 가장 많이 순매수한 종목이었다.", "value": { "text_id": "8", "word_num": 12, "핵심동사": "종목이었다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": " " } }, { "charNum": "295", "label": "사실형", "length": 63, "text": "삼성전자가 연일 신저가를 쓰며 6만원 선까지 위협받고 있는 가운데 개인투자자들은 저가매수가 기회라고 판단한 것이다", "value": { "text_id": "9", "word_num": 14, "핵심동사": "판단한", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": " " } }, { "charNum": "361", "label": "사실형", "length": 43, "text": "증권가에서는 삼성전자가 최악의 경우 5만원 선까지 떨어질 수 있다고 분석한다.", "value": { "text_id": "10", "word_num": 10, "핵심동사": "분석한다", "확실성": "확실", "극성": "긍정", "시제": "미래", "key_word": " " } }, { "charNum": "405", "label": "사실형", "length": 48, "text": "키움증권은 삼성증권의 목표가를 기존보다 11% 내린 8만9000원으로 제시하기도 했다.", "value": { "text_id": "11", "word_num": 9, "핵심동사": "제시하기도", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": " " } }, { "charNum": "455", "label": "사실형", "length": 39, "text": "반면 삼성전자 주가의 추가 하락폭이 제한적일 것이라는 목소리도 나온다.", "value": { "text_id": "12", "word_num": 9, "핵심동사": "나온다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "495", "label": "추론형", "length": 55, "text": "현재 삼성전자의 주가 하락이 회사 개별의 문제보다는 거시경제 환경의 악화로 일어난 것이기 때문이다.", "value": { "text_id": "13", "word_num": 13, "핵심동사": "때문이다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": "때문이다" } }, { "charNum": "551", "label": "사실형", "length": 108, "text": "김장열 상상인증권 연구원도 ＂글로벌 경쟁력이 월등한 기업은 이러한 위기 상황이나 변동성 우려를 공급 측면의 영향력과 신제품, 신기술로 경쟁사 대비 상대적으로 빠르게 극복할 수 있다＂고 판단했다.", "value": { "text_id": "14", "word_num": 25, "핵심동사": "판단했다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": " " } } ], "dupLabelYn": "Y", "metaData": { "ID": "230107", "FILENAME": "230107.json", "MEDIA_TYPE": "매거진", "MEDIA_NAME": "매경이코노미", "CATEGORY": "금융", "PUBDATE": "20220615", "SENTENCE": "14" } } 