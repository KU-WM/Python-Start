{ "annotation": [ { "charNum": "1", "label": "사실형", "length": 10, "text": "셈법이 복잡해졌다.", "value": { "text_id": "1", "word_num": 2, "핵심동사": "복잡해졌다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": " " } }, { "charNum": "11", "label": "추론형", "length": 40, "text": "지난해 말까지만 해도 손태승 우리금융지주 회장의 리더십은 굳건한 듯했다.", "value": { "text_id": "2", "word_num": 9, "핵심동사": "굳건한", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "굳건한" } }, { "charNum": "51", "label": "사실형", "length": 17, "text": "이사회도 그에게 힘을 실어줬다.", "value": { "text_id": "3", "word_num": 4, "핵심동사": "실어줬다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": " " } }, { "charNum": "68", "label": "사실형", "length": 52, "text": "그런데 해외 금리 연계 파생결합펀드(DLF) 불완전판매 의혹 사건 후 상황이 꼬이기 시작했다.", "value": { "text_id": "4", "word_num": 12, "핵심동사": "시작했다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": " " } }, { "charNum": "120", "label": "사실형", "length": 38, "text": "손 회장은 금융감독당국으로부터 중징계에 해당하는 제재 대상자가 됐다.", "value": { "text_id": "5", "word_num": 8, "핵심동사": "됐다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": " " } }, { "charNum": "158", "label": "추론형", "length": 20, "text": "당장 연임에 빨간불이 들어온 셈이다.", "value": { "text_id": "6", "word_num": 5, "핵심동사": "들어온", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": "들어온" } }, { "charNum": "178", "label": "사실형", "length": 40, "text": "그럼에도 불구하고 손 회장은 이사회의 연임 결정에 그대로 따르기로 했다.", "value": { "text_id": "7", "word_num": 10, "핵심동사": "따르기로", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": " " } }, { "charNum": "218", "label": "추론형", "length": 28, "text": "금융당국 입장에서는 반기를 든 것으로 볼 수 있다.", "value": { "text_id": "8", "word_num": 8, "핵심동사": "볼", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": "볼" } }, { "charNum": "246", "label": "사실형", "length": 29, "text": "이런 대치 상황이 3월 우리금융지주를 뒤흔들고 있다.", "value": { "text_id": "9", "word_num": 7, "핵심동사": "뒤흔들고", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } } ], "dupLabelYn": "Y", "metaData": { "ID": "230217", "FILENAME": "230217.json", "MEDIA_TYPE": "매거진", "MEDIA_NAME": "이코노미", "CATEGORY": "금융", "PUBDATE": "20200316", "SENTENCE": "9" } } 