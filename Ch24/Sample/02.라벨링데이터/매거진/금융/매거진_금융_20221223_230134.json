{ "annotation": [ { "charNum": "1", "label": "사실형", "length": 52, "text": "2018년과 2019년은 LG전자 역사상 가장 분위기가 좋았던 시절이라고 해도 과언이 아니다.", "value": { "text_id": "1", "word_num": 11, "핵심동사": "아니다", "확실성": "확실", "극성": "부정", "시제": "현재", "key_word": " " } }, { "charNum": "54", "label": "추론형", "length": 40, "text": "2019년 LG전자 영업이익은 2조6000억원을 넘어설 것으로 예상된다.", "value": { "text_id": "2", "word_num": 7, "핵심동사": "예상된다", "확실성": "불확실", "극성": "긍정", "시제": "미래", "key_word": "예상된다" } }, { "charNum": "95", "label": "사실형", "length": 55, "text": "2018년 영업이익 또한 약 2조7000억원, 2년 연속 좋은 성적표를 거뒀다는 점에서 고무적이다.", "value": { "text_id": "3", "word_num": 12, "핵심동사": "고무적이다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "151", "label": "사실형", "length": 22, "text": "그럼에도 LG전자는 마냥 웃을 수 없다.", "value": { "text_id": "4", "word_num": 6, "핵심동사": "웃을", "확실성": "확실", "극성": "부정", "시제": "현재", "key_word": " " } }, { "charNum": "174", "label": "사실형", "length": 56, "text": "역설적으로 LG전자가 전성기를 달리는 지금, 스마트폰 사업은 긴 터널에서 나올 기미가 보이지 않는다.", "value": { "text_id": "5", "word_num": 13, "핵심동사": "보이지", "확실성": "확실", "극성": "부정", "시제": "현재", "key_word": " " } }, { "charNum": "231", "label": "사실형", "length": 13, "text": "18분기 연속 적자이다.", "value": { "text_id": "6", "word_num": 3, "핵심동사": "적자이다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "245", "label": "사실형", "length": 19, "text": "LG전자 스마트폰 사업의 현실이다.", "value": { "text_id": "7", "word_num": 4, "핵심동사": "현실이다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "265", "label": "사실형", "length": 20, "text": "누적 적자는 3조원을 훌쩍 넘어섰다.", "value": { "text_id": "8", "word_num": 5, "핵심동사": "넘어섰다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": " " } }, { "charNum": "286", "label": "추론형", "length": 45, "text": "만약 LG전자가 스마트폰만 다뤘던 기업이라면 진작 문을 닫았어야 할지도 모르겠다.", "value": { "text_id": "9", "word_num": 10, "핵심동사": "모르겠다", "확실성": "불확실", "극성": "긍정", "시제": "현재", "key_word": "모르겠다" } }, { "charNum": "332", "label": "추론형", "length": 79, "text": "2018년과 2019년 LG전자 스마트폰 사업만 잘됐더라면, 아니, 아예 스마트폰 사업을 하지 않았더라면 영업이익 3조원을 돌파했을 것 이다.", "value": { "text_id": "10", "word_num": 17, "핵심동사": "돌파했을", "확실성": "불확실", "극성": "긍정", "시제": "과거", "key_word": "돌파했을" } }, { "charNum": "412", "label": "사실형", "length": 40, "text": "그럼에도 LG전자가 잘나갈 수 있었던 것은 TV 등 가전의 역할이 컸다.", "value": { "text_id": "11", "word_num": 11, "핵심동사": "컸다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": " " } }, { "charNum": "453", "label": "추론형", "length": 27, "text": "언제까지 스마트폰 없이 버틸 수는 없는 노릇이다.", "value": { "text_id": "12", "word_num": 7, "핵심동사": "노릇이다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": "노릇이다" } }, { "charNum": "481", "label": "사실형", "length": 54, "text": "축구 경기에서 한 명이 퇴장당하면 나머지 10명이 아무리 애를 써도 상대 팀을 이기기 쉽지 않다.", "value": { "text_id": "13", "word_num": 15, "핵심동사": "쉽지", "확실성": "확실", "극성": "부정", "시제": "현재", "key_word": " " } }, { "charNum": "536", "label": "추론형", "length": 10, "text": "사업도 마찬가지다.", "value": { "text_id": "14", "word_num": 2, "핵심동사": "마찬가지다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": "마찬가지다" } }, { "charNum": "547", "label": "추론형", "length": 41, "text": "한 분야에서 이렇게 오랜 기간 공백이 계속된다면 어떻게든 수를 써야 한다.", "value": { "text_id": "15", "word_num": 11, "핵심동사": "써야", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": "써야" } }, { "charNum": "589", "label": "사실형", "length": 44, "text": "다행히도 2019년 3분기 스마트폰 적자 규모는 2분기 대비 큰 폭으로 줄었다.", "value": { "text_id": "16", "word_num": 11, "핵심동사": "줄었다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": " " } }, { "charNum": "634", "label": "사실형", "length": 30, "text": "생산기지를 해외로 옮기면서 원가 부담은 크게 감소했다.", "value": { "text_id": "17", "word_num": 7, "핵심동사": "감소했다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": " " } }, { "charNum": "665", "label": "추론형", "length": 61, "text": "이제 LG전자 스마트폰 인식을 확 바꾸고 브랜드 가치를 높일 수 있는 스페셜한 제품, 딱 하나만 나오면 된다.", "value": { "text_id": "18", "word_num": 17, "핵심동사": "된다", "확실성": "불확실", "극성": "긍정", "시제": "현재", "key_word": "된다" } } ], "dupLabelYn": "Y", "metaData": { "ID": "230134", "FILENAME": "230134.json", "MEDIA_TYPE": "매거진", "MEDIA_NAME": "매경이코노미", "CATEGORY": "금융", "PUBDATE": "20200103", "SENTENCE": "18" } } 