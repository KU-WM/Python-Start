{ "annotation": [ { "charNum": "1", "label": "추론형", "length": 34, "text": "느릿느릿 기어가는 달팽이를 가끔 보지만 이런 생각은 못했었다.", "value": { "text_id": "1", "word_num": 8, "핵심동사": "못했었다", "확실성": "확실", "극성": "부정", "시제": "과거", "key_word": "못했었다" } }, { "charNum": "35", "label": "추론형", "length": 31, "text": "달팽이가 지구를 굴리고 있다는 시인의 발상은 매력적이다.", "value": { "text_id": "2", "word_num": 7, "핵심동사": "매력적이다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": "매력적이다" } }, { "charNum": "66", "label": "추론형", "length": 32, "text": "달팽이는 우주의 일원으로 아주 중요한 시간을 보내고 있다.", "value": { "text_id": "3", "word_num": 8, "핵심동사": "보내고", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": "보내고" } }, { "charNum": "98", "label": "추론형", "length": 31, "text": "우리는 종종 작고 미약한 생명체들을 무시하면서 살아간다.", "value": { "text_id": "4", "word_num": 7, "핵심동사": "살아간다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": "살아간다" } }, { "charNum": "129", "label": "사실형", "length": 22, "text": "시인은 그런 착각에 일침을 가하고 있다.", "value": { "text_id": "5", "word_num": 6, "핵심동사": "가하고", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "151", "label": "추론형", "length": 37, "text": "지구상의 모든 생명은 최적화된 자신의 역할을 수행하고 있는 것이다.", "value": { "text_id": "6", "word_num": 9, "핵심동사": "수행하고", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": "수행하고" } }, { "charNum": "188", "label": "추론형", "length": 46, "text": "아무리 작은 존재라 해도 지금 이 순간 그는 세상의 모든 아픔을 품고 있는 것이다.", "value": { "text_id": "7", "word_num": 14, "핵심동사": "품고", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": "품고" } }, { "charNum": "234", "label": "추론형", "length": 18, "text": "인간이라고 위세 떨지 말 일이다.", "value": { "text_id": "8", "word_num": 5, "핵심동사": "일이다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": "일이다" } } ], "dupLabelYn": "Y", "metaData": { "ID": "220001", "FILENAME": "220001.json", "MEDIA_TYPE": "매거진", "MEDIA_NAME": "매경칼럼", "CATEGORY": "사회", "PUBDATE": "20220620", "SENTENCE": "8" } } 