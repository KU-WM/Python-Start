{ "annotation": [ { "charNum": "1", "label": "추론형", "length": 20, "text": "사람들은 비가 내리면 생각에 빠진다.", "value": { "text_id": "1", "word_num": 5, "핵심동사": "빠진다", "확실성": "불확실", "극성": "긍정", "시제": "현재", "key_word": "빠진다" } }, { "charNum": "21", "label": "추론형", "length": 27, "text": "비에는 사람들의 발걸음을 멈추게 하는 힘이 있다.", "value": { "text_id": "2", "word_num": 7, "핵심동사": "있다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": "있다" } }, { "charNum": "48", "label": "추론형", "length": 18, "text": "비는 사람들을 추억으로 데려간다.", "value": { "text_id": "3", "word_num": 4, "핵심동사": "데려간다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": "데려간다" } }, { "charNum": "66", "label": "사실형", "length": 58, "text": "프랑스의 시인 아폴리네르는 빗줄기를 보면서 ＇위아래 수직으로 그대를 묶어놓은 인연의 줄＇이라고 일갈한다.", "value": { "text_id": "4", "word_num": 12, "핵심동사": "일갈한다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "124", "label": "추론형", "length": 34, "text": "도망칠 수 없었던 인연들이 비가 되어 내리는 것인지도 모른다.", "value": { "text_id": "5", "word_num": 9, "핵심동사": "모른다", "확실성": "불확실", "극성": "긍정", "시제": "현재", "key_word": "모른다" } }, { "charNum": "158", "label": "추론형", "length": 20, "text": "비는 수직으로 내려와 우리를 적신다.", "value": { "text_id": "6", "word_num": 5, "핵심동사": "적신다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": "적신다" } }, { "charNum": "178", "label": "추론형", "length": 23, "text": "우리 대신 울어주기나 하는 것처럼 말이다.", "value": { "text_id": "7", "word_num": 6, "핵심동사": "말이다", "확실성": "불확실", "극성": "긍정", "시제": "현재", "key_word": "말이다" } } ], "dupLabelYn": "Y", "metaData": { "ID": "220049", "FILENAME": "220049.json", "MEDIA_TYPE": "매거진", "MEDIA_NAME": "매경칼럼", "CATEGORY": "사회", "PUBDATE": "20220523", "SENTENCE": "7" } } 