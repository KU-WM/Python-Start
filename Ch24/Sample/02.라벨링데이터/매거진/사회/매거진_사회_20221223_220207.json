{ "annotation": [ { "charNum": "1", "label": "사실형", "length": 86, "text": "가난한 시절 자기를 버린 여자 앞에 출세한 모습으로 나타나기 위해 돈에 미쳐 살고, 그 여자에게 사랑한다는 말을 듣기 위해 바보같이 죽은 사람이 개츠비다.", "value": { "text_id": "1", "word_num": 23, "핵심동사": "개츠비다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "87", "label": "추론형", "length": 30, "text": "도무지 ＇위대한＇이라는 수식어는 어울리지 않아 보인다.", "value": { "text_id": "2", "word_num": 6, "핵심동사": "어울리지", "확실성": "확실", "극성": "부정", "시제": "현재", "key_word": "어울리지" } }, { "charNum": "117", "label": "추론형", "length": 28, "text": "전체적인 스토리라인만 보면 개츠비는 분명 한심하다.", "value": { "text_id": "3", "word_num": 6, "핵심동사": "한심하다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": "한심하다" } }, { "charNum": "145", "label": "추론형", "length": 63, "text": "그런데 소설을 찬찬히 읽어보면 화자인 캐러웨이가 개츠비에 대해 군데군데 대단한 찬사를 보내고 있음을 알 수 있다.", "value": { "text_id": "4", "word_num": 16, "핵심동사": "알", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": "알" } }, { "charNum": "208", "label": "대화형", "length": 36, "text": "'평생 동안 네다섯 번밖에 볼 수 없는 미소를 보여준 사람이다.'", "value": { "text_id": "5", "word_num": 10, "핵심동사": "사람이다.", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "244", "label": "대화형", "length": 27, "text": "'지진계와 같이 예민한 감수성을 지닌 사람이다.'", "value": { "text_id": "6", "word_num": 6, "핵심동사": "사람이다.", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "271", "label": "대화형", "length": 32, "text": "'다른 이들을 모두 합친 것보다 더 가치 있는 사람이다.'", "value": { "text_id": "7", "word_num": 9, "핵심동사": "사람이다.", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "303", "label": "추론형", "length": 25, "text": "그가 가치 있는 사람이 될 수 있었던 이유다.", "value": { "text_id": "8", "word_num": 8, "핵심동사": "이유다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": "이유다" } }, { "charNum": "328", "label": "대화형", "length": 18, "text": "'아니, 결국 개츠비는 옳았다.'", "value": { "text_id": "9", "word_num": 4, "핵심동사": "옳았다.", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": " " } }, { "charNum": "346", "label": "대화형", "length": 98, "text": "'내가 잠시나마 인간의 짧은 슬픔이나 숨 가쁜 환희에 대해 흥미를 잃어버렸던 것은 개츠비를 희생물로 이용한 것들, 개츠비의 꿈이 지나간 자리에 떠도는 더러운 먼지 때문이었다.'", "value": { "text_id": "10", "word_num": 24, "핵심동사": "때문이었다.", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": " " } }, { "charNum": "444", "label": "사실형", "length": 39, "text": "그는 속물적이고 비도덕적인 여인에 대한 사랑을 한 번도 거두지 않았다.", "value": { "text_id": "11", "word_num": 10, "핵심동사": "거두지", "확실성": "확실", "극성": "부정", "시제": "과거", "key_word": " " } }, { "charNum": "483", "label": "대화형", "length": 16, "text": "'나는 내 삶을 살고 싶다.'", "value": { "text_id": "12", "word_num": 5, "핵심동사": "살고 싶다.", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "499", "label": "대화형", "length": 19, "text": "'나의 밤이 후회로 가득할지라도.'", "value": { "text_id": "13", "word_num": 4, "핵심동사": "가득할지라도.", "확실성": "확실", "극성": "긍정", "시제": "미래", "key_word": " " } } ], "dupLabelYn": "Y", "metaData": { "ID": "220207", "FILENAME": "220207.json", "MEDIA_TYPE": "매거진", "MEDIA_NAME": "매경칼럼", "CATEGORY": "사회", "PUBDATE": "20201024", "SENTENCE": "13" } } 