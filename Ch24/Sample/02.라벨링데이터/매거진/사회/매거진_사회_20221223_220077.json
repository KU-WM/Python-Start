{ "annotation": [ { "charNum": "1", "label": "사실형", "length": 18, "text": "아들은 어머니를 요양원에 보낸다.", "value": { "text_id": "1", "word_num": 4, "핵심동사": "보낸다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "20", "label": "사실형", "length": 45, "text": "요양원에 들어가는 날 어머니와 아들은 식당에서 마지막이 될지도 모를 외식을 한다.", "value": { "text_id": "2", "word_num": 11, "핵심동사": "한다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "66", "label": "사실형", "length": 44, "text": "요양원에 들어가는 어머니는 연신 아들의 뚝배기에 자신의 도가니를 건져 넣어준다.", "value": { "text_id": "3", "word_num": 10, "핵심동사": "넣어준다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "111", "label": "사실형", "length": 15, "text": "아들은 눈물을 애써 참는다.", "value": { "text_id": "4", "word_num": 4, "핵심동사": "참는다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "127", "label": "추론형", "length": 15, "text": "가슴이 먹먹해지는 풍경이다.", "value": { "text_id": "5", "word_num": 3, "핵심동사": "풍경이다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": "풍경이다" } }, { "charNum": "143", "label": "추론형", "length": 21, "text": "어쩌면 우리 모두의 모습일지도 모른다.", "value": { "text_id": "6", "word_num": 5, "핵심동사": "모른다", "확실성": "불확실", "극성": "긍정", "시제": "현재", "key_word": "모른다" } }, { "charNum": "165", "label": "대화형", "length": 43, "text": "조건 없는 사랑과 결과적인 불효가 교차하는 이 순간을 뭐라 설명할 수 있을까.", "value": { "text_id": "7", "word_num": 12, "핵심동사": "있을까", "확실성": "불확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "209", "label": "추론형", "length": 27, "text": "인간의 삶이라는 게 한없이 작게 느껴지는 날이다.", "value": { "text_id": "8", "word_num": 7, "핵심동사": "날이다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": "날이다" } } ], "dupLabelYn": "Y", "metaData": { "ID": "220077", "FILENAME": "220077.json", "MEDIA_TYPE": "매거진", "MEDIA_NAME": "매경칼럼", "CATEGORY": "사회", "PUBDATE": "20220509", "SENTENCE": "8" } } 