{ "annotation": [ { "charNum": "1", "label": "추론형", "length": 23, "text": "국민 입장에서 물가 상승은 세금과도 같다.", "value": { "text_id": "1", "word_num": 6, "핵심동사": "같다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": "같다" } }, { "charNum": "24", "label": "추론형", "length": 31, "text": "문제는 한국 경제가 이 물가 함정에 빠져버렸다는 점이다.", "value": { "text_id": "2", "word_num": 8, "핵심동사": "빠져버렸다는", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "빠져버렸다는" } }, { "charNum": "55", "label": "추론형", "length": 33, "text": "물건값이 비싸지자 지갑을 닫는 국민이 크게 늘었다는 뜻이다.", "value": { "text_id": "3", "word_num": 8, "핵심동사": "뜻이다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": "뜻이다" } }, { "charNum": "88", "label": "추론형", "length": 38, "text": "하지만 고물가에 가계 구매력이 줄며 민간소비마저 타격이 불가피해졌다.", "value": { "text_id": "4", "word_num": 8, "핵심동사": "불가피해졌다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": "불가피해졌다" } }, { "charNum": "126", "label": "추론형", "length": 19, "text": "이제 중요한 것은 고물가 해법이다.", "value": { "text_id": "5", "word_num": 5, "핵심동사": "해법이다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": "해법이다" } }, { "charNum": "145", "label": "추론형", "length": 32, "text": "여기에는 우리가 해야 할 것과 하지 말아야 할 것이 있다.", "value": { "text_id": "6", "word_num": 10, "핵심동사": "있다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": "있다" } }, { "charNum": "177", "label": "추론형", "length": 41, "text": "우선 에너지·곡물·생산원료에 대한 전방위적인 관세 인하부터 단행해야 한다.", "value": { "text_id": "7", "word_num": 8, "핵심동사": "단행해야", "확실성": "확실", "극성": "긍정", "시제": "미래", "key_word": "단행해야" } }, { "charNum": "218", "label": "추론형", "length": 55, "text": "최근 물가가 급등한 이유 중 열에 여덟(85%)은 휘발유, 가공식품, 외식비 상승 때문에 발생했다.", "value": { "text_id": "8", "word_num": 13, "핵심동사": "발생했다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "발생했다" } }, { "charNum": "273", "label": "추론형", "length": 36, "text": "관세 인하를 통해 생산물가 상승의 길목부터 잡는 처방이 필요하다.", "value": { "text_id": "9", "word_num": 9, "핵심동사": "필요하다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": "필요하다" } }, { "charNum": "309", "label": "추론형", "length": 26, "text": "이 조치는 2~3분기 집중적으로 이뤄져야 한다.", "value": { "text_id": "10", "word_num": 6, "핵심동사": "이뤄져야", "확실성": "확실", "극성": "긍정", "시제": "미래", "key_word": "이뤄져야" } }, { "charNum": "335", "label": "추론형", "length": 58, "text": "만약 이 기간 기대 인플레 진화에 실패하면 5%대 물가 공포가 확산되며 조기 진화에 실패할 공산이 크다.", "value": { "text_id": "11", "word_num": 16, "핵심동사": "크다", "확실성": "불확실", "극성": "긍정", "시제": "미래", "key_word": "크다" } }, { "charNum": "393", "label": "추론형", "length": 19, "text": "절대 꺼내서는 안 되는 패도 있다.", "value": { "text_id": "12", "word_num": 6, "핵심동사": "있다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": "있다" } }, { "charNum": "412", "label": "추론형", "length": 60, "text": "이 돈은 생산성을 늘리지는 못하고 물가만 0.16%포인트 올릴 것(한국개발연구원(KDI) 추산)으로 보인다.", "value": { "text_id": "13", "word_num": 11, "핵심동사": "보인다", "확실성": "확실", "극성": "긍정", "시제": "미래", "key_word": "보인다" } }, { "charNum": "472", "label": "추론형", "length": 18, "text": "살얼음판을 걷는 고물가 국면이다.", "value": { "text_id": "14", "word_num": 4, "핵심동사": "국면이다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": "국면이다" } }, { "charNum": "490", "label": "추론형", "length": 28, "text": "지극히 섬세한 정책 집행이 어느 때보다 절실해졌다.", "value": { "text_id": "15", "word_num": 7, "핵심동사": "절실해졌다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": "절실해졌다" } }, { "charNum": "518", "label": "예측형", "length": 25, "text": "새 정부 경제정책 내공도 드러나게 될 것이다.", "value": { "text_id": "16", "word_num": 7, "핵심동사": "될", "확실성": "확실", "극성": "긍정", "시제": "미래", "key_word": "될" } } ], "dupLabelYn": "Y", "metaData": { "ID": "220048", "FILENAME": "220048.json", "MEDIA_TYPE": "매거진", "MEDIA_NAME": "매경칼럼", "CATEGORY": "사회", "PUBDATE": "20220524", "SENTENCE": "16" } } 