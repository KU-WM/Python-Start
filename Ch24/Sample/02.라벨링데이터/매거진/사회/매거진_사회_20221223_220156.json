{ "annotation": [ { "charNum": "1", "label": "추론형", "length": 14, "text": "세계가 너무도 위험해졌다.", "value": { "text_id": "1", "word_num": 3, "핵심동사": "위험해졌다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "위험해졌다" } }, { "charNum": "15", "label": "추론형", "length": 38, "text": "미국은 생각보다 훨씬 충동적이고 중국은 생각대로 허술하기 짝이 없다.", "value": { "text_id": "2", "word_num": 9, "핵심동사": "짝이 없다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": "짝이 없다" } }, { "charNum": "53", "label": "추론형", "length": 27, "text": "세계가 3차 대전의 공포에 휩싸인 것은 당연하다.", "value": { "text_id": "3", "word_num": 7, "핵심동사": "당연하다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": "당연하다" } }, { "charNum": "80", "label": "대화형", "length": 37, "text": "대테러 작전이라지만 전쟁을 불사할 만큼 그렇게 긴박한 상황이었을까?", "value": { "text_id": "4", "word_num": 8, "핵심동사": "상황이었을까", "확실성": "불확실", "극성": "미정", "시제": "과거", "key_word": " " } }, { "charNum": "117", "label": "예측형", "length": 63, "text": "이란의 민항기 오발 격추로 사태가 엉뚱하게 진정됐지만 핵무기를 만들고 있는 이란은 결코 가만히 있지 않을 것이다.", "value": { "text_id": "5", "word_num": 16, "핵심동사": "않을", "확실성": "불확실", "극성": "긍정", "시제": "미래", "key_word": "않을" } }, { "charNum": "180", "label": "사실형", "length": 19, "text": "그냥 매복했다가 죽인 것이 아니다.", "value": { "text_id": "6", "word_num": 5, "핵심동사": "아니다", "확실성": "확실", "극성": "부정", "시제": "현재", "key_word": " " } }, { "charNum": "199", "label": "대화형", "length": 25, "text": "유독 사망자가 중국에서만 나오는 이유가 뭘까?", "value": { "text_id": "7", "word_num": 6, "핵심동사": "뭘까", "확실성": "불확실", "극성": "미정", "시제": "현재", "key_word": " " } }, { "charNum": "224", "label": "추론형", "length": 28, "text": "그 허술함을 요즘 마스크를 끼고 살며 체감 중이다.", "value": { "text_id": "8", "word_num": 8, "핵심동사": "체감 중이다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": "체감 중이다" } }, { "charNum": "252", "label": "사실형", "length": 61, "text": "사스, 아프리카돼지열병, 조류 인플루엔자에 이어 이번 신종 코로나바이러스 감염증까지 전혀 통제가 안되고 있다.", "value": { "text_id": "9", "word_num": 13, "핵심동사": "안되고", "확실성": "확실", "극성": "부정", "시제": "현재", "key_word": " " } }, { "charNum": "313", "label": "추론형", "length": 39, "text": "괴질이 의심된다고 알린 의사를 괴담 유포자로 체포했다니 할 말이 없다.", "value": { "text_id": "10", "word_num": 10, "핵심동사": "없다", "확실성": "확실", "극성": "부정", "시제": "현재", "key_word": "없다" } }, { "charNum": "352", "label": "추론형", "length": 18, "text": "신뢰할 수 없는 G2는 위험하다.", "value": { "text_id": "11", "word_num": 5, "핵심동사": "위험하다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": "위험하다" } }, { "charNum": "370", "label": "추론형", "length": 41, "text": "그래서 미국에 안보를, 중국에 경제를 의존하는 우리가 지금 가장 위험하다.", "value": { "text_id": "12", "word_num": 10, "핵심동사": "위험하다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": "위험하다" } }, { "charNum": "411", "label": "추론형", "length": 75, "text": "솔레이마니를 죽이기 바로 직전 마크 에스퍼 미 국방장관이 북한에 ＂오늘 밤이라도 싸울 준비가 돼 있다＂고 한 말은 빈말이 아닌 것이다.", "value": { "text_id": "13", "word_num": 20, "핵심동사": "아닌", "확실성": "확실", "극성": "부정", "시제": "현재", "key_word": "아닌" } }, { "charNum": "486", "label": "예측형", "length": 56, "text": "작년 ＇바오류(保六·6%대 경제성장)＇ 시대가 끝나고 올해 ＇바오우(保五)＇ 시대가 될 것으로 본다.", "value": { "text_id": "14", "word_num": 11, "핵심동사": "될", "확실성": "불확실", "극성": "긍정", "시제": "미래", "key_word": "될" } }, { "charNum": "542", "label": "추론형", "length": 14, "text": "중국 경제위기는 재앙이다.", "value": { "text_id": "15", "word_num": 3, "핵심동사": "재앙이다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": "재앙이다" } } ], "dupLabelYn": "Y", "metaData": { "ID": "220156", "FILENAME": "220156.json", "MEDIA_TYPE": "매거진", "MEDIA_NAME": "매경칼럼", "CATEGORY": "사회", "PUBDATE": "20200207", "SENTENCE": "15" } } 