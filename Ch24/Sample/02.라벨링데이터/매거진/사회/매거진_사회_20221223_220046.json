{ "annotation": [ { "charNum": "1", "label": "추론형", "length": 34, "text": "＂내가 직접 ○○해보니＂라는 말은묘하게 설득력을 주는 말이다.", "value": { "text_id": "1", "word_num": 7, "핵심동사": "말이다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": "말이다" } }, { "charNum": "35", "label": "추론형", "length": 32, "text": "온라인 세상에서 체험기, 사용기 등이 널리 읽히는 이유다.", "value": { "text_id": "2", "word_num": 8, "핵심동사": "이유다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": "이유다" } }, { "charNum": "67", "label": "추론형", "length": 22, "text": "타국살이에도 유사한 메커니즘이 작동한다.", "value": { "text_id": "3", "word_num": 4, "핵심동사": "작동한다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": "작동한다" } }, { "charNum": "89", "label": "추론형", "length": 27, "text": "누구에게나 낯선 이국땅에서의 삶은 두려운 법이다.", "value": { "text_id": "4", "word_num": 6, "핵심동사": "법이다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": "법이다" } }, { "charNum": "116", "label": "대화형", "length": 14, "text": "＂직접 살아보니 어때요?＂", "value": { "text_id": "5", "word_num": 3, "핵심동사": "어때요", "확실성": "불확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "130", "label": "추론형", "length": 40, "text": "그와 사석에서 대화할 때면 중국에 대한 애정을 문득문득 엿볼 수 있었다.", "value": { "text_id": "6", "word_num": 11, "핵심동사": "엿볼", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "엿볼" } }, { "charNum": "170", "label": "추론형", "length": 18, "text": "기억에 남는 건 의외의 송별사다.", "value": { "text_id": "7", "word_num": 5, "핵심동사": "송별사다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": "송별사다" } }, { "charNum": "188", "label": "추론형", "length": 25, "text": "＇이제는 중국과의 질긴 인연을 끝내고 싶다.＇", "value": { "text_id": "8", "word_num": 6, "핵심동사": "끝내고", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": "끝내고" } }, { "charNum": "213", "label": "추론형", "length": 86, "text": "부모와 떨어져 강제 격리돼 울음을 터뜨리는 아기의 모습, 주인이 격리돼 혼자 남겨진 반려견을 방역 요원이 둔기로 때려죽였다는 뉴스는 분노마저 치밀게 한다.", "value": { "text_id": "9", "word_num": 21, "핵심동사": "치밀게", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": "치밀게" } }, { "charNum": "299", "label": "추론형", "length": 40, "text": "물론 A씨와 B씨가 중국 내 모든 한국인의 중국살이를 대표하지는 않는다.", "value": { "text_id": "10", "word_num": 10, "핵심동사": "대표하지는", "확실성": "확실", "극성": "부정", "시제": "현재", "key_word": "대표하지는" } }, { "charNum": "339", "label": "추론형", "length": 74, "text": "하지만 분명한 건 무자비한 제로 코로나 정책으로 인해 중국 내 한국인들의 중국에 대한 실망감과 불만이 그 어느 때보다 높다는 것이다.", "value": { "text_id": "11", "word_num": 20, "핵심동사": "높다는", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": "높다는" } }, { "charNum": "413", "label": "추론형", "length": 49, "text": "정치적·이념적 차이에서 오는 반중(反中)이 아닌 ＇체험형 반중＇은 중국에 훨씬 뼈아프다.", "value": { "text_id": "12", "word_num": 10, "핵심동사": "뼈아프다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": "뼈아프다" } }, { "charNum": "462", "label": "대화형", "length": 35, "text": "A씨와 B씨가 한국으로 돌아가면 중국에 대해 어떻게 이야기할까.", "value": { "text_id": "13", "word_num": 8, "핵심동사": "이야기할까", "확실성": "불확실", "극성": "긍정", "시제": "미래", "key_word": " " } }, { "charNum": "497", "label": "추론형", "length": 26, "text": "제로 코로나로 폭망한 건 중국 경제만이 아니다.", "value": { "text_id": "14", "word_num": 7, "핵심동사": "아니다", "확실성": "확실", "극성": "부정", "시제": "현재", "key_word": "아니다" } }, { "charNum": "523", "label": "추론형", "length": 30, "text": "중국의 국가 이미지가 되돌릴 수 없는 길로 가고 있다.", "value": { "text_id": "15", "word_num": 9, "핵심동사": "가고", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": "가고" } } ], "dupLabelYn": "Y", "metaData": { "ID": "220046", "FILENAME": "220046.json", "MEDIA_TYPE": "매거진", "MEDIA_NAME": "매경칼럼", "CATEGORY": "사회", "PUBDATE": "20220524", "SENTENCE": "15" } } 