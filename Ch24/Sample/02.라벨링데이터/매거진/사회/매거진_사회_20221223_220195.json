{ "annotation": [ { "charNum": "1", "label": "추론형", "length": 14, "text": "우리는 너무 많이 가졌다.", "value": { "text_id": "1", "word_num": 4, "핵심동사": "가졌다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": "가졌다" } }, { "charNum": "16", "label": "추론형", "length": 23, "text": "우리가 불행한 건 그것 때문일지도 모른다.", "value": { "text_id": "2", "word_num": 6, "핵심동사": "모른다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": "모른다" } }, { "charNum": "40", "label": "추론형", "length": 51, "text": "너무 많이 가지다 보니 갈망도 그리움도 시들해졌고, 덩달아 삶의 의미도 이유도 힘을 잃었다.", "value": { "text_id": "3", "word_num": 13, "핵심동사": "잃었다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": "잃었다" } }, { "charNum": "92", "label": "추론형", "length": 15, "text": "충족된 것 같지만 허전하다.", "value": { "text_id": "4", "word_num": 4, "핵심동사": "허전하다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": "허전하다" } }, { "charNum": "108", "label": "추론형", "length": 25, "text": "가지면 가질수록 우리는 점점 폐허가 되어간다.", "value": { "text_id": "5", "word_num": 6, "핵심동사": "되어간다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": "되어간다" } }, { "charNum": "134", "label": "추론형", "length": 35, "text": "많은 것들을 가진 대신 정말 중요한 몇 가지를 잃어버리고 산다.", "value": { "text_id": "6", "word_num": 10, "핵심동사": "산다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": "산다" } }, { "charNum": "170", "label": "추론형", "length": 52, "text": "너무 많은 주장들 속을 헤엄치느라 침묵을 잃었고, 너무 많은 음식을 생산하느라 나무를 잃었다.", "value": { "text_id": "7", "word_num": 13, "핵심동사": "잃었다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": "잃었다" } } ], "dupLabelYn": "Y", "metaData": { "ID": "220195", "FILENAME": "220195.json", "MEDIA_TYPE": "매거진", "MEDIA_NAME": "매경칼럼", "CATEGORY": "사회", "PUBDATE": "20200302", "SENTENCE": "7" } } 