{ "annotation": [ { "charNum": "1", "label": "대화형", "length": 33, "text": "핵무기로 세상을 위협하는 북한이 가장 두려워하는 것이 뭘까?", "value": { "text_id": "1", "word_num": 8, "핵심동사": "뭘까", "확실성": "불확실", "극성": "미정", "시제": "현재", "key_word": " " } }, { "charNum": "34", "label": "추론형", "length": 34, "text": "강력한 대북 제재, 심각한 경제난, 외부 정보 유입도 아니다.", "value": { "text_id": "2", "word_num": 9, "핵심동사": "아니다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": "아니다" } }, { "charNum": "68", "label": "추론형", "length": 12, "text": "무상 의료는 옛말이다.", "value": { "text_id": "3", "word_num": 3, "핵심동사": "옛말이다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": "옛말이다" } }, { "charNum": "80", "label": "추론형", "length": 44, "text": "더욱이 사스, 메르스, 에볼라 등 바이러스 질환이 유행하면 북한은 공포에 떤다.", "value": { "text_id": "4", "word_num": 11, "핵심동사": "떤다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": "떤다" } }, { "charNum": "124", "label": "추론형", "length": 54, "text": "북한에서 바이러스가 확산되면 사회를 통제 불능 상태로 몰아넣고 자칫 체제 위기로 이어질 수 있다.", "value": { "text_id": "5", "word_num": 14, "핵심동사": "이어질", "확실성": "불확실", "극성": "긍정", "시제": "미래", "key_word": "이어질" } }, { "charNum": "178", "label": "추론형", "length": 33, "text": "이젠 전염병으로 나라가 망하는 일은 없지만 북한만은 예외다.", "value": { "text_id": "6", "word_num": 8, "핵심동사": "예외다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": "예외다" } }, { "charNum": "211", "label": "추론형", "length": 27, "text": "바이러스는 북한에선 현대판 ＇호환마마＇인 셈이다.", "value": { "text_id": "7", "word_num": 5, "핵심동사": "＇호환마마＇인", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": "＇호환마마＇인" } }, { "charNum": "238", "label": "추론형", "length": 21, "text": "북한 측 발표를 그대로 믿을 순 없다.", "value": { "text_id": "8", "word_num": 7, "핵심동사": "믿을", "확실성": "확실", "극성": "부정", "시제": "현재", "key_word": "믿을" } }, { "charNum": "259", "label": "사실형", "length": 42, "text": "지난해 아프리카돼지열병(ASF)이 창궐할 때도 발생 보도는 한 건도 없었다.", "value": { "text_id": "9", "word_num": 9, "핵심동사": "없었다", "확실성": "확실", "극성": "부정", "시제": "과거", "key_word": " " } }, { "charNum": "301", "label": "추론형", "length": 26, "text": "코로나19 사태가 언제 끝날지 모르는 상황이다.", "value": { "text_id": "10", "word_num": 6, "핵심동사": "상황이다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": "상황이다" } }, { "charNum": "327", "label": "추론형", "length": 31, "text": "정부가 매달리는 대북 개별 관광도 탄력을 받기가 어렵다.", "value": { "text_id": "11", "word_num": 8, "핵심동사": "어렵다", "확실성": "확실", "극성": "부정", "시제": "현재", "key_word": "어렵다" } }, { "charNum": "358", "label": "추론형", "length": 46, "text": "오히려 인도적 차원의 보건의료 지원이 꽉 막힌 남북 대화에 모멘텀을 만들 수 있다.", "value": { "text_id": "12", "word_num": 13, "핵심동사": "만들", "확실성": "확실", "극성": "긍정", "시제": "미래", "key_word": "만들" } }, { "charNum": "404", "label": "추론형", "length": 31, "text": "국경이 없는 바이러스 대응에 남북이 따로 있을 수 없다.", "value": { "text_id": "13", "word_num": 9, "핵심동사": "있을", "확실성": "확실", "극성": "부정", "시제": "현재", "key_word": "있을" } } ], "dupLabelYn": "Y", "metaData": { "ID": "220190", "FILENAME": "220190.json", "MEDIA_TYPE": "매거진", "MEDIA_NAME": "매경칼럼", "CATEGORY": "사회", "PUBDATE": "20200228", "SENTENCE": "13" } } 