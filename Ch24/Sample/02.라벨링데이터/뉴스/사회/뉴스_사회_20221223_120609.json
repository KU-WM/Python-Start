{ "annotation": [ { "charNum": "1", "label": "추론형", "length": 13, "text": "＂배운 사람답지 않다.＂", "value": { "text_id": "1", "word_num": 3, "핵심동사": "사람답지", "확실성": "확실", "극성": "부정", "시제": "현재", "key_word": "배운/않다" } }, { "charNum": "14", "label": "대화형", "length": 44, "text": "교육열이 높기로 둘째가라면 서러운 우리나라에서 이 말이 칭찬인 이유는 무엇일까.", "value": { "text_id": "2", "word_num": 10, "핵심동사": "무엇일까", "확실성": "불확실", "극성": "미정", "시제": "현재", "key_word": " " } }, { "charNum": "58", "label": "추론형", "length": 21, "text": "공부머리와 일머리는 다르다는 점에서다.", "value": { "text_id": "3", "word_num": 4, "핵심동사": "점에서다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": "다르다는" } }, { "charNum": "79", "label": "추론형", "length": 40, "text": "동양에선, 춘추시대부터 사용됐던 ＇군자(君子)＇가 해당하지 않을까 한다.", "value": { "text_id": "4", "word_num": 7, "핵심동사": "해당하지", "확실성": "불확실", "극성": "긍정", "시제": "현재", "key_word": "해당하지" } }, { "charNum": "119", "label": "대화형", "length": 49, "text": "＇논어＇에서 ＇반지성주의의 오류＇에 빠지지 않기 위한 군자의 4가지 행동강령을 알아보자.", "value": { "text_id": "5", "word_num": 10, "핵심동사": "알아보자", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "168", "label": "사실형", "length": 39, "text": "첫째, (진영논리를 피하기 위해) 군자는 긍지를 가지되 다투지 않는다.", "value": { "text_id": "6", "word_num": 9, "핵심동사": "다투지", "확실성": "확실", "극성": "부정", "시제": "현재", "key_word": " " } }, { "charNum": "207", "label": "추론형", "length": 39, "text": "자신의 가치를 지키는 것과 상대를 경시하거나, 적대시하는 것은 다르다.", "value": { "text_id": "7", "word_num": 9, "핵심동사": "다르다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": "적대시하는/것은" } }, { "charNum": "246", "label": "사실형", "length": 33, "text": "가치를 지키기 위해 연대하지만, 편가르기로 다투지는 않는다.", "value": { "text_id": "8", "word_num": 7, "핵심동사": "다투지는", "확실성": "확실", "극성": "부정", "시제": "현재", "key_word": " " } }, { "charNum": "279", "label": "사실형", "length": 44, "text": "둘째, (확증편향을 피하기 위해) 다방면으로 보고 들어 의심이 남지 않게 한다.", "value": { "text_id": "9", "word_num": 11, "핵심동사": "남지", "확실성": "확실", "극성": "부정", "시제": "현재", "key_word": " " } }, { "charNum": "323", "label": "사실형", "length": 34, "text": "자기주장을 내세우기 위해 근거가 부족한데도 밀어붙이지 않는다.", "value": { "text_id": "10", "word_num": 7, "핵심동사": "밀어붙이지", "확실성": "확실", "극성": "부정", "시제": "현재", "key_word": " " } }, { "charNum": "357", "label": "대화형", "length": 22, "text": "판단하기 어려운 것은 차라리 유보해두라.", "value": { "text_id": "11", "word_num": 5, "핵심동사": "유보해두라", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "379", "label": "추론형", "length": 26, "text": "기계론적 중립과 극단을 포용하는 중용은 다르다.", "value": { "text_id": "12", "word_num": 6, "핵심동사": "다르다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": "중용은" } }, { "charNum": "405", "label": "대화형", "length": 37, "text": "넷째, 여론의 지지율 등락에 일희일비하기보다 공론의 추이를 살피라.", "value": { "text_id": "13", "word_num": 8, "핵심동사": "살피라", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "442", "label": "추론형", "length": 33, "text": "지지율보다 중요한 것은 지지층과 반대층의 특성이기 때문이다.", "value": { "text_id": "14", "word_num": 7, "핵심동사": "때문이다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": "특성이기" } }, { "charNum": "475", "label": "추론형", "length": 50, "text": "＇배운 사람답지 않다＇가 아닌, ＇배운 사람답다＇가 칭찬이 되는 지성주의 세상을 꿈꿔본다.", "value": { "text_id": "15", "word_num": 11, "핵심동사": "꿈꿔본다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": "지성주의/세상을" } } ], "dupLabelYn": "Y", "metaData": { "ID": "120609", "FILENAME": "120609.json", "MEDIA_TYPE": "뉴스", "MEDIA_NAME": "매일경제", "CATEGORY": "사회", "PUBDATE": "20220524", "SENTENCE": "15" } } 