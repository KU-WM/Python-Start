{ "annotation": [ { "charNum": "1", "label": "추론형", "length": 23, "text": "그런데 이 분야에서 일할 사람이 부족하다.", "value": { "text_id": "1", "word_num": 6, "핵심동사": "부족하다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": "그런데/사람이" } }, { "charNum": "24", "label": "사실형", "length": 33, "text": "이전 정부도 공을 들였지만 눈에 띄는 성과는 보이지 않았다.", "value": { "text_id": "2", "word_num": 9, "핵심동사": "보이지", "확실성": "확실", "극성": "부정", "시제": "과거", "key_word": " " } }, { "charNum": "57", "label": "대화형", "length": 29, "text": "어떻게 반도체 인력을 빠르게 많이 길러낼 수 있을까.", "value": { "text_id": "3", "word_num": 8, "핵심동사": "길러낼", "확실성": "확실", "극성": "긍정", "시제": "미래", "key_word": " " } }, { "charNum": "86", "label": "추론형", "length": 27, "text": "이 분야에 매년 1600명가량이 필요한데 말이다.", "value": { "text_id": "4", "word_num": 6, "핵심동사": "말이다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": "매년/필요한데" } }, { "charNum": "113", "label": "추론형", "length": 10, "text": "하지만 쉽지 않다.", "value": { "text_id": "5", "word_num": 3, "핵심동사": "않다", "확실성": "확실", "극성": "부정", "시제": "현재", "key_word": "쉽지" } }, { "charNum": "123", "label": "추론형", "length": 16, "text": "이 법을 고쳐야 풀 수 있다.", "value": { "text_id": "6", "word_num": 6, "핵심동사": "풀", "확실성": "확실", "극성": "긍정", "시제": "미래", "key_word": "교쳐야/수/있다" } }, { "charNum": "139", "label": "추론형", "length": 22, "text": "그런데 상상력을 발휘해보면 해법은 있다.", "value": { "text_id": "7", "word_num": 5, "핵심동사": "있다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": "발휘해보면/해법은" } }, { "charNum": "161", "label": "추론형", "length": 32, "text": "지방에 있기 때문에 수도권대학 정원 규제에서 벗어나 있다.", "value": { "text_id": "8", "word_num": 8, "핵심동사": "벗어나", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": "있기/때문에/있다" } }, { "charNum": "193", "label": "추론형", "length": 50, "text": "이미 양질의 교육과 우수한 연구 성과를 내고 있어 반도체 인력의 ＇질＇을 보장할 수 있다.", "value": { "text_id": "9", "word_num": 14, "핵심동사": "보장할", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": "성과를/내고/있어/수/있다" } }, { "charNum": "243", "label": "추론형", "length": 9, "text": "자구책인 셈이다.", "value": { "text_id": "10", "word_num": 2, "핵심동사": "셈이다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": "셈이다" } }, { "charNum": "252", "label": "사실형", "length": 17, "text": "하지만 정원 자체가 많지 않다.", "value": { "text_id": "11", "word_num": 5, "핵심동사": "많지", "확실성": "확실", "극성": "부정", "시제": "현재", "key_word": " " } }, { "charNum": "269", "label": "추론형", "length": 19, "text": "교수진과 장비 등이 부족한 탓이다.", "value": { "text_id": "12", "word_num": 5, "핵심동사": "탓이다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": "부족한" } }, { "charNum": "288", "label": "추론형", "length": 36, "text": "정부가 할 일은 기업부설대학을 장려하고 학위를 공인해주는 것이다.", "value": { "text_id": "13", "word_num": 8, "핵심동사": "공인해주는", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": "정부가/할 일은/것이다" } }, { "charNum": "324", "label": "추론형", "length": 33, "text": "이 돈의 일부라도 대학으로 갈 수 있게 물꼬를 터줘야 한다.", "value": { "text_id": "14", "word_num": 10, "핵심동사": "터줘야", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": "물꼬를" } }, { "charNum": "357", "label": "추론형", "length": 49, "text": "이젠 안 되는 이유를 찾을 게 아니라 될 수 있는 방안을 찾고 없으면 만들어야 할 때다.", "value": { "text_id": "15", "word_num": 16, "핵심동사": "때다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": "만들어야/할" } } ], "dupLabelYn": "Y", "metaData": { "ID": "120569", "FILENAME": "120569.json", "MEDIA_TYPE": "뉴스", "MEDIA_NAME": "매일경제", "CATEGORY": "사회", "PUBDATE": "20220611", "SENTENCE": "15" } } 