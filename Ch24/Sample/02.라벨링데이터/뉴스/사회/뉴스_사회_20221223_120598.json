{ "annotation": [ { "charNum": "1", "label": "추론형", "length": 30, "text": "일 년 중 가장 신경 쓰이는 날이 아버님 기제삿날이다.", "value": { "text_id": "1", "word_num": 9, "핵심동사": "기제삿날이다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": "기제삿날이다" } }, { "charNum": "31", "label": "사실형", "length": 42, "text": "대전통영 간 고속도로가 생겼지만 서울에서 천 리 길 진주라 가깝지만은 않다.", "value": { "text_id": "2", "word_num": 11, "핵심동사": "가깝지만은", "확실성": "확실", "극성": "부정", "시제": "현재", "key_word": " " } }, { "charNum": "73", "label": "추론형", "length": 42, "text": "저녁 일찍 제사를 지낼 수도 있지만 가급적 子時(23~1시)는 지키고 싶다.", "value": { "text_id": "3", "word_num": 10, "핵심동사": "지키고", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": "지키고" } }, { "charNum": "115", "label": "추론형", "length": 39, "text": "누님이 가까이 있어 제사 음식 준비를 많이 도와주셔서 그나마 다행이다.", "value": { "text_id": "4", "word_num": 10, "핵심동사": "다행이다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": "다행이다" } }, { "charNum": "154", "label": "추론형", "length": 46, "text": "그래도 주말이 끼면 일찍 내려가서 도와야지 그러지 않으면 눈치가 이만저만이 아니다.", "value": { "text_id": "5", "word_num": 11, "핵심동사": "아니다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": "아니다" } }, { "charNum": "200", "label": "추론형", "length": 51, "text": "전을 부치면서 참기 힘든 것은 육전, 새우전, 산적, 녹두전이 뿜어내는 탄수화물의 유혹이다.", "value": { "text_id": "6", "word_num": 12, "핵심동사": "유혹이다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": "유혹이다" } }, { "charNum": "251", "label": "추론형", "length": 26, "text": "일찍 내려가서 도울 수 있어서 미안함이 덜했다.", "value": { "text_id": "7", "word_num": 7, "핵심동사": "덜했다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "덜했다" } }, { "charNum": "277", "label": "추론형", "length": 140, "text": "처음 제사상을 차릴 때는 음식의 배열과 순서를 제대로 지키지 않으면 제사상을 받으실 아버님이 크게 꾸짖을 것 같아 많이 긴장했었는데, 제사에 관한 책이나 인터넷에 그림과 함께 친절하게 설명이 잘 되어 있어서 몇 가지 집안 전통만 보태면 어렵지 않았다.", "value": { "text_id": "8", "word_num": 37, "핵심동사": "어렵지", "확실성": "확실", "극성": "부정", "시제": "과거", "key_word": "어렵지" } }, { "charNum": "417", "label": "추론형", "length": 21, "text": "조율이시, 홍동백서, 이제는 익숙하다.", "value": { "text_id": "9", "word_num": 4, "핵심동사": "익숙하다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": "익숙하다" } }, { "charNum": "438", "label": "추론형", "length": 33, "text": "23시까지 기다려주고, 축문을 읽어주는 것만으로도 대견하다.", "value": { "text_id": "10", "word_num": 6, "핵심동사": "대견하다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": "대견하다" } }, { "charNum": "471", "label": "대화형", "length": 57, "text": "할아버지가 생전에 용돈을 듬뿍 주시고 내가 못하게 하는 걸 할 수 있도록 해 주신 것에 대한 보답일까.", "value": { "text_id": "11", "word_num": 17, "핵심동사": "보답일까", "확실성": "불확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "528", "label": "추론형", "length": 22, "text": "90년대생이라 그 속을 가늠하기 어렵다.", "value": { "text_id": "12", "word_num": 5, "핵심동사": "어렵다", "확실성": "확실", "극성": "부정", "시제": "현재", "key_word": "어렵다" } }, { "charNum": "550", "label": "추론형", "length": 21, "text": "＇불효할까봐 걱정이 많으셨던 것이다.＇", "value": { "text_id": "13", "word_num": 4, "핵심동사": "많으셨던", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "많으셨던" } }, { "charNum": "571", "label": "사실형", "length": 52, "text": "나무는 고요하고자 하나 바람이 그치지 않고, 자식은 봉양하고 싶으나 부모는 기다려주지 않는다.", "value": { "text_id": "14", "word_num": 12, "핵심동사": "기다려주지", "확실성": "확실", "극성": "부정", "시제": "현재", "key_word": " " } } ], "dupLabelYn": "Y", "metaData": { "ID": "120598", "FILENAME": "120598.json", "MEDIA_TYPE": "뉴스", "MEDIA_NAME": "매일경제", "CATEGORY": "사회", "PUBDATE": "20220528", "SENTENCE": "14" } } 