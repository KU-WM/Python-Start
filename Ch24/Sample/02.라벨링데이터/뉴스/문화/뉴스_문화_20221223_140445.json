{ "annotation": [ { "charNum": "1", "label": "추론형", "length": 29, "text": "그동안 두 번이나 눈물을 흘렸지만 이번만큼은 다르다.", "value": { "text_id": "1", "word_num": 7, "핵심동사": "다르다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": "다르다" } }, { "charNum": "30", "label": "추론형", "length": 19, "text": "겉으로 드러난 평창 분위기는 좋다.", "value": { "text_id": "2", "word_num": 5, "핵심동사": "좋다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": "좋다" } }, { "charNum": "49", "label": "추론형", "length": 17, "text": "외신들 평가가 이를 뒷받침한다.", "value": { "text_id": "3", "word_num": 4, "핵심동사": "뒷받침한다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": "뒷받침한다" } }, { "charNum": "66", "label": "추론형", "length": 24, "text": "평창은 경기장 등 인프라스트럭처가 강점이다.", "value": { "text_id": "4", "word_num": 5, "핵심동사": "강점이다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": "강점이다" } }, { "charNum": "90", "label": "추론형", "length": 28, "text": "국민 성원과 강력한 정부 지원도 평창의 경쟁력이다.", "value": { "text_id": "5", "word_num": 7, "핵심동사": "경쟁력이다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": "경쟁력이다" } }, { "charNum": "118", "label": "추론형", "length": 28, "text": "바흐 부위원장은 평창이 가장 경계해야 할 인물이다.", "value": { "text_id": "6", "word_num": 7, "핵심동사": "인물이다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": "인물이다" } }, { "charNum": "146", "label": "추론형", "length": 90, "text": "2018년 후보도시 현지실사 순서가 위치와 이동거리를 무시한 채 안시-평창-뮌헨으로 짜인 것도 막강한 영향력을 지닌 그의 입김이 작용했을 것이라는 관측이 나온다.", "value": { "text_id": "7", "word_num": 20, "핵심동사": "나온다", "확실성": "불확실", "극성": "긍정", "시제": "현재", "key_word": "나온다" } }, { "charNum": "236", "label": "추론형", "length": 86, "text": "2010·2014년 동계올림픽 유치전 당시 모두 1차 투표에서는 1위를 했지만 탈락 국가들 표를 흡수하지 못하며 밴쿠버와 소치에 역전패를 당했기 때문이다.", "value": { "text_id": "8", "word_num": 19, "핵심동사": "때문이다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "때문이다" } }, { "charNum": "322", "label": "추론형", "length": 72, "text": "평창으로선 아프리카와 중남미 표를 우리편으로 만들고 2차 투표까지 갔을 때 유럽 표를 분산시키는 전략을 계획대로 잘 펼쳐야 한다.", "value": { "text_id": "9", "word_num": 18, "핵심동사": "펼쳐야", "확실성": "불확실", "극성": "긍정", "시제": "미래", "key_word": "펼쳐야" } }, { "charNum": "394", "label": "추론형", "length": 41, "text": "이 때문에 평창이 동계올림픽을 유치할 경우 선진국 이미지도 얻을 수 있다.", "value": { "text_id": "10", "word_num": 11, "핵심동사": "얻을", "확실성": "불확실", "극성": "긍정", "시제": "미래", "key_word": "얻을" } } ], "dupLabelYn": "Y", "metaData": { "ID": "140445", "FILENAME": "140445.json", "MEDIA_TYPE": "뉴스", "MEDIA_NAME": "매일경제", "CATEGORY": "문화", "PUBDATE": "20110104", "SENTENCE": "10" } } 