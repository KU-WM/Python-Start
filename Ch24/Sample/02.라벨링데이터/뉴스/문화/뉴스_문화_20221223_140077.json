{ "annotation": [ { "charNum": "1", "label": "추론형", "length": 32, "text": "'데뷔하기가 이렇게 힘든가, 이렇게 생각했던 작품이었다.'", "value": { "text_id": "1", "word_num": 6, "핵심동사": "작품이었다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "작품이었다" } }, { "charNum": "33", "label": "추론형", "length": 73, "text": "영화 `범죄도시2`로 관객 1000만명을 달성한 영화 반열에 오른 이상용 감독은 촬영 장소였던 베트남에서 돌아오며 이렇게 생각했다.", "value": { "text_id": "2", "word_num": 16, "핵심동사": "생각했다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "생각했다" } }, { "charNum": "106", "label": "추론형", "length": 39, "text": "어렵게 만들어진 `범죄도시2`의 위상은, 그러나 지금은 하늘을 찌른다.", "value": { "text_id": "3", "word_num": 8, "핵심동사": "찌른다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": "찌른다" } }, { "charNum": "145", "label": "추론형", "length": 33, "text": "'이렇게 많은 분이 극장을 찾아주신 건 너무 큰 기쁨이다.'", "value": { "text_id": "4", "word_num": 9, "핵심동사": "기쁨이다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": "기쁨이다" } }, { "charNum": "178", "label": "추론형", "length": 46, "text": "'이번 기회로 아직 개봉 일자를 잡지 못한 작품들이 빨리 개봉할 수 있길 바란다.'", "value": { "text_id": "5", "word_num": 13, "핵심동사": "있길", "확실성": "확실", "극성": "미정", "시제": "미래", "key_word": "있길" } }, { "charNum": "224", "label": "추론형", "length": 28, "text": "'움츠러들었던 투자도 활발해지길 바라는 마음이다.'", "value": { "text_id": "6", "word_num": 5, "핵심동사": "마음이다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": "마음이다" } }, { "charNum": "252", "label": "추론형", "length": 12, "text": "'부담감이 꽤 컸다.'", "value": { "text_id": "7", "word_num": 3, "핵심동사": "컸다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "컸다" } }, { "charNum": "264", "label": "추론형", "length": 63, "text": "'하지만 주어진 역할에 충실하려고 노력했고, 기회가 주어졌으니 `못 만든 영화는 아니다`라는 평을 듣고 싶었다.'", "value": { "text_id": "8", "word_num": 14, "핵심동사": "듣고", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "듣고" } }, { "charNum": "327", "label": "추론형", "length": 53, "text": "'코로나19가 풀리면서 관객분들이 영화관을 많이 찾아주신 점이 흥행의 큰 동력이었던 것 같다.'", "value": { "text_id": "9", "word_num": 12, "핵심동사": "동력이었던", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "동력이었던" } }, { "charNum": "380", "label": "추론형", "length": 36, "text": "'`손석구 신드롬`도 1000만 영화에 한몫을 했다고 확신한다.'", "value": { "text_id": "10", "word_num": 7, "핵심동사": "확신한다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": "확신한다" } }, { "charNum": "416", "label": "추론형", "length": 34, "text": "`범죄도시2`의 히어로 마동석은 현장에서도 든든한 거목이었다.", "value": { "text_id": "11", "word_num": 6, "핵심동사": "거목이었다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "거목이었다" } }, { "charNum": "450", "label": "추론형", "length": 69, "text": "'사실 안 되는 걸 끝까지 물고 늘어질 수 없는 곳이 영화 현장인데, 마 배우가 상황을 돌파하는 방식 자체가 인상적이었다.'", "value": { "text_id": "12", "word_num": 19, "핵심동사": "인상적이었다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "인상적이었다" } }, { "charNum": "519", "label": "추론형", "length": 39, "text": "'에너지 자체가 긍정적이어서 모두 합심해서 즐겁게 일하는 분위기였다.'", "value": { "text_id": "13", "word_num": 8, "핵심동사": "분위기였다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "분위기였다" } }, { "charNum": "558", "label": "예측형", "length": 17, "text": "오는 7월부터 촬영에 들어간다.", "value": { "text_id": "14", "word_num": 4, "핵심동사": "들어간다", "확실성": "확실", "극성": "긍정", "시제": "미래", "key_word": "들어간다" } }, { "charNum": "575", "label": "예측형", "length": 16, "text": "'새 팀이 꾸려질 것 같다.'", "value": { "text_id": "15", "word_num": 5, "핵심동사": "꾸려질", "확실성": "불확실", "극성": "긍정", "시제": "미래", "key_word": "꾸려질" } }, { "charNum": "591", "label": "추론형", "length": 145, "text": "이 감독은 '사실 개봉한다는 것만으로도 너무 좋았다. 흥행이 될지는 노심초사했던 부분인데 이렇게 큰 관심을 얻을지는 몰랐다'면서도 '감사하지만 사실 앞으로가 더 걱정이다. 다음에 얼마나 더 잘해야 하는지 걱정도 된다. 솔직히 겁이 많이 난다'며 환하게 웃었다.", "value": { "text_id": "16", "word_num": 34, "핵심동사": "웃었다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "웃었다" } } ], "dupLabelYn": "Y", "metaData": { "ID": "140077", "FILENAME": "140077.json", "MEDIA_TYPE": "뉴스", "MEDIA_NAME": "매일경제신문", "CATEGORY": "문화", "PUBDATE": "20220614", "SENTENCE": "16" } } 