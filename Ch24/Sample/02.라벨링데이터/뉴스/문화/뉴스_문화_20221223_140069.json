{ "annotation": [ { "charNum": "1", "label": "사실형", "length": 12, "text": "공장의 변신은 무죄다.", "value": { "text_id": "1", "word_num": 3, "핵심동사": "무죄다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "13", "label": "사실형", "length": 38, "text": "건물명 F는 팩토리(Factory)를 뜻하고, 1963은 설립연도다.", "value": { "text_id": "2", "word_num": 6, "핵심동사": "설립연도다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "51", "label": "사실형", "length": 25, "text": "건물 내외부에 생산시설이었던 흔적이 남아있다.", "value": { "text_id": "3", "word_num": 5, "핵심동사": "남아있다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "76", "label": "추론형", "length": 39, "text": "서울 을지로에 힙지로로 불리는 카페며 식당처럼 레트로 감성을 자극한다.", "value": { "text_id": "4", "word_num": 9, "핵심동사": "자극한다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": "자극한다" } }, { "charNum": "115", "label": "사실형", "length": 32, "text": "건물 외부에는 분수와 대나무 숲 등이 사진 명소로 꼽힌다.", "value": { "text_id": "5", "word_num": 9, "핵심동사": "꼽힌다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "147", "label": "사실형", "length": 76, "text": "F1963는 부산 수영구 망미동에 위치한 복합 예술 · 문화 공간으로 선재(線材)회사인 고려제강의 첫 공장인 수영공장이 위치했던 장소다.", "value": { "text_id": "6", "word_num": 17, "핵심동사": "장소다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "223", "label": "사실형", "length": 75, "text": "고려제강 수영공장에서는 1963년부터 2008년까지 45년간 와이어로프를 생산했으며 이후 공장이 장소를 이전하면서 창고로 쓰이게 됐다.", "value": { "text_id": "7", "word_num": 14, "핵심동사": "쓰이게", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "298", "label": "사실형", "length": 71, "text": "그러다 2014년 부산비엔날레 특별 전시장으로 사용된 것을 계기로 2016년 리모델링을 거쳐 부산비엔날레 전시장으로 재탄생했다.", "value": { "text_id": "8", "word_num": 14, "핵심동사": "재탄생했다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": " " } }, { "charNum": "369", "label": "추론형", "length": 81, "text": "공장 내부에는 국내 최대 규모 중고서점인 예스24, 커피전문점 테라로사, 막걸리 명가 복순도가 등이 입점해 있어 실내 데이트를 하기에도 적절하다.", "value": { "text_id": "9", "word_num": 19, "핵심동사": "적절하다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": "적절하다" } } ], "dupLabelYn": "Y", "metaData": { "ID": "140069", "FILENAME": "140069.json", "MEDIA_TYPE": "뉴스", "MEDIA_NAME": "매일경제신문", "CATEGORY": "문화", "PUBDATE": "20220615", "SENTENCE": "9" } } 