{ "annotation": [ { "charNum": "1", "label": "추론형", "length": 61, "text": "부산역까지 시간이 애매하게 남았다면 초량동 이바구길을 지나 168계단 모노레일 위 명란브랜드연구소가 적절하다.", "value": { "text_id": "1", "word_num": 12, "핵심동사": "적절하다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": "적절하다" } }, { "charNum": "62", "label": "사실형", "length": 18, "text": "부산역까지 걸어서 20분 거리다.", "value": { "text_id": "2", "word_num": 4, "핵심동사": "거리다", "확실성": "불확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "80", "label": "사실형", "length": 53, "text": "다만, 운영시간이 화요일~토요일 오후 9시, 일요일에는 7시까지라 늦은 시간에는 이용이 어렵다.", "value": { "text_id": "3", "word_num": 11, "핵심동사": "어렵다", "확실성": "불확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "133", "label": "추론형", "length": 29, "text": "노을을 감상하면서 식사와 커피를 해결하기엔 딱 좋다.", "value": { "text_id": "4", "word_num": 7, "핵심동사": "좋다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": "좋다" } }, { "charNum": "162", "label": "사실형", "length": 53, "text": "명란 토마토 파스타가 대표 메뉴이며, 아메리카노 커피 가격이 3000원으로 상대적으로 저렴하다.", "value": { "text_id": "5", "word_num": 11, "핵심동사": "저렴하다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "215", "label": "추론형", "length": 19, "text": "이쯤에서 명란 이야기를 꺼내야겠다.", "value": { "text_id": "6", "word_num": 4, "핵심동사": "꺼내야겠다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": "꺼내야겠다" } }, { "charNum": "234", "label": "사실형", "length": 88, "text": "부산 초량에 웬 명란인가 싶겠지만, 이곳은 명란의 발상지인 남선창고와 초량전통시장의 역사적 스토리를 가공한 지역 특화 콘텐츠로 색다른 체험이 가능한 공간이다.", "value": { "text_id": "7", "word_num": 20, "핵심동사": "공간이다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "322", "label": "사실형", "length": 47, "text": "한국관광공사 부산울산지사에서 야심차게 밀고 있는 원도심 신규 관광 콘텐츠이기도 하다.", "value": { "text_id": "8", "word_num": 10, "핵심동사": "하다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "369", "label": "사실형", "length": 104, "text": "명란삼남매굿즈, 명란파스타 셀프쿠킹 체험, 야경이 돋보이는 카페 등으로 구성된 복합문화공간으로 먹거리, 볼거리 등 다양한 체험을 동시에 즐길 수 있는 지역 관광 명소를 목표로 조성되었다.", "value": { "text_id": "9", "word_num": 24, "핵심동사": "조성되었다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": " " } }, { "charNum": "473", "label": "사실형", "length": 28, "text": "2022 부산 강소형잠재관광지로 선정되었기도 했다.", "value": { "text_id": "10", "word_num": 5, "핵심동사": "선정되었기도", "확실성": "불확실", "극성": "긍정", "시제": "과거", "key_word": " " } }, { "charNum": "501", "label": "사실형", "length": 39, "text": "근처 이바구충전소에서는 직접 명란 파스타 만드는 체험을 할 수도 있다.", "value": { "text_id": "11", "word_num": 10, "핵심동사": "할", "확실성": "불확실", "극성": "긍정", "시제": "현재", "key_word": " " } } ], "dupLabelYn": "Y", "metaData": { "ID": "140070", "FILENAME": "140070.json", "MEDIA_TYPE": "뉴스", "MEDIA_NAME": "매일경제신문", "CATEGORY": "문화", "PUBDATE": "20220615", "SENTENCE": "11" } } 