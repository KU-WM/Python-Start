{ "annotation": [ { "charNum": "1", "label": "대화형", "length": 60, "text": "＂저희가 엄청난 선을 넘었다고 표현할 수도 있는데 생각해보면 사실 오스카가 선을 넘은 것 같아요.(이선균)＂", "value": { "text_id": "1", "word_num": 14, "핵심동사": "넘은", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": " " } }, { "charNum": "61", "label": "대화형", "length": 48, "text": "＂저는 한국시간으로 생일이었는데 배우로서 최고의 생일이 아니었나 생각됩니다.(조여정)＂", "value": { "text_id": "2", "word_num": 8, "핵심동사": "생각됩니다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "109", "label": "추론형", "length": 51, "text": "＇기생충＇이 미국 아카데미 시상식 4개 부문을 휩쓴 뒤 배우들은 들뜬 표정을 감추지 못했다.", "value": { "text_id": "3", "word_num": 13, "핵심동사": "감추지", "확실성": "확실", "극성": "부정", "시제": "과거", "key_word": "감추지" } }, { "charNum": "160", "label": "사실형", "length": 25, "text": "이날 배우들은 시상식 후보에 지명되지 못했다.", "value": { "text_id": "4", "word_num": 6, "핵심동사": "지명되지", "확실성": "확실", "극성": "부정", "시제": "과거", "key_word": " " } }, { "charNum": "185", "label": "대화형", "length": 37, "text": "＂기우의 대사 중에 ＇원래 계획에 없던 건데＇라는 말이 있잖아요.＂", "value": { "text_id": "5", "word_num": 9, "핵심동사": "있잖아요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "222", "label": "대화형", "length": 42, "text": "＂그런데 이번엔 계획할 수 없는 너무 큰 이벤트를 맞이하게 돼서 행복해요.＂", "value": { "text_id": "6", "word_num": 11, "핵심동사": "행복해요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "264", "label": "대화형", "length": 26, "text": "＂저는 봉준호의 진화를 20년 동안 봐왔어요.＂", "value": { "text_id": "7", "word_num": 6, "핵심동사": "봐왔어요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "290", "label": "대화형", "length": 43, "text": "＂＇기생충＇이라는 영화는 봉준호 20년 리얼리즘의 완성에 와 있는 작품이죠.＂", "value": { "text_id": "8", "word_num": 9, "핵심동사": "작품이죠", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "333", "label": "대화형", "length": 32, "text": "＂저는 배우이자 그의 팬으로서 같이 세월을 보내왔습니다.＂", "value": { "text_id": "9", "word_num": 7, "핵심동사": "보내왔습니다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": " " } }, { "charNum": "365", "label": "대화형", "length": 52, "text": "＂봉 감독이 끈을 놓지 않으며 삶에 대해 깊이 있게 성찰하는 모습을 가장 가까이서 봐왔어요.＂", "value": { "text_id": "10", "word_num": 14, "핵심동사": "봐왔어요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "417", "label": "추론형", "length": 15, "text": "차기작에 전념하기 위해서다.", "value": { "text_id": "11", "word_num": 3, "핵심동사": "위해서다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": "위해서다" } } ], "dupLabelYn": "Y", "metaData": { "ID": "140257", "FILENAME": "140257.json", "MEDIA_TYPE": "뉴스", "MEDIA_NAME": "매일경제", "CATEGORY": "문화", "PUBDATE": "20200211", "SENTENCE": "11" } } 