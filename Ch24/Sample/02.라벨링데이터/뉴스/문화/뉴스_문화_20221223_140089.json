{ "annotation": [ { "charNum": "1", "label": "사실형", "length": 45, "text": "소쇄원은 유홍준 교수가 `나의 문화유산 답사기`에서 언급하고 관광객이 몰려들었다.", "value": { "text_id": "1", "word_num": 9, "핵심동사": "몰려들었다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": " " } }, { "charNum": "46", "label": "사실형", "length": 37, "text": "소쇄원은 자연을 그대로 두고 그 주변으로 건물을 지은 특징이 있다.", "value": { "text_id": "2", "word_num": 10, "핵심동사": "있다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "83", "label": "사실형", "length": 55, "text": "건축주인 양상보는 중앙정치에서 벗어나 스스로를 ‘소쇄처사’라고 칭할 정도로 소쇄원을 끔찍이 아꼈다.", "value": { "text_id": "3", "word_num": 11, "핵심동사": "아꼈다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": " " } }, { "charNum": "138", "label": "사실형", "length": 71, "text": "양산보는 “어느 것 하나에도 내 손길이 닿지 않은 것이 없으니 팔지도 말고 어리석은 후손에게 물려주지도 말라”는 유언을 남겼다.", "value": { "text_id": "4", "word_num": 18, "핵심동사": "남겼다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": " " } }, { "charNum": "209", "label": "사실형", "length": 24, "text": "임진왜란때 불에 탔으나 이내 다시 지어졌다.", "value": { "text_id": "5", "word_num": 6, "핵심동사": "지어졌다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": " " } }, { "charNum": "233", "label": "사실형", "length": 18, "text": "조선 후기 건축이 보존되어 있다.", "value": { "text_id": "6", "word_num": 5, "핵심동사": "보존되어", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "251", "label": "추론형", "length": 70, "text": "역사적 가치와 건축적 특징을 굳이 일일이 학습하지 않더라도 그 곳에 가게 되면 옛 선조처럼 신선놀음하는 기분을 느낄 수 있다.", "value": { "text_id": "7", "word_num": 19, "핵심동사": "느낄", "확실성": "불확실", "극성": "긍정", "시제": "미래", "key_word": "느낄" } }, { "charNum": "321", "label": "사실형", "length": 44, "text": "둥실 떠다니 흰구름 벗삼아 멍 때리다 보면 잠시 세상사나 근심걱정을 잊게 된다.", "value": { "text_id": "8", "word_num": 12, "핵심동사": "잊게", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "365", "label": "사실형", "length": 44, "text": "소새원 인근 식영정은 김성원이 1560년에 장인인 임억령을 위하여 지은 정자다.", "value": { "text_id": "9", "word_num": 10, "핵심동사": "정자다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "409", "label": "사실형", "length": 29, "text": "‘그늘도 쉬어간다’는 의미를 담아 식영정이라 지었다.", "value": { "text_id": "10", "word_num": 6, "핵심동사": "지었다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": " " } }, { "charNum": "438", "label": "사실형", "length": 25, "text": "송강 정철이 성산별곡을 지은 장소로 유명하다.", "value": { "text_id": "11", "word_num": 6, "핵심동사": "유명하다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "463", "label": "사실형", "length": 18, "text": "식영정 내부에는 시구가 걸려있다.", "value": { "text_id": "12", "word_num": 4, "핵심동사": "걸려있다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "481", "label": "사실형", "length": 50, "text": "오늘날 래퍼가 라임에 맞춰서 랩을 뱉듯이 선비들은 각운에 맞게 시를 지으며 놀았다고 한다.", "value": { "text_id": "13", "word_num": 13, "핵심동사": "놀았다고", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": " " } }, { "charNum": "531", "label": "사실형", "length": 8, "text": "그 기록들이다.", "value": { "text_id": "14", "word_num": 2, "핵심동사": "기록들이다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "539", "label": "사실형", "length": 42, "text": "식영정 바로 옆에는 김성원이 자신의 호를 따서 지은 서하당이 복원되어 있다.", "value": { "text_id": "15", "word_num": 11, "핵심동사": "복원되어", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } } ], "dupLabelYn": "Y", "metaData": { "ID": "140089", "FILENAME": "140089.json", "MEDIA_TYPE": "뉴스", "MEDIA_NAME": "매일경제신문", "CATEGORY": "문화", "PUBDATE": "20220614", "SENTENCE": "15" } } 