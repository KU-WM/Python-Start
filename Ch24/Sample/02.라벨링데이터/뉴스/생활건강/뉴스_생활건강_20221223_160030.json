{ "annotation": [ { "charNum": "1", "label": "사실형", "length": 27, "text": "무선이어폰을 특별하게 만들어주는 커버가 등장했다.", "value": { "text_id": "1", "word_num": 5, "핵심동사": "등장했다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": " " } }, { "charNum": "28", "label": "사실형", "length": 35, "text": "삼성전자의 갤럭시 버즈2 전용의 포켓몬 몬스터볼 커버 패키지다.", "value": { "text_id": "2", "word_num": 8, "핵심동사": "패키지다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "63", "label": "사실형", "length": 29, "text": "커버는 애니메이션 ‘포켓몬스터’의 몬스터볼 형상이다.", "value": { "text_id": "3", "word_num": 5, "핵심동사": "형상이다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "92", "label": "추론형", "length": 51, "text": "휴대하기 편리한 디자인은 아니지만 ‘포켓몬스터’ 팬이라면 그런 단점을 덮을 만큼 매력적이다.", "value": { "text_id": "4", "word_num": 11, "핵심동사": "매력적이다", "확실성": "불확실", "극성": "긍정", "시제": "현재", "key_word": "매력적이다" } }, { "charNum": "143", "label": "사실형", "length": 38, "text": "공 모양이지만 무게 중심을 고려한 설계로 안정적인 균형감을 제공한다.", "value": { "text_id": "5", "word_num": 9, "핵심동사": "제공한다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "181", "label": "사실형", "length": 25, "text": "또한 커버에는 포켓몬 스티커가 함께 들어있다.", "value": { "text_id": "6", "word_num": 6, "핵심동사": "들어있다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "206", "label": "사실형", "length": 46, "text": "피카츄, 파이리, 꼬부기, 뮤 등 총 11종의 포켓몬 중 랜덤으로 1종이 제공된다.", "value": { "text_id": "7", "word_num": 12, "핵심동사": "제공된다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "252", "label": "사실형", "length": 67, "text": "참고로 갤럭시 버즈2는 액티브 노이즈 캔슬링을 탑재해 사용자가 고개를 움직이면 그에 맞춰 소리의 방향을 정확히 찾아낸다.", "value": { "text_id": "8", "word_num": 16, "핵심동사": "찾아낸다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "319", "label": "사실형", "length": 83, "text": "또 강력한 몰입감을 선사하는 ‘360 오디오’와, 울트라 와이드밴드 기술을 활용해 분실된 버즈를 찾을 수 있는 ‘스마트싱스 파인드’ 기능도 적용됐다.", "value": { "text_id": "9", "word_num": 19, "핵심동사": "적용됐다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": " " } }, { "charNum": "402", "label": "사실형", "length": 47, "text": "갤럭시 버즈2 포켓몬 몬스터볼 커버 패키지는 가격 13만4000원으로 저렴하진 않다.", "value": { "text_id": "10", "word_num": 10, "핵심동사": "저렴하진", "확실성": "확실", "극성": "부정", "시제": "현재", "key_word": " " } }, { "charNum": "449", "label": "사실형", "length": 17, "text": "하지만 한정 수량으로 판매된다.", "value": { "text_id": "11", "word_num": 4, "핵심동사": "판매된다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "466", "label": "추론형", "length": 20, "text": "결제를 고민하는 사이 동날 수 있다.", "value": { "text_id": "12", "word_num": 6, "핵심동사": "동날", "확실성": "불확실", "극성": "미정", "시제": "미래", "key_word": "동날" } } ], "dupLabelYn": "Y", "metaData": { "ID": "160030", "FILENAME": "160030.json", "MEDIA_TYPE": "뉴스", "MEDIA_NAME": "매일경제신문", "CATEGORY": "생활건강", "PUBDATE": "20220602", "SENTENCE": "12" } } 