{ "annotation": [ { "charNum": "1", "label": "추론형", "length": 30, "text": "치매와 같은 병적 망각과 달리 정상적 망각은 축복이다.", "value": { "text_id": "1", "word_num": 8, "핵심동사": "축복이다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": "축복이다" } }, { "charNum": "31", "label": "추론형", "length": 38, "text": "인지가 형성되기 위해서는 기억과 망각이 이룬 균형이 반드시 필요하다.", "value": { "text_id": "2", "word_num": 9, "핵심동사": "필요하다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": "필요하다" } }, { "charNum": "69", "label": "추론형", "length": 73, "text": "그래야만 끊임없이 변하는 환경을 받아들이도록 융통성을 발휘할 수 있고 뒤죽박죽 흩어진 정보를 바탕으로 추상 개념을 추출할 수 있다.", "value": { "text_id": "3", "word_num": 18, "핵심동사": "추출할", "확실성": "불확실", "극성": "미정", "시제": "미래", "key_word": "추출할" } }, { "charNum": "142", "label": "추론형", "length": 21, "text": "정서적 행복을 위해서도 망각은 필수다.", "value": { "text_id": "4", "word_num": 5, "핵심동사": "필수다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": "필수다" } }, { "charNum": "163", "label": "추론형", "length": 31, "text": "분노와 신경증적 공포, 통증의 경험도 내려놓을 수 있다.", "value": { "text_id": "5", "word_num": 8, "핵심동사": "내려놓을", "확실성": "불확실", "극성": "미정", "시제": "미래", "key_word": "내려놓을" } }, { "charNum": "194", "label": "추론형", "length": 23, "text": "너무 많이 기억하면 고통의 감옥에 갇힌다.", "value": { "text_id": "6", "word_num": 6, "핵심동사": "갇힌다", "확실성": "확실", "극성": "긍정", "시제": "미래", "key_word": "갇힌다" } }, { "charNum": "217", "label": "추론형", "length": 19, "text": "창의성을 위해서도 망각은 필요하다.", "value": { "text_id": "7", "word_num": 4, "핵심동사": "필요하다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": "필요하다" } }, { "charNum": "236", "label": "추론형", "length": 53, "text": "뜻밖의 연상이 떠오르는 유레카의 순간이 찾아올 수 있도록 망각이 머리를 가볍게 해주기 때문이다.", "value": { "text_id": "8", "word_num": 13, "핵심동사": "때문이다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": "때문이다" } }, { "charNum": "289", "label": "추론형", "length": 42, "text": "망각하지 않으면 모든 창조적 상상의 나래는 기억의 굴레에 얽매여 있게 된다.", "value": { "text_id": "9", "word_num": 11, "핵심동사": "얽매여", "확실성": "확실", "극성": "긍정", "시제": "미래", "key_word": "얽매여" } }, { "charNum": "331", "label": "사실형", "length": 83, "text": "미술사가들은 마지막 몇 작품만 제외하고 대다수 작품이 높은 예술적 품질을 갖춘 것으로 평가하며 그의 예술적 궤적과도 일관성을 보인다고 결론을 내렸다.", "value": { "text_id": "10", "word_num": 20, "핵심동사": "내렸다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": " " } }, { "charNum": "414", "label": "추론형", "length": 42, "text": "그의 사후인 1997년 뉴욕 현대미술관 전시가 세계적 갈채를 받은 비결이다.", "value": { "text_id": "11", "word_num": 10, "핵심동사": "비결이다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": "비결이다" } } ], "dupLabelYn": "Y", "metaData": { "ID": "160023", "FILENAME": "160023.json", "MEDIA_TYPE": "뉴스", "MEDIA_NAME": "매일경제신문", "CATEGORY": "생활건강", "PUBDATE": "20220602", "SENTENCE": "11" } } 