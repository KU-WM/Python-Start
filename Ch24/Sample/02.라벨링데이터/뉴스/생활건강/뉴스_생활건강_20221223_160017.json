{ "annotation": [ { "charNum": "1", "label": "대화형", "length": 39, "text": "마늘꽃이 얼마나 예쁘면 도로변에 경관 식물로 재배하는 곳까지 생겼을까.", "value": { "text_id": "1", "word_num": 9, "핵심동사": "생겼을까", "확실성": "불확실", "극성": "미정", "시제": "과거", "key_word": " " } }, { "charNum": "40", "label": "사실형", "length": 53, "text": "가사 속 사진은 전라남도 강진군 작천면 부흥마을 도로변에 조성되어 있는 코끼리마늘밭의 풍경이다.", "value": { "text_id": "2", "word_num": 12, "핵심동사": "풍경이다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "93", "label": "사실형", "length": 25, "text": "6월 중순쯤 되면 마늘은 꽃을 활짝 피어낸다.", "value": { "text_id": "3", "word_num": 7, "핵심동사": "피어낸다", "확실성": "확실", "극성": "긍정", "시제": "미래", "key_word": " " } }, { "charNum": "118", "label": "사실형", "length": 15, "text": "마늘꽃의 색깔은 보라색이다.", "value": { "text_id": "4", "word_num": 3, "핵심동사": "보라색이다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "133", "label": "사실형", "length": 14, "text": "향기는 마늘향 그대로이다.", "value": { "text_id": "5", "word_num": 3, "핵심동사": "그대로이다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "147", "label": "사실형", "length": 25, "text": "물론 생마늘의 강한 향기가 나는 것은 아니다.", "value": { "text_id": "6", "word_num": 7, "핵심동사": "아니다", "확실성": "확실", "극성": "부정", "시제": "현재", "key_word": " " } }, { "charNum": "172", "label": "사실형", "length": 8, "text": "은은한 냄새다.", "value": { "text_id": "7", "word_num": 2, "핵심동사": "냄새다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "180", "label": "사실형", "length": 11, "text": "꽃이니 꿀도 나온다.", "value": { "text_id": "8", "word_num": 3, "핵심동사": "나온다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "191", "label": "사실형", "length": 25, "text": "나비와 벌이 착륙해 열심히 꿀을 빨기도 한다.", "value": { "text_id": "9", "word_num": 7, "핵심동사": "빨기도", "확실성": "확실", "극성": "긍정", "시제": "미래", "key_word": " " } }, { "charNum": "216", "label": "사실형", "length": 41, "text": "코끼리마늘의 경우 대형화된 품종이라 마늘도 크고 줄기도 1m 이상 자란다.", "value": { "text_id": "10", "word_num": 10, "핵심동사": "자란다", "확실성": "확실", "극성": "긍정", "시제": "미래", "key_word": " " } }, { "charNum": "257", "label": "사실형", "length": 38, "text": "일반 마늘의 경우 1m 이하로 자라고 색깔도 보라 또는 흰색이 있다.", "value": { "text_id": "11", "word_num": 11, "핵심동사": "있다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "295", "label": "사실형", "length": 36, "text": "또한 품종에 따라 6월 말~7월 사이에 꽃을 피우는 경우도 많다.", "value": { "text_id": "12", "word_num": 10, "핵심동사": "많다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "331", "label": "사실형", "length": 23, "text": "끝이 뾰족한 것도 모든 마늘꽃의 특징이다.", "value": { "text_id": "13", "word_num": 6, "핵심동사": "특징이다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "354", "label": "사실형", "length": 52, "text": "자세히 보면 꽃 생김새가 마늘뿌리에서 분리한 깐 마늘 하나하나의 모습과 비슷해 보이기도 한다.", "value": { "text_id": "14", "word_num": 13, "핵심동사": "보이기도", "확실성": "불확실", "극성": "미정", "시제": "현재", "key_word": " " } }, { "charNum": "406", "label": "사실형", "length": 38, "text": "마늘은 백합과 여러해살이 풀로, 전반적으로 우아한 모습을 띠고 있다.", "value": { "text_id": "15", "word_num": 9, "핵심동사": "띠고", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "444", "label": "사실형", "length": 37, "text": "마늘꽃과 거의 똑같이 생긴 마늘 뿌리는 세계 최강 천연 소독제이다.", "value": { "text_id": "16", "word_num": 10, "핵심동사": "소독제이다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "481", "label": "사실형", "length": 109, "text": "우리 몸에 들어온 온갖 잡균을 죽여주는 역할을 함은 물론 혈관을 건강하게 해줘 혈관이 딱딱해 지는 동맥경화를 개선시켜주고 나쁜 콜레스테롤을 줄이며 혈액순환을 원활하게 해주는 착한 음식이기도 하다.", "value": { "text_id": "17", "word_num": 26, "핵심동사": "음식이기도", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "590", "label": "사실형", "length": 20, "text": "마늘의 알리신 성분이 대활약을 한다.", "value": { "text_id": "18", "word_num": 5, "핵심동사": "한다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } } ], "dupLabelYn": "Y", "metaData": { "ID": "160017", "FILENAME": "160017.json", "MEDIA_TYPE": "뉴스", "MEDIA_NAME": "매일경제신문", "CATEGORY": "생활건강", "PUBDATE": "20220609", "SENTENCE": "18" } } 