{ "annotation": [ { "charNum": "1", "label": "사실형", "length": 15, "text": "강황꽃을 보기란 쉽지 않다.", "value": { "text_id": "1", "word_num": 4, "핵심동사": "쉽지", "확실성": "확실", "극성": "부정", "시제": "현재", "key_word": " " } }, { "charNum": "16", "label": "사실형", "length": 68, "text": "그런데 강황 나무를 집에서 키우는 사람의 이야기나 사진을 보면 당장 나도 강황을 베란다에 들이고 싶어지는 욕구가 일어난다.", "value": { "text_id": "2", "word_num": 17, "핵심동사": "일어난다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "84", "label": "추론형", "length": 14, "text": "의젓하고 예쁘기 때문이다.", "value": { "text_id": "3", "word_num": 3, "핵심동사": "예쁘기", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": "예쁘기" } }, { "charNum": "98", "label": "사실형", "length": 29, "text": "강황 나무는 전형적인 열대 식물의 모습을 하고 있다.", "value": { "text_id": "4", "word_num": 8, "핵심동사": "하고", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "127", "label": "사실형", "length": 15, "text": "일단 키가 크고 잎도 넓다.", "value": { "text_id": "5", "word_num": 5, "핵심동사": "넓다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "142", "label": "사실형", "length": 19, "text": "바나나나무를 축소해 놓은 모습이다.", "value": { "text_id": "6", "word_num": 4, "핵심동사": "모습이다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "161", "label": "사실형", "length": 107, "text": "그래서 마당이나 화분에 심어 재배할 경우 그 쑥쑥 자라는 성장 속도에 놀라게 되고, 어느 정도 자라고 나면 잎이 너무 무성해져서 베란다 정원을 만든 사람의 경우 통행이 힘들 정도로 뻗어나간다.", "value": { "text_id": "7", "word_num": 29, "핵심동사": "뻗어나간다", "확실성": "확실", "극성": "긍정", "시제": "미래", "key_word": " " } }, { "charNum": "268", "label": "추론형", "length": 7, "text": "꽃도 예쁘다.", "value": { "text_id": "8", "word_num": 2, "핵심동사": "예쁘다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": "예쁘다" } }, { "charNum": "275", "label": "사실형", "length": 141, "text": "강황은 꽃을 잘 보여주지 않는다는 속설이 있지만 깊이 30cm 이상의 커다란 화분, 햇볕에 잘 노출되는 장소, 충분한 수분 공급, 특히 무섭게 자라는 6~8월 사이의 철저한 물주기 등 생육법을 잘 지켜주면 매년 어여쁜 흰색, 노란색 꽃을 만날 수 있다.", "value": { "text_id": "9", "word_num": 38, "핵심동사": "만날", "확실성": "불확실", "극성": "미정", "시제": "미래", "key_word": " " } }, { "charNum": "416", "label": "사실형", "length": 56, "text": "또한 한번 개화하면 꽤 오랜 시간 활짝 피어 있어, 온 집안을 은은한 강황의 향으로 가득 채워 준다.", "value": { "text_id": "10", "word_num": 17, "핵심동사": "준다", "확실성": "확실", "극성": "긍정", "시제": "미래", "key_word": " " } }, { "charNum": "472", "label": "사실형", "length": 52, "text": "적당한 시점에 꽃을 따서 덖으면 차로 이용할 수도 있고, 곱게 빻아 약처럼 사용할 수도 있다.", "value": { "text_id": "11", "word_num": 15, "핵심동사": "사용할", "확실성": "확실", "극성": "미정", "시제": "미래", "key_word": " " } }, { "charNum": "524", "label": "사실형", "length": 61, "text": "강황은 생강과의 여러해살이 풀인데, 꽃도 예쁘지만 뿌리의 향기와 영양이 탁월해서 카레의 원료로 애용되고 있다.", "value": { "text_id": "12", "word_num": 14, "핵심동사": "애용되고", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "585", "label": "추론형", "length": 56, "text": "특히 항염증 작용이 탁월해 과립 등 먹기 좋게 만든 식품을 꾸준하게 섭취하면 효과를 기대할 수 있다.", "value": { "text_id": "13", "word_num": 16, "핵심동사": "기대할", "확실성": "불확실", "극성": "미정", "시제": "미래", "key_word": "기대할" } } ], "dupLabelYn": "Y", "metaData": { "ID": "160018", "FILENAME": "160018.json", "MEDIA_TYPE": "뉴스", "MEDIA_NAME": "매일경제신문", "CATEGORY": "생활건강", "PUBDATE": "20220609", "SENTENCE": "13" } } 