{ "annotation": [ { "charNum": "1", "label": "대화형", "length": 24, "text": "＂자, 이렇게 반죽은 다 준비가 됐습니다.＂", "value": { "text_id": "1", "word_num": 6, "핵심동사": "됐습니다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": " " } }, { "charNum": "25", "label": "대화형", "length": 23, "text": "＂이제 감자채전을 완성해 보도록 할게요.＂", "value": { "text_id": "2", "word_num": 5, "핵심동사": "완성해", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "48", "label": "대화형", "length": 39, "text": "＂팬에 기름을 넉넉하게 두르고 처음엔 센 불에 1~2분 구워 주세요.＂", "value": { "text_id": "3", "word_num": 10, "핵심동사": "구워", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "87", "label": "대화형", "length": 26, "text": "＂그래야 밑면이 잘 달라붙어 흩어지지 않아요.＂", "value": { "text_id": "4", "word_num": 6, "핵심동사": "흩어지지", "확실성": "확실", "극성": "부정", "시제": "미래", "key_word": " " } }, { "charNum": "113", "label": "대화형", "length": 32, "text": "＂다음은 뒤집어서 중 불에 노릇하게 구워 주시면 됩니다.＂", "value": { "text_id": "5", "word_num": 8, "핵심동사": "구워", "확실성": "확실", "극성": "긍정", "시제": "미래", "key_word": " " } }, { "charNum": "145", "label": "대화형", "length": 27, "text": "＂자, 이렇게 완성된 감자채전은 그릇에 담고요.＂", "value": { "text_id": "6", "word_num": 6, "핵심동사": "담고요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "172", "label": "대화형", "length": 42, "text": "＂이렇게 먹어도 맛있지만 여기에 뭐 하나 올려 먹으면 꿀맛인데요, 뭘까요?＂", "value": { "text_id": "7", "word_num": 10, "핵심동사": "뭘까요", "확실성": "불확실", "극성": "미정", "시제": "미래", "key_word": " " } } ], "dupLabelYn": "Y", "metaData": { "ID": "560062", "FILENAME": "560062.json", "MEDIA_TYPE": "방송대본", "MEDIA_NAME": "알토란", "CATEGORY": "생활건강", "PUBDATE": "20210619", "SENTENCE": "7" } } 