{ "annotation": [ { "charNum": "1", "label": "대화형", "length": 24, "text": "＂자, 낙지 2마리를 데쳐서 준비했는데요.＂", "value": { "text_id": "1", "word_num": 6, "핵심동사": "준비했는데요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "27", "label": "대화형", "length": 45, "text": "＂소금, 밀가루 치대서 깨끗이 씻은 후 끓는 물에 30초~1분간 데치면 됩니다.＂", "value": { "text_id": "2", "word_num": 11, "핵심동사": "데치면", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "73", "label": "대화형", "length": 26, "text": "＂끓는 물에 소금이나 식초 안 넣어도 되나요?＂", "value": { "text_id": "3", "word_num": 7, "핵심동사": "넣어도", "확실성": "불확실", "극성": "부정", "시제": "현재", "key_word": " " } }, { "charNum": "100", "label": "대화형", "length": 27, "text": "＂이 짧게 데치기 때문에 맹물에 데쳐도 됩니다.＂", "value": { "text_id": "4", "word_num": 7, "핵심동사": "데쳐도", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "128", "label": "대화형", "length": 47, "text": "＂여기에 양념장이랑 부재료만 넣으면 초간단 원기 충전 음식이 되니까 기대해 주세요.＂", "value": { "text_id": "5", "word_num": 11, "핵심동사": "기대해", "확실성": "불확실", "극성": "긍정", "시제": "미래", "key_word": " " } } ], "dupLabelYn": "Y", "metaData": { "ID": "560043", "FILENAME": "560043.json", "MEDIA_TYPE": "방송대본", "MEDIA_NAME": "알토란", "CATEGORY": "생활건강", "PUBDATE": "20210704", "SENTENCE": "5" } } 