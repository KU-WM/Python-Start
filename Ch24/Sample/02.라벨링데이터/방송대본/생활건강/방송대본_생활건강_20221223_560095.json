{ "annotation": [ { "charNum": "1", "label": "대화형", "length": 33, "text": "＂자, 다음은 초무침에 빠질 수 없는 식재료가 하나 있죠.＂", "value": { "text_id": "1", "word_num": 9, "핵심동사": "있죠", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "35", "label": "대화형", "length": 11, "text": "＂바로 오이입니다.＂", "value": { "text_id": "2", "word_num": 2, "핵심동사": "오이입니다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "47", "label": "대화형", "length": 43, "text": "＂그런데 쌤, 오이가 상큼하고 좋긴 한데 양념에 무쳐 두면 물이 생기잖아요.＂", "value": { "text_id": "3", "word_num": 11, "핵심동사": "생기잖아요", "확실성": "확실", "극성": "긍정", "시제": "미래", "key_word": " " } }, { "charNum": "91", "label": "대화형", "length": 29, "text": "＂저는 그게 싫어서 가끔은 오이를 안 넣기도 해요.＂", "value": { "text_id": "4", "word_num": 8, "핵심동사": "넣기도", "확실성": "확실", "극성": "부정", "시제": "과거", "key_word": " " } }, { "charNum": "121", "label": "대화형", "length": 20, "text": "＂그래서 저는 오이를 절일 건데요.＂", "value": { "text_id": "5", "word_num": 5, "핵심동사": "절일", "확실성": "확실", "극성": "긍정", "시제": "미래", "key_word": " " } }, { "charNum": "142", "label": "대화형", "length": 22, "text": "＂오이 1개를 반을 갈라 어슷 썰고요.＂", "value": { "text_id": "6", "word_num": 6, "핵심동사": "썰고요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "165", "label": "대화형", "length": 37, "text": "＂소금 반 작은 술을 넣고 버무린 뒤 딱 10분만 절이면 됩니다.＂", "value": { "text_id": "7", "word_num": 11, "핵심동사": "절이면", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "203", "label": "대화형", "length": 24, "text": "＂오, 오이 절이는 것도 간단하고 쉽네요.＂", "value": { "text_id": "8", "word_num": 6, "핵심동사": "쉽네요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "228", "label": "대화형", "length": 40, "text": "＂앞서 오징어는 몸에 부족한 피와 체액을 보충해 준다고 말씀드렸는데요.＂", "value": { "text_id": "9", "word_num": 9, "핵심동사": "말씀드렸는데요", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": " " } }, { "charNum": "269", "label": "대화형", "length": 35, "text": "＂오이 또한 수분이 많아 혈액을 맑게 해주는데 도움이 됩니다.＂", "value": { "text_id": "10", "word_num": 9, "핵심동사": "됩니다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "305", "label": "대화형", "length": 41, "text": "＂그러면서 오이는 이뇨 작용으로 체내 불필요한 노폐물을 배출해 주는데요.＂", "value": { "text_id": "11", "word_num": 9, "핵심동사": "배출해", "확실성": "확실", "극성": "긍정", "시제": "미래", "key_word": " " } }, { "charNum": "347", "label": "대화형", "length": 49, "text": "＂때문에 오징어와 오이를 함께 드시면 영양은 채우고 몸은 가뿐하게 보내실 수 있습니다.＂", "value": { "text_id": "12", "word_num": 12, "핵심동사": "보내실", "확실성": "확실", "극성": "긍정", "시제": "미래", "key_word": " " } }, { "charNum": "397", "label": "대화형", "length": 33, "text": "＂자, 10분 절인 후에 물기를 꼭 짜서 준비한 오이에요.＂", "value": { "text_id": "13", "word_num": 9, "핵심동사": "오이에요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "431", "label": "대화형", "length": 9, "text": "＂잘 절여졌죠?＂", "value": { "text_id": "14", "word_num": 2, "핵심동사": "절여졌죠", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "441", "label": "대화형", "length": 42, "text": "＂이렇게 절이면 초무침에 물도 생기지 않고 아닥아닥하니 씹는 맛도 좋아요.＂", "value": { "text_id": "15", "word_num": 10, "핵심동사": "좋아요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } } ], "dupLabelYn": "Y", "metaData": { "ID": "560095", "FILENAME": "560095.json", "MEDIA_TYPE": "방송대본", "MEDIA_NAME": "알토란", "CATEGORY": "생활건강", "PUBDATE": "20210725", "SENTENCE": "15" } } 