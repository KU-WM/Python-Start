{ "annotation": [ { "charNum": "1", "label": "대화형", "length": 43, "text": "＂삭힌고추만 무쳐도 맛있지만 다른 재료가 안 들어가면 좀 서운할 것 같아요.＂", "value": { "text_id": "1", "word_num": 11, "핵심동사": "같아요", "확실성": "불확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "45", "label": "대화형", "length": 47, "text": "＂네, 맞아요, 그래서 심심하지 않게 아삭한 식감을 더할 채소 2가지를 준비했어요.＂", "value": { "text_id": "2", "word_num": 11, "핵심동사": "준비했어요", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": " " } }, { "charNum": "93", "label": "대화형", "length": 32, "text": "＂채 썬 당근 30g과 채 썬 양파 1/3개를 넣을게요.＂", "value": { "text_id": "3", "word_num": 9, "핵심동사": "넣을게요", "확실성": "확실", "극성": "긍정", "시제": "미래", "key_word": " " } }, { "charNum": "126", "label": "대화형", "length": 22, "text": "＂그리고 양념장을 넣고 버무려 주세요.＂", "value": { "text_id": "4", "word_num": 5, "핵심동사": "버무려", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "149", "label": "대화형", "length": 27, "text": "＂화룡점정을 장식할 3가지 재료를 넣을 건데요.＂", "value": { "text_id": "5", "word_num": 6, "핵심동사": "넣을", "확실성": "확실", "극성": "긍정", "시제": "미래", "key_word": " " } }, { "charNum": "177", "label": "대화형", "length": 31, "text": "＂먼저, 참기름 반 큰 술, 통깨 1 큰 술을 넣고요.＂", "value": { "text_id": "6", "word_num": 10, "핵심동사": "넣고요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "209", "label": "대화형", "length": 30, "text": "＂송송 썬 파 3 큰 술도 넣고 살살 버무려 주세요.＂", "value": { "text_id": "7", "word_num": 10, "핵심동사": "버무려", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } } ], "dupLabelYn": "Y", "metaData": { "ID": "560179", "FILENAME": "560179.json", "MEDIA_TYPE": "방송대본", "MEDIA_NAME": "알토란", "CATEGORY": "생활건강", "PUBDATE": "20210815", "SENTENCE": "7" } } 