{ "annotation": [ { "charNum": "1", "label": "대화형", "length": 25, "text": "＂갈치 속까지 간이 쏙, 감칠맛 대박입니다.＂", "value": { "text_id": "1", "word_num": 6, "핵심동사": "대박입니다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "27", "label": "대화형", "length": 17, "text": "＂양념의 단짠이 조화롭습니다.＂", "value": { "text_id": "2", "word_num": 3, "핵심동사": "조화롭습니다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "45", "label": "대화형", "length": 32, "text": "＂표고버섯 우린 물을 넣어 그런지 깊은 맛이 일품입니다.＂", "value": { "text_id": "3", "word_num": 8, "핵심동사": "일품입니다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "78", "label": "대화형", "length": 23, "text": "＂겉은 바삭하고 살은 너무 부드럽습니다.＂", "value": { "text_id": "4", "word_num": 5, "핵심동사": "부드럽습니다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "102", "label": "대화형", "length": 21, "text": "＂살이 부서지지 않고 잘 발라집니다.＂", "value": { "text_id": "5", "word_num": 5, "핵심동사": "발라집니다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "124", "label": "대화형", "length": 31, "text": "＂고소하면서도 밑간을 해서 그런지 감칠맛이 일품입니다.＂", "value": { "text_id": "6", "word_num": 6, "핵심동사": "일품입니다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } } ], "dupLabelYn": "Y", "metaData": { "ID": "560054", "FILENAME": "560054.json", "MEDIA_TYPE": "방송대본", "MEDIA_NAME": "알토란", "CATEGORY": "생활건강", "PUBDATE": "20210619", "SENTENCE": "6" } } 