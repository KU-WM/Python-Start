{ "annotation": [ { "charNum": "1", "label": "대화형", "length": 34, "text": "＂자, 이번에는 이미 익혀서 나온 닭가슴살을 활용해 볼게요.＂", "value": { "text_id": "1", "word_num": 8, "핵심동사": "활용해", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "35", "label": "대화형", "length": 34, "text": "＂요즘 편의점에서도 바로바로 구매가 가능해서 너무 편리하죠.＂", "value": { "text_id": "2", "word_num": 7, "핵심동사": "편리하죠", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "69", "label": "대화형", "length": 66, "text": "＂맞습니다, 보통 매콤한 맛, 훈제 맛 등 다양한 맛이 있는데, 저는 양념이 안 된 익힌 닭가슴살 2팩을 준비했어요.＂", "value": { "text_id": "3", "word_num": 18, "핵심동사": "준비했어요", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": " " } }, { "charNum": "135", "label": "대화형", "length": 16, "text": "＂결대로 얇게 찢어 줄게요.＂", "value": { "text_id": "4", "word_num": 4, "핵심동사": "찢어", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "151", "label": "대화형", "length": 49, "text": "＂네, 이렇게 찢으면 조금 더 부드러운 식감도 즐길 수 있고 무침에도 잘 어울리거든요.＂", "value": { "text_id": "5", "word_num": 13, "핵심동사": "어울리거든요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "200", "label": "대화형", "length": 41, "text": "＂셰프님, 만약 일반 생닭을 사용할 경우는 익혀야 하나요, 쪄야 하나요?＂", "value": { "text_id": "6", "word_num": 10, "핵심동사": "쪄야", "확실성": "불확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "241", "label": "대화형", "length": 31, "text": "＂두 가지 방법 다 맛에 큰 차이 없어서 상관없습니다.＂", "value": { "text_id": "7", "word_num": 9, "핵심동사": "상관없습니다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "272", "label": "대화형", "length": 29, "text": "＂자, 이제 닭가슴살에 상큼한 맛을 올려줄 건데요.＂", "value": { "text_id": "8", "word_num": 7, "핵심동사": "올려줄", "확실성": "불확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "301", "label": "대화형", "length": 12, "text": "＂바로 유자청입니다.＂", "value": { "text_id": "9", "word_num": 2, "핵심동사": "유자청입니다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "313", "label": "대화형", "length": 53, "text": "＂셰프님, 닭가슴살을 매콤하게 무치신다고 했는데, 고추장 베이스에 버무려야 하는 거 아니에요?＂", "value": { "text_id": "10", "word_num": 11, "핵심동사": "버무려야", "확실성": "불확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "366", "label": "대화형", "length": 19, "text": "＂왜 유자청에 버무리시는 거예요?＂", "value": { "text_id": "11", "word_num": 4, "핵심동사": "버무리시는", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "385", "label": "대화형", "length": 37, "text": "＂유자청에 들은 설탕이 닭가슴살을 더 촉촉하고 부드럽게 만들고요.＂", "value": { "text_id": "12", "word_num": 8, "핵심동사": "만들고요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "422", "label": "대화형", "length": 17, "text": "＂상큼한 맛도 더해 주거든요.＂", "value": { "text_id": "13", "word_num": 4, "핵심동사": "더해", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "439", "label": "대화형", "length": 32, "text": "＂손질된 닭가슴살에 유자청 2 큰 술을 넣어 버무릴게요.＂", "value": { "text_id": "14", "word_num": 8, "핵심동사": "버무릴게요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } } ], "dupLabelYn": "Y", "metaData": { "ID": "560207", "FILENAME": "560207.json", "MEDIA_TYPE": "방송대본", "MEDIA_NAME": "알토란", "CATEGORY": "생활건강", "PUBDATE": "20210822", "SENTENCE": "14" } } 