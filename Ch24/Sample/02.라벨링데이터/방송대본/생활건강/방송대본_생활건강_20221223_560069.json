{ "annotation": [ { "charNum": "1", "label": "대화형", "length": 17, "text": "＂우유식빵 8개를 준비했어요.＂", "value": { "text_id": "1", "word_num": 3, "핵심동사": "준비했어요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "19", "label": "대화형", "length": 33, "text": "＂식빵 끝부분을 잘라 주고, 밀대로 납작하게 밀어 줄게요.＂", "value": { "text_id": "2", "word_num": 8, "핵심동사": "밀어", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "53", "label": "대화형", "length": 30, "text": "＂셰프님, 식빵을 밀지 않고 그냥 만들면 안 되나요?＂", "value": { "text_id": "3", "word_num": 8, "핵심동사": "만들면", "확실성": "불확실", "극성": "미정", "시제": "현재", "key_word": " " } }, { "charNum": "84", "label": "대화형", "length": 32, "text": "＂그럼 식빵이 수분도 잘 먹고요, 쉽게 바스라 지거든요.＂", "value": { "text_id": "4", "word_num": 8, "핵심동사": "바스라", "확실성": "확실", "극성": "긍정", "시제": "미래", "key_word": " " } }, { "charNum": "117", "label": "대화형", "length": 26, "text": "＂이렇게 하면 애플파이 모양을 잡기도 쉬워요.＂", "value": { "text_id": "5", "word_num": 6, "핵심동사": "쉬워요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "144", "label": "대화형", "length": 39, "text": "＂자, 식빵 한쪽에 칼집을 2~3cm 내서 파이 모양을 잡아 줄게요.＂", "value": { "text_id": "6", "word_num": 10, "핵심동사": "잡아", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "184", "label": "대화형", "length": 15, "text": "＂칼집은 왜 내는 거예요?＂", "value": { "text_id": "7", "word_num": 4, "핵심동사": "내는", "확실성": "불확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "200", "label": "대화형", "length": 24, "text": "＂칼집을 내야 파이 모양이 예쁘게 나와요.＂", "value": { "text_id": "8", "word_num": 6, "핵심동사": "나와요", "확실성": "확실", "극성": "긍정", "시제": "미래", "key_word": " " } }, { "charNum": "225", "label": "대화형", "length": 40, "text": "＂네, 이제 식빵 한쪽에 사과잼 1 큰 술을 넣고 반으로 접어 주세요.＂", "value": { "text_id": "9", "word_num": 12, "핵심동사": "접어", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "266", "label": "대화형", "length": 41, "text": "＂셰프님, 건강을 위해서 잡곡식빵이나 옥수수식빵을 사용하는 건 어떨까요?＂", "value": { "text_id": "10", "word_num": 8, "핵심동사": "어떨까요", "확실성": "불확실", "극성": "미정", "시제": "미래", "key_word": " " } }, { "charNum": "308", "label": "대화형", "length": 29, "text": "＂** 씨, 제가 우유식빵을 사용한 이유가 있어요.＂", "value": { "text_id": "11", "word_num": 7, "핵심동사": "있어요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "338", "label": "대화형", "length": 80, "text": "＂식빵은 발효에 따라 질감이 다른데요, 잡곡식빵은 약간 거칠어서 반으로 접으면 갈라지는 반면, 우유식빵은 부드러워서 갈라짐을 방지해 주거든요.＂", "value": { "text_id": "12", "word_num": 17, "핵심동사": "방지해", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "419", "label": "대화형", "length": 45, "text": "＂자 이제, 반으로 접은 식빵은 벌어지지 않도록 포크로 꾹꾹 눌러 고정시킬게요.＂", "value": { "text_id": "13", "word_num": 11, "핵심동사": "고정시킬게요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "465", "label": "대화형", "length": 29, "text": "＂모양을 유지하기 위해 고정시키는 것도 중요하네요.＂", "value": { "text_id": "14", "word_num": 6, "핵심동사": "중요하네요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "495", "label": "대화형", "length": 29, "text": "＂자, 이대로 구우시면 부드럽게 즐기실 수 있고요.＂", "value": { "text_id": "15", "word_num": 7, "핵심동사": "즐기실", "확실성": "불확실", "극성": "긍정", "시제": "미래", "key_word": " " } }, { "charNum": "525", "label": "대화형", "length": 58, "text": "＂＇나는 파이의 단단한 식감이 좋다＇ 하시는 분은 저처럼 녹인 버터를 애플파이 위에 살짝 발라 주세요.＂", "value": { "text_id": "16", "word_num": 15, "핵심동사": "발라", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "584", "label": "대화형", "length": 35, "text": "＂이제 모든 준비는 끝났고 지금부턴 에어프라이어가 할 거예요.＂", "value": { "text_id": "17", "word_num": 8, "핵심동사": "할", "확실성": "확실", "극성": "긍정", "시제": "미래", "key_word": " " } }, { "charNum": "620", "label": "대화형", "length": 25, "text": "＂예열된 180도에서 15분간 구워 줄게요.＂", "value": { "text_id": "18", "word_num": 5, "핵심동사": "구워", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "646", "label": "대화형", "length": 15, "text": "＂자, 이제 열어 볼게요.＂", "value": { "text_id": "19", "word_num": 4, "핵심동사": "열어", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } } ], "dupLabelYn": "Y", "metaData": { "ID": "560069", "FILENAME": "560069.json", "MEDIA_TYPE": "방송대본", "MEDIA_NAME": "알토란", "CATEGORY": "생활건강", "PUBDATE": "20210619", "SENTENCE": "19" } } 