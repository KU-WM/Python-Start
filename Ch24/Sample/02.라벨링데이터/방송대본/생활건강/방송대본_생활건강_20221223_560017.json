{ "annotation": [ { "charNum": "1", "label": "대화형", "length": 15, "text": "＂이 순간을 기다렸습니다.＂", "value": { "text_id": "1", "word_num": 3, "핵심동사": "기다렸습니다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": " " } }, { "charNum": "17", "label": "대화형", "length": 16, "text": "＂과일로 김치를 담그다니요.＂", "value": { "text_id": "2", "word_num": 3, "핵심동사": "담그다니요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "34", "label": "대화형", "length": 18, "text": "＂어떤 과일일지 너무 궁금해요.＂", "value": { "text_id": "3", "word_num": 4, "핵심동사": "궁금해요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "53", "label": "대화형", "length": 20, "text": "＂그래서 제가 특별히 준비했습니다.＂", "value": { "text_id": "4", "word_num": 4, "핵심동사": "준비했습니다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": " " } }, { "charNum": "74", "label": "대화형", "length": 27, "text": "＂어떤 과일로 만든 김치일지 먼저 드셔 보세요.＂", "value": { "text_id": "5", "word_num": 7, "핵심동사": "드셔", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "102", "label": "대화형", "length": 22, "text": "＂아삭아삭한 게 식감도 너무 좋은데요?＂", "value": { "text_id": "6", "word_num": 5, "핵심동사": "좋은데요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "125", "label": "대화형", "length": 12, "text": "＂이게 과일이라고요?＂", "value": { "text_id": "7", "word_num": 2, "핵심동사": "과일이라고요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "138", "label": "대화형", "length": 96, "text": "＂수박의 화려한 변신, 무보다 더 시원하고 아삭한 식감이 일품인 여름 별미 반찬, 수박생채무침, 그리고 여름 무더위를 확 날려 줄 새콤달콤 수박화채까지 만들어 보겠습니다.＂", "value": { "text_id": "8", "word_num": 23, "핵심동사": "만들어", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } } ], "dupLabelYn": "Y", "metaData": { "ID": "560017", "FILENAME": "560017.json", "MEDIA_TYPE": "방송대본", "MEDIA_NAME": "알토란", "CATEGORY": "생활건강", "PUBDATE": "20210627", "SENTENCE": "8" } } 