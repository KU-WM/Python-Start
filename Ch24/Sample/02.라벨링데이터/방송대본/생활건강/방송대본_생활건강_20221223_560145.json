{ "annotation": [ { "charNum": "1", "label": "대화형", "length": 26, "text": "`먼저 콩잎물김치에 구수함을 더할 재료인데요.`", "value": { "text_id": "1", "word_num": 5, "핵심동사": "재료인데요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "27", "label": "대화형", "length": 23, "text": "`된장 2 큰 술을 믹서에 넣어 주세요.`", "value": { "text_id": "2", "word_num": 7, "핵심동사": "넣어", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "50", "label": "대화형", "length": 18, "text": "`콩잎물김치에 된장도 들어가요?`", "value": { "text_id": "3", "word_num": 3, "핵심동사": "들어가요", "확실성": "불확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "68", "label": "대화형", "length": 38, "text": "`멸치 육수부터 해서 이제까지 알던 물김치 레시피랑은 완전 달라요.`", "value": { "text_id": "4", "word_num": 9, "핵심동사": "달라요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "106", "label": "대화형", "length": 23, "text": "`콩 가는 데는 콩이 가줘야 제맛인데요.`", "value": { "text_id": "5", "word_num": 6, "핵심동사": "제맛인데요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "129", "label": "대화형", "length": 23, "text": "`콩잎과 된장은 궁합이 정말 잘 맞아요.`", "value": { "text_id": "6", "word_num": 6, "핵심동사": "맞아요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "152", "label": "대화형", "length": 29, "text": "`그래서 된장은 딱 2 큰 술 꼭 들어가야 합니다.`", "value": { "text_id": "7", "word_num": 9, "핵심동사": "들어가야", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "181", "label": "대화형", "length": 28, "text": "`맞아요, 콩잎 요리 중에 된장장아찌가 있거든요.`", "value": { "text_id": "8", "word_num": 6, "핵심동사": "있거든요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "209", "label": "대화형", "length": 42, "text": "`간장, 고추장 다 잘 어울리지만 그중에 된장하고 제일 잘 어울리더라고요.`", "value": { "text_id": "9", "word_num": 10, "핵심동사": "어울리더라고요", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": " " } }, { "charNum": "251", "label": "대화형", "length": 43, "text": "`다음은 시원, 달큼한 맛을 내줄 배 1개를 갈기 좋게 잘라서 넣어 주세요.`", "value": { "text_id": "10", "word_num": 12, "핵심동사": "넣어", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "294", "label": "대화형", "length": 29, "text": "`그리고 알갱이가 보이지 않도록 곱게 갈아 주세요.`", "value": { "text_id": "11", "word_num": 7, "핵심동사": "갈아", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "323", "label": "대화형", "length": 25, "text": "`자, 다음은 간 것들을 볼에 옮겨 담고요.`", "value": { "text_id": "12", "word_num": 7, "핵심동사": "담고요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "348", "label": "대화형", "length": 15, "text": "`양념을 넣어 볼 건데요.`", "value": { "text_id": "13", "word_num": 4, "핵심동사": "넣어", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "363", "label": "대화형", "length": 16, "text": "`매실청 3 큰 술 넣고요.`", "value": { "text_id": "14", "word_num": 5, "핵심동사": "넣고요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "379", "label": "대화형", "length": 18, "text": "`설탕 2 큰 술 넣어 줍니다.`", "value": { "text_id": "15", "word_num": 6, "핵심동사": "넣어", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "397", "label": "대화형", "length": 22, "text": "`다음은 소금 3 큰 술 넣어 주세요.`", "value": { "text_id": "16", "word_num": 7, "핵심동사": "넣어", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "419", "label": "대화형", "length": 27, "text": "`그리고 완전히 식은 풀국과 함께 합쳐 주세요.`", "value": { "text_id": "17", "word_num": 7, "핵심동사": "합쳐", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "446", "label": "대화형", "length": 40, "text": "`사실 콩잎장아찌랑 콩잎김치는 먹어 봤는데 물김치는 못 먹어 봤거든요.`", "value": { "text_id": "18", "word_num": 9, "핵심동사": "먹어", "확실성": "확실", "극성": "부정", "시제": "과거", "key_word": " " } }, { "charNum": "486", "label": "대화형", "length": 31, "text": "`지금 만드는 레시피 보니 어떤 맛일지 너무 기대돼요.`", "value": { "text_id": "19", "word_num": 8, "핵심동사": "기대돼요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } } ], "dupLabelYn": "Y", "metaData": { "ID": "560145", "FILENAME": "560145.json", "MEDIA_TYPE": "방송대본", "MEDIA_NAME": "알토란", "CATEGORY": "생활건강", "PUBDATE": "20210808", "SENTENCE": "19" } } 