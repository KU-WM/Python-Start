{ "annotation": [ { "charNum": "1", "label": "대화형", "length": 20, "text": "＂자, 고구마순 준비가 끝났는데요.＂", "value": { "text_id": "1", "word_num": 4, "핵심동사": "끝났는데요", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": " " } }, { "charNum": "22", "label": "대화형", "length": 11, "text": "＂뭘 하면 될까요?＂", "value": { "text_id": "2", "word_num": 3, "핵심동사": "하면", "확실성": "불확실", "극성": "미정", "시제": "미래", "key_word": " " } }, { "charNum": "34", "label": "대화형", "length": 29, "text": "＂저는 고구마순에 양념을 넣어서 먼저 무칠 거예요.＂", "value": { "text_id": "3", "word_num": 7, "핵심동사": "무칠", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "64", "label": "대화형", "length": 38, "text": "＂보통 기름에 볶으면서 양념을 넣는데 왜 굳이 양념을 먼저 무쳐요?＂", "value": { "text_id": "4", "word_num": 10, "핵심동사": "무쳐요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "103", "label": "대화형", "length": 17, "text": "＂고구마순은 조직이 단단하죠?＂", "value": { "text_id": "5", "word_num": 3, "핵심동사": "단단하죠", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "121", "label": "대화형", "length": 52, "text": "＂때문에 볶으면서 양념을 넣으면 간이 안 배서 고구마순 따로, 양념 따로 맛이 따로 놀아요.＂", "value": { "text_id": "6", "word_num": 14, "핵심동사": "놀아요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "174", "label": "대화형", "length": 32, "text": "＂이게 별거 아닌 거 같지만 맛에 큰 영향을 미치거든요.＂", "value": { "text_id": "7", "word_num": 9, "핵심동사": "미치거든요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "207", "label": "대화형", "length": 21, "text": "＂꼭 양념을 먼저 조물조물해 주세요.＂", "value": { "text_id": "8", "word_num": 5, "핵심동사": "조물조물해", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "229", "label": "대화형", "length": 31, "text": "＂고구마순볶음에는 어떤 양념들이 들어가는지도 궁금해요.＂", "value": { "text_id": "9", "word_num": 5, "핵심동사": "궁금해요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "261", "label": "대화형", "length": 15, "text": "＂넣으면서 알려 드릴게요.＂", "value": { "text_id": "10", "word_num": 3, "핵심동사": "알려", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "277", "label": "대화형", "length": 20, "text": "＂들기름 2 큰 술을 넣어 주세요.＂", "value": { "text_id": "11", "word_num": 6, "핵심동사": "넣어", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "298", "label": "대화형", "length": 22, "text": "＂다음은 다진 마늘 2 큰 술 넣고요.＂", "value": { "text_id": "12", "word_num": 7, "핵심동사": "넣고요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "321", "label": "대화형", "length": 20, "text": "＂멸치액젓 3 큰 술 넣어 주세요.＂", "value": { "text_id": "13", "word_num": 6, "핵심동사": "넣어", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "342", "label": "대화형", "length": 29, "text": "＂그리고 고구마순엔 뭐가 꼭 들어가야 한다 그랬죠?＂", "value": { "text_id": "14", "word_num": 7, "핵심동사": "들어가야", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "372", "label": "대화형", "length": 27, "text": "＂매실청 3 큰 술 넣고 조물조물 무쳐 주세요.＂", "value": { "text_id": "15", "word_num": 8, "핵심동사": "무쳐", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "400", "label": "대화형", "length": 41, "text": "＂한 번 데치고 양념까지 먼저 무쳐 주니까 간이 쏙쏙 잘 밸 거 같아요.＂", "value": { "text_id": "16", "word_num": 13, "핵심동사": "밸", "확실성": "불확실", "극성": "긍정", "시제": "미래", "key_word": " " } } ], "dupLabelYn": "Y", "metaData": { "ID": "560015", "FILENAME": "560015.json", "MEDIA_TYPE": "방송대본", "MEDIA_NAME": "알토란", "CATEGORY": "생활건강", "PUBDATE": "20210627", "SENTENCE": "16" } } 