{ "annotation": [ { "charNum": "1", "label": "대화형", "length": 24, "text": "＂먼저, 고사리볶음부터 만들어 볼 텐데요.＂", "value": { "text_id": "1", "word_num": 5, "핵심동사": "만들어", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "26", "label": "대화형", "length": 22, "text": "＂삶은 고사리 300g을 준비했습니다.＂", "value": { "text_id": "2", "word_num": 4, "핵심동사": "준비했습니다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "49", "label": "대화형", "length": 24, "text": "＂**쌤, 혹시 시판되는 삶은 고사리에요?＂", "value": { "text_id": "3", "word_num": 5, "핵심동사": "고사리에요", "확실성": "불확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "74", "label": "대화형", "length": 50, "text": "＂맞아요, 건고사리 사서 불리고 삶고 하려면 기본 2시간은 잡아먹으니까 너무 힘들잖아요.＂", "value": { "text_id": "4", "word_num": 11, "핵심동사": "힘들잖아요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "125", "label": "대화형", "length": 41, "text": "＂그래서 간편하게 시판 삶은 고사리로 맛 내는 방법을 알려 드릴 거예요.＂", "value": { "text_id": "5", "word_num": 11, "핵심동사": "알려", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "167", "label": "대화형", "length": 48, "text": "＂삶은 고사리를 쓰면 편하긴 한데 잘못 구입하면 묵은내가 나거나 질겅질겅 하더라고요.＂", "value": { "text_id": "6", "word_num": 11, "핵심동사": "하더라고요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "216", "label": "대화형", "length": 14, "text": "＂이건 어떻게 해결해요?＂", "value": { "text_id": "7", "word_num": 3, "핵심동사": "해결해요", "확실성": "불확실", "극성": "미정", "시제": "현재", "key_word": " " } }, { "charNum": "231", "label": "대화형", "length": 26, "text": "＂제가 100% 맛 보장해 드린다고 했잖아요.＂", "value": { "text_id": "8", "word_num": 6, "핵심동사": "보장해", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "258", "label": "대화형", "length": 29, "text": "＂삶은 고사리를 한 번 데쳐서 쓰면 다 해결됩니다.＂", "value": { "text_id": "9", "word_num": 8, "핵심동사": "해결됩니다", "확실성": "불확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "288", "label": "대화형", "length": 18, "text": "＂네, 하면서 설명해 드릴게요.＂", "value": { "text_id": "10", "word_num": 4, "핵심동사": "설명해", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "307", "label": "대화형", "length": 22, "text": "＂자, 여기에 쌀뜨물을 끓이고 있어요.＂", "value": { "text_id": "11", "word_num": 5, "핵심동사": "끓이고", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "330", "label": "대화형", "length": 26, "text": "＂**쌤 보통은 물에서 소금 넣고 데치잖아요.＂", "value": { "text_id": "12", "word_num": 6, "핵심동사": "데치잖아요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "357", "label": "대화형", "length": 17, "text": "＂그런데 쌀뜨물에 데치시네요?＂", "value": { "text_id": "13", "word_num": 3, "핵심동사": "데치시네요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "375", "label": "대화형", "length": 49, "text": "＂네, 맹물이나 소금물에 데치는 것보다 쌀뜨물에 데쳐야 묵은내가 사라지고 부드러워져요.＂", "value": { "text_id": "14", "word_num": 10, "핵심동사": "부드러워져요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "425", "label": "대화형", "length": 23, "text": "＂이대로 딱 1분만 삶아 주시면 됩니다.＂", "value": { "text_id": "15", "word_num": 6, "핵심동사": "삶아", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "449", "label": "대화형", "length": 32, "text": "＂고사리를 이미 삶아 놓은 거라 데칠 생각은 못 했어요.＂", "value": { "text_id": "16", "word_num": 9, "핵심동사": "했어요", "확실성": "확실", "극성": "부정", "시제": "과거", "key_word": " " } }, { "charNum": "482", "label": "대화형", "length": 26, "text": "＂고사리볶음은 데치는 과정이 정말 중요하네요.＂", "value": { "text_id": "17", "word_num": 5, "핵심동사": "중요하네요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "509", "label": "대화형", "length": 22, "text": "＂네, 이제 고사리가 다 데쳐졌는데요.＂", "value": { "text_id": "18", "word_num": 5, "핵심동사": "데쳐졌는데요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "532", "label": "대화형", "length": 18, "text": "＂이제 건져서 찬물에 헹굴게요.＂", "value": { "text_id": "19", "word_num": 4, "핵심동사": "헹굴게요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "551", "label": "대화형", "length": 17, "text": "＂그다음 물기를 꼭 짜줍니다.＂", "value": { "text_id": "20", "word_num": 4, "핵심동사": "짜줍니다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "569", "label": "대화형", "length": 23, "text": "＂그리고 6~7cm 길이로 썰어 주세요.＂", "value": { "text_id": "21", "word_num": 5, "핵심동사": "썰어", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } } ], "dupLabelYn": "Y", "metaData": { "ID": "560265", "FILENAME": "560265.json", "MEDIA_TYPE": "방송대본", "MEDIA_NAME": "알토란", "CATEGORY": "생활건강", "PUBDATE": "20210912", "SENTENCE": "21" } } 