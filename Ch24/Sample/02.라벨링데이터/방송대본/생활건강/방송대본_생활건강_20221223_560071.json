{ "annotation": [ { "charNum": "1", "label": "대화형", "length": 24, "text": "＂먼저 전복꽈리고추조림부터 만들어 볼게요.＂", "value": { "text_id": "1", "word_num": 4, "핵심동사": "만들어", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "26", "label": "대화형", "length": 56, "text": "＂전복은 중 사이즈 8마리를 솔로 문지른 후 깨끗이 씻어서 준비했는데요, 전복 살만 분리해 볼게요.＂", "value": { "text_id": "2", "word_num": 14, "핵심동사": "분리해", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "83", "label": "대화형", "length": 29, "text": "＂전복 손질할 때 숟가락으로 하면 된다고 하잖아요.＂", "value": { "text_id": "3", "word_num": 7, "핵심동사": "하잖아요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "113", "label": "대화형", "length": 31, "text": "＂그래서 제가 집에서 따라 했는데, 잘 안 되더라고요.＂", "value": { "text_id": "4", "word_num": 8, "핵심동사": "되더라고요", "확실성": "확실", "극성": "부정", "시제": "과거", "key_word": " " } }, { "charNum": "145", "label": "대화형", "length": 24, "text": "＂**쌤이 오늘 제대로 쉽게 알려 주세요.＂", "value": { "text_id": "5", "word_num": 6, "핵심동사": "알려", "확실성": "확실", "극성": "긍정", "시제": "미래", "key_word": " " } }, { "charNum": "170", "label": "대화형", "length": 23, "text": "＂네, 제가 정말 손쉽게 알려 드릴게요.＂", "value": { "text_id": "6", "word_num": 6, "핵심동사": "알려", "확실성": "확실", "극성": "긍정", "시제": "미래", "key_word": " " } }, { "charNum": "194", "label": "대화형", "length": 62, "text": "＂자, 이렇게 숟가락을 전복의 뾰족한 부분에 넣고 껍데기와 살 사이를 슥슥 움직이면 살이 깔끔하게 떨어집니다.＂", "value": { "text_id": "7", "word_num": 15, "핵심동사": "떨어집니다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "257", "label": "대화형", "length": 35, "text": "＂그럼 내장을 떼어내고요, 여기 보시면 전복의 이빨이 있어요.＂", "value": { "text_id": "8", "word_num": 8, "핵심동사": "있어요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "293", "label": "대화형", "length": 16, "text": "＂이 부분도 잘라내 주세요.＂", "value": { "text_id": "9", "word_num": 4, "핵심동사": "잘라내", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "310", "label": "대화형", "length": 23, "text": "＂그리고 가로로 4등분 해주시면 됩니다.＂", "value": { "text_id": "10", "word_num": 5, "핵심동사": "해주시면", "확실성": "확실", "극성": "긍정", "시제": "미래", "key_word": " " } }, { "charNum": "334", "label": "대화형", "length": 25, "text": "＂근데 **쌤, 내장도 고소하니 맛있잖아요.＂", "value": { "text_id": "11", "word_num": 5, "핵심동사": "맛있잖아요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "360", "label": "대화형", "length": 15, "text": "＂내장은 같이 안 쓰세요?＂", "value": { "text_id": "12", "word_num": 4, "핵심동사": "쓰세요", "확실성": "불확실", "극성": "부정", "시제": "현재", "key_word": " " } }, { "charNum": "376", "label": "대화형", "length": 30, "text": "＂네, 조림에는 내장을 넣지 않는 게 훨씬 깔끔해요.＂", "value": { "text_id": "13", "word_num": 8, "핵심동사": "깔끔해요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "407", "label": "대화형", "length": 45, "text": "＂이 전복 내장은 냉동 보관해 두셨다가 죽이나 볶음밥 할 때 넣으시면 좋습니다.＂", "value": { "text_id": "14", "word_num": 12, "핵심동사": "좋습니다", "확실성": "확실", "극성": "긍정", "시제": "미래", "key_word": " " } } ], "dupLabelYn": "Y", "metaData": { "ID": "560071", "FILENAME": "560071.json", "MEDIA_TYPE": "방송대본", "MEDIA_NAME": "알토란", "CATEGORY": "생활건강", "PUBDATE": "20210718", "SENTENCE": "14" } } 