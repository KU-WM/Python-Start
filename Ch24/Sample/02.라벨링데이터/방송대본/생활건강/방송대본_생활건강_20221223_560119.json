{ "annotation": [ { "charNum": "1", "label": "대화형", "length": 31, "text": "＂자, 그럼 먼저 순한 버전의 맛살부터 양념해 볼게요.＂", "value": { "text_id": "1", "word_num": 8, "핵심동사": "양념해", "확실성": "확실", "극성": "긍정", "시제": "미래", "key_word": " " } }, { "charNum": "33", "label": "대화형", "length": 32, "text": "＂눈 깜빡하면 후루룩 지나가니까 지금부터 집중해 주세요.＂", "value": { "text_id": "2", "word_num": 7, "핵심동사": "집중해", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "66", "label": "대화형", "length": 20, "text": "＂맛살은 잘게 찢어서 준비했습니다.＂", "value": { "text_id": "3", "word_num": 4, "핵심동사": "준비했습니다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "87", "label": "대화형", "length": 22, "text": "＂여기에 마요네즈를 넣고 섞어 주세요.＂", "value": { "text_id": "4", "word_num": 5, "핵심동사": "섞어", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "110", "label": "대화형", "length": 11, "text": "＂그러면 끝이에요.＂", "value": { "text_id": "5", "word_num": 2, "핵심동사": "끝이에요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "122", "label": "대화형", "length": 20, "text": "＂사실 마요네즈를 안 넣어도 돼요.＂", "value": { "text_id": "6", "word_num": 5, "핵심동사": "넣어도", "확실성": "확실", "극성": "부정", "시제": "현재", "key_word": " " } }, { "charNum": "143", "label": "대화형", "length": 50, "text": "＂하지만 마요네즈를 넣으면 고소한 맛이 좋고, 밥과 잘 붙게 하는 접착제 역할도 합니다.＂", "value": { "text_id": "7", "word_num": 13, "핵심동사": "합니다", "확실성": "확실", "극성": "긍정", "시제": "미래", "key_word": " " } }, { "charNum": "194", "label": "대화형", "length": 19, "text": "＂맛살샐러드랑 비슷한 느낌이네요.＂", "value": { "text_id": "8", "word_num": 3, "핵심동사": "느낌이네요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "214", "label": "대화형", "length": 36, "text": "＂저는 맛살샐러드에 머스타드도 넣는데 머스타드 추가해도 되나요?＂", "value": { "text_id": "9", "word_num": 7, "핵심동사": "추가해도", "확실성": "불확실", "극성": "미정", "시제": "미래", "key_word": " " } }, { "charNum": "251", "label": "대화형", "length": 35, "text": "＂그럼요, 근데 꼬마김밥은 겨자소스를 만들어서 찍어 먹잖아요.＂", "value": { "text_id": "10", "word_num": 7, "핵심동사": "먹잖아요", "확실성": "확실", "극성": "긍정", "시제": "미래", "key_word": " " } }, { "charNum": "287", "label": "대화형", "length": 41, "text": "＂그래서 저는 머스타드를 넣지 않았는데 기호에 따라 넣으셔도 무방합니다.＂", "value": { "text_id": "11", "word_num": 9, "핵심동사": "무방합니다", "확실성": "확실", "극성": "긍정", "시제": "미래", "key_word": " " } } ], "dupLabelYn": "Y", "metaData": { "ID": "560119", "FILENAME": "560119.json", "MEDIA_TYPE": "방송대본", "MEDIA_NAME": "알토란", "CATEGORY": "생활건강", "PUBDATE": "20210801", "SENTENCE": "11" } } 