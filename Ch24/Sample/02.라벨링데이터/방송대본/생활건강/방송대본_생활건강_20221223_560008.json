{ "annotation": [ { "charNum": "1", "label": "대화형", "length": 22, "text": "＂먼저 냄비에 들기름을 둘러 주시고요.＂", "value": { "text_id": "1", "word_num": 5, "핵심동사": "둘러", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "24", "label": "대화형", "length": 21, "text": "＂양념한 얼갈이를 넣고 볶아 주세요.＂", "value": { "text_id": "2", "word_num": 5, "핵심동사": "볶아", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "46", "label": "대화형", "length": 24, "text": "＂다음은 소고기를 넣고 함께 볶아 주세요.＂", "value": { "text_id": "3", "word_num": 6, "핵심동사": "볶아", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "71", "label": "대화형", "length": 35, "text": "＂그런데 **쌤, 지짐이는 자박자박한 국물이 또 포인트잖아요.＂", "value": { "text_id": "4", "word_num": 7, "핵심동사": "포인트잖아요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "107", "label": "대화형", "length": 14, "text": "＂육수를 넣으실 건가요?＂", "value": { "text_id": "5", "word_num": 3, "핵심동사": "넣으실", "확실성": "확실", "극성": "미정", "시제": "미래", "key_word": " " } }, { "charNum": "122", "label": "대화형", "length": 17, "text": "＂저는 쌀뜨물을 넣을 건데요.＂", "value": { "text_id": "6", "word_num": 4, "핵심동사": "넣을", "확실성": "확실", "극성": "긍정", "시제": "미래", "key_word": " " } }, { "charNum": "140", "label": "대화형", "length": 44, "text": "＂쌀뜨물은 혹시 모를 잡내도 잡아 주고 또 달달하면서도 깊은 맛을 내주거든요.＂", "value": { "text_id": "7", "word_num": 11, "핵심동사": "내주거든요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "185", "label": "대화형", "length": 17, "text": "＂소고기가 어느 정도 익었죠.＂", "value": { "text_id": "8", "word_num": 4, "핵심동사": "익었죠", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "203", "label": "대화형", "length": 20, "text": "＂이때 쌀뜨물 1.5리터를 넣고요.＂", "value": { "text_id": "9", "word_num": 4, "핵심동사": "넣고요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "224", "label": "대화형", "length": 45, "text": "＂굵게 채 썬 대파 1대와 굵게 채 썬 양파 반 개를 넣고 뚜껑을 닫아 주세요.＂", "value": { "text_id": "10", "word_num": 15, "핵심동사": "닫아", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "270", "label": "대화형", "length": 18, "text": "＂물양이 꽤 많이 들어갔거든요.＂", "value": { "text_id": "11", "word_num": 4, "핵심동사": "들어갔거든요", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": " " } }, { "charNum": "289", "label": "대화형", "length": 11, "text": "＂얼마나 끓이나요?＂", "value": { "text_id": "12", "word_num": 2, "핵심동사": "끓이나요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "301", "label": "대화형", "length": 25, "text": "＂국물이 자박해 질 때까지 끓이면 되는데요.＂", "value": { "text_id": "13", "word_num": 6, "핵심동사": "끓이면", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "327", "label": "대화형", "length": 36, "text": "＂센 불에 15분, 약 불에 35분 정도 은근하게 끓여 주세요.＂", "value": { "text_id": "14", "word_num": 10, "핵심동사": "끓여", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "364", "label": "대화형", "length": 66, "text": "＂일반 배추는 가열하게 되면 비타민 C와 칼슘이 파괴가 되는데 얼갈이는 조리해도 영양 파괴가 적다는 장점이 있습니다.＂", "value": { "text_id": "15", "word_num": 16, "핵심동사": "있습니다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "431", "label": "대화형", "length": 31, "text": "＂하지만 칼로리가 적어 기력을 보충하기 힘이 약한데요.＂", "value": { "text_id": "16", "word_num": 7, "핵심동사": "약한데요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "463", "label": "대화형", "length": 50, "text": "＂**쌤이 그걸 아셨는지 소고기까지 넣어 얼갈이의 부족한 점을 완벽하게 보충해 주셨네요.＂", "value": { "text_id": "17", "word_num": 11, "핵심동사": "보충해", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "514", "label": "대화형", "length": 39, "text": "＂소고기 넣은 얼갈이지짐이는 여름철 보양식으로 드시면 아주 좋습니다.＂", "value": { "text_id": "18", "word_num": 8, "핵심동사": "좋습니다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } } ], "dupLabelYn": "Y", "metaData": { "ID": "560008", "FILENAME": "560008.json", "MEDIA_TYPE": "방송대본", "MEDIA_NAME": "알토란", "CATEGORY": "생활건강", "PUBDATE": "20210627", "SENTENCE": "18" } } 