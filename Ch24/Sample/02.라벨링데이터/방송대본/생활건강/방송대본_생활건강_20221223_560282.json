{ "annotation": [ { "charNum": "1", "label": "대화형", "length": 39, "text": "＂준비물은 생수병, 빨간색 잉크, 주방세제, 베이킹소다, 식초입니다.＂", "value": { "text_id": "1", "word_num": 7, "핵심동사": "식초입니다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "41", "label": "대화형", "length": 27, "text": "＂우리 주변에서 흔히 볼 수 있는 재료들인데요.＂", "value": { "text_id": "2", "word_num": 7, "핵심동사": "재료들인데요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "69", "label": "대화형", "length": 35, "text": "＂이 재료들로 우리 장속에서 일어나는 일들을 가정해보겠습니다.＂", "value": { "text_id": "3", "word_num": 7, "핵심동사": "가정해보겠습니다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "105", "label": "대화형", "length": 25, "text": "＂먼저 생수병을 우리 장으로 생각해 봅시다.＂", "value": { "text_id": "4", "word_num": 6, "핵심동사": "생각해", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "131", "label": "대화형", "length": 14, "text": "＂누구 장으로 해볼까요?＂", "value": { "text_id": "5", "word_num": 3, "핵심동사": "해볼까요", "확실성": "불확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "146", "label": "대화형", "length": 28, "text": "＂좋습니다, 이건 지금부터 홍** 씨의 장입니다.＂", "value": { "text_id": "6", "word_num": 6, "핵심동사": "장입니다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "175", "label": "대화형", "length": 38, "text": "＂여기에 과민대장증후군의 원인으로 알려진 것들 차례대로 넣어볼게요.＂", "value": { "text_id": "7", "word_num": 7, "핵심동사": "넣어볼게요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "214", "label": "대화형", "length": 18, "text": "＂먼저 만병의 근원이라고 하죠.＂", "value": { "text_id": "8", "word_num": 4, "핵심동사": "하죠", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "233", "label": "대화형", "length": 12, "text": "＂스트레스를 넣고요.＂", "value": { "text_id": "9", "word_num": 2, "핵심동사": "넣고요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "246", "label": "대화형", "length": 30, "text": "＂그로 인해 생기는 만성피로, 과음도 빠질 수 없죠.＂", "value": { "text_id": "10", "word_num": 8, "핵심동사": "빠질", "확실성": "확실", "극성": "부정", "시제": "현재", "key_word": " " } }, { "charNum": "277", "label": "대화형", "length": 64, "text": "＂마지막으로 기름지거나 자극적인 음식을 선호하고 제때 챙겨 먹지 못하는 등의 잘못된 식습관이 추가 되면 어떨까요?＂", "value": { "text_id": "11", "word_num": 15, "핵심동사": "어떨까요", "확실성": "불확실", "극성": "미정", "시제": "현재", "key_word": " " } }, { "charNum": "342", "label": "대화형", "length": 8, "text": "＂잘 보세요.＂", "value": { "text_id": "12", "word_num": 2, "핵심동사": "보세요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "351", "label": "대화형", "length": 68, "text": "＂이처럼 스트레스, 피로, 잘못된 식습관으로 인해서 장이 자극을 받으면 이렇게 부글부글 끓고 결국 폭발하게 되는 겁니다.＂", "value": { "text_id": "13", "word_num": 16, "핵심동사": "폭발하게", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "420", "label": "대화형", "length": 45, "text": "＂그러기 때문에 평소 장이 자주 폭발한다면 생활 습관과 음식 관리가 필수입니다.＂", "value": { "text_id": "14", "word_num": 11, "핵심동사": "필수입니다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } } ], "dupLabelYn": "Y", "metaData": { "ID": "560282", "FILENAME": "560282.json", "MEDIA_TYPE": "방송대본", "MEDIA_NAME": "엄지의제왕", "CATEGORY": "생활건강", "PUBDATE": "20190730", "SENTENCE": "14" } } 