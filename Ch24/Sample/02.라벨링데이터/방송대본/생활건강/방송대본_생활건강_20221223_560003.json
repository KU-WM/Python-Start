{ "annotation": [ { "charNum": "1", "label": "대화형", "length": 45, "text": "＂자, 얼갈이배추가 절여질 1시간 동안 우리가 두 가지 일을 완수해야 하는데요.＂", "value": { "text_id": "1", "word_num": 11, "핵심동사": "완수해야", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "47", "label": "대화형", "length": 34, "text": "＂먼저, 국물을 만들고, 두 번째, 양념을 만들어야 합니다.＂", "value": { "text_id": "2", "word_num": 8, "핵심동사": "만들어야", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "82", "label": "대화형", "length": 32, "text": "＂보리얼갈이물김치는 시원한 국물이 포인트일 거 같거든요.＂", "value": { "text_id": "3", "word_num": 6, "핵심동사": "포인트일", "확실성": "확실", "극성": "긍정", "시제": "미래", "key_word": " " } }, { "charNum": "115", "label": "대화형", "length": 14, "text": "＂국물부터 알려 주세요.＂", "value": { "text_id": "4", "word_num": 3, "핵심동사": "알려", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "130", "label": "대화형", "length": 21, "text": "＂네, 그럼 국물부터 만들어 볼게요.＂", "value": { "text_id": "5", "word_num": 5, "핵심동사": "만들어", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "152", "label": "대화형", "length": 19, "text": "＂자, 믹서가 준비되어 있는데요.＂", "value": { "text_id": "6", "word_num": 4, "핵심동사": "준비되어", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "172", "label": "대화형", "length": 29, "text": "＂여기에 적당한 크기로 썬 청양고추 2개를 넣고요.＂", "value": { "text_id": "7", "word_num": 7, "핵심동사": "넣고요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "202", "label": "대화형", "length": 39, "text": "＂씨를 제거하고 적당한 크기로 썬 빨간 파프리카도 1/2개 넣을게요.＂", "value": { "text_id": "8", "word_num": 9, "핵심동사": "넣을게요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "242", "label": "대화형", "length": 35, "text": "＂쌤, 물김치 국물은 보통 과일하고 고춧가루 넣어서 갈잖아요.＂", "value": { "text_id": "9", "word_num": 8, "핵심동사": "갈잖아요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "278", "label": "대화형", "length": 25, "text": "＂청양고추와 파프리카라니, 너무 새로운데요?＂", "value": { "text_id": "10", "word_num": 4, "핵심동사": "새로운데요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "311", "label": "대화형", "length": 19, "text": "＂제가 연구 많이 한 레시피에요.＂", "value": { "text_id": "11", "word_num": 5, "핵심동사": "레시피에요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "331", "label": "대화형", "length": 49, "text": "＂먼저 빨간 파프리카를 넣는 이유는 붉은색 색감을 내주고 또 시원한 단맛을 내주거든요.＂", "value": { "text_id": "12", "word_num": 12, "핵심동사": "내주거든요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "381", "label": "대화형", "length": 33, "text": "＂또 청양고추는 칼칼한 맛을 내고 또 깔끔한 맛을 주고요.＂", "value": { "text_id": "13", "word_num": 9, "핵심동사": "주고요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "415", "label": "대화형", "length": 20, "text": "＂그럼 고춧가루는 안 넣는 건가요?＂", "value": { "text_id": "14", "word_num": 5, "핵심동사": "넣는", "확실성": "확실", "극성": "부정", "시제": "현재", "key_word": " " } }, { "charNum": "436", "label": "대화형", "length": 21, "text": "＂김치 양념장에 고춧가루가 들어가요.＂", "value": { "text_id": "15", "word_num": 4, "핵심동사": "들어가요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "458", "label": "대화형", "length": 64, "text": "＂보리얼갈이물김치는 시원한 맛이 포인트기 때문에 국물에는 고춧가루를 넣지 않고 파프리카와 청양고추를 넣는 거예요.＂", "value": { "text_id": "16", "word_num": 13, "핵심동사": "넣는", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "523", "label": "대화형", "length": 22, "text": "＂다음은 생수 3리터를 넣어 주시고요.＂", "value": { "text_id": "17", "word_num": 5, "핵심동사": "넣어", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "546", "label": "대화형", "length": 36, "text": "＂소금 3 큰 술과 국간장 1 큰 술을 넣고 곱게 갈아 주세요.＂", "value": { "text_id": "18", "word_num": 12, "핵심동사": "갈아", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "583", "label": "대화형", "length": 10, "text": "＂다 갈렸는데요.＂", "value": { "text_id": "19", "word_num": 2, "핵심동사": "갈렸는데요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "594", "label": "대화형", "length": 22, "text": "＂베보자기를 활용해서 국물만 짜낼게요.＂", "value": { "text_id": "20", "word_num": 4, "핵심동사": "짜낼게요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "617", "label": "대화형", "length": 21, "text": "＂국물 색이 아주 맑은 붉은색이네요.＂", "value": { "text_id": "21", "word_num": 5, "핵심동사": "붉은색이네요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "639", "label": "대화형", "length": 27, "text": "＂파프리카와 청양고추로 낸 그 맛이 궁금하네요.＂", "value": { "text_id": "22", "word_num": 6, "핵심동사": "궁금하네요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "667", "label": "대화형", "length": 15, "text": "＂이따가 맛보여 드릴게요.＂", "value": { "text_id": "23", "word_num": 3, "핵심동사": "맛보여", "확실성": "불확실", "극성": "긍정", "시제": "미래", "key_word": " " } }, { "charNum": "683", "label": "대화형", "length": 19, "text": "＂자, 이렇게 국물은 완성됐고요.＂", "value": { "text_id": "24", "word_num": 4, "핵심동사": "완성됐고요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "703", "label": "대화형", "length": 18, "text": "＂다음은 양념을 만들어 볼게요.＂", "value": { "text_id": "25", "word_num": 4, "핵심동사": "만들어", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } } ], "dupLabelYn": "Y", "metaData": { "ID": "560003", "FILENAME": "560003.json", "MEDIA_TYPE": "방송대본", "MEDIA_NAME": "알토란", "CATEGORY": "생활건강", "PUBDATE": "20210627", "SENTENCE": "25" } } 