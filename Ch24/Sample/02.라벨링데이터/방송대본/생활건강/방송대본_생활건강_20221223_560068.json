{ "annotation": [ { "charNum": "1", "label": "대화형", "length": 42, "text": "＂이어서 은은한 사과 향을 가득 품은 달큼 바삭한 애플파이 알려 드릴게요.＂", "value": { "text_id": "1", "word_num": 11, "핵심동사": "알려", "확실성": "확실", "극성": "긍정", "시제": "미래", "key_word": " " } }, { "charNum": "44", "label": "대화형", "length": 12, "text": "＂애플파이 맛있지요.＂", "value": { "text_id": "2", "word_num": 2, "핵심동사": "맛있지요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "57", "label": "대화형", "length": 32, "text": "＂달걀빵은 쉬웠는데, 애플파이는 뭔가 어려울 것 같아요.＂", "value": { "text_id": "3", "word_num": 7, "핵심동사": "어려울", "확실성": "불확실", "극성": "부정", "시제": "미래", "key_word": " " } }, { "charNum": "90", "label": "대화형", "length": 9, "text": "＂걱정 마세요.＂", "value": { "text_id": "4", "word_num": 2, "핵심동사": "마세요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "100", "label": "대화형", "length": 23, "text": "＂애플파이도 손쉽게 뚝딱 알려 드릴게요.＂", "value": { "text_id": "5", "word_num": 5, "핵심동사": "알려", "확실성": "확실", "극성": "긍정", "시제": "미래", "key_word": " " } }, { "charNum": "124", "label": "대화형", "length": 31, "text": "＂먼저 애플파이의 기본 재료, 사과잼을 만들어 볼게요.＂", "value": { "text_id": "6", "word_num": 7, "핵심동사": "만들어", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "156", "label": "대화형", "length": 29, "text": "＂셰프님, 그냥 사과잼을 구입해서 활용해도 되나요?＂", "value": { "text_id": "7", "word_num": 6, "핵심동사": "활용해도", "확실성": "불확실", "극성": "미정", "시제": "미래", "key_word": " " } }, { "charNum": "186", "label": "대화형", "length": 38, "text": "＂물론 그래도 되지만 애플파이의 생명은 아삭한 사과의 식감이거든요.＂", "value": { "text_id": "8", "word_num": 8, "핵심동사": "식감이거든요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "225", "label": "대화형", "length": 40, "text": "＂시중에서 파는 잼은 대부분 사과를 갈아 만들기 때문에 식감이 없어요.＂", "value": { "text_id": "9", "word_num": 10, "핵심동사": "없어요", "확실성": "확실", "극성": "부정", "시제": "현재", "key_word": " " } }, { "charNum": "266", "label": "대화형", "length": 25, "text": "＂그래서 저는 직접 만들어 사용하는 거예요.＂", "value": { "text_id": "10", "word_num": 6, "핵심동사": "사용하는", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "292", "label": "대화형", "length": 65, "text": "＂여기 사과 2개를 약 1.5cm 크기로 다져 놨는데요, 황설탕 3 큰 술과 함께 냄비에 넣고 중 불에서 끓일게요.＂", "value": { "text_id": "11", "word_num": 18, "핵심동사": "끓일게요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "358", "label": "대화형", "length": 21, "text": "＂설탕은 꼭 황설탕을 넣어야 하나요?＂", "value": { "text_id": "12", "word_num": 5, "핵심동사": "넣어야", "확실성": "불확실", "극성": "미정", "시제": "미래", "key_word": " " } }, { "charNum": "380", "label": "대화형", "length": 11, "text": "＂백설탕은 어때요?＂", "value": { "text_id": "13", "word_num": 2, "핵심동사": "어때요", "확실성": "불확실", "극성": "미정", "시제": "현재", "key_word": " " } }, { "charNum": "392", "label": "대화형", "length": 74, "text": "＂설탕을 넣는 이유는 오랜 보관을 위한 방부 효과랑 윤기를 더하기 때문에 넣는 건데, 백설탕에 사과를 졸이면 단맛이 너무 과해져요.＂", "value": { "text_id": "14", "word_num": 19, "핵심동사": "과해져요", "확실성": "확실", "극성": "긍정", "시제": "미래", "key_word": " " } }, { "charNum": "467", "label": "대화형", "length": 70, "text": "＂반면 황설탕은 사과잼의 색감도 살려주고 진한 단맛이 아닌 은은한 단맛을 내기 때문에 애플파이에는 황설탕이 더 잘 어울려요.＂", "value": { "text_id": "15", "word_num": 17, "핵심동사": "어울려요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "538", "label": "대화형", "length": 22, "text": "＂애플파이는 정말 좋은 영양 간식이죠.＂", "value": { "text_id": "16", "word_num": 5, "핵심동사": "간식이죠", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "561", "label": "대화형", "length": 49, "text": "＂사과에 풍부한 식이섬유는 장내 유산균의 먹이가 되어, 면역력을 더욱더 좋게 만듭니다.＂", "value": { "text_id": "17", "word_num": 11, "핵심동사": "만듭니다", "확실성": "확실", "극성": "긍정", "시제": "미래", "key_word": " " } }, { "charNum": "611", "label": "대화형", "length": 41, "text": "＂사과를 잼으로 익히면 섬유질이 부드러워져 소화 흡수가 더 빨라지거든요.＂", "value": { "text_id": "18", "word_num": 9, "핵심동사": "빨라지거든요", "확실성": "확실", "극성": "긍정", "시제": "미래", "key_word": " " } }, { "charNum": "653", "label": "대화형", "length": 69, "text": "＂이때 체내 지방이 쌓이는 것을 막는 펙틴의 밀도 역시 높아져 다이어트나 피로 회복, 피부 미용 등 다양한 도움을 줍니다.＂", "value": { "text_id": "19", "word_num": 19, "핵심동사": "줍니다", "확실성": "확실", "극성": "긍정", "시제": "미래", "key_word": " " } }, { "charNum": "723", "label": "대화형", "length": 20, "text": "＂자, 수분이 어느 정도 날아갔죠?＂", "value": { "text_id": "20", "word_num": 5, "핵심동사": "날아갔죠", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "744", "label": "대화형", "length": 51, "text": "＂이렇게 마무리해도 되지만 저는 한 가지 더, 바로 건크랜베리를 2 큰 술을 넣을 겁니다.＂", "value": { "text_id": "21", "word_num": 14, "핵심동사": "넣을", "확실성": "확실", "극성": "긍정", "시제": "미래", "key_word": " " } }, { "charNum": "796", "label": "대화형", "length": 31, "text": "＂사과의 단맛에 건크랜베리의 상큼함을 더할 수 있어요.＂", "value": { "text_id": "22", "word_num": 7, "핵심동사": "더할", "확실성": "불확실", "극성": "긍정", "시제": "미래", "key_word": " " } }, { "charNum": "828", "label": "대화형", "length": 23, "text": "＂그런 이유라면 건포도도 괜찮지 않아요?＂", "value": { "text_id": "23", "word_num": 5, "핵심동사": "괜찮지", "확실성": "불확실", "극성": "미정", "시제": "현재", "key_word": " " } }, { "charNum": "852", "label": "대화형", "length": 19, "text": "＂맞아요, 건포도도 잘 어울려요.＂", "value": { "text_id": "24", "word_num": 4, "핵심동사": "어울려요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "872", "label": "대화형", "length": 30, "text": "＂이렇게 수분이 없어질 때까지 약 15분간 졸일게요.＂", "value": { "text_id": "25", "word_num": 7, "핵심동사": "졸일게요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "903", "label": "대화형", "length": 71, "text": "＂자, 사과잼이 어느 정도 졸여졌는데, 여기에 시나몬 가루 3꼬집이랑 레몬즙 1 작은 술만 넣으면 완벽한 사과잼이 완성됩니다.＂", "value": { "text_id": "26", "word_num": 17, "핵심동사": "완성됩니다", "확실성": "불확실", "극성": "긍정", "시제": "미래", "key_word": " " } }, { "charNum": "975", "label": "대화형", "length": 20, "text": "＂이렇게 살짝만 끓인 뒤 식힐게요.＂", "value": { "text_id": "27", "word_num": 5, "핵심동사": "식힐게요", "확실성": "확실", "극성": "긍정", "시제": "미래", "key_word": " " } }, { "charNum": "996", "label": "대화형", "length": 43, "text": "＂사과잼은 준비가 됐고, 저는 파이 반죽을 어떻게 만드실 지 너무 궁금해요.＂", "value": { "text_id": "28", "word_num": 11, "핵심동사": "궁금해요", "확실성": "확실", "극성": "긍정", "시제": "미래", "key_word": " " } }, { "charNum": "1040", "label": "대화형", "length": 26, "text": "＂** 씨, 쉽게 만들까요, 어렵게 만들까요?＂", "value": { "text_id": "29", "word_num": 6, "핵심동사": "만들까요", "확실성": "불확실", "극성": "미정", "시제": "미래", "key_word": " " } }, { "charNum": "1067", "label": "대화형", "length": 10, "text": "＂당연히 쉽게죠.＂", "value": { "text_id": "30", "word_num": 2, "핵심동사": "쉽게죠", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "1078", "label": "대화형", "length": 19, "text": "＂그래서 저는 식빵을 준비했어요.＂", "value": { "text_id": "31", "word_num": 4, "핵심동사": "준비했어요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } } ], "dupLabelYn": "Y", "metaData": { "ID": "560068", "FILENAME": "560068.json", "MEDIA_TYPE": "방송대본", "MEDIA_NAME": "알토란", "CATEGORY": "생활건강", "PUBDATE": "20210619", "SENTENCE": "31" } } 