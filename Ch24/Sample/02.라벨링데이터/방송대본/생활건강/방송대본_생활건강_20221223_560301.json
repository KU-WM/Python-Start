{ "annotation": [ { "charNum": "1", "label": "대화형", "length": 13, "text": "＂하지만 걱정 마세요.＂", "value": { "text_id": "1", "word_num": 3, "핵심동사": "마세요", "확실성": "확실", "극성": "부정", "시제": "현재", "key_word": " " } }, { "charNum": "14", "label": "대화형", "length": 36, "text": "＂홍** 씨의 굳은 등을 제가 단 5분 만에 쫙 펴드리겠습니다.＂", "value": { "text_id": "2", "word_num": 10, "핵심동사": "펴드리겠습니다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "50", "label": "대화형", "length": 31, "text": "＂우와, 50년을 굳혀온 등인데 5분 만에 펴진다고요?＂", "value": { "text_id": "3", "word_num": 7, "핵심동사": "펴진다고요", "확실성": "불확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "81", "label": "대화형", "length": 34, "text": "＂우리가 의식이 없고 생명이 위급할 때 가장 먼저 뭘 하죠?＂", "value": { "text_id": "4", "word_num": 10, "핵심동사": "하죠", "확실성": "불확실", "극성": "미정", "시제": "현재", "key_word": " " } }, { "charNum": "115", "label": "대화형", "length": 11, "text": "＂인공호흡을 하죠?＂", "value": { "text_id": "5", "word_num": 2, "핵심동사": "하죠", "확실성": "불확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "126", "label": "대화형", "length": 37, "text": "＂등이 굳는 것도 전신 건강을 위협하는 만큼 위험한 상황이거든요.＂", "value": { "text_id": "6", "word_num": 9, "핵심동사": "상황이거든요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "163", "label": "대화형", "length": 34, "text": "＂그래서 굳은 등의 숨통을 틔워주는 등 호흡을 알려드릴게요.＂", "value": { "text_id": "7", "word_num": 8, "핵심동사": "알려드릴게요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "197", "label": "대화형", "length": 12, "text": "＂바로 시작해볼게요.＂", "value": { "text_id": "8", "word_num": 2, "핵심동사": "시작해볼게요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "209", "label": "대화형", "length": 52, "text": "＂단, 5분 만에 등을 쭉쭉 펼 수 있는 등 호흡법, 효과도 좋지만, 방법도 너무 간단해요.＂", "value": { "text_id": "9", "word_num": 15, "핵심동사": "간단해요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "261", "label": "대화형", "length": 21, "text": "＂제가 우선 시범을 보여드리겠습니다.＂", "value": { "text_id": "10", "word_num": 4, "핵심동사": "보여드리겠습니다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "282", "label": "대화형", "length": 20, "text": "＂앞은 아까 했던 자세와 똑같아요.＂", "value": { "text_id": "11", "word_num": 5, "핵심동사": "똑같아요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "302", "label": "대화형", "length": 33, "text": "＂여기까지는 아까 등근육이 굳었는지 알아보는 자세와 같죠.＂", "value": { "text_id": "12", "word_num": 7, "핵심동사": "같죠", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "335", "label": "대화형", "length": 20, "text": "＂여기서부터 등 호흡법 시작입니다.＂", "value": { "text_id": "13", "word_num": 4, "핵심동사": "시작입니다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "355", "label": "대화형", "length": 34, "text": "＂이 상태에서 몸을 옆으로 숙여 등을 최대한 쭉 늘려줍니다.＂", "value": { "text_id": "14", "word_num": 9, "핵심동사": "늘려줍니다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "389", "label": "대화형", "length": 32, "text": "＂최대한 늘려준 후에 숨을 들이마시고, 5초 정지합니다.＂", "value": { "text_id": "15", "word_num": 7, "핵심동사": "정지합니다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "421", "label": "대화형", "length": 26, "text": "＂등 안에 공기를 넣어준다고 생각하면 됩니다.＂", "value": { "text_id": "16", "word_num": 6, "핵심동사": "생각하면", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "447", "label": "대화형", "length": 28, "text": "＂최대로 늘여서 굳은 등을 풀어 해주는 것입니다.＂", "value": { "text_id": "17", "word_num": 7, "핵심동사": "해주는", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "475", "label": "대화형", "length": 32, "text": "＂다시 숨을 천천히 내뱉으면서 상체를 들어올리면 됩니다.＂", "value": { "text_id": "18", "word_num": 7, "핵심동사": "들어올리면", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "507", "label": "대화형", "length": 25, "text": "＂한쪽에 2번씩, 반대쪽도 똑같이 해줍니다.＂", "value": { "text_id": "19", "word_num": 5, "핵심동사": "해줍니다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "532", "label": "대화형", "length": 10, "text": "＂이게 끝인가요?＂", "value": { "text_id": "20", "word_num": 2, "핵심동사": "끝인가요", "확실성": "불확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "542", "label": "대화형", "length": 10, "text": "＂정말 간단한데?＂", "value": { "text_id": "21", "word_num": 2, "핵심동사": "간단한데", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "552", "label": "대화형", "length": 12, "text": "＂5분도 안 걸렸죠?＂", "value": { "text_id": "22", "word_num": 3, "핵심동사": "걸렸죠", "확실성": "불확실", "극성": "부정", "시제": "현재", "key_word": " " } }, { "charNum": "564", "label": "대화형", "length": 18, "text": "＂간단하지만 효과는 만점입니다.＂", "value": { "text_id": "23", "word_num": 3, "핵심동사": "만점입니다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "582", "label": "대화형", "length": 10, "text": "＂제가 해볼게요.＂", "value": { "text_id": "24", "word_num": 2, "핵심동사": "해볼게요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "592", "label": "대화형", "length": 46, "text": "＂자, 그러면 굳은 등이 정말 풀렸는지 아까 해본 굳은 등 테스트 다시 해볼까요?＂", "value": { "text_id": "25", "word_num": 13, "핵심동사": "해볼까요", "확실성": "불확실", "극성": "긍정", "시제": "현재", "key_word": " " } } ], "dupLabelYn": "Y", "metaData": { "ID": "560301", "FILENAME": "560301.json", "MEDIA_TYPE": "방송대본", "MEDIA_NAME": "엄지의제왕", "CATEGORY": "생활건강", "PUBDATE": "20190712", "SENTENCE": "25" } } 