{ "annotation": [ { "charNum": "1", "label": "대화형", "length": 33, "text": "＂자, 먼저 향신 채소를 볶아서 기름에 향을 내줄 건데요.＂", "value": { "text_id": "1", "word_num": 9, "핵심동사": "내줄", "확실성": "확실", "극성": "긍정", "시제": "미래", "key_word": " " } }, { "charNum": "35", "label": "대화형", "length": 23, "text": "＂궁중 팬에 식용유 1 큰 술을 넣고요.＂", "value": { "text_id": "2", "word_num": 7, "핵심동사": "넣고요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "59", "label": "대화형", "length": 23, "text": "＂3cm로 자른 대파 반 줄기 넣을게요.＂", "value": { "text_id": "3", "word_num": 6, "핵심동사": "넣을게요", "확실성": "확실", "극성": "긍정", "시제": "미래", "key_word": " " } }, { "charNum": "83", "label": "대화형", "length": 19, "text": "＂편으로 썬 마늘 3개도 넣고요.＂", "value": { "text_id": "4", "word_num": 5, "핵심동사": "넣고요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "103", "label": "대화형", "length": 32, "text": "＂마지막으로 베트남 건고추 10개도 넣고 살짝 볶을게요.＂", "value": { "text_id": "5", "word_num": 7, "핵심동사": "볶을게요", "확실성": "확실", "극성": "긍정", "시제": "미래", "key_word": " " } }, { "charNum": "136", "label": "대화형", "length": 34, "text": "＂셰프님, 베트남 건고추가 없다면 청양고추를 넣어도 되나요?＂", "value": { "text_id": "6", "word_num": 7, "핵심동사": "넣어도", "확실성": "불확실", "극성": "미정", "시제": "현재", "key_word": " " } }, { "charNum": "171", "label": "대화형", "length": 40, "text": "＂물론입니다, 청양고추나 건고추도 괜찮지만 톡 쏘는 매운맛만 나거든요.＂", "value": { "text_id": "7", "word_num": 8, "핵심동사": "나거든요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "212", "label": "대화형", "length": 54, "text": "＂반면 베트남 건고추는 매운맛은 물론 은은한 매운 향까지 더해 줘서 난자완스에 더 잘 어울려요.＂", "value": { "text_id": "8", "word_num": 14, "핵심동사": "어울려요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } } ], "dupLabelYn": "Y", "metaData": { "ID": "560235", "FILENAME": "560235.json", "MEDIA_TYPE": "방송대본", "MEDIA_NAME": "알토란", "CATEGORY": "생활건강", "PUBDATE": "20210905", "SENTENCE": "8" } } 