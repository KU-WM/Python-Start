{ "annotation": [ { "charNum": "1", "label": "대화형", "length": 9, "text": "＂걱정 마세요.＂", "value": { "text_id": "1", "word_num": 2, "핵심동사": "걱정 마세요", "확실성": "확실", "극성": "부정", "시제": "현재", "key_word": " " } }, { "charNum": "11", "label": "대화형", "length": 22, "text": "＂제가 실패 없는 비법 알려 드릴게요.＂", "value": { "text_id": "2", "word_num": 6, "핵심동사": "알려", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "34", "label": "대화형", "length": 37, "text": "＂아까 동그랗게 파고 남은 수박 보시면 아직 빨간 과육이 남았죠?＂", "value": { "text_id": "3", "word_num": 10, "핵심동사": "남았죠", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": " " } }, { "charNum": "72", "label": "대화형", "length": 24, "text": "＂칼로 싹싹 긁어서 국물에 활용할 거예요.＂", "value": { "text_id": "4", "word_num": 6, "핵심동사": "활용할", "확실성": "확실", "극성": "긍정", "시제": "미래", "key_word": " " } }, { "charNum": "97", "label": "대화형", "length": 14, "text": "＂저 생각을 왜 못했지?＂", "value": { "text_id": "5", "word_num": 4, "핵심동사": "못했지", "확실성": "확실", "극성": "부정", "시제": "과거", "key_word": " " } }, { "charNum": "112", "label": "대화형", "length": 32, "text": "＂화채 국물에도 수박의 향과 맛이 더해져서 더 맛있겠네.＂", "value": { "text_id": "6", "word_num": 8, "핵심동사": "맛있겠네", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "145", "label": "대화형", "length": 15, "text": "＂정말 좋은 방법 같아요.＂", "value": { "text_id": "7", "word_num": 4, "핵심동사": "같아요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "161", "label": "대화형", "length": 41, "text": "＂이제 믹서에 긁어낸 과육과 꿀 2 큰 술을 넣고 주스처럼 곱게 갈게요.＂", "value": { "text_id": "8", "word_num": 12, "핵심동사": "갈게요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "203", "label": "대화형", "length": 40, "text": "＂쌤, 화채는 국물이 많아야 시원하고 맛있는데, 양이 좀 적지 않아요?＂", "value": { "text_id": "9", "word_num": 10, "핵심동사": "적지", "확실성": "확실", "극성": "부정", "시제": "현재", "key_word": " " } }, { "charNum": "244", "label": "대화형", "length": 37, "text": "＂당연하죠, 화채 국물은 깔끔하면서도 톡 쏘는 맛을 더해 줄게요.＂", "value": { "text_id": "10", "word_num": 9, "핵심동사": "더해", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "282", "label": "대화형", "length": 18, "text": "＂화채엔 소다 맛 음료 아시죠?＂", "value": { "text_id": "11", "word_num": 5, "핵심동사": "아시죠", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "301", "label": "대화형", "length": 11, "text": "＂그게 최고거든요.＂", "value": { "text_id": "12", "word_num": 2, "핵심동사": "최고거든요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "313", "label": "대화형", "length": 51, "text": "＂저 같은 경우는 아이들 때문에 화채 국물로 우유나 아이들 전용 음료를 좀 섞어 넣거든요.＂", "value": { "text_id": "13", "word_num": 14, "핵심동사": "섞어", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "365", "label": "대화형", "length": 15, "text": "＂그것도 좋은 방법이에요.＂", "value": { "text_id": "14", "word_num": 3, "핵심동사": "방법이에요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "381", "label": "대화형", "length": 24, "text": "＂화채 국물은 취향대로 넣으시면 되는데요.＂", "value": { "text_id": "15", "word_num": 5, "핵심동사": "넣으시면", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "406", "label": "대화형", "length": 17, "text": "＂저는 탄산수를 넣을 거예요.＂", "value": { "text_id": "16", "word_num": 4, "핵심동사": "넣을", "확실성": "확실", "극성": "긍정", "시제": "미래", "key_word": " " } }, { "charNum": "424", "label": "대화형", "length": 38, "text": "＂왜냐하면 수박 과즙과 꿀까지 들어갔기 때문에 단맛은 충분하거든요.＂", "value": { "text_id": "17", "word_num": 8, "핵심동사": "충분하거든요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "463", "label": "대화형", "length": 27, "text": "＂톡 쏘는 맛을 위해 무설탕 탄산수를 넣을게요.＂", "value": { "text_id": "18", "word_num": 7, "핵심동사": "넣을게요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "491", "label": "대화형", "length": 35, "text": "＂자, 완성된 화채 국물에 동그랗게 판 수박과 참외를 넣고요.＂", "value": { "text_id": "19", "word_num": 9, "핵심동사": "넣고요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "527", "label": "대화형", "length": 28, "text": "＂다양한 색감을 위해 블루베리 50g도 넣을게요.＂", "value": { "text_id": "20", "word_num": 6, "핵심동사": "넣을게요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "556", "label": "대화형", "length": 66, "text": "＂그리고 저는 상큼한 향과 맛을 더해 줄 레몬 1/4개와 애플민트 2줄기를 넣을 건데, 없으면 안 넣으셔도 괜찮아요.＂", "value": { "text_id": "21", "word_num": 17, "핵심동사": "괜찮아요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "623", "label": "대화형", "length": 22, "text": "＂자, 마지막으로 얼음 동동 띄울게요.＂", "value": { "text_id": "22", "word_num": 5, "핵심동사": "띄울게요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } } ], "dupLabelYn": "Y", "metaData": { "ID": "560022", "FILENAME": "560022.json", "MEDIA_TYPE": "방송대본", "MEDIA_NAME": "알토란", "CATEGORY": "생활건강", "PUBDATE": "20210627", "SENTENCE": "22" } } 