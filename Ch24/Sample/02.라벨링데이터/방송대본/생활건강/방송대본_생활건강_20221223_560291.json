{ "annotation": [ { "charNum": "1", "label": "대화형", "length": 22, "text": "＂식초마다 색이 달라 알록달록 예뻐요.＂", "value": { "text_id": "1", "word_num": 5, "핵심동사": "예뻐요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "24", "label": "대화형", "length": 17, "text": "＂어떤 식초인지 소개해주세요.＂", "value": { "text_id": "2", "word_num": 3, "핵심동사": "소개해주세요", "확실성": "확실", "극성": "긍정", "시제": "미래", "key_word": " " } }, { "charNum": "42", "label": "대화형", "length": 66, "text": "＂노란색 식초가 머위 식초, 초록색 식초가 미나리 식초, 주황색이 버찌 식초, 마지막으로 빨간색이 오미자 식초입니다.＂", "value": { "text_id": "3", "word_num": 16, "핵심동사": "식초입니다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "110", "label": "대화형", "length": 22, "text": "＂여러분, 어떤 식초 드시고 싶으세요?＂", "value": { "text_id": "4", "word_num": 5, "핵심동사": "드시고", "확실성": "불확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "133", "label": "대화형", "length": 18, "text": "＂보기만 해도 침이 고이는데요.＂", "value": { "text_id": "5", "word_num": 5, "핵심동사": "고이는데요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "153", "label": "대화형", "length": 13, "text": "＂다 같이 먹어볼까요?＂", "value": { "text_id": "6", "word_num": 3, "핵심동사": "먹어볼까요", "확실성": "불확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "167", "label": "대화형", "length": 12, "text": "＂시음 준비해주세요.＂", "value": { "text_id": "7", "word_num": 2, "핵심동사": "준비해주세요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "180", "label": "대화형", "length": 15, "text": "＂여러분, 맛이 어떠세요?＂", "value": { "text_id": "8", "word_num": 3, "핵심동사": "어떠세요", "확실성": "불확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "196", "label": "대화형", "length": 21, "text": "＂한** 선생님, 어떻게 보셨나요? ＂", "value": { "text_id": "9", "word_num": 5, "핵심동사": "보셨나요", "확실성": "불확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "218", "label": "대화형", "length": 26, "text": "＂식초는 기본적으로 독소 해독에 효과적입니다.＂", "value": { "text_id": "10", "word_num": 5, "핵심동사": "효과적입니다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "245", "label": "대화형", "length": 37, "text": "＂여기에 어떤 재료를 넣느냐에 따라 부가적인 효능이 추가되는데요.＂", "value": { "text_id": "11", "word_num": 8, "핵심동사": "추가되는데요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "283", "label": "대화형", "length": 42, "text": "＂머위는 ＇콜린＇이라는 성분이 풍부한데, 염증을 완화해 기침을 해소합니다.＂", "value": { "text_id": "12", "word_num": 8, "핵심동사": "해소합니다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "326", "label": "대화형", "length": 57, "text": "＂특히 머위의 꽃은 관동화라고 해서 한의원에서도 기침을 치료하는데, 중요한 약재로 사용하고 있습니다.＂", "value": { "text_id": "13", "word_num": 12, "핵심동사": "사용하고", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "384", "label": "대화형", "length": 28, "text": "＂미나리는 수근이라고 해서 약으로도 사용하는데요.＂", "value": { "text_id": "14", "word_num": 5, "핵심동사": "사용하는데요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "413", "label": "대화형", "length": 40, "text": "＂간 기능을 활성화하는 성분이 있어 간 해독과 숙취 해소를 도와줍니다.＂", "value": { "text_id": "15", "word_num": 10, "핵심동사": "도와줍니다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "454", "label": "대화형", "length": 94, "text": "＂그리고 버찌는 철분이 많아 빈혈에 도움이 되고 오미자는 신장 기능을 강화해 노폐물이 잘 배출될 수 있도록 도와주며 폐 기능을 강화해 호흡기 질환에도 효과가 있습니다.＂", "value": { "text_id": "16", "word_num": 24, "핵심동사": "있습니다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "549", "label": "대화형", "length": 18, "text": "＂김** 씨 무시해서 미안해요.＂", "value": { "text_id": "17", "word_num": 4, "핵심동사": "미안해요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "568", "label": "대화형", "length": 27, "text": "＂오프닝 때 특별한 식초를 알려 준다고 했잖아.＂", "value": { "text_id": "18", "word_num": 7, "핵심동사": "알려", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "596", "label": "대화형", "length": 65, "text": "＂그때 식초로 식초가 특별해 봤자 별 게 있을까 생각했는데, 장인이 만들어주는 특이한 식초도 먹어보고 너무 좋네요.＂", "value": { "text_id": "19", "word_num": 16, "핵심동사": "좋네요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "662", "label": "대화형", "length": 18, "text": "＂여러분, 이게 끝이 아닙니다.＂", "value": { "text_id": "20", "word_num": 4, "핵심동사": "아닙니다", "확실성": "확실", "극성": "부정", "시제": "현재", "key_word": " " } }, { "charNum": "681", "label": "대화형", "length": 23, "text": "＂김** 장인이 뭔가 더 준비하셨다고요?＂", "value": { "text_id": "21", "word_num": 5, "핵심동사": "준비하셨다고요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "705", "label": "대화형", "length": 60, "text": "＂엄지의 제왕 시청자들을 위해 여름철 이 시기에 먹으면 딱 좋을, 다이어트에 효과적인 식초를 준비했는데요.＂", "value": { "text_id": "22", "word_num": 14, "핵심동사": "준비했는데요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "766", "label": "대화형", "length": 37, "text": "＂이 식초만 먹으면 지방세포에 쌓인 독소가 청소돼 살이 빠집니다.＂", "value": { "text_id": "23", "word_num": 9, "핵심동사": "빠집니다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "804", "label": "대화형", "length": 17, "text": "＂<떠먹는 클린 식초>입니다.＂", "value": { "text_id": "24", "word_num": 3, "핵심동사": "식초>입니다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "822", "label": "대화형", "length": 37, "text": "＂일반적으로 식초를 물에 타서 드시거나 요리에 조미료로 쓰잖아요.＂", "value": { "text_id": "25", "word_num": 8, "핵심동사": "쓰잖아요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "860", "label": "대화형", "length": 63, "text": "＂그런데, 떠먹는 클린 식초는 기존 식초 음용법의 상식을 깨면서 맛은 있고, 지방까지 제거하는 효과가 있습니다.＂", "value": { "text_id": "26", "word_num": 15, "핵심동사": "있습니다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "924", "label": "대화형", "length": 22, "text": "＂저도 식초 먹고 나서 살이 빠졌어요.＂", "value": { "text_id": "27", "word_num": 6, "핵심동사": "빠졌어요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "947", "label": "대화형", "length": 15, "text": "＂어떤 식초일지 기대된다.＂", "value": { "text_id": "28", "word_num": 3, "핵심동사": "기대된다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "963", "label": "대화형", "length": 64, "text": "＂굶어도 식단 조절해도 살이 잘 안 빠진다는 분들 주목, 이런 분들은 식초를 드시는 것이 다이어트에 효과적입니다.＂", "value": { "text_id": "29", "word_num": 16, "핵심동사": "효과적입니다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "1028", "label": "대화형", "length": 31, "text": "＂그 이유는 세포에는 미토콘드리아라는 기관이 있습니다.＂", "value": { "text_id": "30", "word_num": 6, "핵심동사": "있습니다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "1060", "label": "대화형", "length": 24, "text": "＂이 기관은 에너지를 생산하는 기관인데요.＂", "value": { "text_id": "31", "word_num": 5, "핵심동사": "기관인데요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "1085", "label": "대화형", "length": 37, "text": "＂그런데, 독소가 세포에 축적되면 미토콘드리아도 망가지게 됩니다.＂", "value": { "text_id": "32", "word_num": 7, "핵심동사": "망가지게", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "1123", "label": "대화형", "length": 36, "text": "＂그로 인해 에너지 생산 능력이 저하돼 신진대사가 떨어지는데요.＂", "value": { "text_id": "33", "word_num": 8, "핵심동사": "떨어지는데요", "확실성": "확실", "극성": "긍정", "시제": "미래", "key_word": " " } }, { "charNum": "1160", "label": "대화형", "length": 29, "text": "＂신진대사가 떨어지면 지방 연소 기능이 낮아집니다.＂", "value": { "text_id": "34", "word_num": 6, "핵심동사": "낮아집니다", "확실성": "확실", "극성": "긍정", "시제": "미래", "key_word": " " } }, { "charNum": "1190", "label": "대화형", "length": 85, "text": "＂이때 식초를 먹으면 식초 속 초산, 비타민, 무기질과 같은 물질이 신진대사를 높여 지방이 잘 탈 수 있도록 만들어주기 때문에 다이어트에 효과적입니다.＂", "value": { "text_id": "35", "word_num": 22, "핵심동사": "효과적입니다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "1277", "label": "대화형", "length": 28, "text": "＂실제로 일본에서 진행된 한 연구 결과를 보면요.＂", "value": { "text_id": "36", "word_num": 7, "핵심동사": "보면요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "1306", "label": "대화형", "length": 124, "text": "＂경증 비만의 성인 남녀 175명을 대상으로 지나친 운동을 피하고, 일상생활을 하면서 사과 식초를 하루 2회씩 꾸준히 마시게 했더니 12주 뒤 내장지방 면적은 평균 6.72㎠! 허리둘레는 1.85㎝가 줄어들었다고 합니다.＂", "value": { "text_id": "37", "word_num": 28, "핵심동사": "합니다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "1431", "label": "대화형", "length": 17, "text": "＂제가 다이어트 전도사잖아요?＂", "value": { "text_id": "38", "word_num": 3, "핵심동사": "전도사잖아요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "1449", "label": "대화형", "length": 27, "text": "＂허리둘레 1cm 빼기가 보통 일이 아니거든요.＂", "value": { "text_id": "39", "word_num": 6, "핵심동사": "아니거든요", "확실성": "확실", "극성": "부정", "시제": "현재", "key_word": " " } }, { "charNum": "1477", "label": "대화형", "length": 72, "text": "＂먹고 싶은 것 참고, 운동을 엄청나게 해도 잘 안 빠지는 게 내장지방인데 앞으로 먹을 거 다 먹고 식초 챙겨 먹으면 되겠어요.＂", "value": { "text_id": "40", "word_num": 21, "핵심동사": "먹으면", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "1550", "label": "대화형", "length": 40, "text": "＂독소와 지방을 한 번에 제거하는 <떠먹는 클린 식초> 만들어 볼게요.＂", "value": { "text_id": "41", "word_num": 10, "핵심동사": "만들어", "확실성": "확실", "극성": "긍정", "시제": "미래", "key_word": " " } } ], "dupLabelYn": "Y", "metaData": { "ID": "560291", "FILENAME": "560291.json", "MEDIA_TYPE": "방송대본", "MEDIA_NAME": "엄지의제왕", "CATEGORY": "생활건강", "PUBDATE": "20190806", "SENTENCE": "41" } } 