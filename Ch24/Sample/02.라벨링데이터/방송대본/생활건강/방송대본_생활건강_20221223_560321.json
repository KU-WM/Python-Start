{ "annotation": [ { "charNum": "1", "label": "대화형", "length": 8, "text": "＂자 어때요?＂", "value": { "text_id": "1", "word_num": 2, "핵심동사": "어때요", "확실성": "확실", "극성": "미정", "시제": "현재", "key_word": " " } }, { "charNum": "10", "label": "대화형", "length": 31, "text": "＂두 분 따라 해보셨는데 지방간이 태워지는 거 같나요?＂", "value": { "text_id": "2", "word_num": 8, "핵심동사": "태워지는", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "42", "label": "대화형", "length": 18, "text": "＂저 이거 조금 했는데 땀나요.＂", "value": { "text_id": "3", "word_num": 5, "핵심동사": "땀나요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "61", "label": "대화형", "length": 17, "text": "＂어디서 타는 냄새 안 나요?＂", "value": { "text_id": "4", "word_num": 5, "핵심동사": "나요", "확실성": "확실", "극성": "부정", "시제": "현재", "key_word": " " } }, { "charNum": "79", "label": "대화형", "length": 13, "text": "＂지방간 타는 냄새요.＂", "value": { "text_id": "5", "word_num": 3, "핵심동사": "냄새요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "93", "label": "대화형", "length": 64, "text": "＂강도 높은 운동은 아니지만 쉬지 않고 움직이기 때문에 하루 30분만 해도 체지방 감소 효과를 보실 수 있습니다.＂", "value": { "text_id": "6", "word_num": 17, "핵심동사": "보실", "확실성": "확실", "극성": "긍정", "시제": "미래", "key_word": " " } }, { "charNum": "158", "label": "대화형", "length": 36, "text": "＂좋아하는 노래에 맞춰서 하시면 한층 재밌게 하실 수 있습니다.＂", "value": { "text_id": "7", "word_num": 9, "핵심동사": "하실", "확실성": "확실", "극성": "긍정", "시제": "미래", "key_word": " " } }, { "charNum": "195", "label": "대화형", "length": 56, "text": "＂운동도 재미가 있어야 꾸준히 하는데 지방간 태우는 운동 온 가족이 즐겁게 할 수 있을 것 같아요.＂", "value": { "text_id": "8", "word_num": 16, "핵심동사": "할", "확실성": "확실", "극성": "긍정", "시제": "미래", "key_word": " " } }, { "charNum": "252", "label": "대화형", "length": 15, "text": "＂우** 엄지 감사합니다.＂", "value": { "text_id": "9", "word_num": 3, "핵심동사": "감사합니다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "268", "label": "대화형", "length": 23, "text": "＂지방간을 없애는 운동까지 배워봤는데요.＂", "value": { "text_id": "10", "word_num": 4, "핵심동사": "배워봤는데요", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": " " } }, { "charNum": "292", "label": "대화형", "length": 27, "text": "＂비알코올성 지방간의 주된 원인이 음식이잖아요.＂", "value": { "text_id": "11", "word_num": 5, "핵심동사": "음식이잖아요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "320", "label": "대화형", "length": 41, "text": "＂먹는 건 어떻게 먹어야 할지, 무작정 적게 먹는 게 좋은지 궁금한데요.＂", "value": { "text_id": "12", "word_num": 11, "핵심동사": "궁금한데요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "362", "label": "대화형", "length": 18, "text": "＂전** 엄지, 방법이 있나요?＂", "value": { "text_id": "13", "word_num": 4, "핵심동사": "있나요", "확실성": "확실", "극성": "미정", "시제": "현재", "key_word": " " } }, { "charNum": "381", "label": "대화형", "length": 34, "text": "＂지방간이 걱정될 때 지방만 적게 먹으면 된다고 생각하시죠?＂", "value": { "text_id": "14", "word_num": 8, "핵심동사": "생각하시죠", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "416", "label": "대화형", "length": 17, "text": "＂진짜 방법은 따로 있습니다.＂", "value": { "text_id": "15", "word_num": 4, "핵심동사": "있습니다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "434", "label": "대화형", "length": 30, "text": "＂바로 평소 저탄수화물 식이를 하는 것이 중요한데요.＂", "value": { "text_id": "16", "word_num": 7, "핵심동사": "중요한데요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "465", "label": "대화형", "length": 28, "text": "＂제가 어떤 식품을 먹어야 하는지 알려 드릴게요.＂", "value": { "text_id": "17", "word_num": 7, "핵심동사": "알려", "확실성": "확실", "극성": "긍정", "시제": "미래", "key_word": " " } } ], "dupLabelYn": "Y", "metaData": { "ID": "560321", "FILENAME": "560321.json", "MEDIA_TYPE": "방송대본", "MEDIA_NAME": "엄지의제왕", "CATEGORY": "생활건강", "PUBDATE": "20190820", "SENTENCE": "17" } } 