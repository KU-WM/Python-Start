{ "annotation": [ { "charNum": "1", "label": "대화형", "length": 21, "text": "＂이제 바로 불을 켜서 볶아 주세요.＂", "value": { "text_id": "1", "word_num": 6, "핵심동사": "볶아", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "23", "label": "대화형", "length": 17, "text": "＂어느 정도로 볶으면 될까요?＂", "value": { "text_id": "2", "word_num": 4, "핵심동사": "볶으면", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "41", "label": "대화형", "length": 23, "text": "＂볶으면서 양념이 스며들게 하는 건데요.＂", "value": { "text_id": "3", "word_num": 5, "핵심동사": "스며들게", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "65", "label": "대화형", "length": 23, "text": "＂약 2~3분 정도 볶아 주시면 됩니다.＂", "value": { "text_id": "4", "word_num": 6, "핵심동사": "볶아", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "89", "label": "대화형", "length": 16, "text": "＂자, 2~3분 지났는데요.＂", "value": { "text_id": "5", "word_num": 3, "핵심동사": "지났는데요", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": " " } }, { "charNum": "106", "label": "대화형", "length": 21, "text": "＂이때 채 썬 양파 1개를 넣습니다.＂", "value": { "text_id": "6", "word_num": 6, "핵심동사": "넣습니다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "128", "label": "대화형", "length": 27, "text": "＂그리고 홍고추 2개를 곱게 채 썬 걸 넣고요.＂", "value": { "text_id": "7", "word_num": 8, "핵심동사": "넣고요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "156", "label": "대화형", "length": 23, "text": "＂어슷 썬 청양고추 2개도 넣어 주세요.＂", "value": { "text_id": "8", "word_num": 6, "핵심동사": "넣어", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "180", "label": "대화형", "length": 32, "text": "＂그리고 물 반 컵을 넣고 자작해질 때까지 끓여 주세요.＂", "value": { "text_id": "9", "word_num": 9, "핵심동사": "끓여", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "213", "label": "대화형", "length": 14, "text": "＂자, 물이 자작해졌죠.＂", "value": { "text_id": "10", "word_num": 3, "핵심동사": "자작해졌죠", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": " " } }, { "charNum": "228", "label": "대화형", "length": 19, "text": "＂이 때 넣어야 하는 게 있어요.＂", "value": { "text_id": "11", "word_num": 6, "핵심동사": "넣어야", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "248", "label": "대화형", "length": 23, "text": "＂고구마순볶음은 고소한 맛이 필수잖아요.＂", "value": { "text_id": "12", "word_num": 4, "핵심동사": "필수잖아요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "272", "label": "대화형", "length": 27, "text": "＂저는 거피 들깻가루를 5 큰 술 넣을 건데요.＂", "value": { "text_id": "13", "word_num": 8, "핵심동사": "넣을", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "300", "label": "대화형", "length": 22, "text": "＂이건 취향에 맞게 조절하시면 됩니다.＂", "value": { "text_id": "14", "word_num": 5, "핵심동사": "조절하시면", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "323", "label": "대화형", "length": 49, "text": "＂고구마순은 여름철 몸의 체액이 지나치게 빠져나가는 것을 잡아 주는 효능이 뛰어난데요.＂", "value": { "text_id": "15", "word_num": 11, "핵심동사": "뛰어난데요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "373", "label": "대화형", "length": 37, "text": "＂이는 자칫 체액의 흐름을 틀어막는 쪽으로 작용할 수도 있습니다.＂", "value": { "text_id": "16", "word_num": 9, "핵심동사": "작용할", "확실성": "불확실", "극성": "미정", "시제": "미래", "key_word": " " } }, { "charNum": "411", "label": "대화형", "length": 75, "text": "＂이때 들깻가루를 함께 드시면 들깻가루가 특유의 향과 따뜻함으로 막혀 있는 체액의 흐름을 뚫어 주고 퍼트려 주는 역할을 하게 됩니다.＂", "value": { "text_id": "17", "word_num": 19, "핵심동사": "하게", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "487", "label": "대화형", "length": 46, "text": "＂마치 퍽퍽한 고구마를 먹고 속이 답답할 때 사이다를 먹으면 뻥 뚫리는 것처럼요.＂", "value": { "text_id": "18", "word_num": 12, "핵심동사": "뚫리는", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "534", "label": "대화형", "length": 16, "text": "＂자, 그릇에 담아 볼게요.＂", "value": { "text_id": "19", "word_num": 4, "핵심동사": "담아", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "551", "label": "대화형", "length": 36, "text": "＂고구마순볶음 너무 맛있어서 식당가면 몇 번씩 리필해 먹잖아요.＂", "value": { "text_id": "20", "word_num": 8, "핵심동사": "먹잖아요", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": " " } }, { "charNum": "588", "label": "대화형", "length": 52, "text": "＂그런데 고구마순 손질부터 엄두가 안 나서 한 번도 안 만들어 봤는데 오늘 용기가 생겼어요.＂", "value": { "text_id": "21", "word_num": 14, "핵심동사": "생겼어요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "641", "label": "대화형", "length": 43, "text": "＂또 제철 식재료고 건강까지 챙길 수 있으니까 올여름 내내 해 먹어야겠어요.＂", "value": { "text_id": "22", "word_num": 11, "핵심동사": "먹어야겠어요", "확실성": "확실", "극성": "긍정", "시제": "미래", "key_word": " " } } ], "dupLabelYn": "Y", "metaData": { "ID": "560016", "FILENAME": "560016.json", "MEDIA_TYPE": "방송대본", "MEDIA_NAME": "알토란", "CATEGORY": "생활건강", "PUBDATE": "20210627", "SENTENCE": "22" } } 