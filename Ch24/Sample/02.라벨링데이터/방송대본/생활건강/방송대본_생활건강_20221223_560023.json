{ "annotation": [ { "charNum": "1", "label": "대화형", "length": 50, "text": "＂진짜 한여름이 되니까 더워서 짜증 나고 갈증도 너무 나고 단 음식만 막 당기지 않나요?＂", "value": { "text_id": "1", "word_num": 14, "핵심동사": "당기지", "확실성": "확실", "극성": "부정", "시제": "현재", "key_word": " " } }, { "charNum": "52", "label": "대화형", "length": 39, "text": "＂그래서 여름 보양식 하면 저는 과일도 빠질 수 없다고 생각하는데요.＂", "value": { "text_id": "2", "word_num": 10, "핵심동사": "생각하는데요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "92", "label": "대화형", "length": 16, "text": "＂그래서 특별히 모셨습니다.＂", "value": { "text_id": "3", "word_num": 3, "핵심동사": "모셨습니다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "109", "label": "대화형", "length": 39, "text": "＂과일로 무려 연 매출 80억을 달성한 주인공, 배** 사장님입니다.＂", "value": { "text_id": "4", "word_num": 10, "핵심동사": "사장님입니다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "150", "label": "대화형", "length": 16, "text": "＂안녕하세요, 배**입니다.＂", "value": { "text_id": "5", "word_num": 2, "핵심동사": "배**입니다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "167", "label": "대화형", "length": 30, "text": "＂아니 근데 과일로 80억 연 매출이 진짜 가능해요?＂", "value": { "text_id": "6", "word_num": 8, "핵심동사": "가능해요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "198", "label": "대화형", "length": 20, "text": "＂도대체 무슨 비법이 있는 거예요?＂", "value": { "text_id": "7", "word_num": 5, "핵심동사": "있는", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "219", "label": "대화형", "length": 14, "text": "＂저도 좀 알려 주세요.＂", "value": { "text_id": "8", "word_num": 4, "핵심동사": "알려", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "243", "label": "대화형", "length": 17, "text": "＂그러면 지금부터 집중하세요.＂", "value": { "text_id": "9", "word_num": 3, "핵심동사": "집중하세요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "261", "label": "대화형", "length": 71, "text": "＂절대 실패하지 않는 여름 과일 고르는 법부터 손질법까지, 저의 노하우가 담긴 80억 영업 기밀을 아낌없이 알려 드리겠습니다.＂", "value": { "text_id": "10", "word_num": 17, "핵심동사": "알려", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } } ], "dupLabelYn": "Y", "metaData": { "ID": "560023", "FILENAME": "560023.json", "MEDIA_TYPE": "방송대본", "MEDIA_NAME": "알토란", "CATEGORY": "생활건강", "PUBDATE": "20210704", "SENTENCE": "10" } } 