{ "annotation": [ { "charNum": "1", "label": "대화형", "length": 49, "text": "＂자, 다음은 감자에 부침가루를 묻혀야 하는데요, 여기서 중요한 포인트 하나 나갑니다.＂", "value": { "text_id": "1", "word_num": 11, "핵심동사": "나갑니다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "51", "label": "대화형", "length": 33, "text": "＂물에서 바로 건진 감자에 부침가루를 묻혀 주시는 거예요.＂", "value": { "text_id": "2", "word_num": 8, "핵심동사": "묻혀", "확실성": "확실", "극성": "긍정", "시제": "미래", "key_word": " " } }, { "charNum": "85", "label": "대화형", "length": 33, "text": "＂아, 감자에 물기가 있어야 부침가루가 잘 달라붙으니까요?＂", "value": { "text_id": "3", "word_num": 7, "핵심동사": "달라붙으니까요", "확실성": "불확실", "극성": "미정", "시제": "미래", "key_word": " " } }, { "charNum": "119", "label": "대화형", "length": 12, "text": "＂오, 딩동댕입니다.＂", "value": { "text_id": "4", "word_num": 2, "핵심동사": "딩동댕입니다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "132", "label": "대화형", "length": 36, "text": "＂감자채전을 할 때 가장 많이 하는 실패 요인이 뭔 줄 아세요?＂", "value": { "text_id": "5", "word_num": 11, "핵심동사": "아세요", "확실성": "불확실", "극성": "미정", "시제": "현재", "key_word": " " } }, { "charNum": "169", "label": "대화형", "length": 28, "text": "＂감자채가 잘 달라붙지가 않고 다 흩어지더라고요.＂", "value": { "text_id": "6", "word_num": 6, "핵심동사": "흩어지더라고요", "확실성": "확실", "극성": "부정", "시제": "과거", "key_word": " " } }, { "charNum": "198", "label": "대화형", "length": 32, "text": "＂그래서 그냥 옜다 모르겠다 하고 그냥 볶아 먹었거든요.＂", "value": { "text_id": "7", "word_num": 8, "핵심동사": "먹었거든요", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": " " } }, { "charNum": "231", "label": "대화형", "length": 48, "text": "＂맞아요, 그런데 이렇게 물기가 있는 감자에 부침가루를 무치면 잘 흩어지지 않습니다.＂", "value": { "text_id": "8", "word_num": 11, "핵심동사": "흩어지지", "확실성": "확실", "극성": "부정", "시제": "현재", "key_word": " " } }, { "charNum": "280", "label": "대화형", "length": 30, "text": "＂감자에 부침가루 6 큰 술을 넣고 잘 섞어 주세요.＂", "value": { "text_id": "9", "word_num": 9, "핵심동사": "섞어", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } } ], "dupLabelYn": "Y", "metaData": { "ID": "560060", "FILENAME": "560060.json", "MEDIA_TYPE": "방송대본", "MEDIA_NAME": "알토란", "CATEGORY": "생활건강", "PUBDATE": "20210619", "SENTENCE": "9" } } 