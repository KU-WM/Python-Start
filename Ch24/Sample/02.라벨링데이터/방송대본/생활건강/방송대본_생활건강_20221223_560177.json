{ "annotation": [ { "charNum": "1", "label": "대화형", "length": 23, "text": "＂자, 삭힌고추 300g을 준비했는데요.＂", "value": { "text_id": "1", "word_num": 4, "핵심동사": "준비했는데요", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": " " } }, { "charNum": "25", "label": "대화형", "length": 30, "text": "＂이대로 그냥 활용하면 너무 짜서 먹을 수가 없어요.＂", "value": { "text_id": "2", "word_num": 8, "핵심동사": "먹을", "확실성": "확실", "극성": "부정", "시제": "현재", "key_word": " " } }, { "charNum": "56", "label": "대화형", "length": 21, "text": "＂그래서 짠 기를 제거해 줄 겁니다.＂", "value": { "text_id": "3", "word_num": 6, "핵심동사": "제거해", "확실성": "확실", "극성": "긍정", "시제": "미래", "key_word": " " } }, { "charNum": "78", "label": "대화형", "length": 26, "text": "＂짠 기를 없애려면 아무래도 물에 씻어야겠죠?＂", "value": { "text_id": "4", "word_num": 6, "핵심동사": "씻어야겠죠", "확실성": "불확실", "극성": "긍정", "시제": "미래", "key_word": " " } }, { "charNum": "105", "label": "대화형", "length": 53, "text": "＂네 맞아요, 삭힌고추를 어떻게 손질하느냐에 따라서 맛이 달라지니까 지금부터 놓치면 안 돼요.＂", "value": { "text_id": "5", "word_num": 12, "핵심동사": "돼요", "확실성": "확실", "극성": "부정", "시제": "현재", "key_word": " " } }, { "charNum": "159", "label": "대화형", "length": 25, "text": "＂자, 이렇게 삭힌고추를 물에 헹궈 주세요.＂", "value": { "text_id": "6", "word_num": 6, "핵심동사": "헹궈", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "185", "label": "대화형", "length": 35, "text": "＂그런데 이렇게만 하면 고추 속에 배어든 소금기는 안 빠져요.＂", "value": { "text_id": "7", "word_num": 9, "핵심동사": "빠져요", "확실성": "확실", "극성": "부정", "시제": "현재", "key_word": " " } }, { "charNum": "221", "label": "대화형", "length": 37, "text": "＂삭힌고추를 잘라서 일일이 다 씻을 수도 없고 그럼 어떻게 해요?＂", "value": { "text_id": "8", "word_num": 10, "핵심동사": "해요", "확실성": "불확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "259", "label": "대화형", "length": 11, "text": "＂정말 간단한데요.＂", "value": { "text_id": "9", "word_num": 2, "핵심동사": "간단한데요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "271", "label": "대화형", "length": 31, "text": "＂이렇게 면포에 삭힌고추를 넣고 물기를 쫙 짜면 돼요.＂", "value": { "text_id": "10", "word_num": 8, "핵심동사": "짜면", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "303", "label": "대화형", "length": 26, "text": "＂그럼 속에 있는 소금기가 함께 빠져나옵니다.＂", "value": { "text_id": "11", "word_num": 6, "핵심동사": "빠져나옵니다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } } ], "dupLabelYn": "Y", "metaData": { "ID": "560177", "FILENAME": "560177.json", "MEDIA_TYPE": "방송대본", "MEDIA_NAME": "알토란", "CATEGORY": "생활건강", "PUBDATE": "20210815", "SENTENCE": "11" } } 