{ "annotation": [ { "charNum": "1", "label": "대화형", "length": 37, "text": "＂그럼 이어서 삼겹살 또 다른 짝꿍, 상추파절이도 만들어 볼게요.＂", "value": { "text_id": "1", "word_num": 9, "핵심동사": "만들어", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "39", "label": "대화형", "length": 19, "text": "＂쫑상추 200g을 준비했습니다.＂", "value": { "text_id": "2", "word_num": 3, "핵심동사": "준비했습니다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "59", "label": "대화형", "length": 28, "text": "＂임짱, 쫑상추는 처음 들어 보는데 이게 뭐예요?＂", "value": { "text_id": "3", "word_num": 7, "핵심동사": "뭐예요", "확실성": "불확실", "극성": "미정", "시제": "현재", "key_word": " " } }, { "charNum": "88", "label": "대화형", "length": 48, "text": "＂쫑상추는 상추를 다 뜯어 먹고 난 후 상추 대 끝에 달린 마지막 상추를 말하는데요.＂", "value": { "text_id": "4", "word_num": 14, "핵심동사": "말하는데요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "137", "label": "대화형", "length": 58, "text": "＂쫑상추는 대까지 함께 먹기 때문에 더 아삭하고 쉽게 흐물흐물해지지 않아서 무침이나 김치용으로 씁니다.＂", "value": { "text_id": "5", "word_num": 13, "핵심동사": "씁니다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "196", "label": "대화형", "length": 32, "text": "＂만약 집에 상추 남는 게 있다면 그걸 활용하셔도 돼요.＂", "value": { "text_id": "6", "word_num": 9, "핵심동사": "활용하셔도", "확실성": "확실", "극성": "긍정", "시제": "미래", "key_word": " " } }, { "charNum": "229", "label": "대화형", "length": 22, "text": "＂대파 3대는 채 썰어서 준비했습니다.＂", "value": { "text_id": "7", "word_num": 5, "핵심동사": "준비했습니다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "252", "label": "대화형", "length": 100, "text": "＂삼겹살을 드실 때는 이 상추파절이를 꼭 함께 드시는 게 좋은데요, 상추의 쓴맛을 내는 성분은 삼겹살 소화를 촉진하고, 체내에 콜레스테롤이 쌓이는 것을 막아 피를 맑게 해줍니다.＂", "value": { "text_id": "8", "word_num": 25, "핵심동사": "해줍니다", "확실성": "확실", "극성": "긍정", "시제": "미래", "key_word": " " } }, { "charNum": "353", "label": "대화형", "length": 71, "text": "＂또한, 대파의 유화아릴 성분은 삼겹살의 찬 성질을 보완해 몸을 따뜻하게 해서 혈액순환, 냉해서 생기는 복통에 아주 좋습니다.＂", "value": { "text_id": "9", "word_num": 17, "핵심동사": "좋습니다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } } ], "dupLabelYn": "Y", "metaData": { "ID": "560088", "FILENAME": "560088.json", "MEDIA_TYPE": "방송대본", "MEDIA_NAME": "알토란", "CATEGORY": "생활건강", "PUBDATE": "20210718", "SENTENCE": "9" } } 