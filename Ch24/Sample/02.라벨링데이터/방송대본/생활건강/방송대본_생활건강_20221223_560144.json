{ "annotation": [ { "charNum": "1", "label": "대화형", "length": 22, "text": "＂자, 먼저 국물을 만들어야 하는데요.＂", "value": { "text_id": "1", "word_num": 5, "핵심동사": "만들어야", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "24", "label": "대화형", "length": 27, "text": "＂국물에서 가장 중요한 건 풀국 만드는 거예요.＂", "value": { "text_id": "2", "word_num": 7, "핵심동사": "만드는", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "52", "label": "대화형", "length": 39, "text": "＂풀국은 물에 쌀가루나 밀가루 넣고 풀어서 끓이면 되는 거 아닌가요?＂", "value": { "text_id": "3", "word_num": 10, "핵심동사": "되는", "확실성": "불확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "92", "label": "대화형", "length": 18, "text": "＂아니면 쌀밥 넣어서 갈던지요.＂", "value": { "text_id": "4", "word_num": 4, "핵심동사": "갈던지요", "확실성": "불확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "111", "label": "대화형", "length": 23, "text": "＂보통 풀국은 그렇게 쑤는 게 맞는데요.＂", "value": { "text_id": "5", "word_num": 6, "핵심동사": "맞는데요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "135", "label": "대화형", "length": 37, "text": "＂저는 고수이기 때문에 깊은 감칠맛을 위해 특별한 풀국을 쑵니다.＂", "value": { "text_id": "6", "word_num": 9, "핵심동사": "쑵니다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "173", "label": "대화형", "length": 37, "text": "＂자, 여기서 입에 착 붙는 콩잎물김치 맛의 한 수를 공개합니다.＂", "value": { "text_id": "7", "word_num": 10, "핵심동사": "공개합니다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "211", "label": "대화형", "length": 18, "text": "＂멸치 육수로 풀국을 만들어라.＂", "value": { "text_id": "8", "word_num": 4, "핵심동사": "만들어라", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "230", "label": "대화형", "length": 25, "text": "＂보통 물김치에 멸치 육수를 쓰기도 하나요?＂", "value": { "text_id": "9", "word_num": 6, "핵심동사": "쓰기도", "확실성": "불확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "256", "label": "대화형", "length": 21, "text": "＂좀 비리진 않을까 걱정이 되는데요?＂", "value": { "text_id": "10", "word_num": 5, "핵심동사": "되는데요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "278", "label": "대화형", "length": 31, "text": "＂멸치 육수 풀국은 저 같은 고수들만 아는 비법인데요.＂", "value": { "text_id": "11", "word_num": 8, "핵심동사": "비법인데요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "310", "label": "대화형", "length": 27, "text": "＂절대 비리지 않으니 걱정하지 않으셔도 되고요.＂", "value": { "text_id": "12", "word_num": 6, "핵심동사": "걱정하지", "확실성": "확실", "극성": "부정", "시제": "현재", "key_word": " " } }, { "charNum": "338", "label": "대화형", "length": 93, "text": "＂또 콩잎이 특유의 향이 강하지 않다 보니 멸치 육수를 써서 맛을 더해주고 다소 억센 콩잎에 간이 어느 정도 있는 멸치 육수 풀국을 쓰게 되면 야들야들 부드러워져요.＂", "value": { "text_id": "13", "word_num": 26, "핵심동사": "부드러워져요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "432", "label": "대화형", "length": 33, "text": "＂그럼 멸치 육수 풀국은 어떻게 쑤는지 빨리 알려 주세요.＂", "value": { "text_id": "14", "word_num": 9, "핵심동사": "알려", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "466", "label": "대화형", "length": 29, "text": "＂알겠습니다, 먼저 준비된 멸치 육수는 5컵인데요.＂", "value": { "text_id": "15", "word_num": 6, "핵심동사": "5컵인데요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "496", "label": "대화형", "length": 17, "text": "＂그중 2컵을 냄비에 넣고요.＂", "value": { "text_id": "16", "word_num": 4, "핵심동사": "넣고요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "514", "label": "대화형", "length": 48, "text": "＂밀가루 4 큰 술을 넣고 잘 풀어준 뒤 불을 켜고 부르르 끓을 때까지 끓여 주세요.＂", "value": { "text_id": "17", "word_num": 15, "핵심동사": "끓여", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "563", "label": "대화형", "length": 26, "text": "＂멸치 육수는 집마다 레시피가 다 다르잖아요.＂", "value": { "text_id": "18", "word_num": 6, "핵심동사": "다르잖아요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "590", "label": "대화형", "length": 21, "text": "＂어떤 방식으로 만들어도 상관없나요?＂", "value": { "text_id": "19", "word_num": 4, "핵심동사": "상관없나요", "확실성": "불확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "612", "label": "대화형", "length": 11, "text": "＂네, 상관없어요.＂", "value": { "text_id": "20", "word_num": 2, "핵심동사": "상관없어요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "624", "label": "대화형", "length": 30, "text": "＂사서 쓰셔도 되고 티백으로 나온 걸 쓰셔도 됩니다.＂", "value": { "text_id": "21", "word_num": 8, "핵심동사": "쓰셔도", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "655", "label": "대화형", "length": 12, "text": "＂자, 부르르 끓죠.＂", "value": { "text_id": "22", "word_num": 3, "핵심동사": "끓죠", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "668", "label": "대화형", "length": 12, "text": "＂이때 불을 끄고요.＂", "value": { "text_id": "23", "word_num": 3, "핵심동사": "끄고요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "681", "label": "대화형", "length": 36, "text": "＂볼에 옮겨 담은 뒤 남은 멸치 육수 3컵을 넣고 섞어 주세요.＂", "value": { "text_id": "24", "word_num": 11, "핵심동사": "섞어", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "718", "label": "대화형", "length": 35, "text": "＂근데 5컵 다 넣고 끓이면 되지 왜 3컵은 나중에 넣으세요?＂", "value": { "text_id": "25", "word_num": 10, "핵심동사": "넣으세요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "754", "label": "대화형", "length": 19, "text": "＂풀국은 어차피 식혀야 하잖아요.＂", "value": { "text_id": "26", "word_num": 4, "핵심동사": "식혀야", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "774", "label": "대화형", "length": 63, "text": "＂5컵 다 끓이면 끓는 데 시간 걸리고 식히는 데 시간 걸리고, 이렇게 하면 빨리빨리 일을 할 수 있는 거예요.＂", "value": { "text_id": "27", "word_num": 19, "핵심동사": "할", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "838", "label": "대화형", "length": 31, "text": "＂풀국이 완전히 식을 동안 국물 양념을 만들어 볼게요.＂", "value": { "text_id": "28", "word_num": 8, "핵심동사": "만들어", "확실성": "확실", "극성": "긍정", "시제": "미래", "key_word": " " } } ], "dupLabelYn": "Y", "metaData": { "ID": "560144", "FILENAME": "560144.json", "MEDIA_TYPE": "방송대본", "MEDIA_NAME": "알토란", "CATEGORY": "생활건강", "PUBDATE": "20210808", "SENTENCE": "28" } } 