{ "annotation": [ { "charNum": "1", "label": "대화형", "length": 36, "text": "＂이제 재료는 준비됐으니 본격적으로 양배추말이를 만들어 볼게요.＂", "value": { "text_id": "1", "word_num": 7, "핵심동사": "만들어", "확실성": "확실", "극성": "긍정", "시제": "미래", "key_word": " " } }, { "charNum": "38", "label": "대화형", "length": 48, "text": "＂미리 쪄놓은 양배추에 속 재료 2 큰 술 반을 넣고 돌돌 말아 모양을 잡아 줄게요.＂", "value": { "text_id": "2", "word_num": 15, "핵심동사": "잡아", "확실성": "확실", "극성": "긍정", "시제": "미래", "key_word": " " } }, { "charNum": "87", "label": "대화형", "length": 39, "text": "＂셰프님, 우선 양배추를 쪘기 때문에 쉽게 터지진 않을 것 같거든요?＂", "value": { "text_id": "3", "word_num": 10, "핵심동사": "터지진", "확실성": "불확실", "극성": "긍정", "시제": "미래", "key_word": " " } }, { "charNum": "127", "label": "대화형", "length": 43, "text": "＂근데 흐물흐물거리지 않으려면 꽉 찬 모양을 잡아야 할 텐데 비법이 있나요?＂", "value": { "text_id": "4", "word_num": 11, "핵심동사": "있나요", "확실성": "불확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "171", "label": "대화형", "length": 28, "text": "＂양배추에 소고기에 보기만 해도 속이 든든하네요.＂", "value": { "text_id": "5", "word_num": 6, "핵심동사": "든든하네요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "200", "label": "대화형", "length": 31, "text": "＂양배추를 쪄서 속만 채우면 되니까 미스티분들 어때요?＂", "value": { "text_id": "6", "word_num": 7, "핵심동사": "어때요", "확실성": "불확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "232", "label": "대화형", "length": 10, "text": "＂어렵지 않겠죠?＂", "value": { "text_id": "7", "word_num": 2, "핵심동사": "어렵지", "확실성": "불확실", "극성": "부정", "시제": "미래", "key_word": " " } } ], "dupLabelYn": "Y", "metaData": { "ID": "560150", "FILENAME": "560150.json", "MEDIA_TYPE": "방송대본", "MEDIA_NAME": "알토란", "CATEGORY": "생활건강", "PUBDATE": "20210808", "SENTENCE": "7" } } 