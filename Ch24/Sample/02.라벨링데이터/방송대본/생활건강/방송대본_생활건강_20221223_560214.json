{ "annotation": [ { "charNum": "1", "label": "대화형", "length": 51, "text": "＂고구마김치전의 주인공, 고구마 1개는 채 썬 후에 물에 헹궈서 전분을 빼서 준비했습니다.＂", "value": { "text_id": "1", "word_num": 12, "핵심동사": "준비했습니다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": " " } }, { "charNum": "53", "label": "대화형", "length": 31, "text": "＂고구마는 직접 채를 썰어야 식감을 살릴 수 있습니다.＂", "value": { "text_id": "2", "word_num": 8, "핵심동사": "살릴", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "85", "label": "대화형", "length": 39, "text": "＂그리고 고구마와 영혼의 단짝 김치 150g은 잘게 송송 썰어놨어요.＂", "value": { "text_id": "3", "word_num": 9, "핵심동사": "썰어놨어요", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": " " } }, { "charNum": "125", "label": "대화형", "length": 36, "text": "＂아니 임**, 고구마전이면 고구마전, 김치전이면 김치전이지요.＂", "value": { "text_id": "4", "word_num": 6, "핵심동사": "김치전이지요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "162", "label": "대화형", "length": 24, "text": "＂고구마김치전은 제 평생 처음 들어봤어요.＂", "value": { "text_id": "5", "word_num": 5, "핵심동사": "들어봤어요", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": " " } }, { "charNum": "187", "label": "대화형", "length": 28, "text": "＂그래서 과연 고구마김치전이 맛있을까 의심됩니다.＂", "value": { "text_id": "6", "word_num": 5, "핵심동사": "의심됩니다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "216", "label": "대화형", "length": 25, "text": "＂** 씨, 고구마김치전에 의심은 사치에요.＂", "value": { "text_id": "7", "word_num": 5, "핵심동사": "사치에요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "242", "label": "대화형", "length": 23, "text": "＂여러분 우리가 찐 고구마를 뭐랑 먹죠?＂", "value": { "text_id": "8", "word_num": 6, "핵심동사": "먹죠", "확실성": "확실", "극성": "미정", "시제": "현재", "key_word": " " } }, { "charNum": "266", "label": "대화형", "length": 30, "text": "＂거 보세요, 고구마랑 김치 같이 먹으면 맛있잖아요.＂", "value": { "text_id": "9", "word_num": 7, "핵심동사": "맛있잖아요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "297", "label": "대화형", "length": 57, "text": "＂고구마김치전은 매콤하고 아삭한 김치전에 부드럽고 달큼한 고구마가 더해진 맛이라고 생각하시면 됩니다.＂", "value": { "text_id": "10", "word_num": 11, "핵심동사": "생각하시면", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "355", "label": "대화형", "length": 22, "text": "＂한 번 먹어 보면 다들 반할 거예요.＂", "value": { "text_id": "11", "word_num": 7, "핵심동사": "반할", "확실성": "확실", "극성": "긍정", "시제": "미래", "key_word": " " } }, { "charNum": "378", "label": "대화형", "length": 40, "text": "＂여러분 대장이 건강해야 전신 건강을 지킬 수 있다는 얘기 들어보셨죠?＂", "value": { "text_id": "12", "word_num": 10, "핵심동사": "들어보셨죠", "확실성": "불확실", "극성": "긍정", "시제": "과거", "key_word": " " } }, { "charNum": "419", "label": "대화형", "length": 26, "text": "＂대장이 건강하려면 유산균 섭취가 중요한데요.＂", "value": { "text_id": "13", "word_num": 5, "핵심동사": "중요한데요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "446", "label": "대화형", "length": 25, "text": "＂고구마김치전을 먹으면 한 방에 해결됩니다.＂", "value": { "text_id": "14", "word_num": 5, "핵심동사": "해결됩니다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "472", "label": "대화형", "length": 26, "text": "＂김치에 유산균이 많은 건 다들 아실 텐데요.＂", "value": { "text_id": "15", "word_num": 7, "핵심동사": "아실", "확실성": "불확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "499", "label": "대화형", "length": 31, "text": "＂유산균의 먹이인 프리바이오틱스가 고구마에 풍부합니다.＂", "value": { "text_id": "16", "word_num": 5, "핵심동사": "풍부합니다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "531", "label": "대화형", "length": 46, "text": "＂한 마디로 고구마김치전은 유산균 가득, 영양 가득한 음식이라고 할 수 있습니다.＂", "value": { "text_id": "17", "word_num": 11, "핵심동사": "할", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } } ], "dupLabelYn": "Y", "metaData": { "ID": "560214", "FILENAME": "560214.json", "MEDIA_TYPE": "방송대본", "MEDIA_NAME": "알토란", "CATEGORY": "생활건강", "PUBDATE": "20210731", "SENTENCE": "17" } } 