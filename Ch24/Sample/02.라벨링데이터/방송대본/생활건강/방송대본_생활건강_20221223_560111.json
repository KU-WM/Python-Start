{ "annotation": [ { "charNum": "1", "label": "대화형", "length": 34, "text": "＂여러분 좋은 사람, 나쁜 사람 구분하는 방법 뭔지 아세요?＂", "value": { "text_id": "1", "word_num": 9, "핵심동사": "아세요", "확실성": "불확실", "극성": "미정", "시제": "현재", "key_word": " " } }, { "charNum": "36", "label": "대화형", "length": 38, "text": "＂여러분 맛있는 음식을 아낌없이 주는 사람치고 나쁜 사람 보셨어요?＂", "value": { "text_id": "2", "word_num": 9, "핵심동사": "보셨어요", "확실성": "불확실", "극성": "미정", "시제": "과거", "key_word": " " } }, { "charNum": "75", "label": "대화형", "length": 40, "text": "＂임짱처럼 맛있는 음식 주는 사람이 좋은 사람, 천사 같은 사람이에요.＂", "value": { "text_id": "3", "word_num": 10, "핵심동사": "사람이에요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "116", "label": "대화형", "length": 42, "text": "＂맞아요, 맛있는 요리 해줄 때마다 날개가 보이면서 막 빛이 만발하잖아요.＂", "value": { "text_id": "4", "word_num": 10, "핵심동사": "만발하잖아요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "159", "label": "대화형", "length": 20, "text": "＂임천사에 걸맞는 요리 준비되셨죠?＂", "value": { "text_id": "5", "word_num": 4, "핵심동사": "준비되셨죠", "확실성": "불확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "180", "label": "대화형", "length": 27, "text": "＂당근이죠, 밥맛 없을 때 이만한 음식이 없죠.＂", "value": { "text_id": "6", "word_num": 7, "핵심동사": "없죠", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "208", "label": "대화형", "length": 30, "text": "＂더위를 싹 날리는 시원한 맛, 기대하셔도 좋습니다.＂", "value": { "text_id": "7", "word_num": 7, "핵심동사": "좋습니다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } } ], "dupLabelYn": "Y", "metaData": { "ID": "560111", "FILENAME": "560111.json", "MEDIA_TYPE": "방송대본", "MEDIA_NAME": "알토란", "CATEGORY": "생활건강", "PUBDATE": "20210801", "SENTENCE": "7" } } 