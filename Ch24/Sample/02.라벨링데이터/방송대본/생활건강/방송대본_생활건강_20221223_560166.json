{ "annotation": [ { "charNum": "1", "label": "대화형", "length": 28, "text": "＂비빔국수는 고명이 더 풍부한 맛을 더해주잖아요.＂", "value": { "text_id": "1", "word_num": 6, "핵심동사": "더해주잖아요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "30", "label": "대화형", "length": 33, "text": "＂특히 메밀비빔국수와 함께 곁들이면 좋은 고명이 있는데요.＂", "value": { "text_id": "2", "word_num": 7, "핵심동사": "있는데요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "64", "label": "대화형", "length": 28, "text": "＂이 고명은 아삭함과 새콤달콤한 맛을 더해줍니다.＂", "value": { "text_id": "3", "word_num": 6, "핵심동사": "더해줍니다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "93", "label": "대화형", "length": 16, "text": "＂어떤 고명일 것 같으세요?＂", "value": { "text_id": "4", "word_num": 4, "핵심동사": "같으세요", "확실성": "불확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "110", "label": "대화형", "length": 12, "text": "＂바로 무절임입니다.＂", "value": { "text_id": "5", "word_num": 2, "핵심동사": "무절임입니다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "123", "label": "대화형", "length": 45, "text": "＂무 300g은 가로 2cm, 세로 5cm, 두께 2mm로 썰어서 준비했습니다.＂", "value": { "text_id": "6", "word_num": 10, "핵심동사": "준비했습니다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": " " } }, { "charNum": "169", "label": "대화형", "length": 48, "text": "＂이 정도가 딱 잘 절여질 뿐만 아니라 메밀비빔국수랑 먹었을 때 맛도 잘 어우러져요.＂", "value": { "text_id": "7", "word_num": 13, "핵심동사": "어우러져요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "218", "label": "대화형", "length": 42, "text": "＂맞아요, 저 크기여야 무절임으로 국수를 감싸서 한 입에 넣기 딱 좋아요.＂", "value": { "text_id": "8", "word_num": 11, "핵심동사": "좋아요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "261", "label": "대화형", "length": 19, "text": "＂네, 절임물도 정말 간단한데요.＂", "value": { "text_id": "9", "word_num": 4, "핵심동사": "간단한데요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "281", "label": "대화형", "length": 28, "text": "＂짭조름한 맛을 낼 소금 1 큰 술 반을 넣고요.＂", "value": { "text_id": "10", "word_num": 9, "핵심동사": "넣고요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "310", "label": "대화형", "length": 23, "text": "＂단맛 담당 설탕 1 큰 술을 넣을게요.＂", "value": { "text_id": "11", "word_num": 7, "핵심동사": "넣을게요", "확실성": "확실", "극성": "긍정", "시제": "미래", "key_word": " " } }, { "charNum": "334", "label": "대화형", "length": 32, "text": "＂마지막으로 식초 2 큰 술을 넣고 골고루 섞어 주세요.＂", "value": { "text_id": "12", "word_num": 9, "핵심동사": "섞어", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "367", "label": "대화형", "length": 23, "text": "＂그럼 이 무절임은 얼마나 절이면 돼요?＂", "value": { "text_id": "13", "word_num": 6, "핵심동사": "절이면", "확실성": "불확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "391", "label": "대화형", "length": 20, "text": "＂딱 30분 정도만 절이면 됩니다.＂", "value": { "text_id": "14", "word_num": 5, "핵심동사": "절이면", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "412", "label": "대화형", "length": 31, "text": "＂메밀비빔국수에 무절임을 딱 올려 먹으면 진짜 맛있죠.＂", "value": { "text_id": "15", "word_num": 7, "핵심동사": "맛있죠", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "444", "label": "대화형", "length": 27, "text": "＂그런데 안**쌤, 맛만큼 건강 궁합도 좋나요?＂", "value": { "text_id": "16", "word_num": 6, "핵심동사": "좋나요", "확실성": "불확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "472", "label": "대화형", "length": 52, "text": "＂네, 좋습니다, 덥고 피로가 쌓이기 쉬운 여름에 먹는 메밀은 사막의 오아시스와도 같은데요.＂", "value": { "text_id": "17", "word_num": 13, "핵심동사": "같은데요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "526", "label": "대화형", "length": 45, "text": "＂메밀은 차가운 성질이라 몸의 열을 내려주고, 루틴이 풍부해 혈압을 낮춰줍니다.＂", "value": { "text_id": "18", "word_num": 10, "핵심동사": "낮춰줍니다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "572", "label": "대화형", "length": 50, "text": "＂뿐만 아니라 풍부한 플라보노이드 성분은 간세포를 보호하며 노폐물 배출에도 도움 됩니다.＂", "value": { "text_id": "19", "word_num": 12, "핵심동사": "됩니다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "624", "label": "대화형", "length": 42, "text": "＂하지만 메밀이 찬 성질이라 소화가 안 되거나 복통을 유발할 수 있는데요.＂", "value": { "text_id": "20", "word_num": 12, "핵심동사": "유발할", "확실성": "확실", "극성": "긍정", "시제": "미래", "key_word": " " } }, { "charNum": "668", "label": "대화형", "length": 68, "text": "＂무에는 아밀라아제, 디아스타아제 성분이 풍부해 소화를 원활하게 하기 때문에 메밀비빔국수에 무절임은 아주 찰떡궁합입니다.＂", "value": { "text_id": "21", "word_num": 13, "핵심동사": "찰떡궁합입니다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "737", "label": "대화형", "length": 20, "text": "＂자, 30분간 절인 무절임이에요.＂", "value": { "text_id": "22", "word_num": 4, "핵심동사": "무절임이에요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "758", "label": "대화형", "length": 16, "text": "＂새들새들하니 잘 절여졌죠?＂", "value": { "text_id": "23", "word_num": 3, "핵심동사": "절여졌죠", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": " " } }, { "charNum": "775", "label": "대화형", "length": 21, "text": "＂절인 무절임은 물기를 꼭 짜주세요.＂", "value": { "text_id": "24", "word_num": 5, "핵심동사": "짜주세요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "797", "label": "대화형", "length": 40, "text": "＂물기를 잘 안 짜면 나중에 수분 때문에 메밀비빔국수의 맛이 달라져요.＂", "value": { "text_id": "25", "word_num": 10, "핵심동사": "달라져요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } } ], "dupLabelYn": "Y", "metaData": { "ID": "560166", "FILENAME": "560166.json", "MEDIA_TYPE": "방송대본", "MEDIA_NAME": "알토란", "CATEGORY": "생활건강", "PUBDATE": "20210815", "SENTENCE": "25" } } 