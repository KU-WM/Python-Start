{ "annotation": [ { "charNum": "1", "label": "대화형", "length": 31, "text": "＂우엉콩나물무침의 주인공 우엉 200g을 준비했습니다.＂", "value": { "text_id": "1", "word_num": 5, "핵심동사": "준비했습니다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": " " } }, { "charNum": "33", "label": "대화형", "length": 58, "text": "＂우엉은 껍질을 긁어서 깨끗이 씻어서 반달썰기한 후 식초물에 씻은 후에 찬물에 헹궈서 물기를 빼놨어요.＂", "value": { "text_id": "2", "word_num": 14, "핵심동사": "빼놨어요", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": " " } }, { "charNum": "92", "label": "대화형", "length": 58, "text": "＂우엉콩나물무침의 또 다른 주인공, 콩나물 200g은 대가리를 떼고 깨끗이 씻은 후 물기를 빼놨습니다.＂", "value": { "text_id": "3", "word_num": 13, "핵심동사": "빼놨습니다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": " " } }, { "charNum": "151", "label": "대화형", "length": 43, "text": "＂저는 콩나물 대가리가 아삭아삭 씹히는 느낌도 좋던데, 왜 다 떼어 내세요?＂", "value": { "text_id": "4", "word_num": 11, "핵심동사": "떼어", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "195", "label": "대화형", "length": 24, "text": "＂콩나물 대가리에서 비린내가 많이 나잖아요.", "value": { "text_id": "5", "word_num": 5, "핵심동사": "나잖아요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "221", "label": "대화형", "length": 78, "text": "＂그래서 비린내가 없어지려면 7분 정도는 익혀야 하는데 저는 콩나물은 짧게 조리해서 식감을 살릴 예정이라 콩나물 대가리는 떼서 준비했어요.＂", "value": { "text_id": "6", "word_num": 18, "핵심동사": "준비했어요", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": " " } } ], "dupLabelYn": "Y", "metaData": { "ID": "560225", "FILENAME": "560225.json", "MEDIA_TYPE": "방송대본", "MEDIA_NAME": "알토란", "CATEGORY": "생활건강", "PUBDATE": "20210731", "SENTENCE": "6" } } 