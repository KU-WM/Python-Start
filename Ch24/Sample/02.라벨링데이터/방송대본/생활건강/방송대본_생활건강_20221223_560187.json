{ "annotation": [ { "charNum": "1", "label": "대화형", "length": 29, "text": "＂자, 먼저 새송이버섯장조림부터 만들어 볼 텐데요.＂", "value": { "text_id": "1", "word_num": 6, "핵심동사": "만들어", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "30", "label": "대화형", "length": 23, "text": "＂주인공 새송이버섯 7개를 준비했습니다.＂", "value": { "text_id": "2", "word_num": 4, "핵심동사": "준비했습니다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": " " } }, { "charNum": "53", "label": "대화형", "length": 44, "text": "＂저는 지방을 많이 다니다 보니까 가지각색의 새송이버섯장조림를 먹어 봤는데요.＂", "value": { "text_id": "3", "word_num": 9, "핵심동사": "먹어", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": " " } }, { "charNum": "97", "label": "대화형", "length": 17, "text": "＂자르는 스타일이 다 달라요.＂", "value": { "text_id": "4", "word_num": 4, "핵심동사": "달라요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "114", "label": "대화형", "length": 39, "text": "＂어떤 곳은 세로로 얇게 편 썰고 어떤 곳은 가로로 어슷어슷 썰고요.＂", "value": { "text_id": "5", "word_num": 11, "핵심동사": "썰고요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "153", "label": "대화형", "length": 17, "text": "＂임짱 스타일은 어떤 건가요?＂", "value": { "text_id": "6", "word_num": 4, "핵심동사": "건가요", "확실성": "불확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "170", "label": "대화형", "length": 24, "text": "＂지금부터 제 스타일을 알려 드리겠습니다.＂", "value": { "text_id": "7", "word_num": 5, "핵심동사": "알려", "확실성": "확실", "극성": "긍정", "시제": "미래", "key_word": " " } }, { "charNum": "194", "label": "대화형", "length": 27, "text": "＂일단 새송이버섯의 갓 부분은 잘라내셔야 해요.＂", "value": { "text_id": "8", "word_num": 6, "핵심동사": "잘라내셔야", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "221", "label": "대화형", "length": 21, "text": "＂이 부분은 장조림에 쓰지 않습니다.＂", "value": { "text_id": "9", "word_num": 5, "핵심동사": "쓰지", "확실성": "확실", "극성": "부정", "시제": "현재", "key_word": " " } }, { "charNum": "242", "label": "대화형", "length": 33, "text": "＂그 부분도 맛있는데 왜 장조림에는 쓰지 않으시는 거예요?＂", "value": { "text_id": "10", "word_num": 8, "핵심동사": "쓰지", "확실성": "확실", "극성": "부정", "시제": "현재", "key_word": " " } }, { "charNum": "275", "label": "대화형", "length": 18, "text": "＂버섯의 갓은 금방 잘 상해요.＂", "value": { "text_id": "11", "word_num": 5, "핵심동사": "상해요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "293", "label": "대화형", "length": 60, "text": "＂때문에 바로 먹는 요리의 경우엔 괜찮지만 장조림처럼 저장해두고 먹을 땐 갓 부분을 제거하는 게 좋습니다.＂", "value": { "text_id": "12", "word_num": 15, "핵심동사": "좋습니다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "353", "label": "대화형", "length": 47, "text": "＂자, 그리고 저는 좀 탱글하게 먹기 위해서 몸통을 반으로만 잘라서 준비할 거예요.＂", "value": { "text_id": "13", "word_num": 12, "핵심동사": "준비할", "확실성": "확실", "극성": "긍정", "시제": "미래", "key_word": " " } }, { "charNum": "400", "label": "대화형", "length": 18, "text": "＂임짱, 너무 두껍지 않을까요?＂", "value": { "text_id": "14", "word_num": 4, "핵심동사": "두껍지", "확실성": "불확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "418", "label": "대화형", "length": 53, "text": "＂아까 김**씨가 먹었다는 것처럼 가로로든 세로로든 얇게 편 썰면 먹기 더 좋을 거 같은데요?＂", "value": { "text_id": "15", "word_num": 14, "핵심동사": "좋을", "확실성": "불확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "471", "label": "대화형", "length": 54, "text": "＂너무 얇게 썬 후 장조림을 만들면 수분이 다 빠져나가서 버섯 특유의 향을 즐기실 수가 없어요.＂", "value": { "text_id": "16", "word_num": 15, "핵심동사": "즐기실", "확실성": "확실", "극성": "부정", "시제": "현재", "key_word": " " } }, { "charNum": "525", "label": "대화형", "length": 15, "text": "＂또 식감도 질겅거리고요.＂", "value": { "text_id": "17", "word_num": 3, "핵심동사": "질겅거리고요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "540", "label": "대화형", "length": 30, "text": "＂그래서 이렇게 좀 두껍게 손질해주시는 게 좋습니다.＂", "value": { "text_id": "18", "word_num": 7, "핵심동사": "좋습니다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "570", "label": "대화형", "length": 36, "text": "＂새송이버섯은 기력을 증진시키고 원활한 신진대사를 도와주는데요.＂", "value": { "text_id": "19", "word_num": 6, "핵심동사": "도와주는데요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "606", "label": "대화형", "length": 17, "text": "＂해독 작용 또한 탁월합니다.＂", "value": { "text_id": "20", "word_num": 4, "핵심동사": "탁월합니다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "623", "label": "대화형", "length": 44, "text": "＂이뇨 작용을 통해 부종을 해소하고 베타글루칸이 풍부해 혈액을 해독시켜줍니다.＂", "value": { "text_id": "21", "word_num": 9, "핵심동사": "해독시켜줍니다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "667", "label": "대화형", "length": 36, "text": "＂또 아스파라긴산이 풍부해 잦은 음주로 인한 주독을 풀어주고요.＂", "value": { "text_id": "22", "word_num": 8, "핵심동사": "풀어주고요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "703", "label": "대화형", "length": 55, "text": "＂장내 유산균과 비피더스균의 비율을 증가시켜주기 때문에 대장 건강을 통한 해독 작용도 뛰어납니다.＂", "value": { "text_id": "23", "word_num": 12, "핵심동사": "뛰어납니다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "758", "label": "대화형", "length": 47, "text": "＂한마디로 몸 구석구석을 해독해주는 청소부라고 할 수 있으니 자주 드시면 좋습니다.＂", "value": { "text_id": "24", "word_num": 11, "핵심동사": "좋습니다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "805", "label": "대화형", "length": 25, "text": "＂자, 이렇게 새송이버섯 손질은 끝났습니다.＂", "value": { "text_id": "25", "word_num": 5, "핵심동사": "끝났습니다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": " " } } ], "dupLabelYn": "Y", "metaData": { "ID": "560187", "FILENAME": "560187.json", "MEDIA_TYPE": "방송대본", "MEDIA_NAME": "알토란", "CATEGORY": "생활건강", "PUBDATE": "20210822", "SENTENCE": "25" } } 