{ "annotation": [ { "charNum": "1", "label": "대화형", "length": 34, "text": "＂여름 바다처럼 화끈한 맛, 풍미 작렬 갈치조림 시작합니다.＂", "value": { "text_id": "1", "word_num": 8, "핵심동사": "시작합니다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "36", "label": "대화형", "length": 34, "text": "＂자, 아까와 같은 방법으로 손질한 갈치 2마리가 있습니다.＂", "value": { "text_id": "2", "word_num": 8, "핵심동사": "있습니다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "71", "label": "대화형", "length": 42, "text": "＂조림을 할 땐 구이보다 조금 짧게 토막 내시는 게 부서지지 않고 좋아요.＂", "value": { "text_id": "3", "word_num": 12, "핵심동사": "좋아요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "114", "label": "대화형", "length": 46, "text": "＂그런데 **쌤, 아까 갈치구이 할 땐 밑간을 하셨잖아요, 조림은 어떻게 하나요?＂", "value": { "text_id": "4", "word_num": 11, "핵심동사": "하나요", "확실성": "불확실", "극성": "미정", "시제": "미래", "key_word": " " } }, { "charNum": "161", "label": "대화형", "length": 25, "text": "＂조림도 마찬가지로 염지 및 밑간을 합니다.＂", "value": { "text_id": "5", "word_num": 6, "핵심동사": "합니다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "187", "label": "대화형", "length": 45, "text": "＂손질한 갈치에 국간장 1 큰 술을 뿌리고요, 진간장도 1 큰 술 뿌려 줍니다.＂", "value": { "text_id": "6", "word_num": 13, "핵심동사": "뿌려", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "233", "label": "대화형", "length": 38, "text": "＂구이와 다르게 조림에는 진간장도 뿌리는 이유가 감칠맛 때문인가요?＂", "value": { "text_id": "7", "word_num": 8, "핵심동사": "때문인가요", "확실성": "불확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "272", "label": "대화형", "length": 19, "text": "＂네, 감칠맛이 훨씬 풍부해져요.＂", "value": { "text_id": "8", "word_num": 4, "핵심동사": "풍부해져요", "확실성": "확실", "극성": "긍정", "시제": "미래", "key_word": " " } }, { "charNum": "292", "label": "대화형", "length": 68, "text": "＂다음은 맛술 4 큰 술을 골고루 뿌려서 20분 정도 두는데요, 이렇게 하면 살집이 단단해지고 달달한 풍미가 더해집니다.＂", "value": { "text_id": "9", "word_num": 17, "핵심동사": "더해집니다", "확실성": "확실", "극성": "긍정", "시제": "미래", "key_word": " " } }, { "charNum": "361", "label": "대화형", "length": 29, "text": "＂갈치에 맛이 스며들 동안 조림장을 만들어 볼게요.＂", "value": { "text_id": "10", "word_num": 7, "핵심동사": "만들어", "확실성": "확실", "극성": "긍정", "시제": "미래", "key_word": " " } } ], "dupLabelYn": "Y", "metaData": { "ID": "560051", "FILENAME": "560051.json", "MEDIA_TYPE": "방송대본", "MEDIA_NAME": "알토란", "CATEGORY": "생활건강", "PUBDATE": "20210619", "SENTENCE": "10" } } 