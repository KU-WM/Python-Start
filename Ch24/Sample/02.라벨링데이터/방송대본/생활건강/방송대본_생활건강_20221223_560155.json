{ "annotation": [ { "charNum": "1", "label": "대화형", "length": 29, "text": "＂**쌤, 드디어 마지막 더위를 알리는 말복이에요.＂", "value": { "text_id": "1", "word_num": 6, "핵심동사": "말복이에요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "31", "label": "대화형", "length": 56, "text": "＂초복, 중복 알셰프님 덕분에 든든하게 잘 챙겨 먹고 건강 유지 잘했는데, 말복도 책임져 주셔야죠?＂", "value": { "text_id": "2", "word_num": 14, "핵심동사": "책임져", "확실성": "불확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "88", "label": "대화형", "length": 28, "text": "＂그래서 오늘 알셰프들이 준비한 주제가 있습니다.＂", "value": { "text_id": "3", "word_num": 6, "핵심동사": "있습니다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "117", "label": "대화형", "length": 23, "text": "＂＇365일 매일매일 보양 반찬＇입니다.＂", "value": { "text_id": "4", "word_num": 4, "핵심동사": "＇365일 매일매일 보양 반찬＇입니다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "141", "label": "대화형", "length": 14, "text": "＂어때요, 맘에 드세요?＂", "value": { "text_id": "5", "word_num": 3, "핵심동사": "드세요", "확실성": "불확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "156", "label": "대화형", "length": 13, "text": "＂너무 마음이 듭니다.＂", "value": { "text_id": "6", "word_num": 3, "핵심동사": "듭니다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "170", "label": "대화형", "length": 37, "text": "＂요즘같이 집콕 해야 할 땐 몇 가지 반찬만 있으면 든든하거든요.＂", "value": { "text_id": "7", "word_num": 10, "핵심동사": "든든하거든요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "208", "label": "대화형", "length": 35, "text": "＂거기에 막바지 더위까지 이길 보양 반찬이라니 너무 기대돼요.＂", "value": { "text_id": "8", "word_num": 8, "핵심동사": "기대돼요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "244", "label": "대화형", "length": 36, "text": "＂그럼 이**쌤이 준비한 365일 매일매일 보양 반찬은 뭔가요?＂", "value": { "text_id": "9", "word_num": 8, "핵심동사": "뭔가요", "확실성": "불확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "281", "label": "대화형", "length": 51, "text": "＂제가 오늘 준비한 보양 반찬은 바다의 영양과 감칠맛으로 똘똘 뭉친 식재료로 만들 건데요.＂", "value": { "text_id": "10", "word_num": 13, "핵심동사": "만들", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "333", "label": "대화형", "length": 34, "text": "＂바로 남녀노소 누구나 좋아하는 황태채와 김을 준비했습니다.＂", "value": { "text_id": "11", "word_num": 7, "핵심동사": "준비했습니다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": " " } }, { "charNum": "368", "label": "대화형", "length": 97, "text": "＂매콤 달콤한 양념에 황태채가 풍덩, 비법 재료를 더해 더 고소한 황태채조림, 그리고 씹으면 씹을수록 더 맛있는 마성의 맛 김무침 비법까지 감칠맛의 끝을 알려 드리겠습니다.＂", "value": { "text_id": "12", "word_num": 24, "핵심동사": "알려", "확실성": "확실", "극성": "긍정", "시제": "미래", "key_word": " " } } ], "dupLabelYn": "Y", "metaData": { "ID": "560155", "FILENAME": "560155.json", "MEDIA_TYPE": "방송대본", "MEDIA_NAME": "알토란", "CATEGORY": "생활건강", "PUBDATE": "20210808", "SENTENCE": "12" } } 