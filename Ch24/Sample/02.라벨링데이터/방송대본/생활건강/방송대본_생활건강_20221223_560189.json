{ "annotation": [ { "charNum": "1", "label": "대화형", "length": 16, "text": "＂자, 조림장이 팔팔 끓죠?＂", "value": { "text_id": "1", "word_num": 4, "핵심동사": "끓죠", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "18", "label": "대화형", "length": 23, "text": "＂이때 손질한 새송이버섯을 넣어 주세요.＂", "value": { "text_id": "2", "word_num": 5, "핵심동사": "넣어", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "42", "label": "대화형", "length": 42, "text": "＂임짱, **씨한테 하수라고 해놓고 임짱도 조림장에 버섯 넣고 조리잖아요.＂", "value": { "text_id": "3", "word_num": 9, "핵심동사": "조리잖아요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "85", "label": "대화형", "length": 14, "text": "＂뭐가 다르다는 거예요?＂", "value": { "text_id": "4", "word_num": 3, "핵심동사": "다르다는", "확실성": "불확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "100", "label": "대화형", "length": 18, "text": "＂시작은 같지만 끝이 다릅니다.＂", "value": { "text_id": "5", "word_num": 4, "핵심동사": "다릅니다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "119", "label": "대화형", "length": 44, "text": "＂자, 여기서 쫄깃쫄깃, 단짠단짠, 새송이버섯장조림 맛의 한 수를 공개합니다.＂", "value": { "text_id": "6", "word_num": 9, "핵심동사": "공개합니다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "164", "label": "대화형", "length": 35, "text": "＂저는 새송이버섯을 조림장에 2분 정도 데친 후에 건져내고요.＂", "value": { "text_id": "7", "word_num": 8, "핵심동사": "건져내고요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "200", "label": "대화형", "length": 22, "text": "＂그다음 조림장을 식혀서 부을 거예요.＂", "value": { "text_id": "8", "word_num": 5, "핵심동사": "부을", "확실성": "확실", "극성": "긍정", "시제": "미래", "key_word": " " } }, { "charNum": "223", "label": "대화형", "length": 17, "text": "＂그렇게 하는 이유가 있나요?＂", "value": { "text_id": "9", "word_num": 4, "핵심동사": "있나요", "확실성": "불확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "241", "label": "대화형", "length": 33, "text": "＂버섯은 양념 흡수를 잘하고 그만큼 수분을 잘 배출해내요.＂", "value": { "text_id": "10", "word_num": 8, "핵심동사": "배출해내요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "275", "label": "대화형", "length": 36, "text": "＂그런 버섯을 뜨거운 조림장에 계속 담가 두면 어떻게 되겠어요?＂", "value": { "text_id": "11", "word_num": 9, "핵심동사": "되겠어요", "확실성": "불확실", "극성": "긍정", "시제": "미래", "key_word": " " } }, { "charNum": "312", "label": "대화형", "length": 33, "text": "＂맞아요, **씨가 만든 딱 그 버섯장조림이 되는 거예요.＂", "value": { "text_id": "12", "word_num": 8, "핵심동사": "되는", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "346", "label": "대화형", "length": 68, "text": "＂때문에 버섯은 살짝 데쳐 놓고, 조림장을 식혀서 넣으면 버섯의 식감이 쫄깃·탱탱할 뿐 아니라 간도 적절하게 배는 거죠.＂", "value": { "text_id": "13", "word_num": 17, "핵심동사": "배는", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "415", "label": "대화형", "length": 22, "text": "＂자, 말하는 사이 2분이 지났는데요.＂", "value": { "text_id": "14", "word_num": 5, "핵심동사": "지났는데요", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": " " } }, { "charNum": "438", "label": "대화형", "length": 27, "text": "＂새송이버섯을 건져서 밀폐 용기에 담아 주세요.＂", "value": { "text_id": "15", "word_num": 6, "핵심동사": "담아", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } } ], "dupLabelYn": "Y", "metaData": { "ID": "560189", "FILENAME": "560189.json", "MEDIA_TYPE": "방송대본", "MEDIA_NAME": "알토란", "CATEGORY": "생활건강", "PUBDATE": "20210822", "SENTENCE": "15" } } 