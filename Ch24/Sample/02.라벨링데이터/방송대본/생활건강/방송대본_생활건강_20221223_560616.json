{ "annotation": [ { "charNum": "1", "label": "대화형", "length": 33, "text": "＂간혹 잘못 만든 청양고추피클은 물컹물컹할 때가 있거든요.＂", "value": { "text_id": "1", "word_num": 7, "핵심동사": "있거든요", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": " " } }, { "charNum": "35", "label": "대화형", "length": 32, "text": "＂피클에 아삭함이 없다면 그건 망한 거나 마찬가지잖아요.＂", "value": { "text_id": "2", "word_num": 7, "핵심동사": "마찬가지잖아요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "68", "label": "대화형", "length": 26, "text": "＂걱정 마세요, 여러분껜 저 임짱이 있잖아요.＂", "value": { "text_id": "3", "word_num": 6, "핵심동사": "있잖아요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "95", "label": "대화형", "length": 16, "text": "＂자, 10분간 끓였습니다.＂", "value": { "text_id": "4", "word_num": 3, "핵심동사": "끓였습니다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": " " } }, { "charNum": "112", "label": "대화형", "length": 24, "text": "＂이제 불을 끄고 딱 5분만 식혀 주세요.＂", "value": { "text_id": "5", "word_num": 7, "핵심동사": "식혀", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } } ], "dupLabelYn": "Y", "metaData": { "ID": "560616", "FILENAME": "560616.json", "MEDIA_TYPE": "방송대본", "MEDIA_NAME": "알토란", "CATEGORY": "생활건강", "PUBDATE": "20200524", "SENTENCE": "5" } } 