{ "annotation": [ { "charNum": "1", "label": "대화형", "length": 18, "text": "＂**쌤, 저 좀 살려 주세요.＂", "value": { "text_id": "1", "word_num": 6, "핵심동사": "살려", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "21", "label": "대화형", "length": 23, "text": "＂요즘 매일매일 숙제하느라 너무 바빠요.＂", "value": { "text_id": "2", "word_num": 5, "핵심동사": "바빠요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "45", "label": "대화형", "length": 40, "text": "＂이 숙제는 하루를 거를 수도 없고, 몰아서 하자니 너무 힘에 부쳐요.＂", "value": { "text_id": "3", "word_num": 11, "핵심동사": "부쳐요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "86", "label": "대화형", "length": 24, "text": "＂** 씨, 도대체 어떤 숙제길래 그래요?＂", "value": { "text_id": "4", "word_num": 6, "핵심동사": "그래요", "확실성": "불확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "111", "label": "대화형", "length": 16, "text": "＂** 씨도 공감할 거예요.＂", "value": { "text_id": "5", "word_num": 5, "핵심동사": "공감할", "확실성": "확실", "극성": "긍정", "시제": "미래", "key_word": " " } }, { "charNum": "129", "label": "대화형", "length": 31, "text": "＂주부들의 영원한 숙제, 매 끼니 어떤 반찬을 만들까.＂", "value": { "text_id": "6", "word_num": 8, "핵심동사": "만들까", "확실성": "불확실", "극성": "긍정", "시제": "미래", "key_word": " " } }, { "charNum": "161", "label": "대화형", "length": 25, "text": "＂이건 정답이 없어서 더 어려운 것 같아요.＂", "value": { "text_id": "7", "word_num": 7, "핵심동사": "어려운", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "187", "label": "대화형", "length": 20, "text": "＂**쌤~ 제 숙제 좀 도와주세요.＂", "value": { "text_id": "8", "word_num": 5, "핵심동사": "도와주세요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "208", "label": "대화형", "length": 39, "text": "＂** 씨, ** 씨, 그리고 전국의 주부님들 모두 걱정하지 마세요.＂", "value": { "text_id": "9", "word_num": 10, "핵심동사": "걱정하지", "확실성": "확실", "극성": "부정", "시제": "현재", "key_word": " " } }, { "charNum": "248", "label": "대화형", "length": 40, "text": "＂여러분들이 1년 치 숙제 다 끝내 드릴 초간단 요리를 알려 드릴게요.＂", "value": { "text_id": "10", "word_num": 11, "핵심동사": "알려", "확실성": "확실", "극성": "긍정", "시제": "미래", "key_word": " " } } ], "dupLabelYn": "Y", "metaData": { "ID": "560172", "FILENAME": "560172.json", "MEDIA_TYPE": "방송대본", "MEDIA_NAME": "알토란", "CATEGORY": "생활건강", "PUBDATE": "20210815", "SENTENCE": "10" } } 