{ "annotation": [ { "charNum": "1", "label": "대화형", "length": 28, "text": "＂자, 이제 3분 정도 지났는데요 다시 맛보세요.＂", "value": { "text_id": "1", "word_num": 7, "핵심동사": "맛보세요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "30", "label": "대화형", "length": 17, "text": "＂왜요, 아까랑 맛이 달라요?＂", "value": { "text_id": "2", "word_num": 4, "핵심동사": "달라요", "확실성": "불확실", "극성": "미정", "시제": "현재", "key_word": " " } }, { "charNum": "48", "label": "대화형", "length": 52, "text": "＂네, 3분만 그냥 뒀을 뿐인데 겉바속촉이 더 잘 느껴지고 식감은 탱글탱글하니 더 맛있어요.＂", "value": { "text_id": "3", "word_num": 13, "핵심동사": "맛있어요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "101", "label": "대화형", "length": 30, "text": "＂진짜 그만 가만히 뒀는데 이렇게 야들야들해진다고요?＂", "value": { "text_id": "4", "word_num": 6, "핵심동사": "야들야들해진다고요", "확실성": "불확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "132", "label": "대화형", "length": 29, "text": "＂임고기, 혹시 저 몰래 바꿔치기 한 거 아니에요?＂", "value": { "text_id": "5", "word_num": 9, "핵심동사": "아니에요", "확실성": "불확실", "극성": "미정", "시제": "과거", "key_word": " " } }, { "charNum": "163", "label": "대화형", "length": 35, "text": "＂** 씨 여기 보는 눈이 몇 갠데 제가 바꿔치기를 하겠어요.＂", "value": { "text_id": "6", "word_num": 10, "핵심동사": "하겠어요", "확실성": "확실", "극성": "부정", "시제": "현재", "key_word": " " } }, { "charNum": "199", "label": "대화형", "length": 25, "text": "＂레스팅 과정을 거쳐서 더 맛있어진 겁니다.＂", "value": { "text_id": "7", "word_num": 6, "핵심동사": "맛있어진", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "225", "label": "대화형", "length": 53, "text": "＂두툼한 삼겹살은 칼집을 내서 굽고 다 구운 후 2분 정도 방치한 후에 먹기, 기억해야겠네요.＂", "value": { "text_id": "8", "word_num": 14, "핵심동사": "기억해야겠네요", "확실성": "확실", "극성": "긍정", "시제": "미래", "key_word": " " } } ], "dupLabelYn": "Y", "metaData": { "ID": "560084", "FILENAME": "560084.json", "MEDIA_TYPE": "방송대본", "MEDIA_NAME": "알토란", "CATEGORY": "생활건강", "PUBDATE": "20210718", "SENTENCE": "8" } } 