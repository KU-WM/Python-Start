{ "annotation": [ { "charNum": "1", "label": "대화형", "length": 22, "text": "＂자, 그럼 이제 낙지를 볶아 볼게요.＂", "value": { "text_id": "1", "word_num": 6, "핵심동사": "볶아", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "23", "label": "대화형", "length": 20, "text": "＂달군 팬에 기름을 약간 두르고요.＂", "value": { "text_id": "2", "word_num": 5, "핵심동사": "두르고요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "43", "label": "대화형", "length": 20, "text": "＂양념에 무친 낙지를 넣어 주세요.＂", "value": { "text_id": "3", "word_num": 5, "핵심동사": "넣어", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "63", "label": "대화형", "length": 26, "text": "＂부재료로는 손질한 대파와 양배추를 넣을게요.＂", "value": { "text_id": "4", "word_num": 5, "핵심동사": "넣을게요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "89", "label": "대화형", "length": 26, "text": "＂임토끼 대파랑 양배추에서 수분이 나오잖아요.＂", "value": { "text_id": "5", "word_num": 5, "핵심동사": "나오잖아요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "115", "label": "대화형", "length": 22, "text": "＂그럼 양념이 싱거워지는 거 아니에요?＂", "value": { "text_id": "6", "word_num": 5, "핵심동사": "싱거워지는", "확실성": "불확실", "극성": "미정", "시제": "미래", "key_word": " " } }, { "charNum": "137", "label": "대화형", "length": 11, "text": "＂네, 아닙니다.＂ ", "value": { "text_id": "7", "word_num": 3, "핵심동사": "아닙니다", "확실성": "확실", "극성": "부정", "시제": "현재", "key_word": " " } }, { "charNum": "148", "label": "대화형", "length": 28, "text": "＂그냥 이대로 볶으면 팬에 양념이 다 눌어붙어요.＂", "value": { "text_id": "8", "word_num": 7, "핵심동사": "눌어붙어요", "확실성": "확실", "극성": "긍정", "시제": "미래", "key_word": " " } }, { "charNum": "176", "label": "대화형", "length": 35, "text": "＂그런데 이 채소에서 수분이 나와서 팬에 눋지 않도록 합니다.＂", "value": { "text_id": "9", "word_num": 9, "핵심동사": "눋지", "확실성": "확실", "극성": "부정", "시제": "현재", "key_word": " " } }, { "charNum": "211", "label": "대화형", "length": 28, "text": "＂자, 여기에 풍미를 더해줄 다진 마늘을 넣고요.＂", "value": { "text_id": "10", "word_num": 7, "핵심동사": "넣고요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "239", "label": "대화형", "length": 27, "text": "＂간을 맞출 멸치액젓 * 큰 술을 넣어 주세요.＂", "value": { "text_id": "11", "word_num": 8, "핵심동사": "넣어", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "266", "label": "대화형", "length": 26, "text": "＂볶으면 볶을수록 맛있는 향이 장난 아니네요.＂", "value": { "text_id": "12", "word_num": 6, "핵심동사": "아니네요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "292", "label": "대화형", "length": 21, "text": "＂그리고 꾸덕꾸덕한 정도도 딱이에요.＂", "value": { "text_id": "13", "word_num": 4, "핵심동사": "딱이에요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "313", "label": "대화형", "length": 49, "text": "＂이 정도 볶아졌으면 마지막으로 오독오독한 식감을 더해주는 재료를 하나 더 넣을 거예요.", "value": { "text_id": "14", "word_num": 12, "핵심동사": "넣을", "확실성": "확실", "극성": "긍정", "시제": "미래", "key_word": " " } }, { "charNum": "362", "label": "대화형", "length": 11, "text": "＂바로 땅콩이에요.＂", "value": { "text_id": "15", "word_num": 2, "핵심동사": "땅콩이에요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "373", "label": "대화형", "length": 23, "text": "＂이 땅콩을 먹으면 식감이 더 좋아져요.＂", "value": { "text_id": "16", "word_num": 6, "핵심동사": "좋아져요", "확실성": "불확실", "극성": "긍정", "시제": "미래", "key_word": " " } }, { "charNum": "396", "label": "대화형", "length": 30, "text": "＂낙지는 쫄깃, 땅콩은 오독오독해서 정말 별미입니다.＂", "value": { "text_id": "17", "word_num": 6, "핵심동사": "별미입니다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "426", "label": "대화형", "length": 32, "text": "＂이 그럼 땅콩 분태 50g을 넣고 골고루 섞어 주세요.＂", "value": { "text_id": "18", "word_num": 9, "핵심동사": "섞어", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "458", "label": "대화형", "length": 28, "text": "＂땅콩은 취향에 따로 넣는 양을 조절하시면 돼요.＂", "value": { "text_id": "19", "word_num": 7, "핵심동사": "조절하시면", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } } ], "dupLabelYn": "Y", "metaData": { "ID": "560042", "FILENAME": "560042.json", "MEDIA_TYPE": "방송대본", "MEDIA_NAME": "알토란", "CATEGORY": "생활건강", "PUBDATE": "20210704", "SENTENCE": "19" } } 