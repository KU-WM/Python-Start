{ "annotation": [ { "charNum": "1", "label": "대화형", "length": 19, "text": "＂자, 총 1시간 끓인 닭인데요.＂", "value": { "text_id": "1", "word_num": 5, "핵심동사": "닭인데요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "21", "label": "대화형", "length": 8, "text": "＂향이 좋죠?＂", "value": { "text_id": "2", "word_num": 2, "핵심동사": "좋죠", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "30", "label": "대화형", "length": 21, "text": "＂자, 이제 뚝배기에 옮겨 담을게요.＂", "value": { "text_id": "3", "word_num": 5, "핵심동사": "담을게요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "52", "label": "대화형", "length": 31, "text": "＂삶은 닭 1마리를 넣고 국물을 넉넉하게 부어 주세요.＂", "value": { "text_id": "4", "word_num": 8, "핵심동사": "부어", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "84", "label": "대화형", "length": 32, "text": "＂고명으로 송송 썬 대파와 다진 청양고추를 올려 줍니다.＂", "value": { "text_id": "5", "word_num": 8, "핵심동사": "올려", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "117", "label": "대화형", "length": 30, "text": "＂혹시 집안에 대대로 내려오는 게 매운 삼계탕이에요?＂", "value": { "text_id": "6", "word_num": 7, "핵심동사": "삼계탕이에요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "148", "label": "대화형", "length": 30, "text": "＂청양고추가 매운맛을 내는 역할만 하는 게 아니에요.＂", "value": { "text_id": "7", "word_num": 7, "핵심동사": "하는", "확실성": "확실", "극성": "부정", "시제": "현재", "key_word": " " } }, { "charNum": "179", "label": "대화형", "length": 44, "text": "＂삼계탕에 청양고추를 소량 넣으면 맛이 훨씬 더 개운하고 깔끔하게 마무리돼요.＂", "value": { "text_id": "8", "word_num": 10, "핵심동사": "마무리돼요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "224", "label": "대화형", "length": 21, "text": "＂또 혹시 모를 잡내도 잡아 줍니다.＂", "value": { "text_id": "9", "word_num": 6, "핵심동사": "잡아", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } } ], "dupLabelYn": "Y", "metaData": { "ID": "560036", "FILENAME": "560036.json", "MEDIA_TYPE": "방송대본", "MEDIA_NAME": "알토란", "CATEGORY": "생활건강", "PUBDATE": "20210704", "SENTENCE": "9" } } 