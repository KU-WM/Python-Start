{ "annotation": [ { "charNum": "1", "label": "대화형", "length": 11, "text": "＂바로 달걀입니다.＂", "value": { "text_id": "1", "word_num": 2, "핵심동사": "달걀입니다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "12", "label": "대화형", "length": 20, "text": "＂저는 촉촉한 수란을 올릴 거예요.＂", "value": { "text_id": "2", "word_num": 5, "핵심동사": "올릴", "확실성": "확실", "극성": "긍정", "시제": "미래", "key_word": " " } }, { "charNum": "32", "label": "대화형", "length": 45, "text": "＂임짱, 수란 만들려면 물 끓여야 되고 자칫하면 터지고, 만들기 쉽지 않거든요.＂", "value": { "text_id": "3", "word_num": 11, "핵심동사": "쉽지", "확실성": "확실", "극성": "부정", "시제": "미래", "key_word": " " } }, { "charNum": "77", "label": "대화형", "length": 11, "text": "＂제가 누구라고요?＂", "value": { "text_id": "4", "word_num": 2, "핵심동사": "누구라고요", "확실성": "불확실", "극성": "미정", "시제": "현재", "key_word": " " } }, { "charNum": "88", "label": "대화형", "length": 22, "text": "＂수란 쉽게 만드는 법 알려 드릴게요.＂", "value": { "text_id": "5", "word_num": 6, "핵심동사": "알려", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "110", "label": "대화형", "length": 21, "text": "＂자, 달군 팬에 식용유를 두르고요.＂", "value": { "text_id": "6", "word_num": 5, "핵심동사": "두르고요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "131", "label": "대화형", "length": 15, "text": "＂물 약간을 넣어 줍니다.＂", "value": { "text_id": "7", "word_num": 4, "핵심동사": "넣어", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "146", "label": "대화형", "length": 17, "text": "＂그리고 달걀을 넣어 주세요.＂", "value": { "text_id": "8", "word_num": 4, "핵심동사": "넣어", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "163", "label": "대화형", "length": 27, "text": "＂그리고 밑면이 익을 때쯤 뚜껑을 덮어 주세요.＂", "value": { "text_id": "9", "word_num": 7, "핵심동사": "덮어", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "190", "label": "대화형", "length": 20, "text": "＂그러면 수란이 완성된다는 건가요?＂", "value": { "text_id": "10", "word_num": 4, "핵심동사": "완성된다는", "확실성": "불확실", "극성": "미정", "시제": "미래", "key_word": " " } }, { "charNum": "210", "label": "대화형", "length": 16, "text": "＂네. 뚜껑을 열어 볼게요.＂", "value": { "text_id": "11", "word_num": 4, "핵심동사": "열어", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "226", "label": "대화형", "length": 10, "text": "＂쉽고 간단하죠?＂", "value": { "text_id": "12", "word_num": 2, "핵심동사": "간단하죠", "확실성": "확실", "극성": "미정", "시제": "현재", "key_word": " " } }, { "charNum": "236", "label": "대화형", "length": 27, "text": "＂이렇게 완성된 수란을 감자채전에 올려 주세요.＂", "value": { "text_id": "13", "word_num": 6, "핵심동사": "올려", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } } ], "dupLabelYn": "Y", "metaData": { "ID": "560063", "FILENAME": "560063.json", "MEDIA_TYPE": "방송대본", "MEDIA_NAME": "알토란", "CATEGORY": "생활건강", "PUBDATE": "20210619", "SENTENCE": "13" } } 