{ "annotation": [ { "charNum": "1", "label": "대화형", "length": 51, "text": "＂먼저 토마토냉수프에 들어갈 양파 100g과 토마토 반 개를 일정하게 채 썰어 준비했고요.＂", "value": { "text_id": "1", "word_num": 12, "핵심동사": "준비했고요", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": " " } }, { "charNum": "53", "label": "대화형", "length": 18, "text": "＂샐러리와 피망을 준비했는데요.＂", "value": { "text_id": "2", "word_num": 3, "핵심동사": "준비했는데요", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": " " } }, { "charNum": "72", "label": "대화형", "length": 11, "text": "＂손질법이 달라요.＂", "value": { "text_id": "3", "word_num": 2, "핵심동사": "달라요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "84", "label": "대화형", "length": 20, "text": "＂왜 샐러리랑 피망만 다른 거예요?＂", "value": { "text_id": "4", "word_num": 5, "핵심동사": "다른", "확실성": "불확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "105", "label": "대화형", "length": 34, "text": "＂샐러리와 피망 껍질은 섬유질이 있어 거친 식감이 나거든요.＂", "value": { "text_id": "5", "word_num": 8, "핵심동사": "나거든요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "140", "label": "대화형", "length": 29, "text": "＂그래서 겉껍질을 살짝 제거해서 똑같이 채 썰게요.＂", "value": { "text_id": "6", "word_num": 7, "핵심동사": "썰게요", "확실성": "확실", "극성": "긍정", "시제": "미래", "key_word": " " } }, { "charNum": "170", "label": "대화형", "length": 38, "text": "＂이렇게 하면 부드러운 수프의 맛을 한 층 더 올려 줄 수 있고요.＂", "value": { "text_id": "7", "word_num": 12, "핵심동사": "올려", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "209", "label": "대화형", "length": 15, "text": "＂체내 흡수까지 도와줘요.＂", "value": { "text_id": "8", "word_num": 3, "핵심동사": "도와줘요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } } ], "dupLabelYn": "Y", "metaData": { "ID": "560152", "FILENAME": "560152.json", "MEDIA_TYPE": "방송대본", "MEDIA_NAME": "알토란", "CATEGORY": "생활건강", "PUBDATE": "20210808", "SENTENCE": "8" } } 