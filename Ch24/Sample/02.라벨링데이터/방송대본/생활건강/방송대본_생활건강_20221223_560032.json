{ "annotation": [ { "charNum": "1", "label": "대화형", "length": 53, "text": "＂자, 삼계탕의 주인공 닭 2마리는 7호짜리로, 목과 꼬리 부분의 지방 덩어리를 제거해놨어요.＂", "value": { "text_id": "1", "word_num": 12, "핵심동사": "제거해놨어요", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": " " } }, { "charNum": "55", "label": "대화형", "length": 34, "text": "＂닭은 아무리 손질된 걸 사도 헹구면 계속 불순물이 나와요.＂", "value": { "text_id": "2", "word_num": 9, "핵심동사": "나와요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "90", "label": "대화형", "length": 23, "text": "＂깨끗하게 손질하려면 어떻게 해야 돼요?＂", "value": { "text_id": "3", "word_num": 5, "핵심동사": "해야", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "114", "label": "대화형", "length": 22, "text": "＂닭의 불순물을 제거하는 방법이 있죠.＂", "value": { "text_id": "4", "word_num": 5, "핵심동사": "있죠", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "137", "label": "대화형", "length": 21, "text": "＂바로 소금으로 문질러 주는 겁니다.＂", "value": { "text_id": "5", "word_num": 5, "핵심동사": "문질러", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "159", "label": "대화형", "length": 42, "text": "＂해산물 손질할 땐 소금으로 하는 건 많이 봤는데 닭도 소금으로 문질러요?＂", "value": { "text_id": "6", "word_num": 11, "핵심동사": "문질러요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "202", "label": "대화형", "length": 26, "text": "＂이 소금이 불순물을 흡착하는 성질이 있어요.＂", "value": { "text_id": "7", "word_num": 6, "핵심동사": "있어요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "229", "label": "대화형", "length": 35, "text": "＂그래서 닭에 붙어 있는 지저분한 것들이 다 씻겨 내려갑니다.＂", "value": { "text_id": "8", "word_num": 9, "핵심동사": "씻겨", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "265", "label": "대화형", "length": 28, "text": "＂자, 이렇게 굵은 소금으로 닭을 문질러 주세요.＂", "value": { "text_id": "9", "word_num": 7, "핵심동사": "문질러", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "294", "label": "대화형", "length": 61, "text": "＂닭 속에도 내장 찌꺼기나 핏기가 있기 때문에 속까지 잘 씻은 후에 깨끗한 물에 2~3번 정도 헹궈 주세요.＂", "value": { "text_id": "10", "word_num": 17, "핵심동사": "헹궈", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } } ], "dupLabelYn": "Y", "metaData": { "ID": "560032", "FILENAME": "560032.json", "MEDIA_TYPE": "방송대본", "MEDIA_NAME": "알토란", "CATEGORY": "생활건강", "PUBDATE": "20210704", "SENTENCE": "10" } } 