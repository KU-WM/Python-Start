{ "annotation": [ { "charNum": "1", "label": "대화형", "length": 34, "text": "＂자, 고구마순볶음을 만들 고구마순 600g을 준비했습니다.＂", "value": { "text_id": "1", "word_num": 6, "핵심동사": "준비했습니다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": " " } }, { "charNum": "36", "label": "대화형", "length": 16, "text": "＂아직 껍질 벗기기 전이죠?＂", "value": { "text_id": "2", "word_num": 4, "핵심동사": "벗기기", "확실성": "확실", "극성": "부정", "시제": "현재", "key_word": " " } }, { "charNum": "53", "label": "대화형", "length": 37, "text": "＂고구마순볶음 할 때는 절일 수도 없고, 껍질을 어떻게 벗기나요?＂", "value": { "text_id": "3", "word_num": 9, "핵심동사": "벗기나요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "91", "label": "대화형", "length": 36, "text": "＂고구마순볶음을 할 땐 양념이 잘 스며들라고 한 번 데치는데요.＂", "value": { "text_id": "4", "word_num": 9, "핵심동사": "데치는데요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "128", "label": "대화형", "length": 22, "text": "＂껍질도 데친 후에 벗기면 수월합니다.＂", "value": { "text_id": "5", "word_num": 5, "핵심동사": "수월합니다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "151", "label": "대화형", "length": 17, "text": "＂냄비에 물이 끓고 있는데요.＂", "value": { "text_id": "6", "word_num": 4, "핵심동사": "끓고", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "169", "label": "대화형", "length": 13, "text": "＂소금 약간을 넣고요.＂", "value": { "text_id": "7", "word_num": 3, "핵심동사": "넣고요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "183", "label": "대화형", "length": 24, "text": "＂고구마순을 넣고 3~5분간 데쳐 주세요.＂", "value": { "text_id": "8", "word_num": 5, "핵심동사": "데쳐", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "208", "label": "대화형", "length": 35, "text": "＂다 데쳐진 고구마순은 바로 찬물에 담가 잔열을 식혀 주세요.＂", "value": { "text_id": "9", "word_num": 9, "핵심동사": "식혀", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "244", "label": "대화형", "length": 21, "text": "＂그리고 껍질을 한 번 벗겨 볼게요.＂", "value": { "text_id": "10", "word_num": 6, "핵심동사": "벗겨", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "266", "label": "대화형", "length": 9, "text": "＂잘 벗겨지죠?＂", "value": { "text_id": "11", "word_num": 2, "핵심동사": "벗겨지죠", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "276", "label": "대화형", "length": 88, "text": "＂정말 생 고구마순 껍질을 손으로 벗기려면 잘 벗겨지지도 않고 손도 새까매지는데 김치 할 땐 소금물에 절이고, 볶음 할 땐 데치고 벗기니까 진짜 수월하네요.＂", "value": { "text_id": "12", "word_num": 23, "핵심동사": "수월하네요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "365", "label": "대화형", "length": 12, "text": "＂꼭 기억해야겠어요.＂", "value": { "text_id": "13", "word_num": 2, "핵심동사": "기억해야겠어요", "확실성": "확실", "극성": "긍정", "시제": "미래", "key_word": " " } }, { "charNum": "378", "label": "대화형", "length": 25, "text": "＂자, 이렇게 껍질을 다 벗긴 고구마순은요.＂", "value": { "text_id": "14", "word_num": 6, "핵심동사": "벗긴", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "404", "label": "대화형", "length": 19, "text": "＂먹기 좋은 크기로 잘라 주세요.＂", "value": { "text_id": "15", "word_num": 5, "핵심동사": "잘라", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } } ], "dupLabelYn": "Y", "metaData": { "ID": "560014", "FILENAME": "560014.json", "MEDIA_TYPE": "방송대본", "MEDIA_NAME": "알토란", "CATEGORY": "생활건강", "PUBDATE": "20210627", "SENTENCE": "15" } } 