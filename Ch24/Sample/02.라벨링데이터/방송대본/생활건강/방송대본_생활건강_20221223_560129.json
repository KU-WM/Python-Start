{ "annotation": [ { "charNum": "1", "label": "대화형", "length": 46, "text": "＂본격적으로 양념을 하기 전에 사태족발을 향신 채소에 먼저 볶아서 향을 입힐게요.＂", "value": { "text_id": "1", "word_num": 11, "핵심동사": "입힐게요", "확실성": "확실", "극성": "긍정", "시제": "미래", "key_word": " " } }, { "charNum": "47", "label": "대화형", "length": 25, "text": "＂먼저, 팬에 식용유를 3 큰 술 두릅니다.＂", "value": { "text_id": "2", "word_num": 7, "핵심동사": "두릅니다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "72", "label": "대화형", "length": 20, "text": "＂다진 마늘 2 큰 술을 넣을게요.＂", "value": { "text_id": "3", "word_num": 6, "핵심동사": "넣을게요", "확실성": "확실", "극성": "긍정", "시제": "미래", "key_word": " " } }, { "charNum": "92", "label": "대화형", "length": 20, "text": "＂다진 양파 반 컵도 넣어 줍니다.＂", "value": { "text_id": "4", "word_num": 6, "핵심동사": "넣어", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "112", "label": "대화형", "length": 32, "text": "＂매콤함을 더할 다진 청양고추 3 큰 술을 넣어 주세요.＂", "value": { "text_id": "5", "word_num": 9, "핵심동사": "넣어", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "144", "label": "대화형", "length": 17, "text": "＂손질한 사태족발도 넣을게요.＂", "value": { "text_id": "6", "word_num": 3, "핵심동사": "넣을게요", "확실성": "확실", "극성": "긍정", "시제": "미래", "key_word": " " } }, { "charNum": "161", "label": "대화형", "length": 26, "text": "＂마늘, 양파, 청양고추 넣으면 말 다 했죠.＂", "value": { "text_id": "7", "word_num": 7, "핵심동사": "했죠", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": " " } }, { "charNum": "187", "label": "대화형", "length": 38, "text": "＂사태족발에 감칠맛까지 쏙쏙 배니까 사시사철 별미로 즐기기 딱이죠.＂", "value": { "text_id": "8", "word_num": 8, "핵심동사": "딱이죠", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "225", "label": "대화형", "length": 21, "text": "＂그럼 이대로 얼마나 볶으면 되나요?＂", "value": { "text_id": "9", "word_num": 5, "핵심동사": "되나요", "확실성": "불확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "246", "label": "대화형", "length": 21, "text": "＂이대로 한 7분 정도 볶아 주세요.＂", "value": { "text_id": "10", "word_num": 6, "핵심동사": "볶아", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "267", "label": "대화형", "length": 43, "text": "＂그래야 마늘의 감칠맛, 양파의 단맛, 청양고추의 매콤함이 싹 배어들거든요.＂", "value": { "text_id": "11", "word_num": 9, "핵심동사": "배어들거든요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } } ], "dupLabelYn": "Y", "metaData": { "ID": "560129", "FILENAME": "560129.json", "MEDIA_TYPE": "방송대본", "MEDIA_NAME": "알토란", "CATEGORY": "생활건강", "PUBDATE": "20210801", "SENTENCE": "11" } } 