{ "annotation": [ { "charNum": "1", "label": "대화형", "length": 22, "text": "＂먼저 황태채조림을 만들어 볼 텐데요.＂", "value": { "text_id": "1", "word_num": 5, "핵심동사": "만들어", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "24", "label": "대화형", "length": 29, "text": "＂주인공 황태채 3컵을 이렇게 잘게 찢어 놓았어요.＂", "value": { "text_id": "2", "word_num": 7, "핵심동사": "찢어", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": " " } }, { "charNum": "54", "label": "대화형", "length": 55, "text": "＂그런데 쌤, 저는 황태채를 잘 안 먹게 되는 게 퍼석퍼석한 식감과 특유의 비린내가 별로더라고요.＂", "value": { "text_id": "3", "word_num": 14, "핵심동사": "별로더라고요", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": " " } }, { "charNum": "110", "label": "대화형", "length": 35, "text": "＂저 같은 사람도 황태채를 잘 먹을 수 있는 방법이 없을까요?＂", "value": { "text_id": "4", "word_num": 10, "핵심동사": "없을까요", "확실성": "불확실", "극성": "긍정", "시제": "미래", "key_word": " " } }, { "charNum": "146", "label": "대화형", "length": 16, "text": "＂제가 집밥의 여왕이잖아요.＂", "value": { "text_id": "5", "word_num": 3, "핵심동사": "여왕이잖아요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "163", "label": "대화형", "length": 28, "text": "＂만인에게 맛있는 음식을 만드는 게 제 일이에요.＂", "value": { "text_id": "6", "word_num": 7, "핵심동사": "일이에요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "192", "label": "대화형", "length": 31, "text": "＂황태채를 비린내 없이 촉촉하게 먹는 비법이 있는데요.＂", "value": { "text_id": "7", "word_num": 7, "핵심동사": "있는데요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "224", "label": "대화형", "length": 15, "text": "＂물에 황태를 씻는다고요?＂", "value": { "text_id": "8", "word_num": 3, "핵심동사": "씻는다고요", "확실성": "불확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "240", "label": "대화형", "length": 35, "text": "＂그렇게 하면 황태가 퍼석퍼석해지고 맛있는 맛 다 빠져나가요.＂", "value": { "text_id": "9", "word_num": 8, "핵심동사": "빠져나가요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "276", "label": "대화형", "length": 17, "text": "＂제 비법은 바로 맛술인데요.＂", "value": { "text_id": "10", "word_num": 4, "핵심동사": "맛술인데요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "294", "label": "대화형", "length": 39, "text": "＂이렇게 찢어 놓은 황태채에 맛술 6 큰 술을 뿌리고 버무려 주세요.＂", "value": { "text_id": "11", "word_num": 11, "핵심동사": "버무려", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "334", "label": "대화형", "length": 31, "text": "＂그리고 젖은 면포에 감싸서 20분 동안 재워 주세요.＂", "value": { "text_id": "12", "word_num": 8, "핵심동사": "재워", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "366", "label": "대화형", "length": 31, "text": "＂맛술을 뿌리고 젖은 면포에 감싸 놓는 이유가 있나요?＂", "value": { "text_id": "13", "word_num": 8, "핵심동사": "있나요", "확실성": "불확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "398", "label": "대화형", "length": 22, "text": "＂맛술은 비린 맛을 없애 주는 거고요.＂", "value": { "text_id": "14", "word_num": 6, "핵심동사": "없애", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "421", "label": "대화형", "length": 55, "text": "＂젖은 면포로 감싸야 맛술이 잘 스며들면서 황태채가 부드럽고 나른해져서 퍼석하다는 느낌이 없어요.＂", "value": { "text_id": "15", "word_num": 12, "핵심동사": "없어요", "확실성": "확실", "극성": "부정", "시제": "현재", "key_word": " " } } ], "dupLabelYn": "Y", "metaData": { "ID": "560156", "FILENAME": "560156.json", "MEDIA_TYPE": "방송대본", "MEDIA_NAME": "알토란", "CATEGORY": "생활건강", "PUBDATE": "20210808", "SENTENCE": "15" } } 