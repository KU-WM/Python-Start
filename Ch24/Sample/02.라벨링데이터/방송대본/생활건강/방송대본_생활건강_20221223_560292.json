{ "annotation": [ { "charNum": "1", "label": "대화형", "length": 12, "text": "＂재료 소개해주세요.＂", "value": { "text_id": "1", "word_num": 2, "핵심동사": "소개해주세요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "13", "label": "대화형", "length": 52, "text": "＂설탕500g, 물 5리터, 녹두 1컵(종이컵), 식초, 꿀 1티스푼, 우유 2큰술입니다.＂ ", "value": { "text_id": "2", "word_num": 11, "핵심동사": "2큰술입니다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "65", "label": "대화형", "length": 21, "text": "＂먼저 식초 베이스를 만들 건데요.＂ ", "value": { "text_id": "3", "word_num": 6, "핵심동사": "만들", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "86", "label": "대화형", "length": 47, "text": "＂일반적으로 한 번 만들 때 저는 보통 설탕 10kg에 물100리터를 사용하는데요.＂", "value": { "text_id": "4", "word_num": 11, "핵심동사": "사용하는데요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "133", "label": "대화형", "length": 48, "text": "＂오늘은 같은 비율로 설탕 500g과 물 5리터를 이용해 식초를 만들어 보겠습니다.＂ ", "value": { "text_id": "5", "word_num": 12, "핵심동사": "만들어", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "181", "label": "대화형", "length": 16, "text": "＂만드는 방법은 간단합니다.＂", "value": { "text_id": "6", "word_num": 3, "핵심동사": "간단합니다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "197", "label": "대화형", "length": 18, "text": "＂냄비에 물을 넣고 끓입니다.＂ ", "value": { "text_id": "7", "word_num": 5, "핵심동사": "끓입니다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "215", "label": "대화형", "length": 27, "text": "＂물이 끓기 시작하면 설탕을 넣어주면 됩니다.＂ ", "value": { "text_id": "8", "word_num": 7, "핵심동사": "넣어주면", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "242", "label": "대화형", "length": 26, "text": "＂이때 비율은 설탕 1 물 10이면 좋습니다.＂", "value": { "text_id": "9", "word_num": 7, "핵심동사": "좋습니다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "268", "label": "대화형", "length": 22, "text": "＂이렇게 얼마나 끓여주면 되는 건가요?＂", "value": { "text_id": "10", "word_num": 5, "핵심동사": "되는", "확실성": "확실", "극성": "미정", "시제": "현재", "key_word": " " } }, { "charNum": "290", "label": "대화형", "length": 22, "text": "＂대략 3시간 이상 끓이면 되는데요.＂ ", "value": { "text_id": "11", "word_num": 6, "핵심동사": "끓이면", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "312", "label": "대화형", "length": 17, "text": "＂눌어붙지 않게 저어주세요.＂ ", "value": { "text_id": "12", "word_num": 4, "핵심동사": "저어주세요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "329", "label": "대화형", "length": 20, "text": "＂색이 노랗게 변하면 완성입니다.＂ ", "value": { "text_id": "13", "word_num": 5, "핵심동사": "완성입니다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "349", "label": "대화형", "length": 16, "text": "＂자, 색이 노랗게 변했죠?＂", "value": { "text_id": "14", "word_num": 4, "핵심동사": "변했죠", "확실성": "불확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "365", "label": "대화형", "length": 42, "text": "＂여기에 원재료를 넣고 실온에서 6개월 이상 보관하면 식초가 완성됩니다.＂ ", "value": { "text_id": "15", "word_num": 10, "핵심동사": "완성됩니다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "407", "label": "대화형", "length": 73, "text": "＂여기서 원재료란 지금 만든 설탕 발효액에 예를 들어 사과를 넣으면 사과 식초, 매실을 넣으면 매실 식초가 된다는 이야기입니다.＂ ", "value": { "text_id": "16", "word_num": 19, "핵심동사": "이야기입니다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "480", "label": "대화형", "length": 15, "text": "＂제가 식초부터 맛볼게요.＂", "value": { "text_id": "17", "word_num": 3, "핵심동사": "맛볼게요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "495", "label": "대화형", "length": 29, "text": "＂전날 5시간 이상 물에 불린 녹두를 준비하는데요.＂", "value": { "text_id": "18", "word_num": 7, "핵심동사": "준비하는데요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "524", "label": "대화형", "length": 22, "text": "＂편하게 전날 밤에 재워주셔도 됩니다.＂", "value": { "text_id": "19", "word_num": 5, "핵심동사": "재워주셔도", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "546", "label": "대화형", "length": 26, "text": "＂물에 불린 녹두를 체에 밭쳐 물기를 뺍니다.＂", "value": { "text_id": "20", "word_num": 7, "핵심동사": "뺍니다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "572", "label": "대화형", "length": 53, "text": "＂녹두가 해독에 좋다는 말은 들었는데, 지방 없애는 데 도움이 된다는 건 오늘 처음 알았어요.＂", "value": { "text_id": "21", "word_num": 14, "핵심동사": "알았어요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "625", "label": "대화형", "length": 92, "text": "＂녹두에는 녹말, 단백질, 필수아미노산 그리고 다양한 미네랄 성분들이 함유되어 있어서 혈액 속에 쌓인 지방을 없애 묵은 군살과 내장지방을 제거하는 데 효과적입니다.＂", "value": { "text_id": "22", "word_num": 21, "핵심동사": "효과적입니다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "717", "label": "대화형", "length": 49, "text": "＂녹두를 그냥 먹어도 되는데, 굳이 식초랑 섞어서 먹으면 지방 제거 효과가 높아지나요?＂", "value": { "text_id": "23", "word_num": 12, "핵심동사": "높아지나요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "766", "label": "대화형", "length": 48, "text": "＂찜 솥에 면보를 깔고 물이 끓기 시작하면 녹두를 올리고 중불에서 50분간 쪄줍니다.＂", "value": { "text_id": "24", "word_num": 12, "핵심동사": "쪄줍니다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "814", "label": "대화형", "length": 43, "text": "＂믹서에 찐 녹두, 우유 그리고 시원한 식감을 위해 얼음을 넣고 갈아줍니다.＂", "value": { "text_id": "25", "word_num": 11, "핵심동사": "갈아줍니다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "857", "label": "대화형", "length": 49, "text": "＂우유는 식초의 체내 흡수율을 도와주기 때문에 식초와 환상의 짝꿍이라 할 수 있습니다.＂", "value": { "text_id": "26", "word_num": 12, "핵심동사": "할", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "906", "label": "사실형", "length": 20, "text": "＂믹서에 간 녹두를 컵에 따라준다.＂", "value": { "text_id": "27", "word_num": 5, "핵심동사": "따라준다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "926", "label": "대화형", "length": 37, "text": "＂그리고 식초와 꿀을 넣고 섞어주면 떠먹는 클린 식초 완성입니다.＂", "value": { "text_id": "28", "word_num": 9, "핵심동사": "완성입니다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } } ], "dupLabelYn": "Y", "metaData": { "ID": "560292", "FILENAME": "560292.json", "MEDIA_TYPE": "방송대본", "MEDIA_NAME": "엄지의제왕", "CATEGORY": "생활건강", "PUBDATE": "20190806", "SENTENCE": "28" } } 