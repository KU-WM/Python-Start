{ "annotation": [ { "charNum": "1", "label": "대화형", "length": 65, "text": "＂언제나 초간단 요리를 만들어 내는 요리의 마술사, 신뚝딱 신** 셰프님, 오늘은 어떤 뚝딱 요리를 준비해오셨나요?＂", "value": { "text_id": "1", "word_num": 15, "핵심동사": "준비해오셨나요", "확실성": "확실", "극성": "미정", "시제": "현재", "key_word": " " } }, { "charNum": "67", "label": "대화형", "length": 37, "text": "＂이제 중복도 코앞이고, 여름 더위도 절정을 향해 가고 있잖아요?＂", "value": { "text_id": "2", "word_num": 9, "핵심동사": "가고", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "105", "label": "대화형", "length": 32, "text": "＂그래서 저 신뚝딱이 ＇여름 특별 코너＇를 준비했습니다.＂", "value": { "text_id": "3", "word_num": 7, "핵심동사": "준비했습니다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": " " } }, { "charNum": "138", "label": "대화형", "length": 76, "text": "＂이렇게 더운 여름날에 먹으면 딱 어울리는 요리를 매주 여러분께 소개해드릴 건데요, 이름하야 <무한 변신! 레토르트 활용 백서>입니다.＂", "value": { "text_id": "4", "word_num": 17, "핵심동사": "<무한 변신! 레토르트 활용 백서>입니다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "215", "label": "대화형", "length": 76, "text": "＂사실 레토르트가 요즘 대세기도 하고 신뚝딱이라는 별명과도 딱 어울리기는 한데요, 레토르트는 원래 완성품이라 그냥 데워 먹는 거잖아요?＂", "value": { "text_id": "5", "word_num": 18, "핵심동사": "먹는", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "293", "label": "대화형", "length": 20, "text": "＂그런데 뭘 또 요리한다는 거예요?＂", "value": { "text_id": "6", "word_num": 5, "핵심동사": "요리한다는", "확실성": "불확실", "극성": "미정", "시제": "현재", "key_word": " " } }, { "charNum": "314", "label": "대화형", "length": 50, "text": "＂맞아요, 보통 레토르트 식품 하면은 간편하게 한 끼 때우는 용도로 드시고 계실 거예요.＂", "value": { "text_id": "7", "word_num": 14, "핵심동사": "드시고", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "366", "label": "대화형", "length": 68, "text": "＂하지만 레토르트 식품도 제 손을 거치면 더 건강하고 색다른 맛의 일품요리로 변신하는 아주 신기한 광경이 연출될 겁니다.＂", "value": { "text_id": "8", "word_num": 17, "핵심동사": "연출될", "확실성": "불확실", "극성": "긍정", "시제": "미래", "key_word": " " } }, { "charNum": "435", "label": "대화형", "length": 30, "text": "＂집에서 레토르트 제대로 활용하는 방법을 공개할게요.＂", "value": { "text_id": "9", "word_num": 6, "핵심동사": "공개할게요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "466", "label": "대화형", "length": 47, "text": "＂근데 레토르트 식품도 종류가 진짜 여러 가지인데 어떤 걸 가지고 요리하실 거예요?＂", "value": { "text_id": "10", "word_num": 12, "핵심동사": "요리하실", "확실성": "불확실", "극성": "미정", "시제": "미래", "key_word": " " } }, { "charNum": "514", "label": "대화형", "length": 29, "text": "＂다들 집 냉동실에 냉동 돈가스 하나씩은 있으시죠?＂", "value": { "text_id": "11", "word_num": 7, "핵심동사": "있으시죠", "확실성": "불확실", "극성": "미정", "시제": "현재", "key_word": " " } }, { "charNum": "544", "label": "대화형", "length": 24, "text": "＂오늘은 그 냉동 돈가스로 요리할 거예요.＂", "value": { "text_id": "12", "word_num": 6, "핵심동사": "요리할", "확실성": "확실", "극성": "긍정", "시제": "미래", "key_word": " " } } ], "dupLabelYn": "Y", "metaData": { "ID": "560076", "FILENAME": "560076.json", "MEDIA_TYPE": "방송대본", "MEDIA_NAME": "알토란", "CATEGORY": "생활건강", "PUBDATE": "20210718", "SENTENCE": "12" } } 