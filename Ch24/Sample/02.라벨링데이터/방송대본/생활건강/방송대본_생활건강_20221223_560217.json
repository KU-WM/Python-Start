{ "annotation": [ { "charNum": "1", "label": "대화형", "length": 26, "text": "＂이제 고구마김치전을 맛있게 부쳐 보겠습니다.＂", "value": { "text_id": "1", "word_num": 5, "핵심동사": "부쳐", "확실성": "확실", "극성": "긍정", "시제": "미래", "key_word": " " } }, { "charNum": "28", "label": "대화형", "length": 25, "text": "＂팬에 식용유 4 큰 술 정도 둘러 주세요.＂", "value": { "text_id": "2", "word_num": 8, "핵심동사": "둘러", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "54", "label": "대화형", "length": 21, "text": "＂그리고 반죽을 적당량 올려 줍니다.＂", "value": { "text_id": "3", "word_num": 5, "핵심동사": "올려", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "76", "label": "대화형", "length": 19, "text": "＂이제 노릇노릇하게 부치면 돼요.＂", "value": { "text_id": "4", "word_num": 4, "핵심동사": "부치면", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "96", "label": "대화형", "length": 32, "text": "＂자, 이렇게 가장자리가 익은 게 보이면 뒤집어 주세요.＂", "value": { "text_id": "5", "word_num": 8, "핵심동사": "뒤집어", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "129", "label": "대화형", "length": 16, "text": "＂노릇노릇하니 잘 구워졌죠?＂", "value": { "text_id": "6", "word_num": 3, "핵심동사": "구워졌죠", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } } ], "dupLabelYn": "Y", "metaData": { "ID": "560217", "FILENAME": "560217.json", "MEDIA_TYPE": "방송대본", "MEDIA_NAME": "알토란", "CATEGORY": "생활건강", "PUBDATE": "20210731", "SENTENCE": "6" } } 