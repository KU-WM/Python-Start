{ "annotation": [ { "charNum": "1", "label": "대화형", "length": 25, "text": "＂삭힌고추는 담가 놓으면 활용도가 높잖아요.＂", "value": { "text_id": "1", "word_num": 5, "핵심동사": "높잖아요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "27", "label": "대화형", "length": 12, "text": "＂어떻게 활용하나요?＂", "value": { "text_id": "2", "word_num": 2, "핵심동사": "활용하나요", "확실성": "불확실", "극성": "긍정", "시제": "미래", "key_word": " " } }, { "charNum": "40", "label": "대화형", "length": 49, "text": "＂동치미나 백김치 담글 때 삭힌고추를 넣으면 감칠맛과 칼칼한 맛을 내는 역할을 하고요.＂", "value": { "text_id": "3", "word_num": 12, "핵심동사": "하고요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "90", "label": "대화형", "length": 32, "text": "＂삭힌고추를 무쳐서 먹거나 다져서 볶아 먹어도 맛있어요.＂", "value": { "text_id": "4", "word_num": 7, "핵심동사": "맛있어요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "123", "label": "대화형", "length": 46, "text": "＂맞아요, 저희 시어머니께서 삭힌고추를 활용해서 다양한 요리를 만들어 주시는데요.＂", "value": { "text_id": "5", "word_num": 9, "핵심동사": "만들어", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "170", "label": "대화형", "length": 23, "text": "＂그냥 고추보다 훨씬 감칠맛이 뛰어나요.＂", "value": { "text_id": "6", "word_num": 5, "핵심동사": "뛰어나요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "194", "label": "대화형", "length": 30, "text": "＂**쌤은 어떤 삭힌고추 요리를 만들어 주실 건가요?＂", "value": { "text_id": "7", "word_num": 7, "핵심동사": "만들어", "확실성": "불확실", "극성": "긍정", "시제": "미래", "key_word": " " } } ], "dupLabelYn": "Y", "metaData": { "ID": "560176", "FILENAME": "560176.json", "MEDIA_TYPE": "방송대본", "MEDIA_NAME": "알토란", "CATEGORY": "생활건강", "PUBDATE": "20210815", "SENTENCE": "7" } } 