{ "annotation": [ { "charNum": "1", "label": "대화형", "length": 31, "text": "＂자, 이 정도로 볶아졌으면 양념 재료를 넣어 볼게요.＂", "value": { "text_id": "1", "word_num": 8, "핵심동사": "넣어", "확실성": "확실", "극성": "긍정", "시제": "미래", "key_word": " " } }, { "charNum": "33", "label": "대화형", "length": 30, "text": "＂처음으로 넣는 재료는 바로 사태족발 삶은 물입니다.＂", "value": { "text_id": "2", "word_num": 7, "핵심동사": "물입니다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "64", "label": "대화형", "length": 38, "text": "＂사태족발 삶은 물은 그냥 버리는 줄 알았는데 여기에 활용하시네요?＂", "value": { "text_id": "3", "word_num": 9, "핵심동사": "활용하시네요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "103", "label": "대화형", "length": 38, "text": "＂네, 사태족발 삶은 물에 깊고 진한 향과 맛이 다 들어 있잖아요.＂", "value": { "text_id": "4", "word_num": 11, "핵심동사": "들어", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "142", "label": "대화형", "length": 28, "text": "＂이걸 활용하면 불족발의 감칠맛이 확 올라갑니다.＂", "value": { "text_id": "5", "word_num": 6, "핵심동사": "올라갑니다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "171", "label": "대화형", "length": 23, "text": "＂사태족발 삶은 물 1컵을 넣어 주세요.＂", "value": { "text_id": "6", "word_num": 6, "핵심동사": "넣어", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "195", "label": "대화형", "length": 32, "text": "＂매콤함을 더할 청양고추 가루 5 큰 술을 넣어 주세요.＂", "value": { "text_id": "7", "word_num": 9, "핵심동사": "넣어", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "228", "label": "대화형", "length": 34, "text": "＂매운맛이 부담스러운 분들은 일반 고춧가루를 쓰셔도 됩니다.＂", "value": { "text_id": "8", "word_num": 7, "핵심동사": "쓰셔도", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "263", "label": "대화형", "length": 18, "text": "＂매운맛에는 단맛이 따라가야죠.＂", "value": { "text_id": "9", "word_num": 3, "핵심동사": "따라가야죠", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "282", "label": "대화형", "length": 29, "text": "＂여기에 단맛을 더해줄 설탕 2 큰 술을 넣을게요.＂", "value": { "text_id": "10", "word_num": 8, "핵심동사": "넣을게요", "확실성": "확실", "극성": "긍정", "시제": "미래", "key_word": " " } }, { "charNum": "312", "label": "대화형", "length": 37, "text": "＂그리고 고소함을 더해 줄 참기름 1 큰 술을 넣고 조려 주세요.＂", "value": { "text_id": "11", "word_num": 11, "핵심동사": "조려", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "350", "label": "대화형", "length": 55, "text": "＂뭔가 불족발의 맛을 내려면 이 양념 저 양념 다 넣지 않을까 싶었는데, 재료도 정말 간단하네요.＂", "value": { "text_id": "12", "word_num": 15, "핵심동사": "간단하네요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "406", "label": "대화형", "length": 47, "text": "＂사태족발을 마늘, 양파, 청양고추 가루에 먼저 볶은 게 정말 신의 한 수 같아요.＂", "value": { "text_id": "13", "word_num": 13, "핵심동사": "같아요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } } ], "dupLabelYn": "Y", "metaData": { "ID": "560130", "FILENAME": "560130.json", "MEDIA_TYPE": "방송대본", "MEDIA_NAME": "알토란", "CATEGORY": "생활건강", "PUBDATE": "20210801", "SENTENCE": "13" } } 