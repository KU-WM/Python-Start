{ "annotation": [ { "charNum": "1", "label": "대화형", "length": 22, "text": "＂자, 그럼 먼저 면부터 삶아 볼게요.＂", "value": { "text_id": "1", "word_num": 6, "핵심동사": "삶아", "확실성": "확실", "극성": "긍정", "시제": "미래", "key_word": " " } }, { "charNum": "24", "label": "대화형", "length": 22, "text": "＂일반 시판 라면 1개를 준비했는데요.＂", "value": { "text_id": "2", "word_num": 5, "핵심동사": "준비했는데요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "47", "label": "대화형", "length": 19, "text": "＂끓는 물에 라면을 넣어 주세요.＂", "value": { "text_id": "3", "word_num": 5, "핵심동사": "넣어", "확실성": "확실", "극성": "긍정", "시제": "미래", "key_word": " " } }, { "charNum": "67", "label": "대화형", "length": 22, "text": "＂라면수프 없이 면만 딱 삶아 줍니다.＂", "value": { "text_id": "4", "word_num": 6, "핵심동사": "삶아", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "90", "label": "대화형", "length": 41, "text": "＂이렇게 면이랑 국물을 따로 만들면 훨씬 더 담백하게 즐길 수 있겠네요.＂", "value": { "text_id": "5", "word_num": 11, "핵심동사": "즐길", "확실성": "확실", "극성": "긍정", "시제": "미래", "key_word": " " } }, { "charNum": "132", "label": "대화형", "length": 40, "text": "＂네 맞아요, 면을 너무 푹 퍼지지 않고 꼬들꼬들하게 삶아야 하는데요.＂", "value": { "text_id": "6", "word_num": 10, "핵심동사": "삶아야", "확실성": "확실", "극성": "긍정", "시제": "미래", "key_word": " " } }, { "charNum": "173", "label": "대화형", "length": 24, "text": "＂한 3분~3분 30초 정도 삶아 주세요.＂", "value": { "text_id": "7", "word_num": 6, "핵심동사": "삶아", "확실성": "확실", "극성": "긍정", "시제": "미래", "key_word": " " } } ], "dupLabelYn": "Y", "metaData": { "ID": "560115", "FILENAME": "560115.json", "MEDIA_TYPE": "방송대본", "MEDIA_NAME": "알토란", "CATEGORY": "생활건강", "PUBDATE": "20210801", "SENTENCE": "7" } } 