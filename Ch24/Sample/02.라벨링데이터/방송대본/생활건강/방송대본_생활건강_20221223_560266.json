{ "annotation": [ { "charNum": "1", "label": "대화형", "length": 28, "text": "＂제가 그동안 **쌤의 요리 패턴을 분석해봤어요.＂", "value": { "text_id": "1", "word_num": 6, "핵심동사": "분석해봤어요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "30", "label": "대화형", "length": 45, "text": "＂알토란 분석맨으로서 예상컨대 데친 고사리에 먼저 밑간을 하지 않을까 싶거든요?＂", "value": { "text_id": "2", "word_num": 10, "핵심동사": "하지", "확실성": "불확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "76", "label": "대화형", "length": 12, "text": "＂오 **씨 맞아요.＂", "value": { "text_id": "3", "word_num": 3, "핵심동사": "맞아요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "89", "label": "대화형", "length": 20, "text": "＂그럼 왜 밑간을 하는지도 아세요?＂", "value": { "text_id": "4", "word_num": 5, "핵심동사": "아세요", "확실성": "불확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "110", "label": "대화형", "length": 30, "text": "＂아 제가 시간이 없어서 거기까진 분석을 못 했어요.＂", "value": { "text_id": "5", "word_num": 8, "핵심동사": "했어요", "확실성": "확실", "극성": "부정", "시제": "과거", "key_word": " " } }, { "charNum": "141", "label": "대화형", "length": 15, "text": "＂왜 밑간을 하는 거예요?＂", "value": { "text_id": "6", "word_num": 4, "핵심동사": "하는", "확실성": "불확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "157", "label": "대화형", "length": 33, "text": "＂이유가 있죠, 추석 때 비린 고사리볶음 먹으면 되겠어요?＂", "value": { "text_id": "7", "word_num": 8, "핵심동사": "먹으면", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "191", "label": "대화형", "length": 53, "text": "＂밑간을 하면 고사리 특유의 비린 맛과 향을 손쉽게 없앨 수 있고 구수함을 살릴 수 있습니다.＂", "value": { "text_id": "8", "word_num": 15, "핵심동사": "살릴", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "245", "label": "대화형", "length": 17, "text": "＂네, 그럼 밑간을 해볼게요.＂", "value": { "text_id": "9", "word_num": 4, "핵심동사": "해볼게요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "263", "label": "대화형", "length": 37, "text": "＂먼저, 간을 맞추고 감칠맛을 더할 국간장 1 큰 술을 넣을게요.＂", "value": { "text_id": "10", "word_num": 10, "핵심동사": "넣을게요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "301", "label": "대화형", "length": 33, "text": "＂다음으로 잡내를 날려 줄 청주 1 큰 술도 넣어 줍니다.＂", "value": { "text_id": "11", "word_num": 10, "핵심동사": "넣어", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "335", "label": "대화형", "length": 42, "text": "＂그리고 풍미를 더할 다진 마늘 1 작은 술도 넣고 조물조물 무쳐 주세요.＂", "value": { "text_id": "12", "word_num": 12, "핵심동사": "무쳐", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "378", "label": "대화형", "length": 27, "text": "＂알가족분들 추석 때 가장 걱정되는 게 뭐예요?＂", "value": { "text_id": "13", "word_num": 7, "핵심동사": "뭐예요", "확실성": "불확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "406", "label": "대화형", "length": 42, "text": "＂우리 알가족들의 걱정, 고민을 싹 없애 줄 수 있는 게 바로 고사리에요.＂", "value": { "text_id": "14", "word_num": 12, "핵심동사": "고사리에요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "449", "label": "대화형", "length": 37, "text": "＂고사리는 칼륨이 풍부해 몸속에 과하게 쌓인 나트륨을 배출하고요.＂", "value": { "text_id": "15", "word_num": 8, "핵심동사": "배출하고요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "487", "label": "대화형", "length": 63, "text": "＂식이섬유가 풍부해 추석 동안 쌓인 노폐물을 제거해 다이어트에 좋고, 항염 작용이 탁월해 위 건강도 지켜줍니다.＂", "value": { "text_id": "16", "word_num": 15, "핵심동사": "지켜줍니다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "551", "label": "대화형", "length": 31, "text": "＂고사리볶음으로 추석을 더 건강하게 보내시길 바랍니다.＂", "value": { "text_id": "17", "word_num": 6, "핵심동사": "바랍니다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } } ], "dupLabelYn": "Y", "metaData": { "ID": "560266", "FILENAME": "560266.json", "MEDIA_TYPE": "방송대본", "MEDIA_NAME": "알토란", "CATEGORY": "생활건강", "PUBDATE": "20210912", "SENTENCE": "17" } } 