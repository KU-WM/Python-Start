{ "annotation": [ { "charNum": "1", "label": "대화형", "length": 31, "text": "＂자, 여기에 동그랑땡난자완스의 소스를 더해볼 건데요.＂", "value": { "text_id": "1", "word_num": 6, "핵심동사": "더해볼", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "33", "label": "대화형", "length": 19, "text": "＂딱 4가지 재료만 넣을 거예요.＂", "value": { "text_id": "2", "word_num": 5, "핵심동사": "넣을", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "53", "label": "대화형", "length": 34, "text": "＂맞습니다, 중식이라고 해서 복잡하게 생각하실 필요 없어요.＂", "value": { "text_id": "3", "word_num": 7, "핵심동사": "없어요", "확실성": "확실", "극성": "부정", "시제": "현재", "key_word": " " } }, { "charNum": "88", "label": "대화형", "length": 19, "text": "＂먼저 청주 2 큰 술 넣을게요.＂", "value": { "text_id": "4", "word_num": 6, "핵심동사": "넣을게요", "확실성": "확실", "극성": "긍정", "시제": "미래", "key_word": " " } }, { "charNum": "108", "label": "대화형", "length": 38, "text": "＂셰프님, 보통 중식 요리는 청주가 꼭 들어가던데 왜 그런 거예요?＂", "value": { "text_id": "5", "word_num": 10, "핵심동사": "그런", "확실성": "불확실", "극성": "미정", "시제": "현재", "key_word": " " } }, { "charNum": "147", "label": "대화형", "length": 61, "text": "＂청주는 잡내를 잡을 뿐만 아니라 단맛을 내주고요, 요리 자체의 향을 골고루 퍼지게 하는 역할을 해주거든요.＂", "value": { "text_id": "6", "word_num": 15, "핵심동사": "해주거든요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "209", "label": "대화형", "length": 61, "text": "＂청주가 없다면 소주를 넣어도 되지만 알코올 향이 날 수 있으니 이왕이면 김빠진 소주를 사용하시길 바랍니다.＂", "value": { "text_id": "7", "word_num": 15, "핵심동사": "바랍니다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "271", "label": "대화형", "length": 38, "text": "＂자, 여기에 감칠맛과 풍미를 위해 다시마 육수 1컵 반을 넣고요.＂", "value": { "text_id": "8", "word_num": 10, "핵심동사": "넣고요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "310", "label": "대화형", "length": 29, "text": "＂간장 1 큰 술과 굴소스 1 큰 술 반 넣을게요.＂", "value": { "text_id": "9", "word_num": 10, "핵심동사": "넣을게요", "확실성": "확실", "극성": "긍정", "시제": "미래", "key_word": " " } } ], "dupLabelYn": "Y", "metaData": { "ID": "560236", "FILENAME": "560236.json", "MEDIA_TYPE": "방송대본", "MEDIA_NAME": "알토란", "CATEGORY": "생활건강", "PUBDATE": "20210905", "SENTENCE": "9" } } 