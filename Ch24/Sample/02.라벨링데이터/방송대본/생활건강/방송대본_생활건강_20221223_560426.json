{ "annotation": [ { "charNum": "1", "label": "대화형", "length": 33, "text": "＂자, 콩나물은 냉수에 넣어 냉장고에 보관해두시면 되고요.＂", "value": { "text_id": "1", "word_num": 7, "핵심동사": "보관해두시면", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "35", "label": "대화형", "length": 18, "text": "＂이제 육수에 간을 해 볼게요.＂", "value": { "text_id": "2", "word_num": 5, "핵심동사": "해", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "54", "label": "대화형", "length": 24, "text": "＂자, 먼저 국간장 1 큰 술을 넣을게요.＂", "value": { "text_id": "3", "word_num": 7, "핵심동사": "넣을게요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "79", "label": "대화형", "length": 25, "text": "＂다음은 고운 소금 1 큰 술을 넣겠습니다.＂", "value": { "text_id": "4", "word_num": 7, "핵심동사": "넣겠습니다", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "105", "label": "대화형", "length": 31, "text": "＂자, 이제 이대로 육수도 차갑게 식혀 주시면 됩니다.＂", "value": { "text_id": "5", "word_num": 8, "핵심동사": "식혀 주시면", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } } ], "dupLabelYn": "Y", "metaData": { "ID": "560426", "FILENAME": "560426.json", "MEDIA_TYPE": "방송대본", "MEDIA_NAME": "알토란", "CATEGORY": "생활건강", "PUBDATE": "20190517", "SENTENCE": "5" } } 