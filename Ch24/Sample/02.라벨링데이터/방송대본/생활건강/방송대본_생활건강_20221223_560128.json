{ "annotation": [ { "charNum": "1", "label": "대화형", "length": 17, "text": "＂자, 남은 사태족발 인데요.＂", "value": { "text_id": "1", "word_num": 4, "핵심동사": "사태족발 인데요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "19", "label": "대화형", "length": 21, "text": "＂먹기 좋은 크기로 큼직하게 썰게요.＂", "value": { "text_id": "2", "word_num": 5, "핵심동사": "썰게요", "확실성": "확실", "극성": "긍정", "시제": "미래", "key_word": " " } }, { "charNum": "41", "label": "대화형", "length": 22, "text": "＂근데 아까랑은 써는 방법이 다르네요?＂", "value": { "text_id": "3", "word_num": 5, "핵심동사": "다르네요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "64", "label": "대화형", "length": 34, "text": "＂불족발용을 얇게 썰면 고기의 맛을 제대로 즐기기 어려워요.＂", "value": { "text_id": "4", "word_num": 8, "핵심동사": "어려워요", "확실성": "불확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "99", "label": "대화형", "length": 47, "text": "＂이렇게 두툼하게 썰어야 매콤한 양념과 살코기의 고소함을 동시에 느낄 수 있습니다.＂", "value": { "text_id": "5", "word_num": 11, "핵심동사": "느낄", "확실성": "확실", "극성": "긍정", "시제": "미래", "key_word": " " } } ], "dupLabelYn": "Y", "metaData": { "ID": "560128", "FILENAME": "560128.json", "MEDIA_TYPE": "방송대본", "MEDIA_NAME": "알토란", "CATEGORY": "생활건강", "PUBDATE": "20210801", "SENTENCE": "5" } } 