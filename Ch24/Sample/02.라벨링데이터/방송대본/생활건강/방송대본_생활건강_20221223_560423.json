{ "annotation": [ { "charNum": "1", "label": "대화형", "length": 22, "text": "＂그런데 콩나물냉국이 뭐 따로 있어요?＂", "value": { "text_id": "1", "word_num": 5, "핵심동사": "있어요", "확실성": "불확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "24", "label": "대화형", "length": 26, "text": "＂콩나물국 끓여서 식히면 그게 콩나물냉국이죠.＂", "value": { "text_id": "2", "word_num": 5, "핵심동사": "콩나물냉국이죠", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "51", "label": "대화형", "length": 46, "text": "＂어머, 그럼 미역냉국도 미역국 끓여서 식힌 다음에 미역냉국이라고 하지 그러세요.＂", "value": { "text_id": "3", "word_num": 10, "핵심동사": "하지", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "98", "label": "대화형", "length": 25, "text": "＂죄송합니다, 뜨겁고 차갑고 차이 아니에요?＂", "value": { "text_id": "4", "word_num": 5, "핵심동사": "아니에요", "확실성": "불확실", "극성": "미정", "시제": "현재", "key_word": " " } }, { "charNum": "124", "label": "대화형", "length": 12, "text": "＂뭔 차이가 있어요?＂", "value": { "text_id": "5", "word_num": 3, "핵심동사": "있어요", "확실성": "불확실", "극성": "미정", "시제": "현재", "key_word": " " } }, { "charNum": "137", "label": "대화형", "length": 43, "text": "＂아무래도 뜨거운 걸 먹을 때보단 차가운 걸 먹을 때 미각이 더 예민해지죠.＂", "value": { "text_id": "6", "word_num": 12, "핵심동사": "예민해지죠", "확실성": "확실", "극성": "긍정", "시제": "미래", "key_word": " " } }, { "charNum": "181", "label": "대화형", "length": 30, "text": "＂또 콩나물도 아삭아삭 식감이 더 살아있어야 하고요.＂", "value": { "text_id": "7", "word_num": 7, "핵심동사": "살아있어야", "확실성": "확실", "극성": "긍정", "시제": "미래", "key_word": " " } } ], "dupLabelYn": "Y", "metaData": { "ID": "560423", "FILENAME": "560423.json", "MEDIA_TYPE": "방송대본", "MEDIA_NAME": "알토란", "CATEGORY": "생활건강", "PUBDATE": "20190517", "SENTENCE": "7" } } 