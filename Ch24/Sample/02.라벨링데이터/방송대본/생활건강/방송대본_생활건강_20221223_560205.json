{ "annotation": [ { "charNum": "1", "label": "대화형", "length": 27, "text": "＂다음은 맛의 핵심, 간장소스를 만들어 볼게요.＂", "value": { "text_id": "1", "word_num": 6, "핵심동사": "만들어", "확실성": "확실", "극성": "긍정", "시제": "미래", "key_word": " " } }, { "charNum": "29", "label": "대화형", "length": 39, "text": "＂닭가슴살의 잡내는 잡고 입맛은 돋울 다진 마늘 2 큰 술을 넣고요.＂", "value": { "text_id": "2", "word_num": 11, "핵심동사": "넣고요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "69", "label": "대화형", "length": 21, "text": "＂다진 생강 1 작은 술도 넣을게요.＂", "value": { "text_id": "3", "word_num": 6, "핵심동사": "넣을게요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "91", "label": "대화형", "length": 26, "text": "＂황설탕 60g과 물엿도 2 큰 술 넣을게요.＂", "value": { "text_id": "4", "word_num": 7, "핵심동사": "넣을게요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "118", "label": "대화형", "length": 27, "text": "＂황설탕도 넣고 물엿도 넣으시는 이유가 있나요?＂", "value": { "text_id": "5", "word_num": 6, "핵심동사": "있나요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "146", "label": "대화형", "length": 64, "text": "＂황설탕은 단맛을 위해 들어가고요, 물엿은 닭가슴살에 기름기가 적다 보니 코팅과 윤기를 내주기 위해 넣는 거예요.＂", "value": { "text_id": "6", "word_num": 15, "핵심동사": "넣는", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "211", "label": "대화형", "length": 21, "text": "＂이어서 참기름 1 큰 술을 넣고요.＂", "value": { "text_id": "7", "word_num": 6, "핵심동사": "넣고요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "233", "label": "대화형", "length": 16, "text": "＂후춧가루 3꼬집을 넣고요.＂", "value": { "text_id": "8", "word_num": 3, "핵심동사": "넣고요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "250", "label": "대화형", "length": 21, "text": "＂맛술 반 컵과 물 2컵을 넣을게요.＂", "value": { "text_id": "9", "word_num": 6, "핵심동사": "넣을게요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "272", "label": "대화형", "length": 22, "text": "＂그리고 간장 7 큰 술도 준비했어요.＂", "value": { "text_id": "10", "word_num": 6, "핵심동사": "준비했어요", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": " " } }, { "charNum": "295", "label": "대화형", "length": 33, "text": "＂셰프님, 제가 얼마 전에 씨간장이란 걸 선물 받았는데요.＂", "value": { "text_id": "11", "word_num": 8, "핵심동사": "받았는데요", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": " " } }, { "charNum": "329", "label": "대화형", "length": 28, "text": "＂저한텐 생소해서 어떻게 활용할지 모르겠더라고요.＂", "value": { "text_id": "12", "word_num": 5, "핵심동사": "모르겠더라고요", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": " " } }, { "charNum": "358", "label": "대화형", "length": 25, "text": "＂오늘 알셰프님들께 물어보려고 가져왔거든요.＂", "value": { "text_id": "13", "word_num": 4, "핵심동사": "가져왔거든요", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": " " } }, { "charNum": "384", "label": "대화형", "length": 68, "text": "＂네, 전통 방식으로 담근 한식 간장은요, 오래 묵힐수록 깊은 발효의 맛이 강해지고 염도는 상대적으로 낮아지게 되는데요.＂", "value": { "text_id": "14", "word_num": 16, "핵심동사": "낮아지게", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "453", "label": "대화형", "length": 27, "text": "＂그렇게 오래 묵힌 진간장을 씨간장이라고 해요.＂", "value": { "text_id": "15", "word_num": 6, "핵심동사": "해요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "481", "label": "대화형", "length": 73, "text": "＂씨간장은 일반 간장보다 오래 숙성되었기 때문에 더 깊은 맛과 풍미를 더해줘 보통 햇간장을 담글 때 함께 섞어서 담그기도 합니다.＂", "value": { "text_id": "16", "word_num": 19, "핵심동사": "담그기도", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "555", "label": "대화형", "length": 14, "text": "＂그만큼 귀한 간장이죠.＂", "value": { "text_id": "17", "word_num": 3, "핵심동사": "간장이죠", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "570", "label": "대화형", "length": 26, "text": "＂그럼 씨간장을 요리에 사용해도 되는 건가요?＂", "value": { "text_id": "18", "word_num": 6, "핵심동사": "사용해도", "확실성": "불확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "597", "label": "대화형", "length": 25, "text": "＂물론이죠, 귀해서 그렇지 사용해도 됩니다.＂", "value": { "text_id": "19", "word_num": 5, "핵심동사": "사용해도", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "623", "label": "대화형", "length": 39, "text": "＂**씨, 그럼 우리 알가족을 위해서 씨간장 몇 방울만 양보해주세요.＂", "value": { "text_id": "20", "word_num": 9, "핵심동사": "양보해주세요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "663", "label": "대화형", "length": 12, "text": "＂오케이, 그러세요.＂", "value": { "text_id": "21", "word_num": 2, "핵심동사": "그러세요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "676", "label": "대화형", "length": 48, "text": "＂그럼 아까 진간장 7 큰 술을 준비했는데요, 1 큰 술 빼고 6 큰 술을 넣을게요.＂", "value": { "text_id": "22", "word_num": 15, "핵심동사": "넣을게요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "725", "label": "대화형", "length": 34, "text": "＂씨간장이 없는 분들은 진간장 7 큰 술을 넣으시면 됩니다.＂", "value": { "text_id": "23", "word_num": 9, "핵심동사": "넣으시면", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "760", "label": "대화형", "length": 19, "text": "＂이렇게 간장소스는 완성됐습니다.＂", "value": { "text_id": "24", "word_num": 3, "핵심동사": "완성됐습니다", "확실성": "확실", "극성": "긍정", "시제": "과거", "key_word": " " } } ], "dupLabelYn": "Y", "metaData": { "ID": "560205", "FILENAME": "560205.json", "MEDIA_TYPE": "방송대본", "MEDIA_NAME": "알토란", "CATEGORY": "생활건강", "PUBDATE": "20210822", "SENTENCE": "24" } } 