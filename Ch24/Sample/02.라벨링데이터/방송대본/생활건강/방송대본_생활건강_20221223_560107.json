{ "annotation": [ { "charNum": "10", "label": "대화형", "length": 13, "text": "＂지금부터 집중하세요.＂", "value": { "text_id": "1", "word_num": 2, "핵심동사": "집중하세요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "24", "label": "대화형", "length": 29, "text": "＂본격적으로 옥수수 맛있게 삶는 법 알려 드릴게요.＂", "value": { "text_id": "2", "word_num": 7, "핵심동사": "알려", "확실성": "확실", "극성": "긍정", "시제": "미래", "key_word": " " } }, { "charNum": "54", "label": "대화형", "length": 17, "text": "＂옥수수 6개를 준비했는데요.＂", "value": { "text_id": "3", "word_num": 3, "핵심동사": "준비했는데요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "72", "label": "대화형", "length": 18, "text": "＂먼저 옥수수수염은 제거하고요.＂", "value": { "text_id": "4", "word_num": 3, "핵심동사": "제거하고요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "91", "label": "대화형", "length": 29, "text": "＂옥수수 껍질은 2겹 정도만 남기고 다 제거할게요.＂", "value": { "text_id": "5", "word_num": 7, "핵심동사": "제거할게요", "확실성": "확실", "극성": "긍정", "시제": "미래", "key_word": " " } }, { "charNum": "121", "label": "대화형", "length": 21, "text": "＂셰프님, 껍질은 왜 남기는 거예요?＂", "value": { "text_id": "6", "word_num": 5, "핵심동사": "남기는", "확실성": "불확실", "극성": "미정", "시제": "현재", "key_word": " " } }, { "charNum": "143", "label": "대화형", "length": 40, "text": "＂옥수수의 껍질이 수분 빠지는 걸 잡아 줘서 촉촉하게 찔 수 있거든요.＂", "value": { "text_id": "7", "word_num": 11, "핵심동사": "찔", "확실성": "확실", "극성": "긍정", "시제": "미래", "key_word": " " } }, { "charNum": "184", "label": "대화형", "length": 37, "text": "＂또 옥수수 껍질에서 단맛과 영양분이 나오니까 꼭 기억해 두세요.＂", "value": { "text_id": "8", "word_num": 9, "핵심동사": "기억해", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "222", "label": "대화형", "length": 34, "text": "＂이제 손질한 옥수수수염과 옥수수는 물에 살짝 씻어 줄게요.＂", "value": { "text_id": "9", "word_num": 8, "핵심동사": "씻어", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "257", "label": "대화형", "length": 14, "text": "＂절대 버리면 안 돼요.＂", "value": { "text_id": "10", "word_num": 4, "핵심동사": "돼요", "확실성": "확실", "극성": "부정", "시제": "현재", "key_word": " " } }, { "charNum": "272", "label": "대화형", "length": 23, "text": "＂옥수수수염이 맛의 큰 역할을 하는데요.＂", "value": { "text_id": "11", "word_num": 5, "핵심동사": "하는데요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } }, { "charNum": "296", "label": "대화형", "length": 51, "text": "＂수염 자체의 고소함이 더해지고요, 수염 속에 있는 포도당이 옥수수의 단맛을 더해주거든요.＂", "value": { "text_id": "12", "word_num": 11, "핵심동사": "더해주거든요", "확실성": "확실", "극성": "긍정", "시제": "미래", "key_word": " " } }, { "charNum": "348", "label": "대화형", "length": 20, "text": "＂옥수수수염은 육수 팩에 넣을게요.＂", "value": { "text_id": "13", "word_num": 4, "핵심동사": "넣을게요", "확실성": "확실", "극성": "긍정", "시제": "현재", "key_word": " " } } ], "dupLabelYn": "Y", "metaData": { "ID": "560107", "FILENAME": "560107.json", "MEDIA_TYPE": "방송대본", "MEDIA_NAME": "알토란", "CATEGORY": "생활건강", "PUBDATE": "20210725", "SENTENCE": "13" } } 